@using UI.ViewModels;
@{
    int pageSize = (ViewData["PageInfo"] as VMPageInfo)?.PageSize ?? 5;
    int pageCurrent = (ViewData["PageInfo"] as VMPageInfo)?.PageCurrent ?? 1;
    string timKiem = (ViewData["PageInfo"] as VMPageInfo)?.Search ?? "";
    string sortCurrent = (ViewData["PageInfo"] as VMPageInfo)?.Sort ?? "";
    int record_giayto = 1;
}
@model List<DataAccess.Entities.Manages.AttachedFile>

<div class="card card-custom" style="border: 1px solid #60aee4;">
    <div class="card-header flex-wrap border-0 pt-6 pb-0">
        <div class="card-title">
            <h3 class="card-label">
                Thông tin giấy tờ đính kèm
                <span class="d-block text-muted pt-2 font-size-sm">Quản lý thông tin giấy tờ đính kèm</span>
            </h3>
        </div>
        <div class="card-toolbar">
            <button type="button" class="btn btn-primary font-weight-bolder" title="Create" onclick="CreateAttachedFile()">
                <i class="la la-plus"></i>Thêm mới
            </button>
        </div>
    </div>
    <hr />
    <div class="card-body">
        <div class="row">
            <div class="col-xl-3" style="text-align:left">
                <div class="form-group fv-plugins-icon-container">
                    <label style="color:blue">Hiển thị</label>
                    <select class="form-control select2basic" name="PageSizeAttachedFileSearch" id="PageSizeAttachedFileSearch" onchange="ChangeAttachedFile()">
                        <!option value="5" @(pageSize == 5 ? "selected" : "")>5 thông tin</!option>
                        <!option value="10" @(pageSize == 10 ? "selected" : "")>10 thông tin</!option>
                        <!option value="20" @(pageSize == 20 ? "selected" : "")>20 thông tin</!option>
                        <!option value="50" @(pageSize == 50 ? "selected" : "")>50 thông tin</!option>
                        <!option value="100" @(pageSize == 100 ? "selected" : "")> 100 thông tin</!option>
                    </select>
                </div>
            </div>
            <div class="col-xl-9" style="text-align:right">
                <div class="form-group fv-plugins-icon-container">
                    <label style="color:blue">Tìm kiếm</label>
                    <input class="form-control" name="txtAttachedFileSearch" id="txtAttachedFileSearch" placeholder="Tìm kiếm..." value="@timKiem" onchange="ChangeAttachedFile()">
                </div>
            </div>
        </div>
        <input hidden id="sort_current" name="sort_current" value="@sortCurrent" />
        <input hidden id="pageCurrent" name="pageCurrent" value="@pageCurrent" />
        <div class="table-responsive border rounded-lg mb-8">
            <table class="table table-striped table-hover rounded-lg m-0">
                <thead class="thead-light">
                    <tr class="table-active">
                        <th style="text-align: center; font-weight: bold;" width="5%">#</th>
                        <th style="text-align: center; font-weight: bold;">Mô tả</th>
                        @* <th style="text-align: center; font-weight: bold;">Đường dẫn</th> *@
                        <th style="text-align: center; font-weight: bold;">File đính kèm</th>
                        <th style="text-align: center; font-weight: bold;" width="10%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td style="text-align: center; vertical-align: middle">@(record_giayto++)</td>
                                <td style="vertical-align: middle">
                                    <div class="row">
                                        <div class="col-2"></div>
                                        <div class="col-10">@item.MoTa</div>
                                    </div>
                                </td>
                                @* <td style="vertical-align: middle">@item.Url</td> *@
                                <td style="vertical-align: middle">@($"{item.FileName}")</td>
                                <td class="text-center text-nowrap" style="vertical-align: middle">
                                    <button type="button" onclick="EditAttachedFile('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Chỉnh sửa">
                                        <i class="icon-lg la la-edit text-success"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-clean btn-icon" title="Xóa" onclick="DeleteAttachedFile('@item.Id', '@item.MoTa')">
                                        <i class="icon-lg la la-trash text-danger"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" style="text-align:center">Không có thông tin</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
    </div>
    @await Html.PartialAsync("~/Views/Admin/AttachedFile/Modal.cshtml")
</div>
