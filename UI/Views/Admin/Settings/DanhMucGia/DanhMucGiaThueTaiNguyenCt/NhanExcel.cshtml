@{
    Layout = "_Layout";
}

@section custom_style {
    <style>
        .mapping-card {
            background-color: #f8f9fa;
            border-left: 4px solid #3699FF;
        }
        .preview-container {
            max-height: 400px;
            overflow-y: auto;
        }
    </style>
}

@section custom_script {
    <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>
    <script>
        let wb = null;
        let parsedData = [];

        $(document).ready(function () {
            $('#file_excel').on('change', handleFileSelect);
            $('#sheet_name, #row_start, #col_stt, #col_cap1, #col_cap2, #col_cap3, #col_cap4, #col_cap5, #col_cap6, #col_ten, #col_dvt').on('change', processExcelData);
            $('#btn_import').on('click', submitData);
        });

        function handleFileSelect(e) {
            const file = e.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function (e) {
                const data = new Uint8Array(e.target.result);
                try {
                    wb = XLSX.read(data, { type: 'array' });
                    
                    // Populate sheet select
                    const sheetSelect = $('#sheet_name');
                    sheetSelect.empty();
                    wb.SheetNames.forEach((name, index) => {
                        sheetSelect.append(`<option value="${name}" ${index === 0 ? 'selected' : ''}>${name}</option>`);
                    });

                    $('#config_section').slideDown();
                    processExcelData();
                } catch (err) {
                    toastr.error("Không thể đọc file Excel: " + err.message);
                }
            };
            reader.readAsArrayBuffer(file);
        }

        function processExcelData() {
            if (!wb) return;

            const sheetName = $('#sheet_name').val();
            const ws = wb.Sheets[sheetName];
            if (!ws) return;

            const rowStart = parseInt($('#row_start').val()) || 2;
            
            const getColIndex = (colLetter) => {
                if (!colLetter) return -1;
                let col = colLetter.trim().toUpperCase();
                let index = 0;
                for (let i = 0; i < col.length; i++) {
                    index = index * 26 + (col.charCodeAt(i) - 64);
                }
                return index - 1;
            };

            const colSttIdx = getColIndex($('#col_stt').val());
            const colCap1Idx = getColIndex($('#col_cap1').val());
            const colCap2Idx = getColIndex($('#col_cap2').val());
            const colCap3Idx = getColIndex($('#col_cap3').val());
            const colCap4Idx = getColIndex($('#col_cap4').val());
            const colCap5Idx = getColIndex($('#col_cap5').val());
            const colCap6Idx = getColIndex($('#col_cap6').val());
            const colTenIdx = getColIndex($('#col_ten').val());
            const colDvtIdx = getColIndex($('#col_dvt').val());

            const range = XLSX.utils.decode_range(ws['!ref'] || "A1:A1");
            parsedData = [];

            for (let r = rowStart - 1; r <= range.e.r; r++) {
                const getCellValue = (cIdx) => {
                    if (cIdx < 0) return "";
                    const cellAddress = XLSX.utils.encode_cell({ r: r, c: cIdx });
                    const cell = ws[cellAddress];
                    return cell && cell.v !== undefined ? String(cell.v).trim() : "";
                };

                const ten = getCellValue(colTenIdx);
                
                if (ten) {
                    parsedData.push({
                        DanhMucGiaThueTaiNguyenId: '@ViewData["DanhMucGiaThueTaiNguyenId"]',
                        STTSapXep: parseInt(getCellValue(colSttIdx)) || 0,
                        Cap1: getCellValue(colCap1Idx),
                        Cap2: getCellValue(colCap2Idx),
                        Cap3: getCellValue(colCap3Idx),
                        Cap4: getCellValue(colCap4Idx),
                        Cap5: getCellValue(colCap5Idx),
                        Cap6: getCellValue(colCap6Idx),
                        Ten: ten,
                        DonViTinh: getCellValue(colDvtIdx)
                    });
                }
            }

            renderPreview();
        }

        function renderPreview() {
            const tbody = $('#preview_tbody');
            tbody.empty();

            if (parsedData.length === 0) {
                tbody.append('<tr><td colspan="9" class="text-center text-muted">Không tìm thấy dữ liệu phù hợp với cấu hình mapping hiện tại</td></tr>');
                $('#btn_import').attr('disabled', true);
                $('#preview_card').slideUp();
                return;
            }

            const previewCount = Math.min(10, parsedData.length);
            for (let i = 0; i < previewCount; i++) {
                const item = parsedData[i];
                tbody.append(`
                    <tr>
                        <td>${item.STTSapXep || (i + 1)}</td>
                        <td>${item.Cap1}</td>
                        <td>${item.Cap2}</td>
                        <td>${item.Cap3}</td>
                        <td>${item.Cap4}</td>
                        <td>${item.Cap5}</td>
                        <td>${item.Cap6}</td>
                        <td>${item.Ten}</td>
                        <td>${item.DonViTinh}</td>
                    </tr>
                `);
            }

            $('#total_rows_txt').text(`Tổng số dòng tìm thấy: ${parsedData.length} dòng.`);
            $('#btn_import').attr('disabled', false);
            $('#preview_card').slideDown();
        }

        function submitData() {
            if (parsedData.length === 0) return;

            const csrfToken = $('input[name="__RequestVerificationToken"]').val();
            
            $('#btn_import').attr('disabled', true).html('<span class="spinner spinner-white spinner-right mr-2"></span>Đang xử lý...');
            
            $.ajax({
                url: '/Settings/DanhMucGia/DanhMucGiaThueTaiNguyenCt/ImportExcel',
                type: 'POST',
                contentType: 'application/json',
                headers: {
                    'RequestVerificationToken': csrfToken
                },
                data: JSON.stringify(parsedData),
                success: function (res) {
                    if (res.status === 'success') {
                        toastr.success(res.message);
                        setTimeout(() => {
                            window.location.href = `/Settings/DanhMucGia/DanhMucGiaThueTaiNguyenCt?danhMucGiaThueTaiNguyenId=@ViewData["DanhMucGiaThueTaiNguyenId"]`;
                        }, 1000);
                    } else {
                        toastr.error(res.message, "Lỗi!");
                        $('#btn_import').attr('disabled', false).html('<i class="la la-check"></i>Thực hiện nhận dữ liệu');
                    }
                },
                error: function (xhr, status, error) {
                    toastr.error("Đã xảy ra lỗi trong quá trình import dữ liệu!");
                    $('#btn_import').attr('disabled', false).html('<i class="la la-check"></i>Thực hiện nhận dữ liệu');
                }
            });
        }
    </script>
}

<div class="card card-custom">
    <div class="card-header">
        <div class="card-title">
            <h3 class="card-label">
                <b>@ViewData["Title"]</b>
                <span class="d-block text-muted pt-2 font-size-sm">
                    Danh mục: <b class="text-primary">@ViewData["TenDanhMuc"]</b>
                </span>
            </h3>
        </div>
        <div class="card-toolbar">
            <a asp-controller="DanhMucGiaThueTaiNguyenCt" asp-action="Index" asp-route-danhMucGiaThueTaiNguyenId="@ViewData["DanhMucGiaThueTaiNguyenId"]" class="btn btn-light-primary font-weight-bolder">
                <i class="la la-reply"></i>Quay lại
            </a>
        </div>
    </div>
    <div class="card-body">
        @Html.AntiForgeryToken()
        
        <!-- Step 1: File selection -->
        <div class="row mb-6">
            <div class="col-lg-6">
                <div class="form-group mb-0">
                    <label class="font-weight-bolder">Chọn file Excel dữ liệu:</label>
                    <div class="custom-file">
                        <input type="file" class="custom-file-input" id="file_excel" accept=".xlsx, .xls">
                        <label class="custom-file-label" for="file_excel">Chọn file...</label>
                    </div>
                    <span class="form-text text-muted">Hệ thống hỗ trợ định dạng file .xlsx, .xls</span>
                </div>
            </div>
        </div>

        <!-- Step 2: Configuration Mapping (Hidden initially) -->
        <div id="config_section" style="display: none;" class="card p-6 mapping-card mb-6">
            <h5 class="mb-4 text-primary font-weight-bold"><i class="la la-cog text-primary"></i> Cấu hình đọc File Excel</h5>
            <div class="row">
                <div class="col-lg-3 col-md-6 form-group">
                    <label>Sheet dữ liệu:</label>
                    <select class="form-control" id="sheet_name"></select>
                </div>
                <div class="col-lg-3 col-md-6 form-group">
                    <label>Dòng bắt đầu đọc:</label>
                    <input type="number" class="form-control" id="row_start" value="2" min="1" />
                </div>
            </div>

            <h6 class="mt-4 mb-3 font-weight-bold text-dark">Ánh xạ cột dữ liệu (Nhập ký tự chữ cái cột, ví dụ: A, B, C...)</h6>
            <div class="row">
                <div class="col-lg-2 col-md-4 form-group">
                    <label>Cột STT sắp xếp:</label>
                    <input type="text" class="form-control text-uppercase" id="col_stt" value="A" />
                </div>
                <div class="col-lg-1 col-md-2 form-group">
                    <label>Cột Cấp I:</label>
                    <input type="text" class="form-control text-uppercase" id="col_cap1" value="B" />
                </div>
                <div class="col-lg-1 col-md-2 form-group">
                    <label>Cột Cấp II:</label>
                    <input type="text" class="form-control text-uppercase" id="col_cap2" value="C" />
                </div>
                <div class="col-lg-1 col-md-2 form-group">
                    <label>Cột Cấp III:</label>
                    <input type="text" class="form-control text-uppercase" id="col_cap3" value="D" />
                </div>
                <div class="col-lg-1 col-md-2 form-group">
                    <label>Cột Cấp IV:</label>
                    <input type="text" class="form-control text-uppercase" id="col_cap4" value="E" />
                </div>
                <div class="col-lg-1 col-md-2 form-group">
                    <label>Cột Cấp V:</label>
                    <input type="text" class="form-control text-uppercase" id="col_cap5" value="F" />
                </div>
                <div class="col-lg-1 col-md-2 form-group">
                    <label>Cột Cấp VI:</label>
                    <input type="text" class="form-control text-uppercase" id="col_cap6" value="G" />
                </div>
                <div class="col-lg-2 col-md-4 form-group">
                    <label>Cột Tên nhóm/tài nguyên:</label>
                    <input type="text" class="form-control text-uppercase" id="col_ten" value="H" />
                </div>
                <div class="col-lg-2 col-md-4 form-group">
                    <label>Cột Đơn vị tính:</label>
                    <input type="text" class="form-control text-uppercase" id="col_dvt" value="I" />
                </div>
            </div>
        </div>

        <!-- Step 3: Data Preview (Hidden initially) -->
        <div id="preview_card" style="display: none;" class="card card-custom card-border mb-6">
            <div class="card-header bg-light">
                <div class="card-title">
                    <h5 class="card-label text-dark font-weight-bold"><i class="la la-eye text-dark"></i> Xem trước dữ liệu (Tối đa 10 dòng đầu)</h5>
                </div>
                <div class="card-toolbar">
                    <span id="total_rows_txt" class="label label-lg label-inline label-light-info font-weight-bolder"></span>
                </div>
            </div>
            <div class="card-body p-0 preview-container">
                <table class="table table-striped table-hover m-0">
                    <thead class="thead-light">
                        <tr>
                            <th width="5%">#</th>
                            <th width="6%">Cấp I</th>
                            <th width="6%">Cấp II</th>
                            <th width="6%">Cấp III</th>
                            <th width="6%">Cấp IV</th>
                            <th width="6%">Cấp V</th>
                            <th width="6%">Cấp VI</th>
                            <th>Tên nhóm, loại tài nguyên</th>
                            <th>Đơn vị tính</th>
                        </tr>
                    </thead>
                    <tbody id="preview_tbody"></tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="card-footer text-center">
        <button type="button" class="btn btn-primary font-weight-bold" id="btn_import" disabled>
            <i class="la la-check"></i>Thực hiện nhận dữ liệu
        </button>
    </div>
</div>
