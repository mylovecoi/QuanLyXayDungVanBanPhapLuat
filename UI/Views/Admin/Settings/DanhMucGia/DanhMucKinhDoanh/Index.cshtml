@using UI.ViewModels;
@using DataAccess.Entities.Settings;

@model VMPageInfoWithData<DanhMucKinhDoanh>

@{
	var session = HttpContextAccessor?.HttpContext?.Session ?? null;
	string role = ViewData["Role"] as string ?? "";
	int pageSize = Model.PageSize;
	string timKiem = Model.Search ?? "";
	int pageCurrent = Model.PageCurrent;
	ViewData["PageInfo"] = Model;
}

@section custom_style {

}

@section custom_script {
	<script src="~/js/site.js"></script>
	<script>
		$(document).ready(function () {
			$('.select2multi').select2();
			HandleRegisterFormFilter('#FilterForm', '#Pagination', '/Settings/DanhMucGia/DanhMucKinhDoanh');
		});

		function ClearTxtSearch() {
			$('#txt_Search').val('');
			$('#FilterForm').submit();
		}
	</script>
}

<div class="card card-custom">
	<div class="card-header flex-wrap border-0 pt-6 pb-0">
		<div class="card-title">
			<h3 class="card-label">
				<b>@ViewData["Title"]?.ToString()?.ToUpper()</b>
				<span class="d-block text-muted pt-2 font-size-sm">
					Quản lý @FuntionGlobal.CapitalizeAll(ViewData["Title"]?.ToString())
				</span>
			</h3>
		</div>
		<div class="card-toolbar">
			@if (session != null && FuntionGlobal.CheckPermission(session, role, "Create"))
			{
				<button type="button" class="btn btn-primary font-weight-bolder" onclick="Create('@Guid.Empty')">
					<i class="la la-plus"></i>Thêm mới
				</button>
			}
		</div>
	</div>
	@Html.AntiForgeryToken()
	<div class="card-body pt-0">
		<hr />
		<form id="FilterForm" method="GET" action="/Settings/DanhMucGia/DanhMucKinhDoanh">
			<div class="row mb-5">
				<div class="col-md-4">
					<div class="form-group">
						<label style="font-weight: bold; color: blue;">Loại Giá:</label>
						<select class="form-control" id="LoaiGia" name="LoaiGia">
							<option value="">-- Tất cả --</option>
							<!option value="KKG" @(ViewData["SelectedLoaiGia"]?.ToString() == "KKG" ? "selected" : "")>Kê khai đăng ký giá</!option>
							<!option value="DG" @(ViewData["SelectedLoaiGia"]?.ToString() == "DG" ? "selected" : "")>Quản lý giá</!option>
						</select>
					</div>
				</div>
			</div>
			<hr />
			<div class="row">
				<div class="col-xl-3" style="text-align:left">
					<div class="form-group fv-plugins-icon-container">
						<label class="text-blue">Hiển thị</label>
						<select class="form-control h-40px" name="PageSize" id="PageSize_Select">
							<!option value="5" @(pageSize == 5 ? "selected" : "")>5 thông tin</!option>
							<!option value="10" @(pageSize == 10 ? "selected" : "")>10 thông tin</!option>
							<!option value="20" @(pageSize == 20 ? "selected" : "")>20 thông tin</!option>
							<!option value="50" @(pageSize == 50 ? "selected" : "")>50 thông tin</!option>
							<!option value="100" @(pageSize == 100 ? "selected" : "")> 100 thông tin</!option>
						</select>
					</div>
				</div>
				<div class="col-xl-9">
					<div class="form-group fv-plugins-icon-container">
						<label class="text-blue">Tìm kiếm</label>
						<div class="input-group">
							<input class="form-control h-40px" name="Search" id="txt_Search" placeholder="Tìm kiếm theo mã, tên..." value="@timKiem">
							<div class="input-group-prepend">
								<button class="btn btn-danger" type="button" onclick="ClearTxtSearch()"><i class="las la-times-circle"></i></button>
							</div>
							<div class="input-group-append">
								<button class="btn btn-primary" type="submit"><i class="las la-search"></i></button>
							</div>
						</div>
					</div>
				</div>
			</div>
			<input hidden id="PageCurrent" name="PageCurrent" value="@pageCurrent" />
		</form>
		<!--begin: Datatable-->
		<div class="table-responsive border rounded-lg mb-8">
			<table class="table table-striped table-hover table-responsive-lg rounded-lg">
				<thead>
					<tr style="text-align:center;" class="table-active">
						<th style="font-weight: bold;" width="2%">#</th>
						<th style="font-weight: bold;">Phân loại</th>
						<th style="font-weight: bold;">Tên nghề / Ngành nghề kinh doanh</th>
						<th style="font-weight: bold;">Thông tin chi tiết</th>
						<th style="font-weight: bold;" width="10%">Trạng thái</th>
						<th style="font-weight: bold;" width="10%">Thao tác</th>
					</tr>
				</thead>
				<tbody>
					@if (Model.Data != null && Model.Data.Any())
					{
						@foreach (var item in Model.Data)
						{
							<tr class="@(FuntionGlobal.GetClassTable(item.Level))">
								<td style="text-align: left; vertical-align: middle" width="5%">
									@Html.Raw(FuntionGlobal.GetBackIn(item.Level))
									@item.STTSapXep
								</td>
								<td style="text-align: left; vertical-align: middle">
									<span style="width: 112px;">
										@Html.Raw(FuntionGlobal.GetBackIn(item.Level))
										<span class="label font-weight-bold label-lg @(item.PhanLoai == "Group" ? "label-primary" : "label-success") label-inline">
											@item.PhanLoai @(item.Level > 0 && item.PhanLoai == "Group" ? item.Level : "")
										</span>
									</span>
								</td>
								<td style="font-weight: bold; vertical-align: middle">
									@Html.Raw(FuntionGlobal.GetBackIn(item.Level))
									@item.TenNghe
								</td>
								<td style="font-weight: bold; font-size: 10px; vertical-align: middle">
									<span class="label label-info label-inline mr-2">Mã HH_BTC</span>@item.MaHH_BTC
									<br />
									<span class="label label-primary label-inline mr-2">Mã Nghề</span>@item.MaNghe
									<br />
									@if (!string.IsNullOrEmpty(item.Role))
									{
										<span class="label label-success label-inline mr-2">Role</span>@item.Role
										<br />
									}
									@if (!string.IsNullOrEmpty(item.LoaiGia))
									{
										<span class="label label-dark label-inline mr-2">Loại giá</span>@(item.LoaiGia == "KKG" ? "Kê khai giá" : item.LoaiGia == "DG" ? "Định giá" : item.LoaiGia)
										<br />
									}
								</td>
								<td style="text-align: center; vertical-align: middle">
									<span style="width: 112px;">
										@if (item.TheoDoi == "TD")
										{
											<span class="label font-weight-bold label-lg label-light-info label-inline">Theo dõi</span>
										}
										else
										{
											<span class="label font-weight-bold label-lg label-danger label-inline">Khóa</span>
										}
									</span>
								</td>
								<td class="text-center" style="vertical-align: middle">
									@Html.Raw(FuntionGlobal.GetBackIn(item.Level))
									@if (session != null && FuntionGlobal.CheckPermission(session, role, "Create"))
									{
										@if (item.PhanLoai != "Detail")
										{
											<button type="button" class="btn btn-sm btn-clean btn-icon" title="Thêm mục con" onclick="Create('@item.Id')">
												<i class="icon-lg la la-plus text-primary"></i>
											</button>
										}
									}
									@if (session != null && FuntionGlobal.CheckPermission(session, role, "Edit"))
									{
										<button type="button" onclick="Edit('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Chỉnh sửa">
											<i class="icon-lg la la-edit text-success"></i>
										</button>
									}
									@if (session != null && FuntionGlobal.CheckPermission(session, role, "Delete"))
									{
										<button type="button" class="btn btn-sm btn-clean btn-icon" title="Xóa" onclick="Delete('@item.Id', '@item.TenNghe')">
											<i class="icon-lg la la-trash text-danger"></i>
										</button>
									}
								</td>
							</tr>
						}
					}
					else
					{
						<tr>
							<td style="text-align:center" colspan="6">Không tìm thấy thông tin!!!</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<!--end: Datatable-->
		<div id="Pagination">
			@await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
		</div>
	</div>
</div>
@await Html.PartialAsync("~/Views/Admin/Settings/DanhMucGia/DanhMucKinhDoanh/Modal.cshtml")
