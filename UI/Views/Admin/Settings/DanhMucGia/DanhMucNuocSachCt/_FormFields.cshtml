@model DataAccess.Entities.Settings.DanhMucGia.DanhMucNuocSachCt

<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="DanhMucNuocSachId" />

<div class="row">
    <div class="col-xl-6">
        <div class="form-group fv-plugins-icon-container">
            <label>Số thứ tự sắp xếp:</label>
            <input type="number" class="form-control" asp-for="STTSapXep" required />
        </div>
    </div>
    <div class="col-xl-6">
        <div class="form-group fv-plugins-icon-container">
            <label>Mã đối tượng: <span class="text-danger">*</span></label>
            <input type="text" class="form-control" asp-for="MaDoiTuong" required />
        </div>
    </div>
    <div class="col-xl-12">
        <div class="form-group fv-plugins-icon-container">
            <label>Đối tượng sử dụng: <span class="text-danger">*</span></label>
            <input type="text" class="form-control" asp-for="DoiTuongSuDung" required />
        </div>
    </div>
</div>

