@section custom_style {
}
@section custom_script {
	<script src="~/lib/ckeditor/ckeditor.js"></script>
	<script>
		$(document).ready(function () {
			CKEDITOR.replace('TrinhTuThucHien');
			CKEDITOR.replace('ThanhPhanHoSo');
			CKEDITOR.replace('YeuCauDieuKien');
			CKEDITOR.replace('CanCuPhapLy');
			CKEDITOR.replace('KetQuaThucHien');
		});
	</script>
}
<div class="card card-custom">
	<div class="card-header ribbon ribbon-top ribbon-ver">
		<div class="card-title">
			<h3 class="card-label">
				@ViewData["Title"]
				<span class="d-block text-muted pt-2 font-size-sm">
					Thêm mới @ViewData["Title"]
				</span>
			</h3>
		</div>
	</div>
	<!--begin::Form-->
	<form asp-controller="DanhMucThuTuc" asp-action="Store" method="post">
		<div class="card-body">
			@await Html.PartialAsync("~/Views/Admin/Settings/DanhMucDungChung/DanhMucThuTuc/Detail/Index.cshtml")
		</div>
		<div class="card-footer" style="text-align:center">
			<a asp-controller="DanhMucThuTuc" asp-action="Index" class="btn btn-danger">
				<i class="la la-reply"></i>Quay lại
			</a>&ensp;
			<button type="reset" class="btn btn-secondary"><i class="la la-refresh"></i>Nhập lại</button>&ensp;
			<button type="submit" class="btn btn-primary mr-2"><i class="la la-check"></i>Hoàn Thành</button>
		</div>
	</form>
	<!--end::Form-->
</div>
@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}