@using UI.ViewModels;
@model VMPageInfoWithData<DataAccess.Entities.Settings.DanhMucHopDong>
@{
	ViewData["PageInfo"] = Model;
	var session = HttpContextAccessor?.HttpContext?.Session ?? null;
	string role = ViewData["Role"] as string ?? "";
}

<div class="card card-custom">
	<div class="card-header flex-wrap border-0 pt-6 pb-0">
		<div class="card-title">
			<h3 class="card-label">
				<b>@ViewData["Title"]?.ToString()?.ToUpper()</b>
				<span class="d-block text-muted pt-2 font-size-sm">
					Quản lý @FuntionGlobal.CapitalizeAll(ViewData["Title"]?.ToString())
				</span>
			</h3>
		</div>
		<div class="card-toolbar">
			@if (session != null && FuntionGlobal.CheckPermission(session, role, "Create"))
			{
				<button type="button" class="btn btn-primary font-weight-bolder" onclick="HandleShowModel('modalCreateOrEdit','@Url.Action("Create", "DanhMucNghiepVu")', 'Thêm mới Danh mục Nhóm nghiệp vụ')">
					<i class="la la-plus"></i>Thêm mới
				</button>
			}
		</div>
	</div>
	@Html.AntiForgeryToken()
	<div class="card-body pt-0">
		<form id="FilterForm">
			<hr />
			<div class="row">
				<div class="col-xl-3" style="text-align:left">
					<div class="form-group fv-plugins-icon-container">
						<label class="text-blue">Hiển thị</label>
						<select class="form-control h-40px" name="PageSize" id="PageSize_Select">
							<!option value="5" @(Model.PageSize == 5 ? "selected" : "")>5 thông tin</!option>
							<!option value="10" @(Model.PageSize == 10 ? "selected" : "")>10 thông tin</!option>
							<!option value="20" @(Model.PageSize == 20 ? "selected" : "")>20 thông tin</!option>
							<!option value="50" @(Model.PageSize == 50 ? "selected" : "")>50 thông tin</!option>
							<!option value="100" @(Model.PageSize == 100 ? "selected" : "")> 100 thông tin</!option>
						</select>
					</div>
				</div>
				<div class="col-xl-9">
					<div class="form-group fv-plugins-icon-container">
						<label class="text-blue">Tìm kiếm</label>
						<div class="input-group">
							<input class="form-control h-40px" name="Search" id="txt_Search" placeholder="Tìm kiếm..." value="@Model.Search">
							<div class="input-group-prepend">
								<button class="btn btn-danger" type="reset"><i class="las la-times-circle"></i></button>
							</div>
							<div class="input-group-append">
								<button class="btn btn-primary" type="submit"><i class="las la-search"></i></button>
							</div>
						</div>
					</div>
				</div>
			</div>
			<input hidden id="sort_current" name="sort_current" value="@Model.Sort" />
			<input hidden id="PageCurrent" name="PageCurrent" value="@Model.PageCurrent" />
		</form>
		<!--begin: Datatable-->
		<div class="table-responsive border rounded-lg mb-8">
			@await Html.PartialAsync("~/Views/Admin/Settings/DanhMucDungChung/DanhMucNghiepVu/_DataTable.cshtml", Model.Data)
			<form id="DeleteForm" method="post" style="display:none;" asp-controller="DanhMucNghiepVu" asp-action="Delete">
				<input type="hidden" name="danhMucId" id="recordId" />
			</form>
		</div>
		<!--end: Datatable-->
		<div id="Pagination">
			@await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
		</div>
	</div>
</div>
@await Html.PartialAsync("~/Views/Shared/_ModalPartial.cshtml")

@section custom_style {

}

@section custom_script {
	@* page *@
	<script src="~/js/site.js"></script>
	@* lib *@

	<script>
		$(document).ready(function () {
			HandleRegisterFormFilter('#FilterForm', '#Pagination', '@Url.Action("Index", "DanhMucNghiepVu")');
		});
	</script>
}