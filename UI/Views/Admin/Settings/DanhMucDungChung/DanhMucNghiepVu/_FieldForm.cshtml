@using DataAccess.Entities.Settings
@model DataAccess.Entities.Settings.DanhMucHopDongChiTiet
@{
	bool initalOptionDataDisplay = Model.Type == FieldType.Select ||
								   Model.Type == FieldType.Checkbox ||
								   Model.Type == FieldType.Radio;
}

<div class="modal-body">
	<div asp-validation-summary="ModelOnly" class="text-danger"></div>
	@if (ViewData["Msg"] != null)
	{
		<div class="alert alert-danger" role="alert">@ViewData["Msg"]</div>
	}

	<form id="FieldForm" method="post" action="@Url.Action(Model != null && Model.Id != Guid.Empty ? "FieldUpdate" : "FieldStore", "DanhMucNghiepVu")" onsubmit="return handleFieldFormSubmit(event, this);">
		@Html.AntiForgeryToken()
		<input type="hidden" asp-for="Id" />
		<input type="hidden" asp-for="DanhMucHopDongId" />

		<div class="row">
			<div class="col-xl-8">
				<div class="form-group">
					<label class="form-label fs-6 text-blue font-weight-boldest">Tiêu đề</label>
					<label class="form-label text-blue font-weight-boldest">:</label><span class="text-danger"> (*)</span>
					<input class="form-control" asp-for="Title" placeholder="Nhập tiêu đề trường" required>
					<span asp-validation-for="Title" class="text-danger mt-1"></span>
				</div>
			</div>

			<div class="col-xl-4">
				<div class="form-group">
					<label class="form-label fs-6 text-blue font-weight-boldest">Kiểu trường</label>
					<label class="form-label text-blue font-weight-boldest">:</label><span class="text-danger"> (*)</span>
					<select class="form-control" asp-for="Type" id="fieldTypeSelect" onchange="handleFieldTypeChange()" required>
						<option value="">-- Chọn kiểu trường --</option>
						<option value="Text">Văn bản (1 dòng)</option>
						<option value="TextArea">Văn bản (nhiều dòng)</option>
						<option value="Number">Số</option>
						<option value="Date">Ngày</option>
						<option value="Money">Số tiền</option>
						<option value="Select">Lựa chọn một (Dropdown)</option>
						<option value="Checkbox">Lựa chọn nhiều (Checkbox)</option>
						<option value="Radio">Lựa chọn một (Radio)</option>
					</select>
					<span asp-validation-for="Type" class="text-danger mt-1"></span>
				</div>
			</div>

			<div class="col-xl-2">
				<div class="form-group">
					<label class="form-label fs-6 text-blue font-weight-boldest">Thứ tự</label>
					<label class="form-label text-blue font-weight-boldest">:</label><span class="text-danger"> (*)</span>
					<input class="form-control" asp-for="Order" type="number" min="1" placeholder="Từ 1 trở lên" required>
					<span asp-validation-for="Order" class="text-danger mt-1"></span>
				</div>
			</div>

			<div class="col-xl-3">
				<div class="form-group">
					<label class="form-label fs-6 text-blue font-weight-boldest">Độ rộng cột (1-12)</label>
					<label class="form-label text-blue font-weight-boldest">:</label><span class="text-danger"> (*)</span>
					<input class="form-control" asp-for="ColSize" type="number" min="1" max="12" placeholder="1-12" required>
					<span asp-validation-for="ColSize" class="text-danger mt-1"></span>
				</div>
			</div>
			<div class="col-xl-2">
				<div class="form-group">
					<label class="form-label fs-6 text-blue font-weight-boldest">Bắt buộc</label>
					<label class="form-label text-blue font-weight-boldest">:</label><span class="text-danger"> (*)</span>
					<select class="form-control" asp-for="IsRequired">
						<option value="false">Không</option>
						<option value="true">Có</option>
					</select>
				</div>
			</div>
			<div class="col-xl-5" id="optionDataGroup" style="display: @(initalOptionDataDisplay ? "block" : "none")">
				<div class="form-group">
					<label class="form-label fs-6 text-blue font-weight-boldest">Mã OptionData</label>
					<label class="form-label text-blue font-weight-boldest">:</label><span class="text-danger" id="optionDataRequired"> (*)</span>
					<input class="form-control" asp-for="Code" id="optionDataInput" placeholder="VD: LoaiTaiSan, HangXe">
					<span asp-validation-for="Code" class="text-danger mt-1"></span>
				</div>
			</div>
			<div class="col-xl-12">
				<div class="form-group">
					<label class="form-label fs-6 text-blue font-weight-boldest">Ghi chú</label>
					<label class="form-label text-blue font-weight-boldest">:</label>
					<input class="form-control" asp-for="GhiChu" placeholder="Ghi chú thêm về trường này">
				</div>
			</div>
		</div>
	</form>
</div>
<div class="modal-footer">
	<button type="button" class="btn btn-light-danger font-weight-bold" onclick="goBackToFieldsList()">Quay lại</button>
	<button type="submit" form="FieldForm" class="btn btn-primary font-weight-bold">Lưu</button>
</div>

<script>
	function handleFieldTypeChange() {
		const typeSelect = document.getElementById('fieldTypeSelect');
		const optionDataGroup = document.getElementById('optionDataGroup');
		const optionDataInput = document.getElementById('optionDataInput');
		const optionDataRequired = document.getElementById('optionDataRequired');

		const selectedValue = typeSelect.value;
		const needsOptionData = ['Select', 'Checkbox', 'Radio'].includes(selectedValue);

		if (needsOptionData) {
			optionDataGroup.style.display = 'block';
			optionDataInput.setAttribute('required', 'required');
			optionDataRequired.style.display = 'inline';
		} else {
			optionDataGroup.style.display = 'none';
			optionDataInput.removeAttribute('required');
			optionDataRequired.style.display = 'none';
		}
	}

	// Go back to fields list
	function goBackToFieldsList() {
		var danhMucId = '@Model.DanhMucHopDongId';
		HandleShowModel('modalCreateOrEdit','@Url.Action("ManageFields", "DanhMucNghiepVu")?danhMucId=' + danhMucId,'Quản lý các trường nhập động cho loại hợp đồng này');
		// Sau khi nội dung modal load xong, trigger resize để cập nhật chiều cao vùng cuộn
		setTimeout(function(){
			if (window.FieldsModalResize) {
				window.FieldsModalResize();
			}
		}, 50);
	}

	// Handle field form submit (based on HandleSubmitFormCreateOrEdit but with custom success callback)
	function handleFieldFormSubmit(event, form) {
		event.preventDefault();
		let urlPost = $(form).attr('action');

		HandlePostAjax({
			url: urlPost,
			data: new FormData(form),
			beforeSendCallback: (res) => {
				$('#modalCreateOrEdit').modal('hide');
			},
			successCallback: (res) => {
				if (res.isValid) {
					toastr.success(res.message || 'Lưu trường thành công!', 'Thành Công!');
					// Đợi một chút để hiển thị thông báo trước khi chuyển về danh sách
					setTimeout(() => {
						goBackToFieldsList();
					}, 300);
				}
				else {
					toastr.warning(res.message || 'Có lỗi khi thao tác với dữ liệu', 'Cảnh Báo!');
					if (res.html) {
						$('#modalCreateOrEdit #modalCreateOrEdit_Body').html(res.html);
						$('#modalCreateOrEdit').modal('show');
					}
				}
			},
			errorCallback: (xhr, status, error) => {
				toastr.error('Không nhận được phản hồi từ máy chủ. Vui lòng thử lại sau.');
			},
		});

		return false;
	}

	// Initialize on page load
	document.addEventListener('DOMContentLoaded', function() {
		handleFieldTypeChange();
	});
</script>


