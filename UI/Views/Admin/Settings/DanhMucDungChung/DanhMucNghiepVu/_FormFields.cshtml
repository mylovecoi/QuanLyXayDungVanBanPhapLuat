@model DataAccess.Entities.Settings.DanhMucHopDong
@if (Model != null)
{
	<form asp-action="@(Model.Id == Guid.Empty ? "Store" : "Update")" id="AddOrEditForm" onsubmit="return HandleSubmitFormCreateOrEdit(event ,this, 'modalCreateOrEdit');">
		<div class="modal-body">
			<div class="row">
				<div class="col-xl-12">
					<div asp-validation-summary="ModelOnly" class="text-danger"></div>
					@if (ViewData["Msg"] != null)
					{
						<div class="alert alert-danger" role="alert">@ViewData["Msg"]</div>
					}
					<input type="hidden" asp-for="Id" />
					<input type="hidden" asp-for="ParentId" />
					<input type="hidden" asp-for="Level" />
					@if (ViewData.ModelState["Level"]?.Errors.Count > 0)
					{
						<div class="alert alert-danger pb-0" role="alert">
							<h4 class="alert-heading">Cảnh báo</h4>
							<p>@ViewData.ModelState["Level"]?.Errors[0].ErrorMessage</p>
						</div>
					}

				</div>
				<div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 col-xxl-12 form-group">
					<label class="form-label text-blue fs-6 font-weight-boldest">@(Model.ParentId != Guid.Empty ? Html.DisplayNameFor(x => x.MaHopDong) : "Mã Nhóm Nghiệp Vụ")</label>
					<label class="form-label text-blue font-weight-boldest">:</label><span class="text-danger"> (*)</span>
					<input type="text" asp-for="MaHopDong" class="form-control" placeholder="Nhập @Html.DisplayNameFor(x=>x.MaHopDong).ToLower()">
					<span asp-validation-for="MaHopDong" class="text-danger mt-1"></span>
				</div>

				<div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 col-xxl-12 form-group">
					<label class="form-label text-blue fs-6 font-weight-boldest">@(Model.ParentId != Guid.Empty ? Html.DisplayNameFor(x => x.TenHopDong) : "Tên Nhóm Nghiệp Vụ")</label>
					<label class="form-label text-blue font-weight-boldest">:</label><span class="text-danger"> (*)</span>
					<input type="text" asp-for="TenHopDong" class="form-control" placeholder="Nhập @Html.DisplayNameFor(x=>x.TenHopDong).ToLower()">
					<span asp-validation-for="TenHopDong" class="text-danger mt-1"></span>
				</div>

				@if (Model.ParentId.HasValue == false || Model.ParentId == Guid.Empty)
				{
					<div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 col-xxl-12 form-group">
						<label class="form-label text-blue fs-6 font-weight-boldest" asp-for="IsCC"></label>
						<label class="form-label text-blue font-weight-boldest">:</label>
						<select class="form-control" asp-for="IsCC">
							<option value="true">Công Chứng</option>
							<option value="false">Chứng Thực</option>
						</select>
						<span asp-validation-for="IsCC" class="text-danger mt-1"></span>
					</div>
				}
				else
				{
					<div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 col-xxl-12 form-group">
						<label class="form-label text-blue fs-6 font-weight-boldest" asp-for="DanhSachOption"></label>
						<label class="form-label text-blue font-weight-boldest">:</label>
						<select class="form-control" asp-for="DanhSachOption" multiple>
							@if (Model?.DanhMucLoaiGiayTos != null)
							{
								foreach (var item in Model.DanhMucLoaiGiayTos)
								{
									<option value="@item.Value">@item.DisplayName</option>
								}
							}
						</select>
						<span asp-validation-for="DanhSachOption" class="text-danger mt-1"></span>
					</div>
				}

				<div class="col-sm-12 col-md-12 col-lg-6 col-xl-6 col-xxl-6 form-group">
					<label class="form-label text-blue fs-6 font-weight-boldest" asp-for="TrangThai"></label>
					<label class="form-label text-blue font-weight-boldest">:</label>
					<select class="form-control" asp-for="TrangThai">
						<option value="true">Đang Hoạt Động</option>
						<option value="false">Không Hoạt Động</option>
					</select>
					<span asp-validation-for="TrangThai" class="text-danger mt-1"></span>
				</div>

				<div class="col-sm-12 col-md-12 col-lg-6 col-xl-6 col-xxl-6 form-group">
					<label class="form-label text-blue fs-6 font-weight-boldest" asp-for="STTSapXep"></label>
					<label class="form-label text-blue font-weight-boldest">:</label>
					<input type="text" asp-for="STTSapXep" class="form-control" placeholder="Nhập @Html.DisplayNameFor(x=>x.STTSapXep).ToLower()">
					<span asp-validation-for="STTSapXep" class="text-danger mt-1"></span>
				</div>

				<div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 col-xxl-12 form-group">
					<label class="form-label text-blue fs-6 font-weight-boldest" asp-for="MoTa"></label>
					<label class="form-label text-blue font-weight-boldest">:</label>
					<textarea asp-for="MoTa" class="form-control" placeholder="Nhập @Html.DisplayNameFor(x=> x.MoTa).ToLower()" rows="4"></textarea>
					<span asp-validation-for="MoTa" class="text-danger mt-1"></span>
				</div>
			</div>
		</div>
		<div class="modal-footer">
			<button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Đóng</button>
			<button type="submit" class="btn btn-primary font-weight-bold">Xác Nhận</button>
		</div>
	</form>
}
else
{
	<div class="modal-body">
		<div class="row">
			<div class="col-xl-12">
				<div class="alert alert-danger d-flex align-items-center flex-wrap gap-1" role="alert">
					<span class="alert-icon rounded-circle"><i class="icon-base bx bx-error"></i></span>
					@(string.IsNullOrEmpty(ViewData["Msg"]?.ToString()) ? "Có lỗi trong quá trình xử lý. Hãy kiêm tra lại" : ViewData["Msg"])
				</div>
			</div>
		</div>
	</div>
	<div class="modal-footer">
		<button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Đóng</button>
	</div>
}
<script>
	$(document).ready(() => {
		SetupSelect2('#DanhSachOption', 'Lựa chọn loại giấy tờ', { enableSearch: true, enableClear: true });
		SetupSelect2('#TrangThai', 'Lựa chọn @Html.DisplayNameFor(x => x.TrangThai).ToLower()', { enableSearch: false, enableClear: false });
		SetupSelect2('#IsCC', 'Lựa chọn @Html.DisplayNameFor(x => x.IsCC).ToLower()', { enableSearch: false, enableClear: false });
	});
</script>