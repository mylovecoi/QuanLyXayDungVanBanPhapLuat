@using DataAccess.Entities.Settings
@model List<DanhMucHopDongChiTiet>
@{
	var danhMucId = (Guid)(ViewData["DanhMucId"] ?? Guid.Empty);
	var danhMucHopDong = ViewData["DanhMucHopDong"] as DanhMucHopDong;

	// Helper function for friendly field type names
	string GetFieldTypeName(FieldType type)
	{
		return type switch
		{
			FieldType.Text => "Văn bản (1 dòng)",
			FieldType.TextArea => "Văn bản (nhiều dòng)",
			FieldType.Number => "Số",
			FieldType.Date => "Ngày",
			FieldType.Money => "Số tiền",
			FieldType.Select => "Lựa chọn một (Dropdown)",
			FieldType.Checkbox => "Lựa chọn nhiều (Checkbox)",
			FieldType.Radio => "Lựa chọn một (Radio)",
			_ => throw new ArgumentOutOfRangeException(nameof(type), type, "Không hỗ trợ kiểu trường này")
		};
	}
}

<button style="float: right; margin-top: 1.75rem; margin-right: 1.75rem" type="button" class="btn btn-primary font-weight-bolder" onclick="HandleShowModel('modalCreateOrEdit','@Url.Action("FieldCreate", "DanhMucNghiepVu", new { danhMucId = danhMucId })','Thêm trường mới')">
	<i class="la la-plus"></i> Thêm trường
</button>

<div class="modal-body" style="min-height: 400px; clear: both">
	<div id="fieldsListContainer" class="border rounded-lg" style="overflow-y: auto;">
		<div class="table-responsive">
			<table class="table table-striped table-hover table-responsive-lg rounded-lg m-0">
				<thead class="thead-light">
					<tr style="text-align:center;" class="table-active">
						<th width="5%" style="font-weight: bold;">#</th>
						<th width="25%" style="font-weight: bold;">Tiêu đề</th>
						<th width="15%" style="font-weight: bold;">Kiểu</th>
						<th width="10%" style="font-weight: bold;">Độ rộng</th>
						<th width="10%" style="font-weight: bold;">Bắt buộc</th>
						<th width="20%" style="font-weight: bold;">Ghi chú</th>
						<th width="15%" style="font-weight: bold;">Thao tác</th>
					</tr>
				</thead>
				<tbody>
					@if (Model != null && Model.Any())
					{
						foreach (var f in Model.OrderBy(x => x.Order))
						{
							<tr>
								<td class="text-center" style="vertical-align: middle">@f.Order</td>
								<td class="text-left" style="vertical-align: middle">@f.Title</td>
								<td class="text-center" style="vertical-align: middle">@GetFieldTypeName(f.Type)</td>
								<td class="text-center" style="vertical-align: middle">@f.ColSize/12</td>
								<td class="text-center" style="vertical-align: middle">
									<span class="label label-@(f.IsRequired ? "primary" : "light-danger") label-inline font-weight-bolder">
										@(f.IsRequired ? "Có" : "Không")
									</span>
								</td>
								<td style="vertical-align: middle">@f.GhiChu</td>
								<td class="text-center text-nowrap" style="vertical-align: middle">
									<button type="button" onclick="HandleShowModel('modalCreateOrEdit','@Url.Action("FieldEdit", "DanhMucNghiepVu", new { id = f.Id })','Chỉnh sửa trường')" class="btn btn-sm btn-clean btn-icon" title="Chỉnh sửa">
										<i class="icon-lg la la-edit text-success"></i>
									</button>
									<button type="button" onclick="HandleConfirmFieldDelete('@f.Id', '@f.Title')" class="btn btn-sm btn-clean btn-icon" title="Xóa">
										<i class="icon-lg la la-trash text-danger"></i>
									</button>
								</td>
							</tr>
						}
					}
					else
					{
						<tr>
							<td style="text-align:center" colspan="7">Chưa có trường nào được thiết lập!</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>
<div class="modal-footer">
	<button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Đóng</button>
</div>

<!-- Form ẩn để xử lý xóa trường -->
<form id="DeleteFieldForm" method="post" style="display:none;" action="@Url.Action("FieldDelete", "DanhMucNghiepVu")">
	@Html.AntiForgeryToken()
	<input type="hidden" name="id" id="fieldIdToDelete" />
</form>

<script>
	function HandleConfirmFieldDelete(fieldId, fieldTitle) {
		Swal.fire({
			icon: "warning",
			title: "<span class='font-weight-boldest font-size-h1 text-capitalize text-warning mb-n5'>Bạn có chắc chắn muốn xóa?</span>",
			text: "Trường \"" + fieldTitle + "\" sẽ bị xóa vĩnh viễn. Hành động này không thể hoàn tác!",
			showCancelButton: true,
			confirmButtonText: "Xác Nhận",
			confirmButtonClass: 'btn btn-danger font-weight-bold',
			cancelButtonText: "Hủy",
			cancelButtonClass: "btn btn-light-secondary font-weight-bold text-dark-75",
			reverseButtons: true
		}).then((result) => {
			if (result.isConfirmed) {
				// Set field ID to delete
				$('#fieldIdToDelete').val(fieldId);
				
				// Get form data
				let urlPost = $('#DeleteFieldForm').attr('action');
				let formData = new FormData($('#DeleteFieldForm')[0]);
				
				HandlePostAjax({
					url: urlPost,
					data: formData,
					beforeSendCallback: (res) => {
						// Optional: Show loading indicator
					},
					successCallback: (res) => {
						if (res.isValid) {
							Swal.fire({
								icon: "success",
								title: "<span class='font-weight-boldest font-size-h1 text-capitalize text-success mb-n5'>Xóa thành công!</span>",
								text: "Trường \"" + fieldTitle + "\" đã được xóa.",
								confirmButtonText: "OK",
								confirmButtonClass: 'btn btn-success font-weight-bold'
							}).then(() => {
								// Refresh the fields list by reloading the modal content
								var danhMucId = '@danhMucId';
								HandleShowModel('modalCreateOrEdit','@Url.Action("ManageFields", "DanhMucNghiepVu")?danhMucId=' + danhMucId,'Quản lý các trường nhập động cho loại hợp đồng này');
							});
						} else {
							Swal.fire({
								icon: "error",
								title: "<span class='font-weight-boldest font-size-h1 text-capitalize text-danger mb-n5'>Có lỗi xảy ra!</span>",
								text: res.message || "Không thể xóa trường này.",
								confirmButtonText: "OK",
								confirmButtonClass: 'btn btn-danger font-weight-bold'
							});
						}
					},
					errorCallback: (xhr, status, error) => {
						Swal.fire({
							icon: "error",
							title: "<span class='font-weight-boldest font-size-h1 text-capitalize text-danger mb-n5'>Lỗi kết nối!</span>",
							text: "Không nhận được phản hồi từ máy chủ. Vui lòng thử lại sau.",
							confirmButtonText: "OK",
							confirmButtonClass: 'btn btn-danger font-weight-bold'
						});
					}
				});
			}
		});
	}
</script>

<script>
	(function () {
		function resizeFieldsModal() {
			var modal = document.getElementById('modalCreateOrEdit');
			if (!modal) return;
			var modalContent = modal.querySelector('.modal-content');
			if (!modalContent) return;
			var header = modalContent.querySelector('.modal-header');
			var footer = modalContent.querySelector('.modal-footer');
			var container = document.getElementById('fieldsListContainer');
			if (!container) return;
			var headerH = header ? header.offsetHeight : 0;
			var footerH = footer ? footer.offsetHeight : 0;
			var verticalPadding = 150;
			var max = window.innerHeight - (headerH + footerH + verticalPadding);
			max = Math.max(max, 200);
			container.style.maxHeight = max + 'px';
		}
		window.FieldsModalResize = resizeFieldsModal;

		document.addEventListener('DOMContentLoaded', function(){
			resizeFieldsModal();
		});
		window.addEventListener('resize', function(){
			resizeFieldsModal();
		});
		$(document).on('shown.bs.modal', '#modalCreateOrEdit', function(){
			setTimeout(resizeFieldsModal, 0);
		});
	})();
</script>

