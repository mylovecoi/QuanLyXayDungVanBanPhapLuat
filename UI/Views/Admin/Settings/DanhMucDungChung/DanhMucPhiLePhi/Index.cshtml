@using UI.ViewModels;
@using DataAccess.Entities.Settings;

@{
    var session = HttpContextAccessor?.HttpContext?.Session ?? null;
    int pageSize = (ViewData["PageInfo"] as VMPageInfo)?.PageSize ?? 5;
    string timKiem = (ViewData["PageInfo"] as VMPageInfo)?.Search ?? "";
    string sort = (ViewData["PageInfo"] as VMPageInfo)?.Sort ?? "";
    string role = ViewData["Role"] as string ?? "";
    int record_id = (ViewData["PageInfo"] as VMPageInfo)?.RecordStart ?? 1;
    var donViTinhs = ViewData["DonViTinhs"] as IEnumerable<DataAccess.Entities.Settings.DanhMucDonViTinh> ?? new List<DataAccess.Entities.Settings.DanhMucDonViTinh>();
}

@model IEnumerable<DanhMucPhiLePhi>

@section custom_style {

}

@section custom_script {
    <script src="~/assets/js/pages/crud/forms/widgets/select2.js"></script>
    <script>
        $(document).ready(function () {
            $('.select2multi').select2({ width: '100%' });
            MoneyDecimalMask();
        });

        function ClearTxtSearch() {
            $('#txt_Search').val('');
        }

        function SubmitTxtSearch() {
            ReloadFrm();
        }

        $('#LoaiNghiepVu_Select, #PageSize_Search').change(function () {
            ReloadFrm();
        });

        function ReloadFrm() {
            var current_path_url = window.location.pathname + '?';
            var timkiem = '&timKiem=' + $('#txt_Search').val();
            var pageSize = '&pageSize=' + $('#PageSize_Search').val();
            var loainghiepvu = '&loaiNghiepVu=' + $('#LoaiNghiepVu_Select').val();
            var url = current_path_url + timkiem + loainghiepvu + pageSize;
            window.location.href = url;
        }

        function ClickPage(pageSelect) {
            var current_path_url = window.location.pathname + '?';
            var timkiem = '&timKiem=' + $('#txt_Search').val();
            var pageSize = '&pageSize=' + $('#PageSize_Search').val();
            var pageCurrent = '&pageCurrent=' + pageSelect;
            var loainghiepvu = '&loaiNghiepVu=' + $('#LoaiNghiepVu_Select').val();
            var url = current_path_url + timkiem + loainghiepvu + pageSize + pageCurrent;
            window.location.href = url;
        }
    </script>
}

<div class="card card-custom">
    <div class="card-header flex-wrap border-0 pt-6 pb-0">
        <div class="card-title">
            <h3 class="card-label">
                <b>@ViewData["Title"]?.ToString()?.ToUpper()</b>
                <span class="d-block text-muted pt-2 font-size-sm">
                    Quản lý @FuntionGlobal.CapitalizeAll(ViewData["Title"]?.ToString())
                </span>
            </h3>
        </div>
        <div class="card-toolbar">
            @if (session != null && FuntionGlobal.CheckPermission(session, role, "Create"))
            {
                <button type="button" class="btn btn-primary font-weight-bolder" onclick="Create()">
                    <i class="la la-plus"></i>Thêm mới
                </button>
            }
        </div>
    </div>
    @Html.AntiForgeryToken()
    <div class="card-body">
        <div class="row">
            <div class="col-xl-3" style="text-align:left">
                <div class="form-group fv-plugins-icon-container">
                    <label style="color: blue; font-weight: bold;">Loại nghiệp vụ:</label>
                    <select id="LoaiNghiepVu_Select" name="LoaiNghiepVu_Select" class="form-control select2basic" style="width:100%" asp-items='ViewData["DanhMucHopDong"] as List<SelectListItem>'>
                        <option value="">---Tất cả---</option>
                    </select>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-xl-3" style="text-align:left">
                <div class="form-group fv-plugins-icon-container">
                    <label class="text-blue">Hiển thị</label>
                    <select class="form-control" name="PageSize_Search" id="PageSize_Search">
                        <!option value="5" @(pageSize == 5 ? "selected" : "")>5 thông tin</!option>
                        <!option value="10" @(pageSize == 10 ? "selected" : "")>10 thông tin</!option>
                        <!option value="20" @(pageSize == 20 ? "selected" : "")>20 thông tin</!option>
                        <!option value="50" @(pageSize == 50 ? "selected" : "")>50 thông tin</!option>
                        <!option value="100" @(pageSize == 100 ? "selected" : "")>100 thông tin</!option>
                    </select>
                </div>
            </div>
            <div class="col-xl-9" style="text-align:left">
                <div class="form-group fv-plugins-icon-container">
                    <label class="text-blue">Tìm kiếm</label>
                    <div class="input-group">
                        <input class="form-control" name="txt_Search" id="txt_Search" placeholder="Tìm kiếm..." value="@timKiem">
                        <div class="input-group-prepend">
                            <button class="btn btn-danger" type="button" onclick="ClearTxtSearch()"><i class="las la-times-circle"></i></button>
                        </div>
                        <div class="input-group-append">
                            <button class="btn btn-primary" type="submit" onclick="SubmitTxtSearch()"><i class="las la-search"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <input hidden id="sort_current" name="sort_current" value="@ViewData["Sort"]" />
        <input hidden id="PageCurrent" name="PageCurrent" value="@ViewData["PageCurrent"]" />
        <!--begin: Datatable-->
        <div class="table-responsive border rounded-lg mb-8">
            <table class="table table-striped table-hover table-responsive-lg rounded-lg m-0">
                <thead class="thead-light">
                    <tr style="text-align:center;" class="table-active">
                        <th width="2%">#</th>
                        <th style="font-weight: bold;">Loại nghiệp vụ</th>
                        <th style="font-weight: bold;">Mô tả</th>
                        <th style="font-weight: bold;">Phân loại</th>
                        <th style="font-weight: bold;">Phí cố định</th>
                        <th style="font-weight: bold;">Tỷ lệ vượt mức</th>
                        <th style="font-weight: bold;">Ngưỡng vượt mức</th>
                        <th style="font-weight: bold;">Phí tối đa</th>
                        <th style="font-weight: bold;">Đơn vị tính</th>
                        <th style="font-weight: bold;">Số lượng tối đa</th>
                        <th style="font-weight: bold;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count() > 0)
                    {
                        @foreach (var item in Model)
                        {
                            int record = record_id++;
                            <tr>
                                <td style="text-align:center; vertical-align:middle" width="5%">
                                    @record
                                </td>
                                <td style="font-weight: bold; vertical-align: middle;">
                                    @item.LoaiHopDong?.TenHopDong
                                </td>
                                <td style="font-weight: bold; vertical-align: middle">
                                    @item.MoTa
                                </td>
                                <td style="font-weight: bold; vertical-align: middle; text-align: center;">
                                    @item.PhanLoai?.DisplayName
                                </td>
                                <td style="font-weight: bold; vertical-align: middle; text-align:right;">
                                    @FuntionGlobal.ConvertDblToStr(item.PhiCoDinh)
                                </td>
                                <td style="font-weight: bold; vertical-align: middle; text-align:center;">
                                    @FuntionGlobal.ConvertDblToStr(item.TyLeVuotMuc)
                                </td>
                                <td style="font-weight: bold; vertical-align: middle; text-align:right;">
                                    @FuntionGlobal.ConvertDblToStr(item.NguongVuotMuc)
                                </td>
                                <td style="font-weight: bold; vertical-align: middle; text-align:right;">
                                    @FuntionGlobal.ConvertDblToStr(item.PhiToiDa)
                                </td>
                                <td style="font-weight: bold; vertical-align: middle; text-align:center;">
                                    @(donViTinhs.FirstOrDefault(x => x.MaDonViTinh == item.DonViTinh)?.TenDonViTinh ?? item.DonViTinh)
                                </td>
                                <td style="font-weight: bold; vertical-align: middle; text-align:center;">
                                    @FuntionGlobal.ConvertDblToStr(item.SoLuongToiDa)
                                </td>
                                <td style="vertical-align: middle; text-align: center">
                                    @if (session != null && FuntionGlobal.CheckPermission(session, role, "Edit"))
                                    {
                                        <button type="button" onclick="Edit('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Chỉnh sửa">
                                            <i class="icon-lg la la-edit text-success"></i>
                                        </button>
                                    }
                                    @if (session != null && FuntionGlobal.CheckPermission(session, role, "Delete"))
                                    {
                                        <button type="button" class="btn btn-sm btn-clean btn-icon" title="Xóa" onclick="Delete('@item.Id', '@item.MoTa')">
                                            <i class="icon-lg la la-trash text-danger"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td style="text-align:center" colspan="10">Không tìm thấy thông tin!!!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!--end: Datatable-->
        @await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
    </div>
</div>
@await Html.PartialAsync("~/Views/Admin/Settings/DanhMucDungChung/DanhMucPhiLePhi/_Modal.cshtml")