@using UI.ViewModels;
@{
    var session = HttpContextAccessor?.HttpContext?.Session ?? null;
    int pageSize = (ViewData["PageInfo"] as VMPageInfo)?.PageSize ?? 5;
    string timKiem = (ViewData["PageInfo"] as VMPageInfo)?.Search ?? "";
    string sort = (ViewData["PageInfo"] as VMPageInfo)?.Sort ?? "";
    string role = ViewData["Role"]?.ToString() ?? "";
    int record_id = 1;
    Guid? donViId = ViewData["DonViId"] as Guid?;
    var danhMucDonVis = ViewData["DanhMucDonVis"] as List<DataAccess.Entities.Settings.DanhMucDonVi>;
    Guid? phongBanId = ViewData["PhongBanId"] as Guid?;
    var danhMucPhongBans = ViewData["DanhMucPhongBans"] as List<DataAccess.Entities.Settings.DanhMucPhongBan>;
    string status = ViewData["Status"]?.ToString() ?? "";
}

@model IEnumerable<DataAccess.Entities.Settings.DanhMucCanBo>

@section custom_style {
}

@section custom_script {
    <script src="~/js/site.js"></script>
    <script>
        $(document).ready(function () {
            // Khởi tạo Select2 cho dropdown đơn vị và phòng ban
            SetupSelect2('#DonViId_Select', 'Lựa Chọn Đơn Vị');
            SetupSelect2('#PhongBanId_Select', 'Lựa Chọn Phòng Ban');
            
            // Xử lý sự kiện khi thay đổi đơn vị
            $('#DonViId_Select').on('change', function() {
                var donViId = $(this).val();
                if (donViId) {
                    // Gọi API lấy danh sách phòng ban theo đơn vị
                    loadPhongBan(donViId);
                }
            });
            
            // Đăng ký form lọc
            HandleRegisterFormFilter('#FilterForm', '#Pagination', '@Url.Action("Index", "DanhMucCanBo")');
        });
        
        function loadPhongBan(donViId) {
            // Tải lại trang với đơn vị mới được chọn để cập nhật danh sách phòng ban
            var current_path_url = '/Settings/DanhMucCanBo?';
            var donViParam = 'DonViId=' + donViId;
            var url = current_path_url + donViParam;
            window.location.href = url;
        }

        function ClickPage(pageSelect) {
            var current_path_url = '/Settings/DanhMucCanBo?';
            var timkiem = 'Search=' + $('#txt_Search').val();
            var pageSize = '&PageSize=' + $('#PageSize_Search').val();
            var donViId = '&DonViId=' + $('#DonViId_Select').val();
            var phongBanId = '&PhongBanId=' + $('#PhongBanId_Select').val();
            var status = '&Status=' + $('#Status_Select').val();
            var pageCurrent = '&PageCurrent=' + pageSelect;
            var url = current_path_url + timkiem + pageSize + donViId + phongBanId + status + pageCurrent;
            window.location.href = url;
        }
    </script>
}

<div class="card card-custom">
    <div class="card-header flex-wrap border-0 pt-6 pb-0">
        <div class="card-title">
            <h3 class="card-label">
                <b>@ViewData["Title"]?.ToString()?.ToUpper()</b>
                <span class="d-block text-muted pt-2 font-size-sm">
                    Quản lý @ViewData["Title"]?.ToString()?.ToLower()
                </span>
            </h3>
        </div>
        <div class="card-toolbar">
            @if (session != null && FuntionGlobal.CheckPermission(session, role, "Create"))
            {
                <button type="button" class="btn btn-primary font-weight-bolder" title="Thêm mới" onclick="Create()">
                    <i class="la la-plus"></i>Thêm mới
                </button>
            }
        </div>
    </div>
    <br />
    @Html.AntiForgeryToken()
    <div class="card-body pt-0">
        <form id="FilterForm">
            <div class="row">
                <div class="col-xl-3">
                    <div class="form-group fv-plugins-icon-container">
                        <label style="font-weight:bold; color:blue" >Đơn Vị:</label>
                        <select class="form-control h-40px" name="DonViId" id="DonViId_Select">
                            @if (danhMucDonVis != null && danhMucDonVis.Any())
                            {
                                foreach (var item in danhMucDonVis)
                                {
                                    string backIn = FuntionGlobal.GetBackIn(item.Level);
                                    <!option value="@item.Id" @(donViId == item.Id ? "selected" : "")>@Html.Raw(backIn)@item.TenDonVi</!option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-xl-3">
                    <div class="form-group fv-plugins-icon-container">
                        <label style="font-weight:bold; color:blue" >Phòng Ban:</label>
                        <select class="form-control h-40px" name="PhongBanId" id="PhongBanId_Select">
                            <option value="">--Tất cả--</option>
                            @if (danhMucPhongBans != null && danhMucPhongBans.Any())
                            {
                                foreach (var item in danhMucPhongBans)
                                {
                                    <!option value="@item.Id" @(phongBanId == item.Id ? "selected" : "")>@item.TenPhongBan</!option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-xl-3">
                    <div class="form-group fv-plugins-icon-container">
                        <label style="font-weight:bold; color:blue">Trạng Thái:</label>
                        <select class="form-control h-40px" name="Status" id="Status_Select">
                            <option value="">--Tất cả--</option>
                            <!option value="Kích hoạt" @(status == "Kích hoạt" ? "selected" : "")>Kích hoạt</!option>
                            <!option value="Khóa" @(status == "Khóa" ? "selected" : "")>Khóa</!option>
                            <!option value="Chờ kích hoạt" @(status == "Chờ kích hoạt" ? "selected" : "")>Chờ kích hoạt</!option>
                        </select>
                    </div>
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="col-xl-3" style="text-align:left">
                    <div class="form-group fv-plugins-icon-container">
                        <label class="text-blue">Hiển thị</label>
                        <select class="form-control h-40px" name="PageSize" id="PageSize_Search">
                            <!option value="5" @(pageSize == 5 ? "selected" : "")>5 thông tin</!option>
                            <!option value="10" @(pageSize == 10 ? "selected" : "")>10 thông tin</!option>
                            <!option value="20" @(pageSize == 20 ? "selected" : "")>20 thông tin</!option>
                            <!option value="50" @(pageSize == 50 ? "selected" : "")>50 thông tin</!option>
                            <!option value="100" @(pageSize == 100 ? "selected" : "")>100 thông tin</!option>
                        </select>
                    </div>
                </div>
                <div class="col-xl-9">
                    <div class="form-group fv-plugins-icon-container">
                        <label class="text-blue">Tìm kiếm</label>
                        <div class="input-group">
                            <input class="form-control h-40px" name="Search" id="txt_Search" placeholder="Tìm kiếm..." value="@timKiem">
                            <div class="input-group-prepend">
                                <button class="btn btn-danger" type="reset"><i class="las la-times-circle"></i></button>
                            </div>
                            <div class="input-group-append">
                                <button class="btn btn-primary" type="submit"><i class="las la-search"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <input hidden id="sort_current" name="sort_current" value="@sort" />
            <input hidden id="PageCurrent" name="PageCurrent" value="@ViewData["PageCurrent"]" />
        </form>
        <!--begin: Datatable-->
        <div class="table-responsive border rounded-lg mb-8">
            <table class="table table-striped table-hover table-responsive-lg rounded-lg m-0">
                <thead class="thead-light">
                    <tr style="text-align:center;" class="table-active">
                        <th width="5%">#</th>
                        <th style="font-weight: bold;" width="20%">Tên cán bộ</th>
                        <th style="font-weight: bold;" width="12%">Ngày sinh</th>
                        <th style="font-weight: bold;" width="18%">Phòng ban</th>
                        <th style="font-weight: bold;" width="18%">Tên đăng nhập</th>
                        <th style="font-weight: bold;" width="15%">Trạng thái</th>
                        <th style="font-weight: bold;" width="12%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        var pageInfo = ViewData["PageInfo"] as VMPageInfo;
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td style="text-align: center; vertical-align:middle">@(record_id++)</td>
                                <td style="text-align: left; vertical-align:middle">@item.TenCanBo</td>
                                <td style="text-align: center; vertical-align:middle">
                                    @(item.NgaySinh.HasValue ? item.NgaySinh.Value.ToString("dd/MM/yyyy") : "")
                                </td>
                                <td style="text-align: left; vertical-align:middle">@(item.PhongBan?.TenPhongBan)</td>
                                <td style="text-align: left; vertical-align:middle">@item.Username</td>
                                <td style="text-align: center; vertical-align: middle">
                                    @switch (item.Status)
                                    {
                                        case "Kích hoạt":
                                            <span class="label font-weight-bold label-lg label-success label-inline">Kích hoạt</span>
                                            break;
                                        case "Khóa":
                                            <span class="label font-weight-bold label-lg label-danger label-inline">Khóa</span>
                                            break;
                                        case "Chờ kích hoạt":
                                            <span class="label font-weight-bold label-lg label-warning label-inline">Chờ kích hoạt</span>
                                            break;
                                        default:
                                            <span class="label font-weight-bold label-lg label-secondary label-inline">Không xác định</span>
                                            break;
                                    }
                                </td>
                                <td style="text-align: center; vertical-align: middle">
                                    <button type="button" onclick="Show('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Xem chi tiết">
                                        <i class="icon-lg la la-eye text-primary"></i>
                                    </button>
                                    
                                    @if (session != null && FuntionGlobal.CheckPermission(session, role ?? "", "Edit"))
                                    {
                                        <button type="button" onclick="Edit('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Chỉnh sửa">
                                            <i class="icon-lg la la-edit text-success"></i>
                                        </button>
                                    }

                                    @if (session != null && FuntionGlobal.CheckPermission(session, role ?? "", "Delete"))
                                    {
                                        <button type="button" class="btn btn-sm btn-clean btn-icon" title="Xóa"
                                                onclick="Delete('@item.Id', '@item.TenCanBo')">
                                            <i class="icon-lg la la-trash text-danger"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td style="text-align:center" colspan="7">Không tìm thấy thông tin!!!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!--end: Datatable-->
        <div id="Pagination">
            @await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
        </div>
    </div>
</div>
@await Html.PartialAsync("~/Views/Admin/Settings/DanhMucDonViSuDung/DanhMucCanBo/Modal.cshtml")
