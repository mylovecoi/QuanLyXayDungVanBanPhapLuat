@using System.Text.Json
@model Services.DTOs.HomeResponseDto

@{
    var summary = Model?.Summary ?? new Services.DTOs.DashboardSummaryDto();
    var hotWarnings = Model?.ThiHanhCanhBao ?? new List<Services.DTOs.DashboardCanhBaoItemDto>();
    var chartJson = JsonSerializer.Serialize(Model ?? new Services.DTOs.HomeResponseDto());
}

<div class="container-fluid">
    <div class="row mb-6">
        <div class="col-12">
            <div class="card card-custom shadow">
                <div class="card-header">
                    <div class="card-title">
                        <h3 class="card-label text-danger">Cảnh báo nóng cần theo dõi</h3>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-xl-3 col-md-6 mb-4">
                            <a href="/Manages/GiaHanXayDung" class="text-decoration-none">
                                <div class="border rounded p-5 h-100 bg-light-warning">
                                    <div class="text-dark font-weight-bold mb-2">Hồ sơ văn bản đang xử lý</div>
                                    <div class="font-size-h2 font-weight-bolder text-warning">@summary.HoSoDangXuLy</div>
                                    <div class="text-muted">Bấm để theo dõi xử lý hoặc gia hạn</div>
                                </div>
                            </a>
                        </div>
                        @foreach (var item in hotWarnings)
                        {
                            var bgClass = item.MaCanhBao == "QUA_HAN" ? "bg-light-danger" : item.MaCanhBao == "CHAM_TIEN_DO" ? "bg-light-warning" : "bg-light-primary";
                            var textClass = item.MaCanhBao == "QUA_HAN" ? "text-danger" : item.MaCanhBao == "CHAM_TIEN_DO" ? "text-warning" : "text-primary";
                            <div class="col-xl-3 col-md-6 mb-4">
                                <a href="/Manages/DanhGiaKetQuaThiHanhPhapLuat?CanhBao=@item.MaCanhBao" class="text-decoration-none">
                                    <div class="border rounded p-5 h-100 @bgClass">
                                        <div class="text-dark font-weight-bold mb-2">@item.TieuChi</div>
                                        <div class="font-size-h2 font-weight-bolder @textClass">@item.SoLuong</div>
                                        <div class="text-muted">Bấm để xem danh sách chi tiết</div>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-6">
        <div class="col-xl-3 col-md-6 mb-4">
            <a href="/Manages/TraCuuDangKyVanBan" class="text-decoration-none">
                <div class="card card-custom gutter-b shadow h-100">
                    <div class="card-body">
                        <div class="text-muted font-weight-bold">Tổng hồ sơ văn bản</div>
                        <div class="font-size-h1 font-weight-bolder text-primary">@summary.TongHoSoVanBan</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <a href="/Manages/GiaHanXayDung" class="text-decoration-none">
                <div class="card card-custom gutter-b shadow h-100">
                    <div class="card-body">
                        <div class="text-muted font-weight-bold">Hồ sơ đang xử lý</div>
                        <div class="font-size-h1 font-weight-bolder text-warning">@summary.HoSoDangXuLy</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <a href="/Manages/TraCuuDangKyVanBan?MaBuoc=HOAN_THANH" class="text-decoration-none">
                <div class="card card-custom gutter-b shadow h-100">
                    <div class="card-body">
                        <div class="text-muted font-weight-bold">Hồ sơ đã hoàn thành</div>
                        <div class="font-size-h1 font-weight-bolder text-success">@summary.HoSoDaHoanThanh</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <a href="/Manages/BanHanhVanBan" class="text-decoration-none">
                <div class="card card-custom gutter-b shadow h-100">
                    <div class="card-body">
                        <div class="text-muted font-weight-bold">Hồ sơ đã ban hành</div>
                        <div class="font-size-h1 font-weight-bolder text-info">@summary.HoSoDaBanHanh</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="row mb-6">
        <div class="col-xl-3 col-md-6 mb-4">
            <a href="/Manages/DanhSachKeHoachThiHanhPhapLuat" class="text-decoration-none">
                <div class="card card-custom gutter-b shadow h-100">
                    <div class="card-body">
                        <div class="text-muted font-weight-bold">Kế hoạch thi hành</div>
                        <div class="font-size-h1 font-weight-bolder text-primary">@summary.TongKeHoachThiHanh</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <a href="/Manages/DanhGiaKetQuaThiHanhPhapLuat?CanhBao=QUA_HAN" class="text-decoration-none">
                <div class="card card-custom gutter-b shadow h-100">
                    <div class="card-body">
                        <div class="text-muted font-weight-bold">Nhiệm vụ quá hạn</div>
                        <div class="font-size-h1 font-weight-bolder text-danger">@summary.NhiemVuThiHanhQuaHan</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <a href="/Manages/DanhGiaKetQuaThiHanhPhapLuat?CanhBao=CHAM_TIEN_DO" class="text-decoration-none">
                <div class="card card-custom gutter-b shadow h-100">
                    <div class="card-body">
                        <div class="text-muted font-weight-bold">Chậm tiến độ</div>
                        <div class="font-size-h1 font-weight-bolder text-warning">@summary.NhiemVuThiHanhChamTienDo</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <a href="/Manages/DanhGiaKetQuaThiHanhPhapLuat?CanhBao=CHUA_NHAP_LIEU" class="text-decoration-none">
                <div class="card card-custom gutter-b shadow h-100">
                    <div class="card-body">
                        <div class="text-muted font-weight-bold">Chưa nhập liệu</div>
                        <div class="font-size-h1 font-weight-bolder text-dark">@summary.NhiemVuThiHanhChuaNhapLieu</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-8 mb-6">
            <div class="card card-custom shadow">
                <div class="card-header">
                    <div class="card-title">
                        <h3 class="card-label">Diễn biến hồ sơ văn bản theo tháng (@summary.NamThongKe)</h3>
                    </div>
                </div>
                <div class="card-body">
                    <div id="dashboard_ho_so_monthly" style="min-height: 360px;"></div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 mb-6">
            <div class="card card-custom shadow">
                <div class="card-header">
                    <div class="card-title">
                        <h3 class="card-label">Xếp loại chấm điểm</h3>
                    </div>
                </div>
                <div class="card-body">
                    <div id="dashboard_xep_loai" style="min-height: 360px;"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-6 mb-6">
            <div class="card card-custom shadow">
                <div class="card-header"><div class="card-title"><h3 class="card-label">Hồ sơ theo bước hiện tại</h3></div></div>
                <div class="card-body"><div id="dashboard_by_step" style="min-height: 340px;"></div></div>
            </div>
        </div>
        <div class="col-xl-6 mb-6">
            <div class="card card-custom shadow">
                <div class="card-header"><div class="card-title"><h3 class="card-label">Hồ sơ theo đơn vị soạn thảo</h3></div></div>
                <div class="card-body"><div id="dashboard_by_donvi" style="min-height: 340px;"></div></div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-6 mb-6">
            <div class="card card-custom shadow">
                <div class="card-header"><div class="card-title"><h3 class="card-label">Tình trạng nhiệm vụ thi hành pháp luật</h3></div></div>
                <div class="card-body"><div id="dashboard_thihanh_status" style="min-height: 340px;"></div></div>
            </div>
        </div>
        <div class="col-xl-6 mb-6">
            <div class="card card-custom shadow">
                <div class="card-header"><div class="card-title"><h3 class="card-label">Cảnh báo thi hành pháp luật</h3></div></div>
                <div class="card-body"><div id="dashboard_thihanh_warning" style="min-height: 340px;"></div></div>
            </div>
        </div>
    </div>
</div>

@section custom_script {
    <script>
        window.homeDashboardData = @Html.Raw(chartJson);
    </script>
    <script src="~/js/pages/Admin/Home/dashboard.js" asp-append-version="true"></script>
}
