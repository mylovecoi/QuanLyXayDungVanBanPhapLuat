@using UI.ViewModels;
@{
    var session = HttpContextAccessor?.HttpContext?.Session ?? null;
    int pageSize = (ViewData["PageInfo"] as VMPageInfo)?.PageSize ?? 5;
    string timKiem = (ViewData["PageInfo"] as VMPageInfo)?.Search ?? "";
    string sort = (ViewData["PageInfo"] as VMPageInfo)?.Sort ?? "";
    string role = ViewData["Role"]?.ToString() ?? "";
    int record_id = 1;
    
    DateTime ngayBatDau = ViewBag.NgayBatDau;
    DateTime ngayKetThuc = ViewBag.NgayKetThuc;
}

@model IEnumerable<DataAccess.Entities.Log>

@section custom_style{

}

@section custom_script{
    <script>
        function ClearTxtSearch() {
            $('#txt_Search').val('');
        }

        function SubmitTxtSearch() {
            ReloadFrm();
        }

        function ReloadFrm() {
            var current_path_url = window.location.pathname + '?';
            var timkiem = '&TimKiem=' + $('#txt_Search').val();
            var pageSize = '&PageSize=' + $('#PageSize_Search').val();
            var ngaybatdau = '&NgayBatDau=' + $('#NgayBatDau').val();
            var ngaykethuc = '&NgayKetThuc=' + $('#NgayKetThuc').val();
            var url = current_path_url + timkiem + pageSize + ngaybatdau + ngaykethuc;
            window.location.href = url;
        }

        function ClickPage(pageSelect) {
            var current_path_url = window.location.pathname + '?';
            var timkiem = '&TimKiem=' + $('#txt_Search').val();
            var pageSize = '&PageSize=' + $('#PageSize_Search').val();
            var ngaybatdau = '&NgayBatDau=' + $('#NgayBatDau').val();
            var ngaykethuc = '&NgayKetThuc=' + $('#NgayKetThuc').val();
            var pageCurrent = '&PageCurrent=' + pageSelect;
            var url = current_path_url + timkiem + pageSize + ngaybatdau + ngaykethuc + pageCurrent;
            window.location.href = url;
        }

        $('#PageSize_Search').change(function () {
            ReloadFrm();
        });
        
        $('#NgayBatDau, #NgayKetThuc').change(function () {
            ReloadFrm();
        });
    </script>
}

<div class="card card-custom">
    <div class="card-header flex-wrap border-0 pt-6 pb-0">
        <div class="card-title">
            <h3 class="card-label">
                <b>@ViewData["Title"]?.ToString()?.ToUpper()</b>
                <span class="d-block text-muted pt-2 font-size-sm">
                    Quản lý @ViewData["Title"]?.ToString()?.ToLower()
                </span>
            </h3>
        </div>
        <div class="card-toolbar">
        </div>
    </div>
    @Html.AntiForgeryToken()
    <div class="card-body">
        <hr />
        <div class="row">
            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12">
                <div class="form-group">
                    <label style="font-weight:bold; color:blue">Từ ngày:</label>
                    <input type="date" class="form-control" id="NgayBatDau" name="NgayBatDau" value="@ngayBatDau.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12">
                <div class="form-group">
                    <label style="font-weight:bold; color:blue">Đến ngày:</label>
                    <input type="date" class="form-control" id="NgayKetThuc" name="NgayKetThuc" value="@ngayKetThuc.ToString("yyyy-MM-dd")" />
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-xl-3 col-lg-3 col-md-4 col-sm-12">
                <div class="form-group fv-plugins-icon-container">
                    <label style="color:blue">Hiển thị:</label>
                    <select class="form-control h-40px" name="PageSize_Search" id="PageSize_Search">
                        <!option value="5" @(pageSize == 5 ? "selected" : "")>5 thông tin</!option>
                        <!option value="10" @(pageSize == 10 ? "selected" : "")>10 thông tin</!option>
                        <!option value="20" @(pageSize == 20 ? "selected" : "")>20 thông tin</!option>
                        <!option value="50" @(pageSize == 50 ? "selected" : "")>50 thông tin</!option>
                        <!option value="100" @(pageSize == 100 ? "selected" : "")>100 thông tin</!option>
                    </select>
                </div>
            </div>
            <div class="col-xl-9 col-lg-9 col-md-8 col-sm-12">
                <div class="form-group fv-plugins-icon-container">
                    <label style="color:blue">Tìm kiếm:</label>
                    <div class="input-group">
                        <input class="form-control h-40px" name="txt_Search" id="txt_Search" placeholder="Tìm kiếm..." value="@timKiem">
                        <div class="input-group-prepend">
                            <button class="btn btn-danger" type="button" onclick="ClearTxtSearch()"><i class="las la-times-circle"></i></button>
                        </div>
                        <div class="input-group-append">
                            <button class="btn btn-primary" type="button" onclick="SubmitTxtSearch()"><i class="las la-search"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!--begin: Datatable-->
        <table class="table table-striped table-hover table-responsive-lg rounded-lg">
            <thead>
                <tr style="text-align:center;" class="table-active">
                    <th style="font-weight: bold;" width="2%">#</th>
                    <th style="font-weight: bold;" width="15%">Thời gian</th>
                    <th style="font-weight: bold;" width="15%">Tài khoản</th>
                    <th style="font-weight: bold;" width="15%">Địa chỉ IP</th>
                    <th style="font-weight: bold;" width="10%">Phương thức</th>
                    <th style="font-weight: bold;" width="15%">Đường dẫn</th>
                    <th style="font-weight: bold;">Nội dung hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        int record = record_id++;
                        <tr>
                            <td style="text-align: center; vertical-align:middle">@record</td>
                            <td style="vertical-align: middle">@item.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td style="font-weight: bold; vertical-align: middle">@item.Username</td>
                            <td style="vertical-align: middle">@item.IpAddress</td>
                            <td style="text-align: center; vertical-align: middle">
                                <span class="label font-weight-bold label-lg label-inline @(item.Method == "POST" ? "label-light-primary" : "label-light-success")">
                                    @item.Method
                                </span>
                            </td>
                            <td style="vertical-align: middle; word-break: break-all;">@item.Url</td>
                            <td style="vertical-align: middle">
                                <span style="white-space: pre-wrap;">@item.Request</span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td style="text-align:center" colspan="7">Không tìm thấy thông tin nhật ký hệ thống!!!</td>
                    </tr>
                }
            </tbody>
        </table>
        <!--end: Datatable-->
        @await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
    </div>
</div>
