@using UI.ViewModels;
@{
    var session = HttpContextAccessor?.HttpContext?.Session ?? null;
    int pageSize = (ViewData["PageInfo"] as VMPageInfo)?.PageSize ?? 5;
    string timKiem = (ViewData["PageInfo"] as VMPageInfo)?.Search ?? "";
    string sort = (ViewData["PageInfo"] as VMPageInfo)?.Sort ?? "";
    string maGoc = ViewData["MaGoc"]?.ToString() ?? "";
}

@model IEnumerable<DataAccess.Entities.Systems.RoleAction>

@section custom_style{
}

@section custom_script{
    <script src="~/assets/js/pages/crud/forms/widgets/select2.js"></script>
    <script>  
        $('#PageSize_Search').change(function () {
            ReloadFrm();
        });

        function ClearTxtSearch() {
            $('#txt_Search').val('');
        }

        function SubmitTxtSearch() {
            ReloadFrm();
        }

        function ReloadFrm() {
            var current_path_url = window.location.pathname + '?';
            var timkiem = '&TimKiem=' + $('#txt_Search').val();
            var pageSize = '&PageSize=' + $('#PageSize_Search').val();
            var url = current_path_url + timkiem + pageSize;
            window.location.href = url;
        }

        function ClickPage(pageSelect) {
            var current_path_url = window.location.pathname + '?';
            var timkiem = '&TimKiem=' + $('#txt_Search').val();
            var pageSize = '&PageSize=' + $('#PageSize_Search').val();
            var pageCurrent = '&PageCurrent=' + pageSelect;
            var url = current_path_url + timkiem + pageSize + pageCurrent;
            window.location.href = url;
        }
    </script>
}

<div class="card card-custom">
    <div class="card-header flex-wrap border-0 pt-6 pb-0">
        <div class="card-title">
            <h3 class="card-label">
                Danh sách chức năng
                <span class="d-block text-muted pt-2 font-size-sm">
                    Quản lý Danh sách chức năng
                </span>
            </h3>
        </div>
        <div class="card-toolbar">
            <button type="button" class="btn btn-primary font-weight-bolder" onclick="Create('@Guid.Empty')">
                <i class="la la-plus"></i>Thêm mới
            </button>
        </div>
    </div>
    @Html.AntiForgeryToken()
    <div class="card-body">
        <hr />
        <div class="row">
            <div class="col-xl-3" style="text-align:left">
                <div class="form-group fv-plugins-icon-container">
                    <label class="text-blue">Hiển thị</label>
                    <select class="form-control" name="PageSize_Search" id="PageSize_Search">
                        <!option value="5" @(pageSize == 5 ? "selected" : "")>5 thông tin</!option>
                        <!option value="10" @(pageSize == 10 ? "selected" : "")>10 thông tin</!option>
                        <!option value="20" @(pageSize == 20 ? "selected" : "")>20 thông tin</!option>
                        <!option value="50" @(pageSize == 50 ? "selected" : "")>50 thông tin</!option>
                        <!option value="100" @(pageSize == 100 ? "selected" : "")> 100 thông tin</!option>
                    </select>
                </div>
            </div>
            <div class="col-xl-9">
                <div class="form-group fv-plugins-icon-container">
                    <label class="text-blue">Tìm kiếm</label>
                    <div class="input-group">
                        <input class="form-control" name="txt_Search" id="txt_Search" placeholder="Tìm kiếm..." value="@timKiem">
                        <div class="input-group-prepend">
                            <button class="btn btn-danger" type="button" onclick="ClearTxtSearch()"><i class="las la-times-circle"></i></button>
                        </div>
                        <div class="input-group-append">
                            <button class="btn btn-primary" type="submit" onclick="SubmitTxtSearch()"><i class="las la-search"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <input hidden id="sort_current" name="sort_current" value="@ViewData["Sort"]" />
        <input hidden id="PageCurrent" name="PageCurrent" value="@ViewData["PageCurrent"]" />
        <!--begin: Datatable-->
        <table class="table table-striped table-hover table-responsive-lg rounded-lg">
            <thead>
                <tr style="text-align:center;" class="table-active">
                    <th style="font-weight: bold;" width="2%">#</th>
                    <th style="font-weight: bold;">Phân loại</th>
                    <th style="font-weight: bold;">Mô tả chức năng</th>
                    <th style="font-weight: bold;">Tương tác</th>
                    <th style="font-weight: bold;">Use</th>
                    <th style="font-weight: bold;" width="10%">Trạng thái</th>
                    <th style="font-weight: bold;" width="10%">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count() > 0)
                {
                    @foreach (var item in Model)
                    {
                        <tr class="@(FuntionGlobal.GetClassTable(item.Level))">
                            <td style="text-align: left; vertical-align: middle" width="5%">
                                @Html.Raw(FuntionGlobal.GetBackIn(item.Level))
                                @item.STTSapXep
                            </td>
                            <td style="text-align: left; vertical-align: middle">
                                <span style="width: 112px;">
                                    @Html.Raw(FuntionGlobal.GetBackIn(item.Level))
                                    <span class="label font-weight-bold label-lg @(item.PhanLoai == "Group" ? "label-primary" : "label-success") label-inline">
                                        @item.PhanLoai @(item.Level > 0 && item.PhanLoai == "Group" ? item.Level : "")
                                    </span>
                                </span>
                            </td>
                            <td style="font-weight: bold; vertical-align: middle">
                                @Html.Raw(FuntionGlobal.GetBackIn(item.Level))
                                @item.Title
                            </td>
                            <td style="font-weight: bold; font-size: 10px; vertical-align: middle">
                                <span class="label label-info label-inline mr-2">Role</span>@item.Role
                                <br />
                                @if (item.PhanLoai != "Group")
                                {
                                    <span class="label label-primary label-inline mr-2">Controller</span>
                                    @item.Controller
                                    <br />
                                    <span class="label label-success label-inline mr-2">Action</span>
                                    @item.Action
                                    <br />
                                    <span class="label label-warning label-inline mr-2">TableName</span>
                                    @item.Table
                                    <br />
                                }
                            </td>
                            <td style="font-weight: bold; vertical-align: middle">@item.UseGroup</td>
                            <td style="text-align: center; vertical-align: middle">
                                <span style="width: 112px;">
                                    @if (item.Status == "Kích hoạt")
                                    {
                                        <span class="label font-weight-bold label-lg label-light-info label-inline">Kích hoạt</span>
                                    }
                                    else
                                    {
                                        <span class="label font-weight-bold label-lg label-danger label-inline">Dừng kích hoạt</span>
                                    }
                                </span>
                            </td>
                            <td class="text-center" style="vertical-align: middle">
                                @Html.Raw(FuntionGlobal.GetBackIn(item.Level))

                                @if (item.PhanLoai != "Detail")
                                {
                                    <button type="button" class="btn btn-sm btn-clean btn-icon" title="Thêm mới" onclick="Create('@item.Id')">
                                        <i class="icon-lg la la-plus text-primary"></i>
                                    </button>
                                }
                                <button type="button" onclick="Edit('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Chỉnh sửa">
                                    <i class="icon-lg la la-edit text-success"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-clean btn-icon" title="Xóa" onclick="Delete('@item.Id', '@item.Title')">
                                    <i class="icon-lg la la-trash text-danger"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td style="text-align:center" colspan="6">Không tìm thấy thông tin!!!</td>
                    </tr>
                }
            </tbody>
        </table>
        <!--end: Datatable-->
        @await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
    </div>
</div>
@await Html.PartialAsync("~/Views/Admin/Systems/RoleAction/Modal.cshtml")