<!--Create-Modal-->
<div class="modal fade" id="Create_Modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="card-label">
                    Danh sách chức năng
                    <span class="d-block text-muted pt-2 font-size-sm">Thêm mới Danh sách chức năng</span>
                </h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">
                <form id="frm_create"></form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary font-weight-bold" onclick="Store()">Thêm mới</button>
            </div>
        </div>
    </div>
</div>

<!--Edit Modal-->
<div class="modal fade" id="Edit_Modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="card-label">
                    Danh sách chức năng
                    <span class="d-block text-muted pt-2 font-size-sm">Chỉnh sửa Danh sách chức năng</span>
                </h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">
                <form id="frm_edit"></form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary font-weight-bold" onclick="Update()">Cập nhật</button>
            </div>
        </div>
    </div>
</div>

<!--Delete Modal-->
<div class="modal fade" id="Delete_Modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="card-label">
                    Danh sách chức năng
                    <span class="d-block text-muted pt-2 font-size-sm">Xóa Danh sách chức năng</span>
                </h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <form asp-controller="roleAction" asp-action="Delete" method="post" id="data_delete">
                <div class="modal-body">
                    <div class="form-group fv-plugins-icon-container">
                        <label>
                            Mô tả:&nbsp;<b id="mota_delete" style="color: #0000FF"></b>
                        </label>
                    </div>
                    <input hidden id="id_delete" name="id_delete" />
                    @Html.AntiForgeryToken()
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light-primary font-weight-bold" data-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger font-weight-bold">Đồng ý</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/modal.validation.js"></script>
<script>
    function Create(groupid) {
        const csrfToken = $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url: '/Systems/RoleAction/Create',
            type: 'POST',
            headers: {
                'RequestVerificationToken': csrfToken // Gửi token qua header
            },
            data: {
                GroupId: groupid,
            },
            success: function (data) {
                $('#frm_create').html(data);
                $('#frm_create').find('.select2multi').select2();
                $('#Create_Modal').modal('show');
            },
            error: function () {
                toastr.error("Không thể tải dữ liệu!", "Lỗi!");
            }
        })
    }

    function Store() {
        var form = document.getElementById('frm_create');

        // Kiểm tra xem form có tồn tại không
        if (!form) {
            toastr.error("Không tìm thấy form với id 'frm_create'", "Lỗi!");
            return;
        }
        const fieldsToValidate = [
            { id: 'Role', message: 'Thông tin không được bỏ trống' },
            { id: 'Title', message: 'Thông tin không được bỏ trống' }
        ];

        if (validateModalFormFields(form, fieldsToValidate)) {
            const csrfToken = $('input[name="__RequestVerificationToken"]').val();
            const formData = new FormData(form);
            $.ajax({
                url: '/Systems/RoleAction/Store',
                type: 'POST',
                headers: {
                    'RequestVerificationToken': csrfToken // Gửi token qua header
                },
                data: formData,
                dataType: 'JSON',
                processData: false,
                contentType: false,
                success: function (data) {
                    if (data.status === 'success') {
                        toastr.success(data.message);
                        location.reload();
                    } else {
                        toastr.error(data.message, "Lỗi!");
                    }
                },
                error: function (xhr, status, error) {
                    toastr.error("Đã xảy ra lỗi: " + error, "Lỗi!");
                }
            });

        } else {
            console.log('Form validation failed. Please correct the highlighted fields.');
        }
    }

    function Edit(id) {
        const csrfToken = $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url: '/Systems/RoleAction/Edit',
            type: 'POST',
            headers: {
                'RequestVerificationToken': csrfToken // Gửi token qua header
            },
            data: {
                Id: id,
            },
            success: function (data) {
                $('#frm_edit').html(data);
                $('#frm_edit').find('.select2multi').select2();
                $('#Edit_Modal').modal('show');
            },
            error: function () {
                toastr.error("Không thể tải dữ liệu!", "Lỗi!");
            }
        })
    }

    function Update() {
        var form = document.getElementById('frm_edit');

        // Kiểm tra xem form có tồn tại không
        if (!form) {
            toastr.error("Không tìm thấy form với id 'frm_edit'", "Lỗi!");
            return;
        }

        const fieldsToValidate = [
            { id: 'Role', message: 'Thông tin không được bỏ trống' },
            { id: 'Title', message: 'Thông tin không được bỏ trống' }
        ];

        if (validateModalFormFields(form, fieldsToValidate)) {
            const csrfToken = $('input[name="__RequestVerificationToken"]').val();
            const formData = new FormData(form);
            $.ajax({
                url: '/Systems/RoleAction/Update',
                type: 'POST',
                headers: {
                    'RequestVerificationToken': csrfToken // Gửi token qua header
                },
                data: formData,
                dataType: 'JSON',
                processData: false,
                contentType: false,
                success: function (data) {
                    if (data.status === 'success') {
                        toastr.success(data.message);
                        location.reload();
                    } else {
                        toastr.error(data.message, "Lỗi!");
                    }
                },
                error: function (xhr, status, error) {
                    toastr.error("Đã xảy ra lỗi: " + error, "Lỗi!");
                }
            });

        } else {
            console.log('Form validation failed. Please correct the highlighted fields.');
        }
    }

    function Delete(id, mota) {
        document.getElementById("id_delete").value = id;
        document.getElementById("mota_delete").innerHTML = mota;
        $('#Delete_Modal').modal('show');
    }
</script>