<!--Edit Modal-->
<div class="modal fade" id="Edit_Modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="card-label">
                    @ViewData["Title"]
                    <span class="d-block text-muted pt-2 font-size-sm">Chỉnh sửa @ViewData["Title"]</span>
                </h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body" id="frm_edit">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary font-weight-bold" onclick="Update()">Đồng ý</button>
            </div>
        </div>
    </div>
</div>
<script>
    function Edit(id) {
        const csrfToken = $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url: '/Systems/Permission/Edit',
            type: 'POST',
            headers: {
                'RequestVerificationToken': csrfToken // Gửi token qua header
            },
            data: {
                Id: id,
            },
            success: function (data) {
                //console.log("Response nhận được:", data); // Debug
                if (data.status === "error") {
                    toastr.error(data.message, "Lỗi!");
                } else {
                    $('#frm_edit').html(data);
                    $('#Edit_Modal').modal('show'); // Hiển thị modal
                }
            },
            error: function (xhr, status, error) {
                //console.error("Lỗi AJAX:", xhr.responseText); // Debug lỗi
                toastr.error("Không thể tải dữ liệu!", "Lỗi!");
            }
        });
    }

    function Update() {
        //showLoadingOverlay();
        const csrfToken = $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url: '/Systems/Permission/Update',
            type: 'POST',
            headers: {
                'RequestVerificationToken': csrfToken // Gửi token qua header
            },
            data: {
                Index: $('#Index_edit').is(":checked"),
                Create: $('#Create_edit').is(":checked"),
                Edit: $('#Edit_edit').is(":checked"),
                Delete: $('#Delete_edit').is(":checked"),
                Approve: $('#Approve_edit').is(":checked"),
                Public: $('#Public_edit').is(":checked"),
                Id: $('#Id_edit').val(),
                GroupPermissionId: $('#GroupPermissionId_edit').val(),
                TimKiem: $('#txt_Search').val(),
                PageSize: $('#PageSize_Search').val(),
                PageCurrent: $('#PageCurrent').val(),
            },

            success: function (data) {
                //toastr.success("Cập nhật thông tin thành công!", "Thành công!!!");
                $('#frm_permissions').html(data);
                $('#Edit_Modal').modal("hide");
                //hideLoadingOverlay();
                //$('body').removeClass('modal-open');
                //$('.modal-backdrop').remove(); // Xóa lớp phủ
            },
            error: function (xhr, status, error) {
                //console.error("Lỗi AJAX:", xhr.responseText); // Debug lỗi
                toastr.error("Không thể tải dữ liệu!", "Lỗi!");
            }
        })
    }
</script>