@using UI.ViewModels;
@{
    int pageSize = (ViewData["PageInfo"] as VMPageInfo)?.PageSize ?? 5;
    int pageCurrent = (ViewData["PageInfo"] as VMPageInfo)?.PageCurrent ?? 1;
    string timKiem = (ViewData["PageInfo"] as VMPageInfo)?.Search ?? "";
    string sort = (ViewData["PageInfo"] as VMPageInfo)?.Sort ?? "";
}
@model List<DataAccess.Entities.Systems.Permission>;
<div class="row">
    <div class="col-xl-3" style="text-align:left">
        <div class="form-group fv-plugins-icon-container">
            <label style="color:blue">Hiển thị</label>
            <select class="form-control" name="PageSize_Search" id="PageSize_Search" onchange="ChangePageSize()">
                <!option value="5" @(pageSize == 5 ? "selected" : "")>5 thông tin</!option>
                <!option value="10" @(pageSize == 10 ? "selected" : "")>10 thông tin</!option>
                <!option value="20" @(pageSize == 20 ? "selected" : "")>20 thông tin</!option>
                <!option value="50" @(pageSize == 50 ? "selected" : "")>50 thông tin</!option>
                <!option value="100" @(pageSize == 100 ? "selected" : "")> 100 thông tin</!option>
            </select>
        </div>
    </div>
    <div class="col-xl-9" style="text-align:right">
        <div class="form-group fv-plugins-icon-container">
            <label style="color:blue">Tìm kiếm</label>
            <div class="input-group">
                <input class="form-control" name="txt_Search" id="txt_Search" placeholder="Tìm kiếm..." value="@timKiem">
                <div class="input-group-prepend">
                    <button class="btn btn-danger" type="button" onclick="ClearTxtSearch()"><i class="las la-times-circle"></i></button>
                </div>
                <div class="input-group-append">
                    <button class="btn btn-primary" type="submit" onclick="SubmitTxtSearch()"><i class="las la-search"></i></button>
                </div>
            </div>
        </div>
    </div>
    <input hidden id="SortCurent" name="SortCurent" value="@sort" />
    <input hidden id="PageCurrent" name="PageCurrent" value="@pageCurrent" />
</div>

<table class="table table-striped table-hover table-responsive-lg rounded-lg">
    <thead class="thead-light">
        <tr>
            <th style="text-align: center; font-weight: bold;" width="5%">#</th>
            <th style="text-align: center; font-weight: bold;">Chức năng</th>
            <th style="text-align: center; font-weight: bold;" width="5%">Xem</th>
            <th style="text-align: center; font-weight: bold;" width="5%">Thêm</th>
            <th style="text-align: center; font-weight: bold;" width="5%">Sửa</th>
            <th style="text-align: center; font-weight: bold;" width="5%">Xóa</th>
            <th style="text-align: center; font-weight: bold;" width="5%">Chuyển/ Xét duyệt</th>
            <th style="text-align: center; font-weight: bold;" width="5%">Công bố</th>
            <th style="text-align: center; font-weight: bold;" width="5%">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(FuntionGlobal.GetClassTable(item.Level))">
                <td style="text-align: left; vertical-align: middle">
                    @Html.Raw(FuntionGlobal.GetBackIn(item.Level))
                    @item.STTSapXep
                </td>
                <td style="font-weight: bold; vertical-align: middle">
                    @Html.Raw(FuntionGlobal.GetBackIn(item.Level))
                    @item.Title
                </td>
                <td style="text-align: center; vertical-align: middle">
                    @if (item.Index)
                    {<i class="la la-check icon-2x text-info mr-5"></i> }
                    else
                    { <i class="la la-remove icon-2x text-danger mr-5"></i>}
                </td>
                <td style="text-align: center; vertical-align: middle">
                    @if (item.Create)
                    {<i class="la la-check icon-2x text-info mr-5"></i> }
                    else
                    { <i class="la la-remove icon-2x text-danger mr-5"></i>}
                </td>
                <td style="text-align: center; vertical-align: middle">
                    @if (item.Edit)
                    {<i class="la la-check icon-2x text-info mr-5"></i> }
                    else
                    { <i class="la la-remove icon-2x text-danger mr-5"></i>}
                </td>
                <td style="text-align: center; vertical-align: middle">
                    @if (item.Delete)
                    {<i class="la la-check icon-2x text-info mr-5"></i> }
                    else
                    { <i class="la la-remove icon-2x text-danger mr-5"></i>}
                </td>
                <td style="text-align: center; vertical-align: middle">
                    @if (item.Approve)
                    {<i class="la la-check icon-2x text-info mr-5"></i> }
                    else
                    { <i class="la la-remove icon-2x text-danger mr-5"></i>}
                </td>
                <td style="text-align: center; vertical-align: middle">
                    @if (item.Public)
                    {<i class="la la-check icon-2x text-info mr-5"></i> }
                    else
                    { <i class="la la-remove icon-2x text-danger mr-5"></i>}
                </td>
                <td>
                    <button type="button" onclick="Edit('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Chỉnh sửa">
                        <i class="icon-lg la la-edit text-success"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>
@await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")




<script>
    function ClearTxtSearch() {
        $('#txt_Search').val('');
    }
    function ChangePageSize() {
        var timkiem = $('#txt_Search').val();
        var pageSize = $('#PageSize_Search').val();
        var pageCurrent = 1;
        ReloadData(timkiem, pageSize, pageCurrent);
    }
    function ClickPage(pageSelect) {
        var timkiem = $('#txt_Search').val();
        var pageSize = $('#PageSize_Search').val();
        var pageCurrent = pageSelect;
        ReloadData(timkiem, pageSize, pageCurrent);
    }
    function SubmitTxtSearch() {
        var timkiem = $('#txt_Search').val();
        var pageSize = $('#PageSize_Search').val();
        ReloadData(timkiem, pageSize, 1);
    }

    function ReloadData(search, pageSize, pageCurrent) {
        showLoadingOverlay();
        const csrfToken = $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url: '/Systems/Permission/LoadData',
            type: 'POST',
            headers: {
                'RequestVerificationToken': csrfToken // Gửi token qua header
            },
            data: {
                timKiem: search,
                PageSize: pageSize,
                PageCurrent: pageCurrent,
                GroupPermissionId: $('#Id').val(),
            },

            success: function (data) {
                $('#frm_permissions').html(data);
                hideLoadingOverlay();
            },
            error: function (xhr, status, error) {
                //console.error("Lỗi AJAX:", xhr.responseText); // Debug lỗi
                toastr.error("Không thể tải dữ liệu!", "Lỗi!");
            }

        })
    }    
</script>

