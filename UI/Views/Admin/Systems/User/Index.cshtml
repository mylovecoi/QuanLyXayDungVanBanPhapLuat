@using UI.ViewModels;
@{
    var session = HttpContextAccessor?.HttpContext?.Session ?? null;
    int pageSize = (ViewData["PageInfo"] as VMPageInfo)?.PageSize ?? 5;
    string timKiem = (ViewData["PageInfo"] as VMPageInfo)?.Search ?? "";
    string sort = (ViewData["PageInfo"] as VMPageInfo)?.Sort ?? "";
    string role = ViewData["Role"]?.ToString() ?? "";
    string level = ViewData["Level"]?.ToString() ?? "";
    int record_id = 1;
}

@model IEnumerable<DataAccess.Entities.Systems.User>

@section custom_style{

}

@section custom_script{
    <script>
        $('#PageSize_Search').change(function () {
            ReloadFrm();
        });

        $('#Level_Search').change(function () {
            ReloadFrm();
        });

        function ClearTxtSearch() {
            $('#txt_Search').val('');
        }

        function SubmitTxtSearch() {
            ReloadFrm();
        }

        function ReloadFrm() {
            var current_path_url = window.location.pathname + '?';
            var timkiem = '&TimKiem=' + $('#txt_Search').val();
            var pageSize = '&PageSize=' + $('#PageSize_Search').val();
            var level = '&Level=' + $('#Level_Search').val();
            var url = current_path_url + timkiem + pageSize + level;
            window.location.href = url;
        }

        function ClickPage(pageSelect) {
            var current_path_url = window.location.pathname + '?';
            var timkiem = '&TimKiem=' + $('#txt_Search').val();
            var pageSize = '&PageSize=' + $('#PageSize_Search').val();
            var level = '&Level=' + $('#Level_Search').val();
            var pageCurrent = '&PageCurrent=' + pageSelect;
            var url = current_path_url + timkiem + pageSize + level + pageCurrent;
            window.location.href = url;
        }
    </script>
}

<div class="card card-custom">
    <div class="card-header flex-wrap border-0 pt-6 pb-0">
        <div class="card-title">
            <h3 class="card-label">
                <b>@ViewData["Title"]?.ToString()?.ToUpper()</b>
                <span class="d-block text-muted pt-2 font-size-sm">
                    Quản lý @ViewData["Title"]?.ToString()?.ToLower()
                </span>
            </h3>
        </div>
        <div class="card-toolbar">
        </div>
    </div>
    @Html.AntiForgeryToken()
    <div class="card-body">
        <hr />
        <div class="row">
            <div class="col-xl-3">
                <div class="form-group fv-plugins-icon-container">
                    <label style="font-weight:bold; color:blue">Phân loại:</label>
                    <select class="form-control h-40px" name="Level_Search" id="Level_Search">
                        <!option value="" @(level == "" ? "selected" : "")>-- Tất cả --</!option>
                        <!option value="Nhà nước" @(level == "Nhà nước" ? "selected" : "")>Nhà nước</!option>
                        <!option value="Doanh nghiệp" @(level == "Doanh nghiệp" ? "selected" : "")>Doanh nghiệp</!option>
                    </select>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-xl-3">
                <div class="form-group fv-plugins-icon-container">
                    <label style="color:blue">Hiển thị:</label>
                    <select class="form-control h-40px" name="PageSize_Search" id="PageSize_Search">
                        <!option value="5" @(pageSize == 5 ? "selected" : "")>5 thông tin</!option>
                        <!option value="10" @(pageSize == 10 ? "selected" : "")>10 thông tin</!option>
                        <!option value="20" @(pageSize == 20 ? "selected" : "")>20 thông tin</!option>
                        <!option value="50" @(pageSize == 50 ? "selected" : "")>50 thông tin</!option>
                        <!option value="100" @(pageSize == 100 ? "selected" : "")> 100 thông tin</!option>
                    </select>
                </div>
            </div>
            <div class="col-xl-9">
                <div class="form-group fv-plugins-icon-container">
                    <label style="color:blue">Tìm kiếm:</label>
                    <div class="input-group">
                        <input class="form-control h-40px" name="txt_Search" id="txt_Search" placeholder="Tìm kiếm..." value="@timKiem">
                        <div class="input-group-prepend">
                            <button class="btn btn-danger" type="button" onclick="ClearTxtSearch()"><i class="las la-times-circle"></i></button>
                        </div>
                        <div class="input-group-append">
                            <button class="btn btn-primary" type="submit" onclick="SubmitTxtSearch()"><i class="las la-search"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <input hidden id="sort_current" name="sort_current" value="@ViewData["Sort"]" />
        <input hidden id="PageCurrent" name="PageCurrent" value="@ViewData["PageCurrent"]" />
        <!--begin: Datatable-->
        <table class="table table-striped table-hover table-responsive-lg rounded-lg">
            <thead>
                <tr style="text-align:center;" class="table-active">
                    <th style="font-weight: bold;" width="2%">#</th>
                    <th style="font-weight: bold;">Username</th>
                    <th style="font-weight: bold;">Name</th>
                    <th style="font-weight: bold;">Email</th>
                    <th style="font-weight: bold;">Phân loại</th>
                    <th style="font-weight: bold;" width="10%">Trạng thái</th>
                    <th style="font-weight: bold;" width="15%">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count() > 0)
                {
                    @foreach (var item in Model)
                    {
                        int record = record_id++;
                        string statusClass = "";                        
                        if (item.Status == "Chờ kích hoạt")
                        {
                            statusClass = "table-warning";
                        }
                        else if (item.Status == "Kích hoạt")
                        {
                            statusClass = "table-success";
                        }
                        else if (item.Status != "Kích hoạt")
                        {
                            statusClass = "table-danger";
                        }
                        <tr class="@statusClass">
                            <td style="text-align: center; vertical-align:middle" width="5%">@record</td>
                            <td style="font-weight: bold; vertical-align: middle">@item.Username</td>
                            <td style="font-weight: bold; vertical-align: middle">@item.Name</td>
                            <td style="font-weight: bold; vertical-align: middle">@item.Email</td>
                            <td style="font-weight: bold; vertical-align: middle">@item.Level</td>
                            <td style="text-align: center; vertical-align: middle">
                                <span style="width: 112px;">
                                    @if (item.Status == "Kích hoạt")
                                    {
                                        <span class="label font-weight-bold label-lg label-light-success label-inline">Kích hoạt</span>
                                    }
                                    else if (item.Status == "Chờ kích hoạt")
                                    {
                                        <span class="label font-weight-bold label-lg label-light-warning label-inline">Chờ kích hoạt</span>
                                    }
                                    else
                                    {
                                        <span class="label font-weight-bold label-lg label-light-danger label-inline">Khóa</span>
                                    }
                                </span>
                            </td>
                            <td>
                                @if (session != null && FuntionGlobal.CheckPermission(session, role, "Create"))
                                {
                                    <button type="button" onclick="SetDuplicate('@item.Id', '@item.Username', '@item.Name')" class="btn btn-sm btn-clean btn-icon" title="Duplicate">
                                        <i class="icon-lg la la-copy text-primary"></i>
                                    </button>
                                }
                                @if (session != null && FuntionGlobal.CheckPermission(session, role, "Edit"))
                                {
                                    <button type="button" onclick="SetEdit('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Chỉnh sửa">
                                        <i class="icon-lg la la-edit text-success"></i>
                                    </button>
                                }
                                @if (session != null && FuntionGlobal.CheckPermission(session, role, "Create"))
                                {
                                    <button type="button" onclick="SetReset('@item.Id', '@item.Username', '@item.Name')" class="btn btn-sm btn-clean btn-icon" title="Reset mật khẩu">
                                        <i class="icon-lg la la-refresh text-warning"></i>
                                    </button>
                                }
                                @if (session != null && FuntionGlobal.CheckPermission(session, role, "Edit"))
                                {
                                    if (item.Status == "Kích hoạt")
                                    {
                                        <button type="button" onclick="SetActive('@item.Id', 'Khóa', '@item.Username', '@item.Name')" class="btn btn-sm btn-clean btn-icon" title="Khóa tài khoản">
                                            <i class="icon-lg la la-lock text-danger"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" onclick="SetActive('@item.Id', 'Kích hoạt', '@item.Username', '@item.Name')" class="btn btn-sm btn-clean btn-icon" title="Kích hoạt tài khoản">
                                            <i class="icon-lg la la-unlock text-primary"></i>
                                        </button>
                                    }
                                }
                                @if (session != null && FuntionGlobal.CheckPermission(session, role, "Delete"))
                                {
                                    <button type="button" class="btn btn-sm btn-clean btn-icon" title="Xóa" onclick="SetDelete('@item.Id', '@item.Username', '@item.Name')">
                                        <i class="icon-lg la la-trash text-danger"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td style="text-align:center" colspan="6">Không tìm thấy thông tin!!!</td>
                    </tr>
                }
            </tbody>
        </table>
        <!--end: Datatable-->
        @await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
    </div>
</div>
@await Html.PartialAsync("~/Views/Admin/Systems/User/Modal.cshtml")
