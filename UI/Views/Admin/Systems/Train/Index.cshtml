@{
    Layout = null;

    int record_id = (ViewData["PageInfo"] as VMPageInfo)?.RecordStart ?? 1;
    int pageSize = (ViewData["PageInfo"] as VMPageInfo)?.PageSize ?? 5;
    string timKiem = (ViewData["PageInfo"] as VMPageInfo)?.Search ?? "";
    string sort = (ViewData["PageInfo"] as VMPageInfo)?.Sort ?? "";
}

@model IEnumerable<DataAccess.Entities.Systems.User>

<!DOCTYPE html>
<html lang="en">
<!--begin::Head-->
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] | LifeSoft</title>
    <meta name="description" content="Login page" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <link rel="canonical" href="https://keenthemes.com/metronic" />
    <!--begin::Fonts-->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Nunito+Sans:300,400,500,600,700" />
    <!--end::Fonts-->
    <!--begin::Page Custom Styles(used by this page)-->
    <link href="~/assets/css/pages/login/classic/login-3.css" rel="stylesheet" type="text/css" />
    <!--end::Page Custom Styles-->
    <!--begin::Global Theme Styles(used by all pages)-->
    <link href="~/assets/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/plugins/custom/prismjs/prismjs.bundle.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/css/style.bundle.css" rel="stylesheet" type="text/css" />
    <!--end::Global Theme Styles-->
    <!--begin::Layout Themes(used by all pages)-->
    <link href="~/assets/css/themes/layout/header/base/light.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/css/themes/layout/header/menu/light.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/css/themes/layout/brand/dark.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/css/themes/layout/aside/dark.css" rel="stylesheet" type="text/css" />
    <!--end::Layout Themes-->
    <link rel="shortcut icon" href="~/FileUpload/Logo/logoLife.png" />
    <style>
        .user-list-card {
            background-color: #fff;
            color: #000;
            border-radius: 0.5rem;
            padding: 2rem;
            width: 1600px;
            max-width: 95%;
            margin: auto;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.1);
        }
    </style>

</head>
<!--end::Head-->
<!--begin::Body-->
<body id="kt_body" class="header-fixed header-mobile-fixed subheader-enabled subheader-fixed aside-enabled aside-fixed aside-minimize-hoverable page-loading">
    <!--begin::Main-->
    <div class="d-flex flex-column flex-root">
        <!--begin::List-->
        <div class="d-flex flex-row-fluid">
            <div class="d-flex flex-center bgi-size-cover bgi-no-repeat flex-row-fluid" style="background-image: url(/assets/media/bg/bg-3.jpg);">
                <div class="text-center text-dark p-7 position-relative overflow-hidden">
                    <h1 style="text-align: center; padding-bottom: 1rem">@ViewData["Title"]?.ToString()?.ToUpper()</h1>
                    <h2 style="text-align: center; padding-bottom: 3rem">@Html.Raw((ViewData["AppName"] as string)?.Replace("<br />", " "))</h2>
                    <div class="card-body user-list-card">
                        <div class="row">
                            <div class="col-xl-3" style="text-align:left">
                                <div class="form-group fv-plugins-icon-container">
                                    <label class="text-blue">Hiển thị</label>
                                    <select class="form-control" name="PageSize_Search" id="PageSize_Search">
                                        <!option value="5" @(pageSize == 5 ? "selected" : "")>5 thông tin</!option>
                                        <!option value="10" @(pageSize == 10 ? "selected" : "")>10 thông tin</!option>
                                        <!option value="20" @(pageSize == 20 ? "selected" : "")>20 thông tin</!option>
                                        <!option value="50" @(pageSize == 50 ? "selected" : "")>50 thông tin</!option>
                                        <!option value="100" @(pageSize == 100 ? "selected" : "")>100 thông tin</!option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-xl-9" style="text-align:left">
                                <div class="form-group fv-plugins-icon-container">
                                    <label class="text-blue">Tìm kiếm</label>
                                    <div class="input-group">
                                        <input class="form-control" name="txt_Search" id="txt_Search" placeholder="Tìm kiếm..." value="@timKiem">
                                        <div class="input-group-prepend">
                                            <button class="btn btn-danger" type="button" onclick="ClearTxtSearch()"><i class="las la-times-circle"></i></button>
                                        </div>
                                        <div class="input-group-append">
                                            <button class="btn btn-primary" type="submit" onclick="SubmitTxtSearch()"><i class="las la-search"></i></button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <input hidden id="sort_current" name="sort_current" value="@ViewData["Sort"]" />
                        <input hidden id="PageCurrent" name="PageCurrent" value="@ViewData["PageCurrent"]" />

                        <div class="table-responsive border rounded-lg mb-8">
                            <table class="table table-striped table-hover table-responsive-lg rounded-lg m-0">
                                <thead class="thead-light">
                                    <tr style="text-align:center;" class="table-active">
                                        <th width="5%">#</th>
                                        <th style="font-weight: bold;" width="40%">Tên tài khoản</th>
                                        <th style="font-weight: bold;" width="20%">Username</th>
                                        <th style="font-weight: bold;" width="25%">Email</th>
                                        <th style="font-weight: bold;" width="10%">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Count() > 0)
                                    {
                                        @foreach (var item in Model)
                                        {
                                            int record = record_id++;
                                            <tr>
                                                <td style="text-align:center; vertical-align:middle" width="5%">
                                                    @record
                                                </td>
                                                <td style="text-align:left; vertical-align:middle">@item.Name</td>
                                                <td style="text-align:left; vertical-align:middle">@item.Username</td>
                                                <td style="text-align:left; vertical-align:middle">@item.Email</td>
                                                <td>
                                                    <a asp-controller="Auth"
                                                       asp-action="Login"
                                                       asp-route-username="@item.Username"
                                                       class="btn btn-md btn-primary">
                                                        Chọn
                                                    </a>

                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td style="text-align:center" colspan="5">Không tìm thấy thông tin!!!</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
                        <div class="card-footer" style="text-align:center">
                            <a asp-controller="Auth" asp-action="Login" class="btn btn-danger mr-2"><i class="la la-reply"></i>Quay lại</a>
                        </div>
                    </div>

                    <div class="mt-10">
                        <span class="text-dark opacity-70 mr-4" style="font-weight:bold">
                            @Html.Raw(ViewData["Copyright"])
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <!--end::List-->
    </div>
    <!--end::Main-->
    <script>var HOST_URL = "https://preview.keenthemes.com/metronic/theme/html/tools/preview";</script>
    <!--begin::Global Config(global config for global JS scripts)-->
    <script>var KTAppSettings = { "breakpoints": { "sm": 576, "md": 768, "lg": 992, "xl": 1200, "xxl": 1400 }, "colors": { "theme": { "base": { "white": "#ffffff", "primary": "#3699FF", "secondary": "#E5EAEE", "success": "#1BC5BD", "info": "#8950FC", "warning": "#FFA800", "danger": "#F64E60", "light": "#E4E6EF", "dark": "#181C32" }, "light": { "white": "#ffffff", "primary": "#E1F0FF", "secondary": "#EBEDF3", "success": "#C9F7F5", "info": "#EEE5FF", "warning": "#FFF4DE", "danger": "#FFE2E5", "light": "#F3F6F9", "dark": "#D6D6E0" }, "inverse": { "white": "#ffffff", "primary": "#ffffff", "secondary": "#3F4254", "success": "#ffffff", "info": "#ffffff", "warning": "#ffffff", "danger": "#ffffff", "light": "#464E5F", "dark": "#ffffff" } }, "gray": { "gray-100": "#F3F6F9", "gray-200": "#EBEDF3", "gray-300": "#E4E6EF", "gray-400": "#D1D3E0", "gray-500": "#B5B5C3", "gray-600": "#7E8299", "gray-700": "#5E6278", "gray-800": "#3F4254", "gray-900": "#181C32" } }, "font-family": "Poppins" };</script>
    <!--end::Global Config-->
    <!--begin::Global Theme Bundle(used by all pages)-->
    <script src="~/assets/plugins/global/plugins.bundle.js"></script>
    <script src="~/assets/plugins/custom/prismjs/prismjs.bundle.js"></script>
    <script src="~/assets/js/scripts.bundle.js"></script>
    <!--end::Global Theme Bundle-->

    <script>
        function ClearTxtSearch() {
            $('#txt_Search').val('');
            ReloadFrm();
        }

        function SubmitTxtSearch() {
            ReloadFrm();
        }

        $('#PageSize_Search').change(function () {
            ReloadFrm();
        });

        function ReloadFrm() {
            var current_path_url = window.location.pathname + '?';
            var timkiem = '&timKiem=' + $('#txt_Search').val();
            var pageSize = '&pageSize=' + $('#PageSize_Search').val();
            var url = current_path_url + timkiem + pageSize;
            window.location.href = url;
        }

        function ClickPage(pageSelect) {
            var current_path_url = window.location.pathname + '?';
            var timkiem = '&timKiem=' + $('#txt_Search').val();
            var pageSize = '&pageSize=' + $('#PageSize_Search').val();
            var pageCurrent = '&pageCurrent=' + pageSelect;
            var url = current_path_url + timkiem + pageSize + pageCurrent;
            window.location.href = url;
        }
    </script>
</body>
<!--end::Body-->
</html>