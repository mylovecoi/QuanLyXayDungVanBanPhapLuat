@model DataAccess.Entities.ThamDinhGia.ThamDinhGiaDanhMucHangHoaCt

<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="HangHoaId" value="@(Model.HangHoaId == Guid.Empty ? ViewData["HangHoaId"] : Model.HangHoaId)" />

@{
    var donViTinhs = ViewData["DonViTinhs"] as IEnumerable<DataAccess.Entities.Settings.DanhMucDonViTinh> ?? new List<DataAccess.Entities.Settings.DanhMucDonViTinh>();
}

<div class="row">
    <div class="col-xl-6">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Mã hàng hóa:</label>
            <input type="text" class="form-control" asp-for="MaHangHoa" required />
        </div>
    </div>
    <div class="col-xl-6">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Tên hàng hóa:</label>
            <input type="text" class="form-control" asp-for="TenHangHoa" required />
        </div>
    </div>
    <div class="col-xl-12">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Quy cách chất lượng:</label>
            <textarea class="form-control" asp-for="QuyCachChatLuong" rows="2"></textarea>
        </div>
    </div>
    <div class="col-xl-12">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Thông số kỹ thuật:</label>
            <textarea class="form-control" asp-for="ThongSoKt" rows="2"></textarea>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Xuất xứ:</label>
            <input type="text" class="form-control" asp-for="XuatXu" />
        </div>
    </div>
    <div class="col-xl-4">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Đơn vị tính:</label>
            <select class="form-control select2multi" asp-for="DonViTinh">
                <option value="">-- Chọn đơn vị tính --</option>
                @foreach (var item in donViTinhs)
                {
                    <!option value="@item.MaDonViTinh" @(Model.DonViTinh == item.MaDonViTinh ? "selected" : "")>@item.TenDonViTinh</!option>
                }
            </select>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Trạng thái:</label>
            <select class="form-control" asp-for="TrangThai">
                <option value="Kích hoạt">Kích hoạt</option>
                <option value="Khóa">Khóa</option>
            </select>
        </div>
    </div>
</div>
