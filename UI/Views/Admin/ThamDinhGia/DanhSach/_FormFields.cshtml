@model DataAccess.Entities.ThamDinhGia.ThamDinhGia
@using DataAccess.Entities.Settings
@using DataAccess.Entities.ThamDinhGia

@{
    var dmDiaDanh = ViewData["DanhMucDiaDanh"] as List<DanhMucDiaDanh> ?? new List<DanhMucDiaDanh>();
    var dmDonVi = ViewData["DanhMucDonVi"] as DanhMucDonVi;
    var dmHangHoa = ViewData["DanhMucHangHoa"] as ThamDinhGiaDanhMucHangHoa;
    var dmDonViThamDinh = ViewData["DanhMucDonViThamDinh"] as List<ThamDinhGiaDanhMucDonVi> ?? new List<ThamDinhGiaDanhMucDonVi>();
    var dmHoiDong = ViewData["DanhMucHoiDong"] as List<ThamDinhGiaHoiDong> ?? new List<ThamDinhGiaHoiDong>();
}

<input hidden asp-for="DonViQuanLyId" />
<input hidden asp-for="HangHoaId" />
<input hidden asp-for="Id" />
<input hidden asp-for="PhanLoai" />
<input hidden asp-for="DiaBanId" />
<input hidden asp-for="ChiTietExcel" id="CodeExcel" />
<input type="hidden" id="tableName" name="TableName" value="ThamDinhGia" />

<div class="mb-3 font-weight-bold font-size-lg">
    <label style="color: blue; text-decoration-line: underline; font-weight: bold">Thông tin hồ sơ @Model.PhanLoai</label>
</div>

<div class="row">
    <div class="col-xl-6">
        <div class="form-group">
            <label>Số thông báo kết luận: <span class="text-danger">*</span></label>
            <input type="text" class="form-control" asp-for="SoTbKl" required />
        </div>
    </div>
    <div class="col-xl-6">
        <div class="form-group">
            <label>Ngày ban hành: <span class="text-danger">*</span></label>
            <input type="date" class="form-control" asp-for="Thoidiem" required value="@Model.Thoidiem.ToString("yyyy-MM-dd")" />
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-4">
        <div class="form-group">
            <label>Đơn vị yêu cầu thẩm định giá:</label>
            <input type="text" class="form-control" asp-for="DvYeuCau" />
        </div>
    </div>
    <div class="col-xl-4">
        <div class="form-group">
            <label>Đơn vị thực hiện thẩm định giá:</label>
            <select class="form-control select2multi" asp-for="DonViThamDinhId" id="DonViThamDinhId" style="width: 100%">
                <option value="">-- Chọn đơn vị thẩm định --</option>
                @foreach (var item in dmDonViThamDinh)
                {
                    <option value="@item.Id">@item.TenDv</option>
                }
            </select>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="form-group">
            <label>Thời hạn thẩm định giá:</label>
            <input type="date" class="form-control" asp-for="ThoiHan" value="@Model.ThoiHan.ToString("yyyy-MM-dd")" />
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-6">
        <div class="form-group">
            <label class="font-weight-bold">Hàng hóa thẩm định:</label>
            <select class="form-control" disabled>
                <option value="@dmHangHoa?.Id">@dmHangHoa?.TenDanhMucHangHoa</option>
            </select>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="form-group">
            <label>Hội đồng thẩm định giá: <span class="text-danger">*</span></label>
            <select class="form-control select2multi" asp-for="HoiDongId" id="HoiDongId" required style="width: 100%">
                <option value="" disabled selected>-- Chọn hội đồng thẩm định --</option>
                @foreach (var item in dmHoiDong)
                {
                    <option value="@item.Id">@item.TenHoiDong</option>
                }
            </select>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-4">
        <div class="form-group">
            <label>Số quyết định phê duyệt:</label>
            <input type="text" class="form-control" asp-for="SoQdPheDuyet" />
        </div>
    </div>
    <div class="col-xl-4">
        <div class="form-group">
            <label>Ngày quyết định phê duyệt:</label>
            <input type="date" class="form-control" asp-for="NgayQdPheDuyet" value="@Model.NgayQdPheDuyet.ToString("yyyy-MM-dd")" />
        </div>
    </div>
    <div class="col-xl-4">
        <div class="form-group">
            <label>Thời hạn sử dụng kết quả (Số ngày):</label>
            <input type="number" class="form-control" asp-for="SoNgayKq" />
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-6">
        <div class="form-group">
            <label>Địa điểm thẩm định:</label>
            <input type="text" class="form-control" asp-for="DiaDiem" />
        </div>
    </div>
    <div class="col-xl-6">
        <div class="form-group">
            <label>Thông tin/Tình trạng tài sản:</label>
            <input type="text" class="form-control" asp-for="TtTsTd" />
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="form-group">
            <label>Ghi chú:</label>
            <textarea type="text" class="form-control" asp-for="GhiChu" rows="2"></textarea>
        </div>
    </div>
</div>

<div class="mb-3 font-weight-bold font-size-lg mt-5">
    <label style="color: blue; text-decoration-line: underline; font-weight: bold">Giấy Tờ Kèm Theo:</label>
    <button type="button" class="btn btn-link" onclick="HandleShowHideFrom(this, '#frmThongTinGiayToiKemTheo')" style="font-style:italic">Hiển thị</button>
</div>
<div id="frmThongTinGiayToiKemTheo" style="display: none">
    <div class="row">
        <div class="col-12" id="attachedFile_frm">
            @await Html.PartialAsync("~/Views/Admin/AttachedFile/Index.cshtml", Model!.AttachedFiles)
        </div>
    </div>
</div>

<div class="mb-3 font-weight-bold font-size-lg mt-5">
    <label style="color: blue; text-decoration-line: underline; font-weight: bold">Thông tin hồ sơ chi tiết</label>
</div>
<div class="card card-custom" style="border: 1px solid #60aee4;">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
                <span id="save-status" class="text-muted me-3"></span>
                <button id="btn-import-excel" type="button" class="btn btn-info btn-sm me-2">
                    <i class="fas fa-file-excel"></i> Nhận file Excel
                </button>
                <button id="btn-export-excel" type="button" class="btn btn-success btn-sm me-2">
                    <i class="fas fa-download"></i> Xuất file Excel
                </button>
                <input type="file" id="file-import-excel" accept=".xls,.xlsx,.xlsm" style="display: none;" />
            </div>
        </div>
        <!-- SheetJS for Excel Support (.xls, .xlsx, .xlsm) -->
        <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>
        <script>
            let currentWorkbook = null;
            window.univerAPIInstance = null;

            function convertSheetJsToUniver(worksheet, fromRow, toRow) {
                if (!worksheet || !worksheet['!ref']) return null;
                const range = XLSX.utils.decode_range(worksheet['!ref']);
                
                let startRow = range.s.r;
                let endRow = range.e.r;
                
                if (fromRow && fromRow > 0) startRow = Math.max(range.s.r, fromRow - 1);
                if (toRow && toRow > 0) endRow = Math.min(range.e.r, toRow - 1);

                const cellData = {};
                const stylesDict = {};

                function getStyleId(bold, italic) {
                    const key = `style_b${bold ? 1 : 0}_i${italic ? 1 : 0}`;
                    if (!stylesDict[key]) {
                        stylesDict[key] = {
                            bl: bold ? 1 : 0,
                            it: italic ? 1 : 0,
                            vt: 2,
                            tb: 3
                        };
                    }
                    return key;
                }

                for (let r = startRow; r <= endRow; r++) {
                    const univerRowIdx = r - startRow;
                    cellData[univerRowIdx.toString()] = {};

                    for (let c = range.s.c; c <= range.e.c; c++) {
                        const cellAddress = { r: r, c: c };
                        const cellRef = XLSX.utils.encode_cell(cellAddress);
                        const cell = worksheet[cellRef];

                        if (cell) {
                            let cellValue = cell.v;
                            if (cell.t === 'n') {
                                cellValue = Number(cell.v);
                            } else if (cell.t === 'b') {
                                cellValue = Boolean(cell.v);
                            } else {
                                cellValue = cell.v !== undefined ? String(cell.v) : '';
                            }

                            const isBold = cell.s && cell.s.font && cell.s.font.bold;
                            const isItalic = cell.s && cell.s.font && cell.s.font.italic;
                            const styleId = getStyleId(isBold, isItalic);

                            cellData[univerRowIdx.toString()][c.toString()] = {
                                v: cellValue,
                                s: styleId
                            };
                        }
                    }
                }

                const totalRowsCount = endRow - startRow + 1;
                const totalColumnsCount = range.e.c - range.s.c + 1;

                const columnData = {};
                for (let c = 0; c < totalColumnsCount; c++) {
                    columnData[c.toString()] = { w: 150 };
                }

                return {
                    id: "sheet1",
                    name: "Sheet1",
                    rowCount: Math.max(totalRowsCount + 20, 50),
                    columnCount: Math.max(totalColumnsCount + 5, 20),
                    cellData: cellData,
                    rowData: (() => {
                        const rd = { "0": { "h": 80 } };
                        const totalRows = Math.max(totalRowsCount + 20, 50);
                        for (let r = 1; r < totalRows; r++) {
                            rd[r.toString()] = { "ia": 1 };
                        }
                        return rd;
                    })(),
                    columnData: columnData,
                    styles: stylesDict
                };
            }

            function handleExcelFileSelect(file, $statusTxt) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    try {
                        $statusTxt.text('Đang xử lý file Excel...');
                        const data = new Uint8Array(e.target.result);
                        const workbook = XLSX.read(data, { type: 'array' });
                        
                        if (workbook.SheetNames.length === 0) {
                            $statusTxt.text('File Excel trống!');
                            return;
                        }

                        const firstSheetName = workbook.SheetNames[0];
                        const worksheet = workbook.Sheets[firstSheetName];
                        
                        const univerSheet = convertSheetJsToUniver(worksheet);
                        if (!univerSheet) {
                            $statusTxt.text('Không đọc được dữ liệu từ sheet!');
                            return;
                        }

                        const univerData = {
                            id: window.univerAPIInstance.getActiveWorkbook().getId(),
                            name: "Bảng giá chi tiết",
                            sheetOrder: ["sheet1"],
                            styles: univerSheet.styles,
                            sheets: {
                                "sheet1": univerSheet
                            },
                            locale: "vi-VN"
                        };

                        const activeWorkbook = window.univerAPIInstance.getActiveWorkbook();
                        if (activeWorkbook) {
                            activeWorkbook.dispose();
                        }

                        window.univerAPIInstance.createWorkbook(univerData);
                        if (window.autoFitAllRows) {
                            window.autoFitAllRows();
                        }
                        $statusTxt.text('Đã nhận dữ liệu từ file Excel thành công!');
                    } catch (err) {
                        console.error('Lỗi đọc file Excel:', err);
                        $statusTxt.text('Lỗi định dạng file Excel!');
                    }
                };
                reader.readAsArrayBuffer(file);
            }

            document.getElementById('btn-export-excel').addEventListener('click', function () {
                try {
                    const snapshot = window.univerAPIInstance.getActiveWorkbook().save();
                    const sheetId = snapshot.sheetOrder[0];
                    const sheet = snapshot.sheets[sheetId];
                    const cellData = sheet.cellData;
                    
                    const rows = [];
                    const rowKeys = Object.keys(cellData).map(Number).sort((a, b) => a - b);
                    
                    rowKeys.forEach(r => {
                        const rowObj = cellData[r];
                        const rowData = [];
                        const colKeys = Object.keys(rowObj).map(Number).sort((a, b) => a - b);
                        
                        colKeys.forEach(c => {
                            rowData[c] = rowObj[c]?.v !== undefined ? rowObj[c].v : '';
                        });
                        rows.push(rowData);
                    });

                    const worksheet = XLSX.utils.aoa_to_sheet(rows);
                    const workbook = XLSX.utils.book_new();
                    XLSX.utils.book_append_sheet(workbook, worksheet, "Sheet1");
                    XLSX.writeFile(workbook, "BangGiaChiTiet.xlsx");
                } catch (err) {
                    console.error('Lỗi xuất file Excel:', err);
                    alert('Lỗi xuất file Excel!');
                }
            });
        </script>
        
        <div id="app-univer" data-mahs="@Model.Id" style="height: 600px; width: 100%;"></div>
    </div>
</div>
