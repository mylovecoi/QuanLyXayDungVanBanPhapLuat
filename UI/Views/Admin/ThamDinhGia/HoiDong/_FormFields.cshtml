@model DataAccess.Entities.ThamDinhGia.ThamDinhGiaHoiDong

<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="Ipf1" />

<div class="row">
    <div class="col-xl-6">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Tên hội đồng:</label>
            <input type="text" class="form-control" asp-for="TenHoiDong" required />
        </div>
    </div>
    <div class="col-xl-6">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Số quyết định:</label>
            <input type="text" class="form-control" asp-for="SoQd" required />
        </div>
    </div>
    <div class="col-xl-6">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Ngày quyết định:</label>
            <input type="date" class="form-control" asp-for="NgayQd" value="@(Model.NgayQd == DateTime.MinValue ? DateTime.Now.ToString("yyyy-MM-dd") : Model.NgayQd.ToString("yyyy-MM-dd"))" required />
        </div>
    </div>
    <div class="col-xl-6">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Cơ quan ban hành:</label>
            <input type="text" class="form-control" asp-for="CoQuanBanHanh" />
        </div>
    </div>
    <div class="col-xl-6">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Chủ tịch hội đồng:</label>
            <input type="text" class="form-control" asp-for="ChuTichHoiDong" required />
        </div>
    </div>
    <div class="col-xl-6">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Chức vụ:</label>
            <input type="text" class="form-control" asp-for="ChucVu" />
        </div>
    </div>
    <div class="col-xl-4">
        <div class="form-group">
            <label style="font-weight:bold; color:black">Phân loại tố tụng</label>
            <select asp-for="ToTung" class="form-control">
                <option value="0">Không phải là hội đồng định giá trong hoạt động tố tụng hình sự</option>
                <option value="1">Hội đồng định giá trong hoạt động tố tụng hình sự</option>
            </select>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="form-group">
            <label style="font-weight:bold; color:black">Cấp hội đồng</label>
            <select asp-for="CapHoiDong" class="form-control">
                <option value="1">Nhà nước</option>
                <option value="2">Bộ, cơ quan trung ương</option>
                <option value="3">Cấp Tỉnh/Thành phố</option>
                <option value="4">Cấp Quận/Huyện</option>
                <option value="5">Cơ quan, tổ chức, đơn vị khác</option>
            </select>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="form-group">
            <label style="font-weight:bold; color:black">Phân loại hội đồng</label>
            <select asp-for="LoaiHoiDong" class="form-control">
                <option value="1">Hội đồng theo vụ việc</option>
                <option value="2">Hội đồng thường xuyên</option>
            </select>
        </div>
    </div>
    <div class="col-xl-12">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Nhiệm vụ hội đồng:</label>
            <textarea class="form-control" asp-for="NhiemVuHoiDong" rows="2"></textarea>
        </div>
    </div>
    <div class="col-xl-12">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Nội dung quyết định:</label>
            <textarea class="form-control" asp-for="NoiDungQd" rows="2"></textarea>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Căn cứ pháp lý:</label>
            <input type="text" class="form-control" asp-for="CanCuPhapLy" />
        </div>
    </div>
    <div class="col-xl-6">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Theo đề nghị:</label>
            <input type="text" class="form-control" asp-for="TheoDeNghi" />
        </div>
    </div>
    <div class="col-xl-6">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">File quyết định:</label>
            <input type="file" class="form-control" asp-for="Ipf1Upload" />
            @if (!string.IsNullOrEmpty(Model.Ipf1))
            {
                <div class="mt-2">
                    <span class="text-muted">File hiện tại: </span>
                    <a href="/FileUpload/ThamDinhGia/@Model.Ipf1" target="_blank" class="text-primary font-weight-bold">
                        <i class="la la-download"></i> Tải về file quyết định
                    </a>
                </div>
            }
        </div>
    </div>
    <div class="col-xl-6">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Mã tỉnh áp dụng:</label>
            <input type="text" class="form-control" asp-for="MaTinhApDung" />
        </div>
    </div>
    <div class="col-xl-6">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Mã huyện áp dụng:</label>
            <input type="text" class="form-control" asp-for="MaHuyenApDung" />
        </div>
    </div>
</div>
