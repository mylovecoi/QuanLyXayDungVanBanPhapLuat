@using UI.ViewModels;
@using DataAccess.Entities.ThamDinhGia;

@{
    var session = HttpContextAccessor?.HttpContext?.Session ?? null;
    string role = ViewData["Role"] as string ?? "";
    int pageSize = (ViewData["PageInfo"] as VMPageInfo)?.PageSize ?? 5;
    string timKiem = (ViewData["PageInfo"] as VMPageInfo)?.Search ?? "";
    int record_id = (ViewData["PageInfo"] as VMPageInfo)?.RecordStart ?? 1;
}

@model IEnumerable<ThamDinhGiaHoiDongCt>

@section custom_style {
}

@section custom_script {
    <script>
        function ClearTxtSearch() {
            $('#txt_Search').val('');
        }

        function SubmitTxtSearch() {
            ReloadFrm();
        }

        $('#PageSize_Search').change(function () {
            ReloadFrm();
        });

        function ReloadFrm() {
            var current_path_url = window.location.pathname + '?';
            var hoiDongId = 'hoiDongId=@ViewData["HoiDongId"]';
            var timkiem = '&timKiem=' + $('#txt_Search').val();
            var pageSize = '&pageSize=' + $('#PageSize_Search').val();
            var url = current_path_url + hoiDongId + timkiem + pageSize;
            window.location.href = url;
        }

        function ClickPage(pageSelect) {
            var current_path_url = window.location.pathname + '?';
            var hoiDongId = 'hoiDongId=@ViewData["HoiDongId"]';
            var timkiem = '&timKiem=' + $('#txt_Search').val();
            var pageSize = '&pageSize=' + $('#PageSize_Search').val();
            var pageCurrent = '&pageCurrent=' + pageSelect;
            var url = current_path_url + hoiDongId + timkiem + pageSize + pageCurrent;
            window.location.href = url;
        }
    </script>
}

<div class="card card-custom">
    <div class="card-header flex-nowrap border-0 pt-6 pb-0">
        <div class="card-title" style="min-width: 0; flex: 1;">
            <h3 class="card-label" style="text-overflow: ellipsis; overflow: hidden; white-space: nowrap; width: 100%;">
                <b title="@ViewData["Title"]?.ToString()?.ToUpper()">@ViewData["Title"]?.ToString()?.ToUpper()</b>
                <span class="d-block text-muted pt-2 font-size-sm" style="text-overflow: ellipsis; overflow: hidden; white-space: nowrap;" title="Hội đồng: @ViewData["TenHoiDong"]">
                    Hội đồng: <b class="text-primary">@ViewData["TenHoiDong"]</b>
                </span>
            </h3>
        </div>
        <div class="card-toolbar" style="flex-shrink: 0;">
            <a asp-controller="ThamDinhGiaHoiDong" asp-action="Index" class="btn btn-light-primary font-weight-bolder mr-2">
                <i class="la la-reply"></i>Quay lại
            </a>
            @if (session != null && FuntionGlobal.CheckPermission(session, role, "Delete"))
            {
                <button type="button" class="btn btn-danger font-weight-bolder mr-2" onclick="DeleteAll()">
                    <i class="la la-trash"></i>Xóa hết
                </button>
            }
            @if (session != null && FuntionGlobal.CheckPermission(session, role, "Create"))
            {
                <a asp-controller="ThamDinhGiaHoiDongCt" asp-action="NhanExcel" asp-route-hoiDongId="@ViewData["HoiDongId"]" class="btn btn-success font-weight-bolder mr-2">
                    <i class="la la-file-excel"></i>Nhận Excel
                </a>
                <button type="button" class="btn btn-primary font-weight-bolder" onclick="Create()">
                    <i class="la la-plus"></i>Thêm mới
                </button>
            }
        </div>
    </div>
    @Html.AntiForgeryToken()
    <div class="card-body">
        <div class="row">
            <div class="col-xl-3" style="text-align:left">
                <div class="form-group fv-plugins-icon-container">
                    <label class="text-blue">Hiển thị</label>
                    <select class="form-control" name="PageSize_Search" id="PageSize_Search">
                        <!option value="5" @(pageSize == 5 ? "selected" : "")>5 thông tin</!option>
                        <!option value="10" @(pageSize == 10 ? "selected" : "")>10 thông tin</!option>
                        <!option value="20" @(pageSize == 20 ? "selected" : "")>20 thông tin</!option>
                        <!option value="50" @(pageSize == 50 ? "selected" : "")>50 thông tin</!option>
                        <!option value="100" @(pageSize == 100 ? "selected" : "")>100 thông tin</!option>
                    </select>
                </div>
            </div>
            <div class="col-xl-9" style="text-align:left">
                <div class="form-group fv-plugins-icon-container">
                    <label class="text-blue">Tìm kiếm</label>
                    <div class="input-group">
                        <input class="form-control" name="txt_Search" id="txt_Search" placeholder="Tìm kiếm theo họ tên, chức vụ, vai trò..." value="@timKiem">
                        <div class="input-group-prepend">
                            <button class="btn btn-danger" type="button" onclick="ClearTxtSearch()"><i class="las la-times-circle"></i></button>
                        </div>
                        <div class="input-group-append">
                            <button class="btn btn-primary" type="submit" onclick="SubmitTxtSearch()"><i class="las la-search"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--begin: Datatable-->
        <div class="table-responsive border rounded-lg mb-8">
            <table class="table table-striped table-hover table-responsive-lg rounded-lg m-0">
                <thead class="thead-light">
                    <tr style="text-align:center;" class="table-active">
                        <th width="5%">#</th>
                        <th style="font-weight: bold;" width="15%">STT sắp xếp</th>
                        <th style="font-weight: bold;">Họ và tên</th>
                        <th style="font-weight: bold;">Chức vụ</th>
                        <th style="font-weight: bold;">Vai trò</th>
                        <th style="font-weight: bold;" width="15%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td style="text-align:center; vertical-align:middle">
                                    @(record_id++)
                                </td>
                                <td style="font-weight: bold; vertical-align: middle; text-align: center;">
                                    @item.STTSapXep
                                </td>
                                <td style="vertical-align: middle; font-weight: bold;">
                                    @item.HoTen
                                </td>
                                <td style="vertical-align: middle;">
                                    @item.ChucVu
                                </td>
                                <td style="vertical-align: middle;">
                                    @item.VaiTro
                                </td>
                                <td style="vertical-align: middle; text-align: center">
                                    @if (session != null && FuntionGlobal.CheckPermission(session, role, "Edit"))
                                    {
                                        <button type="button" onclick="Edit('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Chỉnh sửa">
                                            <i class="icon-lg la la-edit text-success"></i>
                                        </button>
                                    }
                                    @if (session != null && FuntionGlobal.CheckPermission(session, role, "Delete"))
                                    {
                                        <button type="button" class="btn btn-sm btn-clean btn-icon" title="Xóa" onclick="Delete('@item.Id', '@item.HoTen')">
                                            <i class="icon-lg la la-trash text-danger"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td style="text-align:center" colspan="6">Không tìm thấy thông tin!!!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!--end: Datatable-->
        @await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
    </div>
</div>
@await Html.PartialAsync("~/Views/Admin/ThamDinhGia/HoiDongCt/_Modal.cshtml")
