<!--Tra Lai Modal-->
<div class="modal fade" id="TraLai_Modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="TraLaiForm" method="post" asp-controller="ThamDinhGiaXetDuyet" asp-action="TraLai" onsubmit="SubmitTraLaiForm(event)">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h3 class="card-label">
                        <b>@FuntionGlobal.CapitalizeAll(ViewData["Title"]?.ToString()).ToUpper()</b>
                        <span class="d-block text-muted pt-2 font-size-sm">
                            Trả lại hồ sơ thẩm định giá
                        </span>
                    </h3>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <i aria-hidden="true" class="ki ki-close"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-xl-12">
                            <div class="form-group fv-plugins-icon-container">
                                <label>Số TBKL:</label>
                                <label class="form-control" id="soqd_tralai" style="font-weight: bold; color: blue;"></label>
                            </div>
                        </div>
                        <div class="col-xl-12">
                            <div class="form-group">
                                <label class="control-label">Lý do trả lại:</label>
                                <textarea class="form-control" rows="4" id="Lydo_Input" name="Lydo" required></textarea>
                            </div>
                        </div>
                    </div>
                    <input id="tralaiId" name="hoSoId" type="hidden" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Hủy thao tác</button>
                    <button type="submit" class="btn btn-primary font-weight-bold">Trả lại hồ sơ</button>
                </div>
            </form>
        </div>
    </div>
</div>

