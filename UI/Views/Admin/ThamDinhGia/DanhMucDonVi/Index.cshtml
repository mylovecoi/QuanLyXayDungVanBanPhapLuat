@using UI.ViewModels;

@{
    var session = HttpContextAccessor?.HttpContext?.Session ?? null;
    int pageSize = (ViewData["PageInfo"] as VMPageInfo)?.PageSize ?? 5;
    string timKiem = (ViewData["PageInfo"] as VMPageInfo)?.Search ?? "";
    string sort = (ViewData["PageInfo"] as VMPageInfo)?.Sort ?? "";
    string role = ViewData["Role"]?.ToString() ?? "";
    int record_id = 1;
}

@model IEnumerable<DataAccess.Entities.ThamDinhGia.ThamDinhGiaDanhMucDonVi>

@section custom_style {
    <style>
        @@media print {
            .header, .aside, .footer, .card-header, .card-toolbar, .no-print, form, #Pagination, .btn-icon, td:last-child, th:last-child {
                display: none !important;
            }
            .card, .card-body, .table-responsive {
                border: none !important;
                padding: 0 !important;
                margin: 0 !important;
            }
            body {
                background: white !important;
            }
        }
    </style>
}

@section custom_script {
    <script src="~/js/site.js"></script>
    <script>
        $(document).ready(function () {
            HandleRegisterFormFilter('#FilterForm', '#Pagination', '@Url.Action("Index", "ThamDinhGiaDanhMucDonVi")');
        });

        function ClickPage(pageSelect) {
            var current_path_url = '/ThamDinhGia/DanhMucDonVi?';
            var timkiem = 'Search=' + $('#txt_Search').val();
            var pageSize = '&PageSize=' + $('#PageSize_Search').val();
            var pageCurrent = '&PageCurrent=' + pageSelect;
            var url = current_path_url + timkiem + pageSize + pageCurrent;
            window.location.href = url;
        }

        function PrintPage() {
            var url = '@Url.Action("Print", "ThamDinhGiaDanhMucDonVi")' + '?Search=' + encodeURIComponent($('#txt_Search').val());
            window.open(url, '_blank');
        }
    </script>
}

<div class="card card-custom">
    <div class="card-header flex-wrap border-0 pt-6 pb-0">
        <div class="card-title">
            <h3 class="card-label">
                Quản lý <b>@ViewData["Title"]?.ToString()?.ToUpper()</b>
            </h3>
        </div>
        <div class="card-toolbar">
            @if (session != null && FuntionGlobal.CheckPermission(session, role, "Create"))
            {
                <button type="button" class="btn btn-primary font-weight-bolder mr-2" title="Thêm mới" onclick="Create()">
                    <i class="la la-plus"></i>Thêm mới
                </button>
                <a href="@Url.Action("NhanExcel", "ThamDinhGiaDanhMucDonVi")" class="btn btn-success font-weight-bolder mr-2" title="Nhận Excel">
                    <i class="la la-file-excel"></i>Nhận dữ liệu
                </a>
            }
            <button type="button" class="btn btn-info font-weight-bolder" title="In trang" onclick="PrintPage()">
                <i class="la la-print"></i>In trang
            </button>
        </div>
    </div>
    <br />
    @Html.AntiForgeryToken()
    <div class="card-body pt-0">
        <form id="FilterForm">
            <div class="row">
                <div class="col-xl-3" style="text-align:left">
                    <div class="form-group fv-plugins-icon-container">
                        <label class="text-blue">Hiển thị</label>
                        <select class="form-control h-40px" name="PageSize" id="PageSize_Search">
                            <!option value="5" @(pageSize == 5 ? "selected" : "")>5 thông tin</!option>
                            <!option value="10" @(pageSize == 10 ? "selected" : "")>10 thông tin</!option>
                            <!option value="20" @(pageSize == 20 ? "selected" : "")>20 thông tin</!option>
                            <!option value="50" @(pageSize == 50 ? "selected" : "")>50 thông tin</!option>
                            <!option value="100" @(pageSize == 100 ? "selected" : "")>100 thông tin</!option>
                        </select>
                    </div>
                </div>
                <div class="col-xl-9">
                    <div class="form-group fv-plugins-icon-container">
                        <label class="text-blue">Tìm kiếm</label>
                        <div class="input-group">
                            <input class="form-control h-40px" name="Search" id="txt_Search" placeholder="Tìm kiếm theo mã GCN, tên đơn vị, số QĐ, địa chỉ..." value="@timKiem">
                            <div class="input-group-prepend">
                                <button class="btn btn-danger" type="reset"><i class="las la-times-circle"></i></button>
                            </div>
                            <div class="input-group-append">
                                <button class="btn btn-primary" type="submit"><i class="las la-search"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <input hidden id="sort_current" name="sort_current" value="@sort" />
            <input hidden id="PageCurrent" name="PageCurrent" value="@ViewData["PageCurrent"]" />
        </form>
        <!--begin: Datatable-->
        <div class="table-responsive border rounded-lg mb-8">
            <table class="table table-striped table-hover table-responsive-lg rounded-lg m-0">
                <thead class="thead-light">
                    <tr style="text-align:center;" class="table-active">
                        <th width="3%">#</th>
                        <th style="font-weight: bold;" width="10%">Mã GCN</th>
                        <th style="font-weight: bold;" width="20%">Tên đơn vị</th>
                        <th style="font-weight: bold;" width="15%">Địa chỉ</th>
                        <th style="font-weight: bold;" width="12%">Người đại diện</th>
                        <th style="font-weight: bold;" width="10%">Trạng thái</th>
                        <th style="font-weight: bold;" width="10%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td style="text-align: center; vertical-align:middle">@(record_id++)</td>
                                <td style="text-align: left; vertical-align:middle">@item.MaGCN</td>
                                <td style="text-align: left; vertical-align:middle" class="font-weight-bold">@item.TenDv</td>
                                <td style="text-align: left; vertical-align:middle">@item.DiaChi</td>
                                <td style="text-align: left; vertical-align:middle">
                                    @item.NguoiDaiDien<br />
                                    <span class="text-muted font-size-sm">@item.ChucVu</span>
                                </td>
                                <td style="text-align: center; vertical-align: middle">
                                    @if (item.TrangThai == "Kích hoạt")
                                    {
                                        <span class="label font-weight-bold label-lg label-light-success label-inline">Kích hoạt</span>
                                    }
                                    else
                                    {
                                        <span class="label font-weight-bold label-lg label-light-danger label-inline">Khóa</span>
                                    }
                                </td>
                                <td style="text-align: center; vertical-align: middle">
                                    @if (session != null && FuntionGlobal.CheckPermission(session, role ?? "", "Index"))
                                    {
                                        <button type="button" onclick="Show('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Xem chi tiết">
                                            <i class="icon-lg la la-eye text-primary"></i>
                                        </button>
                                    }
                                    @if (session != null && FuntionGlobal.CheckPermission(session, role ?? "", "Edit"))
                                    {
                                        <button type="button" onclick="Edit('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Chỉnh sửa">
                                            <i class="icon-lg la la-edit text-success"></i>
                                        </button>
                                    }
                                    @if (session != null && FuntionGlobal.CheckPermission(session, role ?? "", "Delete"))
                                    {
                                        <button type="button" class="btn btn-sm btn-clean btn-icon" title="Xóa"
                                                onclick="Delete('@item.Id', '@item.TenDv')">
                                            <i class="icon-lg la la-trash text-danger"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td style="text-align:center" colspan="9">Không tìm thấy thông tin!!!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!--end: Datatable-->
        <div id="Pagination">
            @await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
        </div>
    </div>
</div>
@await Html.PartialAsync("~/Views/Admin/ThamDinhGia/DanhMucDonVi/Modal.cshtml")
