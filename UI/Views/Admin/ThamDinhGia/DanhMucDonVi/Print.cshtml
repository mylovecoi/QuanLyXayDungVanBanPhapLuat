@model IEnumerable<DataAccess.Entities.ThamDinhGia.ThamDinhGiaDanhMucDonVi>

@{
    Layout = "_LayoutReport";
    int stt = 1;
}

<div style="margin: 15mm 15mm 20mm 20mm;">
    <div class="card-body">
        <div style="text-align: center; margin-bottom: 30px;">
            <h2 style="font-weight: bold; text-transform: uppercase;">DANH SÁCH DANH MỤC ĐƠN VỊ SỬ DỤNG</h2>
            @if (!string.IsNullOrEmpty(ViewData["Search"]?.ToString()))
            {
                <p style="font-style: italic; font-size: 13px; margin: 5px 0;">
                    Từ khóa tìm kiếm: @ViewData["Search"]
                </p>
            }
            <p>Ngày in: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
        </div>

        <table cellspacing="0" cellpadding="5" border="1" style="border-collapse: collapse; font-size: 14px; width: 100%;" id="data_render">
            <thead>
                <tr style="text-align: center; font-weight: bold; background-color: #f2f2f2;">
                    <th width="4%">#</th>
                    <th width="10%">Mã GCN</th>
                    <th width="20%">Tên đơn vị</th>
                    <th width="20%">Địa chỉ</th>
                    <th width="15%">Người đại diện</th>
                    <th width="15%">Số thẻ / Ngày cấp</th>
                    <th width="15%">Số QĐ / Ngày QĐ</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="text-align: center;">@(stt++)</td>
                            <td style="text-align: center;">@item.MaGCN</td>
                            <td style="font-weight: bold;">@item.TenDv</td>
                            <td>@item.DiaChi</td>
                            <td>
                                @item.NguoiDaiDien<br />
                                <small class="text-muted">@item.ChucVu</small>
                            </td>
                            <td style="text-align: center;">
                                @item.SoThe<br />
                                <small>@item.NgayCap.ToString("dd/MM/yyyy")</small>
                            </td>
                            <td style="text-align: center;">
                                @item.SoQd<br />
                                <small>@item.NgayQd.ToString("dd/MM/yyyy")</small>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="text-align: center; font-style: italic;">Không tìm thấy thông tin đơn vị nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
