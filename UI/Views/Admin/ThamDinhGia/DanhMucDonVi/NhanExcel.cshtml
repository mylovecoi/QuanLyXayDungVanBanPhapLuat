@{
    Layout = "_Layout";
}

@section custom_style {
    <style>
        .mapping-card {
            background-color: #f8f9fa;
            border-left: 4px solid #3699FF;
        }
        .preview-container {
            max-height: 400px;
            overflow-y: auto;
        }
    </style>
}

@section custom_script {
    <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>
    <script>
        let wb = null;
        let parsedData = [];

        $(document).ready(function () {
            $('#file_excel').on('change', handleFileSelect);
            $('#sheet_name, #row_start, #col_stt, #col_magcn, #col_tendv, #col_diachi, #col_rep, #col_chucvu, #col_sothe, #col_ngaycap, #col_soqd, #col_ngayqd').on('change', processExcelData);
            $('#btn_import').on('click', submitData);
        });

        function handleFileSelect(e) {
            const file = e.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function (e) {
                const data = new Uint8Array(e.target.result);
                try {
                    wb = XLSX.read(data, { type: 'array' });
                    
                    const sheetSelect = $('#sheet_name');
                    sheetSelect.empty();
                    wb.SheetNames.forEach((name, index) => {
                        sheetSelect.append(`<option value="${name}" ${index === 0 ? 'selected' : ''}>${name}</option>`);
                    });

                    $('#config_section').slideDown();
                    processExcelData();
                } catch (err) {
                    toastr.error("Không thể đọc file Excel: " + err.message);
                }
            };
            reader.readAsArrayBuffer(file);
        }

        const parseExcelDate = (val) => {
            if (!val) return new Date().toISOString().split('T')[0];
            // If number (Excel serial date)
            if (!isNaN(val)) {
                const date = new Date(Math.round((parseFloat(val) - 25569) * 86400 * 1000));
                return date.toISOString().split('T')[0];
            }
            // Parse standard string
            const d = new Date(val);
            if (!isNaN(d.getTime())) {
                return d.toISOString().split('T')[0];
            }
            // Custom DD/MM/YYYY parsing
            const parts = String(val).split(/[\/\-]/);
            if (parts.length === 3) {
                if (parts[2].length === 4) {
                    return `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;
                } else if (parts[0].length === 4) {
                    return `${parts[0]}-${parts[1].padStart(2, '0')}-${parts[2].padStart(2, '0')}`;
                }
            }
            return new Date().toISOString().split('T')[0];
        };

        function processExcelData() {
            if (!wb) return;

            const sheetName = $('#sheet_name').val();
            const ws = wb.Sheets[sheetName];
            if (!ws) return;

            const rowStart = parseInt($('#row_start').val()) || 2;
            
            const getColIndex = (colLetter) => {
                if (!colLetter) return -1;
                let col = colLetter.trim().toUpperCase();
                let index = 0;
                for (let i = 0; i < col.length; i++) {
                    index = index * 26 + (col.charCodeAt(i) - 64);
                }
                return index - 1;
            };

            const colSttIdx = getColIndex($('#col_stt').val());
            const colMaGcnIdx = getColIndex($('#col_magcn').val());
            const colTenDvIdx = getColIndex($('#col_tendv').val());
            const colDiaChiIdx = getColIndex($('#col_diachi').val());
            const colRepIdx = getColIndex($('#col_rep').val());
            const colChucVuIdx = getColIndex($('#col_chucvu').val());
            const colSoTheIdx = getColIndex($('#col_sothe').val());
            const colNgayCapIdx = getColIndex($('#col_ngaycap').val());
            const colSoQdIdx = getColIndex($('#col_soqd').val());
            const colNgayQdIdx = getColIndex($('#col_ngayqd').val());

            const range = XLSX.utils.decode_range(ws['!ref'] || "A1:A1");
            parsedData = [];

            for (let r = rowStart - 1; r <= range.e.r; r++) {
                const getCellValue = (cIdx) => {
                    if (cIdx < 0) return "";
                    const cellAddress = XLSX.utils.encode_cell({ r: r, c: cIdx });
                    const cell = ws[cellAddress];
                    return cell && cell.v !== undefined ? String(cell.v).trim() : "";
                };

                const tenDv = getCellValue(colTenDvIdx);
                const maGCN = getCellValue(colMaGcnIdx);
                
                if (tenDv || maGCN) {
                    parsedData.push({
                        STTSapXep: getCellValue(colSttIdx),
                        MaGCN: maGCN,
                        TenDv: tenDv,
                        DiaChi: getCellValue(colDiaChiIdx),
                        NguoiDaiDien: getCellValue(colRepIdx),
                        ChucVu: getCellValue(colChucVuIdx),
                        SoThe: getCellValue(colSoTheIdx),
                        NgayCap: parseExcelDate(getCellValue(colNgayCapIdx)),
                        SoQd: getCellValue(colSoQdIdx),
                        NgayQd: parseExcelDate(getCellValue(colNgayQdIdx)),
                        TrangThai: "Kích hoạt"
                    });
                }
            }

            renderPreview();
        }

        function renderPreview() {
            const tbody = $('#preview_tbody');
            tbody.empty();

            if (parsedData.length === 0) {
                tbody.append('<tr><td colspan="7" class="text-center text-muted">Không tìm thấy dữ liệu phù hợp với cấu hình mapping hiện tại</td></tr>');
                $('#btn_import').attr('disabled', true);
                $('#preview_card').slideUp();
                return;
            }

            const previewCount = Math.min(10, parsedData.length);
            for (let i = 0; i < previewCount; i++) {
                const item = parsedData[i];
                tbody.append(`
                    <tr>
                        <td>${item.STTSapXep || (i + 1)}</td>
                        <td class="font-weight-bold">${item.MaGCN}</td>
                        <td>${item.TenDv}</td>
                        <td>${item.DiaChi}</td>
                        <td>${item.NguoiDaiDien} (${item.ChucVu})</td>
                        <td>${item.SoThe} / ${item.NgayCap}</td>
                        <td>${item.SoQd} / ${item.NgayQd}</td>
                    </tr>
                `);
            }

            $('#total_rows_txt').text(`Tổng số dòng tìm thấy: ${parsedData.length} dòng.`);
            $('#btn_import').attr('disabled', false);
            $('#preview_card').slideDown();
        }

        function submitData() {
            if (parsedData.length === 0) return;

            const csrfToken = $('input[name="__RequestVerificationToken"]').val();
            
            $('#btn_import').attr('disabled', true).html('<span class="spinner spinner-white spinner-right mr-2"></span>Đang xử lý...');
            
            $.ajax({
                url: '@Url.Action("ImportExcel", "ThamDinhGiaDanhMucDonVi")',
                type: 'POST',
                contentType: 'application/json',
                headers: {
                    'RequestVerificationToken': csrfToken
                },
                data: JSON.stringify(parsedData),
                success: function (res) {
                    if (res.status === 'success') {
                        toastr.success(res.message);
                        setTimeout(() => {
                            window.location.href = '@Url.Action("Index", "ThamDinhGiaDanhMucDonVi")';
                        }, 1000);
                    } else {
                        toastr.error(res.message, "Lỗi!");
                        $('#btn_import').attr('disabled', false).html('<i class="la la-check"></i>Thực hiện nhận dữ liệu');
                    }
                },
                error: function (xhr, status, error) {
                    toastr.error("Đã xảy ra lỗi trong quá trình import dữ liệu!");
                    $('#btn_import').attr('disabled', false).html('<i class="la la-check"></i>Thực hiện nhận dữ liệu');
                }
            });
        }
    </script>
}

<div class="card card-custom">
    <div class="card-header">
        <div class="card-title">
            <h3 class="card-label">
                <b>@ViewData["Title"]</b>
                <span class="d-block text-muted pt-2 font-size-sm">
                    Nhập dữ liệu danh mục đơn vị sử dụng thẩm định giá từ file Excel
                </span>
            </h3>
        </div>
        <div class="card-toolbar">
            <a asp-controller="ThamDinhGiaDanhMucDonVi" asp-action="Index" class="btn btn-light-primary font-weight-bolder">
                <i class="la la-reply"></i>Quay lại
            </a>
        </div>
    </div>
    <div class="card-body">
        @Html.AntiForgeryToken()
        
        <!-- Step 1: File selection -->
        <div class="row mb-6">
            <div class="col-lg-6">
                <div class="form-group mb-0">
                    <label class="font-weight-bolder">Chọn file Excel dữ liệu:</label>
                    <div class="custom-file">
                        <input type="file" class="custom-file-input" id="file_excel" accept=".xlsx, .xls">
                        <label class="custom-file-label" for="file_excel">Chọn file...</label>
                    </div>
                    <span class="form-text text-muted">Hệ thống hỗ trợ định dạng file .xlsx, .xls</span>
                </div>
            </div>
        </div>

        <!-- Step 2: Configuration Mapping -->
        <div id="config_section" style="display: none;" class="card p-6 mapping-card mb-6">
            <h5 class="mb-4 text-primary font-weight-bold"><i class="la la-cog text-primary"></i> Cấu hình đọc File Excel</h5>
            <div class="row">
                <div class="col-lg-3 col-md-6 form-group">
                    <label>Sheet dữ liệu:</label>
                    <select class="form-control" id="sheet_name"></select>
                </div>
                <div class="col-lg-3 col-md-6 form-group">
                    <label>Dòng bắt đầu đọc:</label>
                    <input type="number" class="form-control" id="row_start" value="2" min="1" />
                </div>
            </div>

            <h6 class="mt-4 mb-3 font-weight-bold text-dark">Ánh xạ cột dữ liệu (Nhập ký tự chữ cái cột, ví dụ: A, B, C...)</h6>
            <div class="row">
                <div class="col-lg-2 col-md-4 form-group">
                    <label>Cột STT sắp xếp:</label>
                    <input type="text" class="form-control text-uppercase" id="col_stt" value="A" />
                </div>
                <div class="col-lg-2 col-md-4 form-group">
                    <label>Cột Mã GCN:</label>
                    <input type="text" class="form-control text-uppercase" id="col_magcn" value="B" />
                </div>
                <div class="col-lg-4 col-md-4 form-group">
                    <label>Cột Tên đơn vị sử dụng:</label>
                    <input type="text" class="form-control text-uppercase" id="col_tendv" value="C" />
                </div>
                <div class="col-lg-4 col-md-4 form-group">
                    <label>Cột Địa chỉ:</label>
                    <input type="text" class="form-control text-uppercase" id="col_diachi" value="D" />
                </div>
                <div class="col-lg-3 col-md-4 form-group">
                    <label>Cột Người đại diện:</label>
                    <input type="text" class="form-control text-uppercase" id="col_rep" value="E" />
                </div>
                <div class="col-lg-3 col-md-4 form-group">
                    <label>Cột Chức vụ:</label>
                    <input type="text" class="form-control text-uppercase" id="col_chucvu" value="F" />
                </div>
                <div class="col-lg-3 col-md-4 form-group">
                    <label>Cột Số thẻ TĐV:</label>
                    <input type="text" class="form-control text-uppercase" id="col_sothe" value="G" />
                </div>
                <div class="col-lg-3 col-md-4 form-group">
                    <label>Cột Ngày cấp thẻ:</label>
                    <input type="text" class="form-control text-uppercase" id="col_ngaycap" value="H" />
                </div>
                <div class="col-lg-3 col-md-4 form-group">
                    <label>Cột Số quyết định:</label>
                    <input type="text" class="form-control text-uppercase" id="col_soqd" value="I" />
                </div>
                <div class="col-lg-3 col-md-4 form-group">
                    <label>Cột Ngày quyết định:</label>
                    <input type="text" class="form-control text-uppercase" id="col_ngayqd" value="J" />
                </div>
            </div>
        </div>

        <!-- Step 3: Data Preview -->
        <div id="preview_card" style="display: none;" class="card card-custom card-border mb-6">
            <div class="card-header bg-light">
                <div class="card-title">
                    <h5 class="card-label text-dark font-weight-bold"><i class="la la-eye text-dark"></i> Xem trước dữ liệu (Tối đa 10 dòng đầu)</h5>
                </div>
                <div class="card-toolbar">
                    <span id="total_rows_txt" class="label label-lg label-inline label-light-info font-weight-bolder"></span>
                </div>
            </div>
            <div class="card-body p-0 preview-container">
                <table class="table table-striped table-hover m-0">
                    <thead class="thead-light">
                        <tr>
                            <th width="5%">#</th>
                            <th width="10%">Mã GCN</th>
                            <th width="20%">Tên đơn vị</th>
                            <th width="20%">Địa chỉ</th>
                            <th width="15%">Người đại diện</th>
                            <th width="15%">Số thẻ / Ngày cấp</th>
                            <th width="15%">Số QĐ / Ngày QĐ</th>
                        </tr>
                    </thead>
                    <tbody id="preview_tbody"></tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="card-footer text-center">
        <button type="button" class="btn btn-primary font-weight-bold" id="btn_import" disabled>
            <i class="la la-check"></i>Thực hiện nhận dữ liệu
        </button>
    </div>
</div>
