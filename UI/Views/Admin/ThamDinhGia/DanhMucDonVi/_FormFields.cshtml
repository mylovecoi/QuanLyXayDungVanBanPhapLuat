@model DataAccess.Entities.ThamDinhGia.ThamDinhGiaDanhMucDonVi
<div class="modal-body">
    @Html.AntiForgeryToken()
    <input hidden asp-for="Id" />
    <div class="row">
        <div class="col-xl-6">
            <div class="form-group fv-plugins-icon-container">
                <label style="font-weight:bold; color:blue">Tên đơn vị sử dụng <span class="text-danger">*</span></label>
                <input class="form-control" asp-for="TenDv" placeholder="Nhập tên đơn vị sử dụng" autofocus />
                <span id="TenDvError" class="text-danger"></span>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="form-group fv-plugins-icon-container">
                <label style="font-weight:bold; color:blue">Mã GCN <span class="text-danger">*</span></label>
                <input class="form-control" asp-for="MaGCN" placeholder="Nhập mã giấy chứng nhận" />
                <span id="MaGCNError" class="text-danger"></span>
            </div>
        </div>
        <div class="col-xl-12">
            <div class="form-group fv-plugins-icon-container">
                <label style="font-weight:bold; color:blue">Địa chỉ</label>
                <input class="form-control" asp-for="DiaChi" placeholder="Nhập địa chỉ đơn vị" />
            </div>
        </div>
        <div class="col-xl-6">
            <div class="form-group fv-plugins-icon-container">
                <label style="font-weight:bold; color:blue">Người đại diện</label>
                <input class="form-control" asp-for="NguoiDaiDien" placeholder="Nhập tên người đại diện" />
            </div>
        </div>
        <div class="col-xl-6">
            <div class="form-group fv-plugins-icon-container">
                <label style="font-weight:bold; color:blue">Chức vụ</label>
                <input class="form-control" asp-for="ChucVu" placeholder="Nhập chức vụ" />
            </div>
        </div>
        <div class="col-xl-6">
            <div class="form-group fv-plugins-icon-container">
                <label style="font-weight:bold; color:blue">Số thẻ thẩm định viên</label>
                <input class="form-control" asp-for="SoThe" placeholder="Nhập số thẻ" />
            </div>
        </div>
        <div class="col-xl-6">
            <div class="form-group fv-plugins-icon-container">
                <label style="font-weight:bold; color:blue">Ngày cấp thẻ</label>
                <input type="date" class="form-control" asp-for="NgayCap" value="@Model.NgayCap.ToString("yyyy-MM-dd")" />
            </div>
        </div>
        <div class="col-xl-6">
            <div class="form-group fv-plugins-icon-container">
                <label style="font-weight:bold; color:blue">Số quyết định</label>
                <input class="form-control" asp-for="SoQd" placeholder="Nhập số quyết định thành lập / bổ nhiệm" />
            </div>
        </div>
        <div class="col-xl-6">
            <div class="form-group fv-plugins-icon-container">
                <label style="font-weight:bold; color:blue">Ngày quyết định</label>
                <input type="date" class="form-control" asp-for="NgayQd" value="@Model.NgayQd.ToString("yyyy-MM-dd")" />
            </div>
        </div>
        <div class="col-xl-6">
            <div class="form-group fv-plugins-icon-container">
                <label style="font-weight:bold; color:blue">STT Sắp xếp</label>
                <input class="form-control" asp-for="STTSapXep" placeholder="Nhập số thứ tự sắp xếp" />
            </div>
        </div>
        <div class="col-xl-6">
            <div class="form-group fv-plugins-icon-container">
                <label style="font-weight:bold; color:blue">Trạng thái</label>
                <select class="form-control w-100" asp-for="TrangThai">
                    <!option value="Kích hoạt" @(Model.TrangThai == "Kích hoạt" ? "selected" : "")>Kích hoạt</!option>
                    <!option value="Khóa" @(Model.TrangThai == "Khóa" ? "selected" : "")>Khóa</!option>
                </select>
            </div>
        </div>
    </div>
</div>
