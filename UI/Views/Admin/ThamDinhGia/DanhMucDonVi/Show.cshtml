@model DataAccess.Entities.ThamDinhGia.ThamDinhGiaDanhMucDonVi

<div class="row">
    <div class="col-xl-6 mb-4">
        <div class="form-group mb-0">
            <label style="font-weight:bold; color:blue" class="d-block">Tên đơn vị sử dụng:</label>
            <span class="font-weight-bold font-size-lg text-dark">@Model.TenDv</span>
        </div>
    </div>
    <div class="col-xl-6 mb-4">
        <div class="form-group mb-0">
            <label style="font-weight:bold; color:blue" class="d-block">Mã GCN:</label>
            <span class="font-weight-bold text-dark">@Model.MaGCN</span>
        </div>
    </div>
    <div class="col-xl-12 mb-4">
        <div class="form-group mb-0">
            <label style="font-weight:bold; color:blue" class="d-block">Địa chỉ:</label>
            <span class="font-weight-bold text-dark">@Model.DiaChi</span>
        </div>
    </div>
    <div class="col-xl-6 mb-4">
        <div class="form-group mb-0">
            <label style="font-weight:bold; color:blue" class="d-block">Người đại diện:</label>
            <span class="font-weight-bold text-dark">@Model.NguoiDaiDien</span>
        </div>
    </div>
    <div class="col-xl-6 mb-4">
        <div class="form-group mb-0">
            <label style="font-weight:bold; color:blue" class="d-block">Chức vụ:</label>
            <span class="font-weight-bold text-dark">@Model.ChucVu</span>
        </div>
    </div>
    <div class="col-xl-6 mb-4">
        <div class="form-group mb-0">
            <label style="font-weight:bold; color:blue" class="d-block">Số thẻ thẩm định viên:</label>
            <span class="font-weight-bold text-dark">@Model.SoThe</span>
        </div>
    </div>
    <div class="col-xl-6 mb-4">
        <div class="form-group mb-0">
            <label style="font-weight:bold; color:blue" class="d-block">Ngày cấp thẻ:</label>
            <span class="font-weight-bold text-dark">@Model.NgayCap.ToString("dd/MM/yyyy")</span>
        </div>
    </div>
    <div class="col-xl-6 mb-4">
        <div class="form-group mb-0">
            <label style="font-weight:bold; color:blue" class="d-block">Số quyết định:</label>
            <span class="font-weight-bold text-dark">@Model.SoQd</span>
        </div>
    </div>
    <div class="col-xl-6 mb-4">
        <div class="form-group mb-0">
            <label style="font-weight:bold; color:blue" class="d-block">Ngày quyết định:</label>
            <span class="font-weight-bold text-dark">@Model.NgayQd.ToString("dd/MM/yyyy")</span>
        </div>
    </div>
    <div class="col-xl-6 mb-4">
        <div class="form-group mb-0">
            <label style="font-weight:bold; color:blue" class="d-block">STT Sắp xếp:</label>
            <span class="font-weight-bold text-dark">@Model.STTSapXep</span>
        </div>
    </div>
    <div class="col-xl-6 mb-4">
        <div class="form-group mb-0">
            <label style="font-weight:bold; color:blue" class="d-block">Trạng thái:</label>
            <span>
                @if (Model.TrangThai == "Kích hoạt")
                {
                    <span class="label font-weight-bold label-lg label-light-success label-inline">Kích hoạt</span>
                }
                else
                {
                    <span class="label font-weight-bold label-lg label-light-danger label-inline">Khóa</span>
                }
            </span>
        </div>
    </div>
</div>
