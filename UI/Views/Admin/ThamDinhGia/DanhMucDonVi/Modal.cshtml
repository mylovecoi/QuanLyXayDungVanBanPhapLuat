<!--Create-Modal-->
<div class="modal fade" id="Create_Modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="card-label">
                    <b>@ViewData["Title"]?.ToString()?.ToUpper()</b>
                    <span class="d-block text-muted pt-2 font-size-sm">Thêm mới @ViewData["Title"]</span>
                </h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <form asp-controller="ThamDinhGiaDanhMucDonVi" asp-action="Store" method="post" id="frm_create">
            </form>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary font-weight-bold" onclick="Store()">Thêm mới</button>
            </div>
        </div>
    </div>
</div>

<!--Edit-Modal-->
<div class="modal fade" id="Edit_Modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="card-label">
                    <b>@ViewData["Title"]?.ToString()?.ToUpper()</b>
                    <span class="d-block text-muted pt-2 font-size-sm">Cập nhật @ViewData["Title"]</span>
                </h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <form asp-controller="ThamDinhGiaDanhMucDonVi" asp-action="Update" method="post" id="frm_edit">
            </form>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary font-weight-bold" onclick="Update()">Cập nhật</button>
            </div>
        </div>
    </div>
</div>

<!--Delete-Modal-->
<div class="modal fade" id="Delete_Modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="card-label">
                    @ViewData["Title"]
                    <span class="d-block text-muted pt-2 font-size-sm">Đồng ý xóa @ViewData["Title"] ?</span>
                </h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <form asp-controller="ThamDinhGiaDanhMucDonVi" asp-action="Delete" method="post" id="frm_delete">
                <div class="modal-body">
                    <div class="form-group fv-plugins-icon-container">
                        <label id="titleDelete">
                            Bạn có chắc chắn muốn xóa thông tin này?
                        </label>
                        @Html.AntiForgeryToken()
                    </div>
                    <input hidden id="id_delete" name="id_delete" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light-primary font-weight-bold" data-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger font-weight-bold">Xóa</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!--Show-Modal-->
<div class="modal fade" id="Show_Modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="card-label">
                    @ViewData["Title"]
                    <span class="d-block text-muted pt-2 font-size-sm">Chi tiết @ViewData["Title"]</span>
                </h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body" id="frm_show">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-primary font-weight-bold" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<script>
    function Create() {
        $.ajax({
            url: '@Url.Action("Create", "ThamDinhGiaDanhMucDonVi")',
            type: 'GET',
            success: function (data) {
                if (data) {
                    $('#frm_create').html(data);
                    $('#Create_Modal').modal('show');
                }
            },
            error: function (xhr, status, error) {
                toastr.error("Không thể tải thông tin", "Lỗi!");
            }
        });
    }

    function Store() {
        var form = document.getElementById('frm_create');
        if (!form) {
            console.error('Không tìm thấy thông tin.');
            return;
        }

        if (validateFormFields(form)) {
            form.submit();
        } else {
            toastr.warning('Vui lòng điền đầy đủ các thông tin bắt buộc.', 'Chú ý!');
        }
    }

    function Edit(id) {
        const csrfToken = $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url: '@Url.Action("Edit", "ThamDinhGiaDanhMucDonVi")',
            type: 'POST',
            headers: {
                'RequestVerificationToken': csrfToken
            },
            data: {
                Id: id,
            },
            success: function (data) {
                $('#frm_edit').html(data);
                $('#Edit_Modal').modal('show');
            },
            error: function () {
                toastr.error("Không thể tải dữ liệu!", "Lỗi!");
            }
        })
    }

    function Update() {
        var form = document.getElementById('frm_edit');
        if (!form) {
            console.error('Không tìm thấy thông tin.');
            return;
        }

        if (validateFormFields(form)) {
            form.submit();
        } else {
            toastr.warning('Vui lòng điền đầy đủ các thông tin bắt buộc.', 'Chú ý!');
        }
    }

    function validateFormFields(form) {
        var fields = [
            { id: 'TenDv', message: 'Tên đơn vị không được bỏ trống' },
            { id: 'MaGCN', message: 'Mã GCN không được bỏ trống' }
        ];

        var isValid = true;

        fields.forEach(function (field) {
            var inputElement = form.querySelector('#' + field.id);
            if (!inputElement) {
                return;
            }

            var errorElement = form.querySelector('#' + field.id + 'Error');
            if (!errorElement) {
                errorElement = document.createElement('span');
                errorElement.id = field.id + 'Error';
                errorElement.className = 'text-danger';
                inputElement.parentNode.appendChild(errorElement);
            }

            if (inputElement.value.trim() === '') {
                isValid = false;
                inputElement.style.border = '1px solid red';
                errorElement.textContent = field.message;
            } else {
                inputElement.style.border = '';
                errorElement.textContent = '';
            }
        });

        return isValid;
    }

    function Delete(id, tenDv) {
        $('#id_delete').val(id);
        $('#titleDelete').text('Bạn có chắc chắn muốn xóa đơn vị "' + tenDv + '"?');
        $('#Delete_Modal').modal('show');
    }

    function Show(id) {
        const csrfToken = $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url: '@Url.Action("Show", "ThamDinhGiaDanhMucDonVi")',
            type: 'POST',
            headers: {
                'RequestVerificationToken': csrfToken
            },
            data: {
                Id: id,
            },
            success: function (data) {
                $('#frm_show').html(data);
                $('#Show_Modal').modal('show');
            },
            error: function () {
                toastr.error("Không thể tải dữ liệu!", "Lỗi!");
            }
        })
    }
</script>
