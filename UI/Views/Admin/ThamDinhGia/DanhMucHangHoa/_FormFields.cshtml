@model DataAccess.Entities.ThamDinhGia.ThamDinhGiaDanhMucHangHoa

<input type="hidden" asp-for="Id" />
<div class="row">
    <div class="col-xl-12">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Tên danh mục hàng hóa:</label>
            <input type="text" class="form-control" asp-for="TenDanhMucHangHoa" required />
        </div>
    </div>
    <div class="col-xl-12">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Trạng thái:</label>
            <select class="form-control" asp-for="TrangThai">
                <option value="Kích hoạt">Kích hoạt</option>
                <option value="Khóa">Khóa</option>
            </select>
        </div>
    </div>
</div>
