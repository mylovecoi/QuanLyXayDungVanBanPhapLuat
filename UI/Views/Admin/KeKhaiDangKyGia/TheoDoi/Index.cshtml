@using Services.DTOs.KeKhaiDangKyGia;
@using DataAccess.Entities.Settings;
@using DataAccess.Entities.KeKhaiDangKyGia;
@model VMPageInfoWithData<DataAccess.Entities.KeKhaiDangKyGia.KeKhaiDangKyGia>
@{
    ViewData["PageInfo"] = Model;
    var session = HttpContextAccessor?.HttpContext?.Session ?? null;
    string role = ViewData["Role"] as string ?? "";
    var listDonVi = ViewData["DanhMucDonVi"] as List<DanhMucDonVi> ?? [];
    var listKinhDoanhNganh = ViewData["DanhMucKinhDoanhNganh"] as List<DanhMucKinhDoanh> ?? [];
    var listKinhDoanhNghe = ViewData["DanhMucKinhDoanhNghe"] as List<DanhMucKinhDoanh> ?? [];
    int record_id = Model.RecordStart;

    int targetYear = (int)(ViewData["Year"] ?? DateTime.Now.Year);
    string selectedDonVi = ViewData["SelectedDonVi"] as string ?? "all";
    string selectedMaNghe = ViewData["SelectedMaNghe"] as string ?? "all";
    string selectedTrangThai = ViewData["SelectedTrangThai"] as string ?? "all";
    string search = ViewData["Search"] as string ?? "";
}

<div class="card card-custom">
    <div class="card-header flex-nowrap border-0 pt-6 pb-0">
        <div class="card-title" style="min-width: 0; flex: 1;">
            <h3 class="card-label" style="text-overflow: ellipsis; overflow: hidden; white-space: nowrap; width: 100%;">
                <b title="@ViewData["Title"]?.ToString()?.ToUpper()">@ViewData["Title"]?.ToString()?.ToUpper()</b>
            </h3>
        </div>
    </div>

    <div class="card-body pt-0">
        <form id="FilterForm" method="GET" action="/KeKhaiDangKyGiaTheoDoi">
            <div class="row">
                <div class="col-xl-3">
                    <div class="form-group fv-plugins-icon-container">
                        <label style="font-weight:bold; color:blue">Năm:</label>
                        <select class="form-control h-40px" name="Year" id="TargetYear_Select" onchange="$('#FilterForm').submit()">
                            @for (int year = DateTime.Now.Year - 5; year <= DateTime.Now.Year; year++)
                            {
                                <!option value="@year" @(targetYear == year ? "selected" : "")>Năm @year</!option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-xl-3">
                    <div class="form-group fv-plugins-icon-container">
                        <label style="font-weight:bold; color:blue">Đơn vị nhận hồ sơ:</label>
                        <select class="form-control h-40px" name="DonViQuanLyId" id="DonViQuanLyId_Select" onchange="$('#FilterForm').submit()">
                            <!option value="all" @(selectedDonVi == "all" ? "selected" : "")>-- Tất cả đơn vị --</!option>
                            @foreach (var dv in listDonVi)
                            {
                                <!option value="@dv.Id" @(selectedDonVi == dv.Id.ToString() ? "selected" : "")>@dv.TenDonVi</!option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-xl-3">
                    <div class="form-group fv-plugins-icon-container">
                        <label style="font-weight:bold; color:blue">Trạng thái:</label>
                        <select class="form-control h-40px" name="TrangThai" id="TrangThai_Select" onchange="$('#FilterForm').submit()">
                            <!option value="all" @(selectedTrangThai == "all" ? "selected" : "")>-- Tất cả trạng thái --</!option>
                            <!option value="CD" @(selectedTrangThai == "CD" ? "selected" : "")>Chờ duyệt</!option>
                            <!option value="DD" @(selectedTrangThai == "DD" ? "selected" : "")>Đã duyệt</!option>
                            <!option value="CB" @(selectedTrangThai == "CB" ? "selected" : "")>Công bố</!option>
                            <!option value="HCB" @(selectedTrangThai == "HCB" ? "selected" : "")>Hủy công bố</!option>
                        </select>
                    </div>
                </div>
                <div class="col-xl-3">
                    <div class="form-group fv-plugins-icon-container">
                        <label style="font-weight:bold; color:blue">Nghề kinh doanh:</label>
                        <select class="form-control h-40px" name="MaNghe" id="MaNghe_Select" onchange="$('#FilterForm').submit()">
                            <!option value="all" @(selectedMaNghe == "all" ? "selected" : "")>-- Tất cả nghề kinh doanh --</!option>
                            @foreach (var nganh in listKinhDoanhNganh)
                            {
                                <optgroup label="@nganh.TenNghe">
                                    @{
                                        var listNgheTheoNganh = listKinhDoanhNghe.Where(t => t.MaNganh == nganh.MaNghe).ToList();
                                    }
                                    @foreach (var nghe in listNgheTheoNganh)
                                    {
                                        <!option value="@nghe.MaNghe" @(selectedMaNghe == nghe.MaNghe ? "selected" : "")>@nghe.TenNghe</!option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="col-xl-3" style="text-align:left">
                    <div class="form-group fv-plugins-icon-container">
                        <label class="text-blue">Hiển thị</label>
                        <select class="form-control h-40px" name="PageSize" id="PageSize_Select" onchange="$('#FilterForm').submit()">
                            <!option value="5" @(Model.PageSize == 5 ? "selected" : "")>5 thông tin</!option>
                            <!option value="10" @(Model.PageSize == 10 ? "selected" : "")>10 thông tin</!option>
                            <!option value="20" @(Model.PageSize == 20 ? "selected" : "")>20 thông tin</!option>
                            <!option value="50" @(Model.PageSize == 50 ? "selected" : "")>50 thông tin</!option>
                            <!option value="100" @(Model.PageSize == 100 ? "selected" : "")>100 thông tin</!option>
                        </select>
                    </div>
                </div>
                <div class="col-xl-9">
                    <div class="form-group fv-plugins-icon-container">
                        <label class="text-blue">Tìm kiếm</label>
                        <div class="input-group">
                            <input class="form-control h-40px" name="Search" id="txt_Search" placeholder="Tìm kiếm theo số quyết định, ghi chú..." value="@search">
                            <div class="input-group-prepend">
                                <button class="btn btn-danger" type="button" onclick="ClearTxtSearch()"><i class="las la-times-circle"></i></button>
                            </div>
                            <div class="input-group-append">
                                <button class="btn btn-primary" type="submit"><i class="las la-search"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <input hidden id="sort_current" name="sort_current" value="@Model.Sort" />
            <input hidden id="PageCurrent" name="PageCurrent" value="@Model.PageCurrent" />
        </form>
        <!--begin: Datatable-->
        <div class="table-responsive border rounded-lg mb-8">
            <table class="table table-striped table-hover table-responsive-lg rounded-lg m-0">
                <thead class="thead-light">
                    <tr style="text-align:center;" class="table-active">
                        <th width="5%">#</th>
                        <th style="font-weight: bold;">Tên hồ sơ</th>
                        <th width="12%" style="font-weight: bold;">Ngày gửi hồ sơ</th>
                        <th style="font-weight: bold;">Doanh nghiệp gửi hồ sơ</th>
                        <th style="font-weight: bold;">Đơn vị nhận hồ sơ</th>
                        <th width="12%" style="font-weight: bold;">Trạng thái</th>
                        <th width="8%" style="font-weight: bold;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Data != null && Model.Data.Any())
                    {
                        foreach (var item in Model.Data)
                        {
                            var donVi = listDonVi.FirstOrDefault(d => d.Id == item.DonViQuanLyId);
                            var ngheKinhDoanh = listKinhDoanhNghe.FirstOrDefault(x => x.MaNghe == item.MaNghe);
                            string tenNghe = ngheKinhDoanh?.TenNghe ?? "";
                            string tenHoSo = "Kê khai giá " + tenNghe;
                            if (!string.IsNullOrEmpty(item.SoQd))
                            {
                                tenHoSo += " - Số QĐ: " + item.SoQd;
                            }
                            
                            <tr class="@FuntionGlobal.GetClassTableWithStatus(item.TrangThai)">
                                <td class="text-center" style="vertical-align: middle">
                                    @(record_id++)
                                </td>
                                <td style="vertical-align: middle">
                                    <strong>@tenHoSo</strong>
                                </td>
                                <td class="text-center text-nowrap text-primary font-weight-boldest" style="vertical-align: middle">
                                    @(item.NgayChuyen != DateTime.MinValue ? FuntionGlobal.ConvertDateTimeToStr(item.NgayChuyen) : "")
                                </td>
                                <td style="vertical-align: middle">
                                    <strong>@item.DoanhNghiepQuanLy?.TenDoanhNghiep</strong>
                                </td>
                                <td style="vertical-align: middle">
                                    @(donVi?.TenDonVi ?? "")
                                </td>
                                <td class="text-center text-nowrap" style="vertical-align: middle">
                                    @if (item.TrangThai == "CD")
                                    {
                                        <span class="label label-lg label-inline font-weight-bolder label-warning">Chờ duyệt</span>
                                    }
                                    else if (item.TrangThai == "DD")
                                    {
                                        <span class="label label-lg label-inline font-weight-bolder label-success">Đã duyệt</span>
                                    }
                                    else if (item.TrangThai == "CB")
                                    {
                                        <span class="label label-lg label-inline font-weight-bolder label-primary">Công bố</span>
                                    }
                                    else if (item.TrangThai == "HCB")
                                    {
                                        <span class="label label-lg label-inline font-weight-bolder label-danger">Hủy công bố</span>
                                    }
                                    else
                                    {
                                        <span class="label label-lg label-inline font-weight-bolder label-secondary">@item.TrangThai</span>
                                    }
                                </td>
                                <td class="text-center text-nowrap" style="vertical-align: middle">
                                    <a class="btn btn-sm btn-clean btn-icon" title="Xem chi tiết" target="_blank"
                                       asp-controller="KeKhaiDangKyGia" asp-action="Show" asp-route-id="@item.Id">
                                        <i class="icon-lg la la-eye text-success"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td style="text-align:center" colspan="7">Không tìm thấy thông tin!!!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!--end: Datatable-->
        <div id="Pagination">
            @await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
        </div>
    </div>
</div>

@section custom_style {
}

@section custom_script {
    <script src="~/js/site.js"></script>
    <script>
        $(document).ready(function () {
            SetupSelect2('#TargetYear_Select', 'Lựa Chọn Năm', { enableSearch: false, enableClear: false });
            SetupSelect2('#DonViQuanLyId_Select', 'Lựa Chọn Đơn Vị Nhận Hồ Sơ', { enableSearch: true, enableClear: false });
            SetupSelect2('#TrangThai_Select', 'Lựa Chọn Trạng Thái', { enableSearch: false, enableClear: false });
            SetupSelect2('#MaNghe_Select', 'Lựa Chọn Nghề Kinh Doanh', { enableSearch: true, enableClear: false });
            HandleRegisterFormFilter('#FilterForm', '#Pagination', '/KeKhaiDangKyGiaTheoDoi');
        });

        function ClearTxtSearch() {
            $('#txt_Search').val('');
            $('#FilterForm').submit();
        }
    </script>
}
