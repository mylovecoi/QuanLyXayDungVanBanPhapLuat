@using DataAccess.Entities.KeKhaiDangKyGia;
@{
    var dsDoanhNghiep = ViewData["DanhSachDoanhNghiep"] as List<DoanhNghiep> ?? new List<DoanhNghiep>();
}

<div class="card card-custom">
    <div class="card-header flex-nowrap border-0 pt-6 pb-0">
        <div class="card-title" style="min-width: 0; flex: 1;">
            <h3 class="card-label" style="text-overflow: ellipsis; overflow: hidden; white-space: nowrap; width: 100%;">
                <b title="THÔNG TIN DOANH NGHIỆP">THÔNG TIN DOANH NGHIỆP</b>
                @* <span class="d-block text-muted pt-2 font-size-sm" style="text-overflow: ellipsis; overflow: hidden; white-space: nowrap;" title="Xem thông tin hồ sơ và lĩnh vực kinh doanh của doanh nghiệp">
                    Xem thông tin hồ sơ và lĩnh vực kinh doanh của doanh nghiệp
                </span> *@
            </h3>
        </div>
    </div>

    <div class="card-body pt-0">
        <div class="row">
            <div class="col-xl-6">
                <div class="form-group fv-plugins-icon-container">
                    <label style="font-weight:bold; color:blue">Doanh nghiệp:</label>
                    <select class="form-control select2basic h-40px" name="DoanhNghiepId" id="DoanhNghiep_Select" style="width: 100%">
                        <option value="">-- Chọn doanh nghiệp --</option>
                        @foreach (var item in dsDoanhNghiep)
                        {
                            <option value="@item.Id">@item.TenDoanhNghiep</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <hr />
        
        <!-- Container dynamic detail content -->
        <div id="doanhnghiep_detail_container">
            <div class="alert alert-custom alert-light-primary fade show mb-5" role="alert">
                <div class="alert-icon">
                    <i class="flaticon-warning"></i>
                </div>
                <div class="alert-text font-weight-bold">
                    Vui lòng chọn một doanh nghiệp từ danh sách trên để xem chi tiết hồ sơ.
                </div>
            </div>
        </div>
    </div>
</div>

@section custom_script {
    <script>
        $(document).ready(function () {
            // Khởi tạo Select2 cho doanh nghiệp
            $('#DoanhNghiep_Select').select2({
                placeholder: "-- Chọn doanh nghiệp --",
                allowClear: true
            }).on('change', function () {
                var selectedId = $(this).val();
                if (selectedId) {
                    LoadDoanhNghiepDetail(selectedId);
                } else {
                    $('#doanhnghiep_detail_container').html(
                        '<div class="alert alert-custom alert-light-primary fade show mb-5" role="alert">' +
                        '    <div class="alert-icon"><i class="flaticon-warning"></i></div>' +
                        '    <div class="alert-text font-weight-bold">Vui lòng chọn một doanh nghiệp từ danh sách trên để xem chi tiết hồ sơ.</div>' +
                        '</div>'
                    );
                }
            });
        });

        function LoadDoanhNghiepDetail(id) {
            // Hiển thị loading spinner hoặc văn bản đang tải
            $('#doanhnghiep_detail_container').html(
                '<div class="d-flex align-items-center justify-content-center p-20">' +
                '    <div class="spinner spinner-primary spinner-lg mr-5"></div>' +
                '    <span class="text-muted font-weight-bold">Đang tải dữ liệu doanh nghiệp...</span>' +
                '</div>'
            );

            $.ajax({
                url: '/DoanhNghiep/ThongTin/GetDetail',
                type: 'POST',
                data: { id: id },
                dataType: 'JSON',
                success: function (res) {
                    if (res.status == 'success') {
                        $('#doanhnghiep_detail_container').html(res.message);
                    } else {
                        toastr.error(res.message, "Lỗi!");
                        $('#doanhnghiep_detail_container').html(
                            '<div class="alert alert-custom alert-light-danger fade show mb-5" role="alert">' +
                            '    <div class="alert-text font-weight-bold">' + res.message + '</div>' +
                            '</div>'
                        );
                    }
                },
                error: function () {
                    toastr.error('Có lỗi xảy ra khi tải dữ liệu từ máy chủ.', 'Lỗi hệ thống');
                }
            });
        }
    </script>
}
