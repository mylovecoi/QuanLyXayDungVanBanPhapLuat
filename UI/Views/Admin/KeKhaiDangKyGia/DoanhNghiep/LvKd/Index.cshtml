@using DataAccess.Entities.KeKhaiDangKyGia;
@using DataAccess.Entities.Settings;
@{
    int record_id = 1;
    var listKinhDoanhNganh = ViewData["DanhMucNganhKd"] as IEnumerable<DanhMucKinhDoanh> ?? new List<DanhMucKinhDoanh>();
    var listKinhDoanhNghe = ViewData["DanhMucKinhDoanh"] as IEnumerable<DanhMucKinhDoanh> ?? new List<DanhMucKinhDoanh>();
    var dsdonvi = ViewData["DanhMucDonVi"] as IEnumerable<DanhMucDonVi> ?? new List<DanhMucDonVi>();
    var lvkd = ViewData["DoanhNghiepLvKd"] as IEnumerable<DoanhNghiepLvKd> ?? new List<DoanhNghiepLvKd>();
}

<div id="lvkd_data">
<div class="card card-custom" style="border: 1px solid #60aee4;">
    <div class="card-header flex-nowrap border-0 pt-6 pb-0">
        <div class="card-title" style="min-width: 0; flex: 1;">
            <span class="card-label" style="text-overflow: ellipsis; overflow: hidden; white-space: nowrap; width: 100%;" title="Danh sách lĩnh vực kinh doanh đăng ký">Danh sách lĩnh vực kinh doanh đăng ký</span>
        </div>
        <div class="card-toolbar" style="flex-shrink: 0;">
            <button type="button" class="btn btn-primary font-weight-bolder" title="Create" onclick="add_lvkd()">
                <i class="la la-plus"></i>Thêm mới
            </button>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-striped table-bordered table-hover">
            <thead>
                <tr style="text-align:center">
                    <th width="5%">#</th>
                    <th>Tên nghề kinh doanh</th>
                    <th>Đơn vị nhận hồ sơ</th>
                    <th width="15%">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in lvkd)
                {
                    var nghe = listKinhDoanhNghe.FirstOrDefault(x => x.MaNghe == item.MaNghe);
                    <tr>
                        <td style="text-align:center">@(record_id++)</td>
                        <td style="font-weight:bold">@nghe?.TenNghe</td>
                        <td style="text-align:center">
                            @(dsdonvi.FirstOrDefault(x => x.Id == item.DonViQuanLyId)?.TenDonVi ?? "")
                        </td>
                        <td style="text-align:center">
                            <button type="button" data-target="#Edit_Lvkd_Modal" data-toggle="modal"
                                    onclick="SetEditLvkd('@item.Id')"
                                    class="btn btn-sm btn-clean btn-icon" title="Chỉnh sửa">
                                <i class="icon-lg la la-edit text-primary"></i>
                            </button>
                            <button type="button" data-target="#Delete_Lvkd_Modal" data-toggle="modal"
                                    onclick="GetDeleteLvkd('@item.Id', '@(nghe?.TenNghe ?? "")')"
                                    class="btn btn-sm btn-clean btn-icon" title="Xóa">
                                <i class="icon-lg la la-trash text-danger"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
</div>

<script>
    function AjaxGetDvNhanHs() {
        $.ajax({
            url: '/Ajax/GetDvNhanHs',
            type: 'POST',
            data: {
                MaNghe: $('#manghe_create').val(),
                KeySelect: 'madvhs_create'
            },
            dataType: 'JSON',
            success: function (data) {
                if (data.status == 'success') {
                    $('#madvhs_create').html(data.message).trigger('change');
                } else {
                    toastr.error(data.message, "Lỗi!");
                    $('#madvhs_create').html('<option value="">--Chọn đơn vị nhận hồ sơ--</option>').trigger('change');
                }
            }
        })
    }

    function AjaxGetDvNhanHsEdit() {
        $.ajax({
            url: '/Ajax/GetDvNhanHs',
            type: 'POST',
            data: {
                MaNghe: $('#manghe_edit').val(),
                KeySelect: 'madvhs_edit'
            },
            dataType: 'JSON',
            success: function (data) {
                if (data.status == 'success') {
                    $('#madvhs_edit').html(data.message).trigger('change');
                } else {
                    toastr.error(data.message, "Lỗi!");
                    $('#madvhs_edit').html('<option value="">--Chọn đơn vị nhận hồ sơ--</option>').trigger('change');
                }
            }
        })
    }

    $(document).ready(function() {
        $('#MaSoThue').on('change', function() {
            var maSoThue = $(this).val();
            if (maSoThue) {
                $.ajax({
                    url: '/DoanhNghiep/DangKy/Lvkd/CheckMaSoThue',
                    type: 'POST',
                    data: { MaSoThue: maSoThue },
                    dataType: 'JSON',
                    success: function (data) {
                        if (data.status == 'success') {
                            $('#lvkd_data').replaceWith(data.message);
                            $('#listcoquanxetduyet_data').replaceWith(data.message2);
                        } else {
                            toastr.error(data.message, "Lỗi!");
                            // Clear sectors list table content if duplicate tax code
                            $('#lvkd_data').replaceWith('<div id="lvkd_data"><div class="card card-custom" style="border: 1px solid #60aee4;"><div class="card-header flex-nowrap border-0 pt-6 pb-0"><div class="card-title" style="min-width: 0; flex: 1;"><span class="card-label" style="text-overflow: ellipsis; overflow: hidden; white-space: nowrap; width: 100%;" title="Danh sách lĩnh vực kinh doanh đăng ký">Danh sách lĩnh vực kinh doanh đăng ký</span></div><div class="card-toolbar" style="flex-shrink: 0;"><button type="button" class="btn btn-primary font-weight-bolder" title="Create" onclick="add_lvkd()"><i class="la la-plus"></i>Thêm mới</button></div></div><div class="card-body"><table class="table table-striped table-bordered table-hover"><thead><tr style="text-align:center"><th width="5%">#</th><th>Tên nghề kinh doanh</th><th>Đơn vị nhận hồ sơ</th><th width="15%">Thao tác</th></tr></thead><tbody></tbody></table></div></div></div>');
                        }
                    }
                });
            }
        });
    });

    function add_lvkd() {
        var maSoThue = $('#MaSoThue').val();
        if (maSoThue == '' || maSoThue == null) {
            toastr.error('Mã số thuế không được bỏ trống.', 'Lỗi mã số thuế');
            $('#MaSoThue').focus();
        } else {
            $.ajax({
                url: '/DoanhNghiep/DangKy/Lvkd/CheckMaSoThue',
                type: 'POST',
                data: { MaSoThue: maSoThue },
                dataType: 'JSON',
                success: function (data) {
                    if (data.status == 'success') {
                        $('#lvkd_data').replaceWith(data.message);
                        $('#listcoquanxetduyet_data').replaceWith(data.message2);

                        $('#Create_Lvkd_Modal').modal("show");
                        // Initialize select2 inside modal
                        $('#manghe_create').select2({
                            dropdownParent: $('#Create_Lvkd_Modal')
                        }).on('change', function () {
                            AjaxGetDvNhanHs();
                        });
                        $('#madvhs_create').select2({
                            dropdownParent: $('#Create_Lvkd_Modal')
                        });
                    } else {
                        toastr.error(data.message, "Lỗi!");
                    }
                }
            });
        }
    }

    function SetStoreLvkd() {
        if (document.getElementById("madvhs_create").value == '') {
            toastr.error("Đơn vị nhận hồ sơ không được để trống!!!", "Lỗi!");
        } else {
            $.ajax({
                url: '/DoanhNghiep/DangKy/Lvkd/Store',
                type: 'POST',
                data: {
                    MaNghe: $('#manghe_create').val(),
                    DonViQuanLyId: $('#madvhs_create').val(),
                    MaSoThue: $('#MaSoThue').val(),
                },
                dataType: 'JSON',
                success: function (data) {
                    if (data.status == 'success') {
                        toastr.success("Cập nhật thông tin thành công!", "Thành công");
                        $('#lvkd_data').replaceWith(data.message);
                        $('#listcoquanxetduyet_data').replaceWith(data.message2);
                        $('#Create_Lvkd_Modal').modal("hide");
                    } else {
                        toastr.error(data.message, "Lỗi!");
                    }
                }
            })
        }
    }

    function SetEditLvkd(id_edit) {
        $.ajax({
            url: '/DoanhNghiep/DangKy/Lvkd/Edit',
            type: 'POST',
            data: {
                Id: id_edit
            },
            dataType: 'JSON',
            success: function (data) {
                if (data.status == 'success') {
                    $('#edit_thongtin').replaceWith(data.message);
                    $('#Edit_Lvkd_Modal').modal("show");
                    // Initialize select2 inside edit modal
                    $('#manghe_edit').select2({
                        dropdownParent: $('#Edit_Lvkd_Modal')
                    }).on('change', function () {
                        AjaxGetDvNhanHsEdit();
                    });
                    $('#madvhs_edit').select2({
                        dropdownParent: $('#Edit_Lvkd_Modal')
                    });
                } else {
                    toastr.error(data.message, "Lỗi!!!");
                }
            }
        })
    }

    function SetUpdateLvkd() {
        if (document.getElementById("madvhs_edit").value == '') {
            toastr.error("Đơn vị nhận hồ sơ không được để trống!!!", "Lỗi!");
        } else {
            $.ajax({
                url: '/DoanhNghiep/DangKy/Lvkd/Update',
                type: 'POST',
                data: {
                    MaNghe: $('#manghe_edit').val(),
                    DonViQuanLyId: $('#madvhs_edit').val(),
                    MaSoThue: $('#MaSoThue').val(),
                    Id: $('#id_edit').val()
                },
                dataType: 'JSON',
                success: function (data) {
                    if (data.status == 'success') {
                        toastr.success("Cập nhật thông tin thành công!", "Thành công");
                        $('#lvkd_data').replaceWith(data.message);
                        $('#listcoquanxetduyet_data').replaceWith(data.message2);
                        $('#Edit_Lvkd_Modal').modal("hide");
                    } else {
                        toastr.error(data.message, "Lỗi!");
                    }
                }
            })
        }
    }

    function GetDeleteLvkd(id, tennghe) {
        document.getElementById("id_delete").value = id;
        document.getElementById("tennghe_delete").innerHTML = tennghe;
    }

    function SetDeleteLvkd() {
        $.ajax({
            url: '/DoanhNghiep/DangKy/Lvkd/Delete',
            type: 'POST',
            data: {
                Id: $('#id_delete').val(),
            },
            dataType: 'JSON',
            success: function (data) {
                if (data.status == 'success') {
                    $('#lvkd_data').replaceWith(data.message);
                    $('#listcoquanxetduyet_data').replaceWith(data.message2);
                    toastr.success("Cập nhật thành công!!!", "Thành công!");
                    $('#Delete_Lvkd_Modal').modal("hide");
                } else {
                    toastr.error(data.message, "Lỗi!");
                }
            }
        })
    }
</script>
