<!--Tra Lai Modal-->
<div class="modal fade" id="TraLai_Modal" data-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <form id="TraLaiForm" method="post" asp-controller="KeKhaiDangKyGiaXetDuyet" asp-action="TraLai" onsubmit="SubmitTraLaiForm(event)">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h3 class="card-label">
                        Trả lại hồ sơ kê khai giá
                        <span class="d-block text-muted pt-2 font-size-sm">
                            Trả lại hồ sơ kê khai đăng ký giá
                        </span>
                    </h3>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <i aria-hidden="true" class="ki ki-close"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-custom alert-light-danger fade show mb-5" role="alert">
                        <div class="alert-text font-weight-bold text-danger">
                            Hồ sơ bị trả lại sẽ được chuyển về đơn vị kê khai để chỉnh sửa!
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xl-12 mb-3">
                            <div class="form-group m-0">
                                <label>Số QĐ:&nbsp;<b id="soqd_tralai" style="color: #0000FF"></b></label>
                            </div>
                        </div>
                        <div class="col-xl-12 mb-3">
                            <div class="form-group">
                                <label class="control-label font-weight-bold">Lý do trả lại:</label>
                                <textarea class="form-control" rows="4" id="Lydo_Input" name="Lydo" required></textarea>
                            </div>
                        </div>
                    </div>
                    <input id="tralaiId" name="hoSoId" type="hidden" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Hủy thao tác</button>
                    <button type="submit" class="btn btn-primary font-weight-bold">Trả lại hồ sơ</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!--Duyet Modal-->
<div class="modal fade" id="Duyet_Modal" data-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <form id="DuyetForm" method="post" asp-controller="KeKhaiDangKyGiaXetDuyet" asp-action="Duyet" onsubmit="SubmitDuyetForm(event)">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h3 class="card-label">
                        Duyệt hồ sơ kê khai giá
                        <span class="d-block text-muted pt-2 font-size-sm">
                            Duyệt hồ sơ kê khai đăng ký giá
                        </span>
                    </h3>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <i aria-hidden="true" class="ki ki-close"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-custom alert-light-primary fade show mb-5" role="alert">
                        <div class="alert-text font-weight-bold text-primary">
                            Bạn có chắc chắn muốn duyệt hồ sơ này?
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xl-12 mb-3">
                            <div class="form-group m-0">
                                <label>Số QĐ:&nbsp;<b id="soqd_duyet" style="color: #0000FF"></b></label>
                            </div>
                        </div>
                        <div class="col-xl-12 mb-3">
                            <div class="form-group m-0">
                                <label>Số hồ sơ nhận:&nbsp;<b id="sohsduyet" style="color: #0000FF"></b></label>
                            </div>
                        </div>
                    </div>
                    <input id="soqd_duyet_input" type="hidden" />
                    <input id="sohsduyet_input" name="soHsDuyet" type="hidden" />
                    <input id="duyetId" name="hoSoId" type="hidden" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Hủy thao tác</button>
                    <button type="submit" class="btn btn-primary font-weight-bold">Đồng ý</button>
                </div>
            </form>
        </div>
    </div>
</div>

