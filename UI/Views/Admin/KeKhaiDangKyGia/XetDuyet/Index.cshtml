@using Services.DTOs.KeKhaiDangKyGia;
@using DataAccess.Entities.Settings;
@using DataAccess.Entities.KeKhaiDangKyGia;
@model VMPageInfoWithData<DataAccess.Entities.KeKhaiDangKyGia.KeKhaiDangKyGia>
@{
    ViewData["PageInfo"] = Model;
    var session = HttpContextAccessor?.HttpContext?.Session ?? null;
    string role = ViewData["Role"] as string ?? "";
    var filter = ViewData["Filter"] as KeKhaiDangKyGiaFilter;
    var listDonVi = ViewData["DanhMucDonVi"] as List<DanhMucDonVi> ?? [];
    var listKinhDoanh = ViewData["DanhMucKinhDoanh"] as List<DanhMucKinhDoanh> ?? [];
    int record_id = Model.RecordStart;
}

<div class="card card-custom">
    <div class="card-header flex-nowrap border-0 pt-6 pb-0">
        <div class="card-title" style="min-width: 0; flex: 1;">
            <h3 class="card-label" style="text-overflow: ellipsis; overflow: hidden; white-space: nowrap; width: 100%;">
                Quản Lý Xét Duyệt <b title="@ViewData["Title"]?.ToString()?.ToUpper()">@ViewData["Title"]?.ToString()?.ToUpper()</b>
                @* <span class="d-block text-muted pt-2 font-size-sm" style="text-overflow: ellipsis; overflow: hidden; white-space: nowrap;" title="Quản Lý Xét Duyệt @FuntionGlobal.CapitalizeAll(ViewData["Title"]?.ToString())">
                    Quản Lý Xét Duyệt @FuntionGlobal.CapitalizeAll(ViewData["Title"]?.ToString())
                </span> *@
            </h3>
        </div>
    </div>

    <div class="card-body pt-0">
        <form id="FilterForm" method="GET" action="/KeKhaiDangKyGiaXetDuyet">
            <div class="row">
                <div class="col-xl-3">
                    <div class="form-group fv-plugins-icon-container">
                        <label style="font-weight:bold; color:blue">Năm:</label>
                        <select class="form-control h-40px" name="Year" id="TargetYear_Select">
                            @for (int year = DateTime.Now.Year - 5; year <= DateTime.Now.Year; year++)
                            {
                                <!option value="@year" @(filter?.TargetYear == year ? "selected" : "")>Năm @year</!option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-xl-3">
                    <div class="form-group fv-plugins-icon-container">
                        <label style="font-weight:bold; color:blue">Đơn vị quản lý:</label>
                        <select class="form-control h-40px" name="DonViQuanLyId" id="DonViQuanLyId_Select">
                            <!option value="all" @(filter?.DonViQuanLyId == Guid.Empty ? "selected" : "")>-- Tất cả đơn vị --</!option>
                            @foreach (var dv in listDonVi)
                            {
                                <!option value="@dv.Id" @(filter?.DonViQuanLyId == dv.Id ? "selected" : "")>@dv.TenDonVi</!option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-xl-3">
                    <div class="form-group fv-plugins-icon-container">
                        <label style="font-weight:bold; color:blue">Trạng thái:</label>
                        <select class="form-control h-40px" name="TrangThai" id="TrangThai_Select">
                            <!option value="CD" @(filter?.TrangThai == "CD" ? "selected" : "")>Chờ duyệt</!option>
                            <!option value="DD" @(filter?.TrangThai == "DD" ? "selected" : "")>Đã duyệt</!option>
                            <!option value="CB" @(filter?.TrangThai == "CB" ? "selected" : "")>Công bố</!option>
                        </select>
                    </div>
                </div>
                <div class="col-xl-3">
                    <div class="form-group fv-plugins-icon-container">
                        <label style="font-weight:bold; color:blue">Nghề kinh doanh:</label>
                        <select class="form-control h-40px" name="MaNghe" id="MaNghe_Select">
                            <!option value="all" @(filter?.MaNghe == "all" ? "selected" : "")>-- Tất cả nghề kinh doanh --</!option>
                            @foreach (var kd in listKinhDoanh)
                            {
                                <!option value="@kd.MaNghe" @(filter?.MaNghe == kd.MaNghe ? "selected" : "")>@kd.TenNghe</!option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="col-xl-3" style="text-align:left">
                    <div class="form-group fv-plugins-icon-container">
                        <label class="text-blue">Hiển thị</label>
                        <select class="form-control h-40px" name="PageSize" id="PageSize_Select">
                            <!option value="5" @(filter?.PageSize == 5 ? "selected" : "")>5 thông tin</!option>
                            <!option value="10" @(filter?.PageSize == 10 ? "selected" : "")>10 thông tin</!option>
                            <!option value="20" @(filter?.PageSize == 20 ? "selected" : "")>20 thông tin</!option>
                            <!option value="50" @(filter?.PageSize == 50 ? "selected" : "")>50 thông tin</!option>
                            <!option value="100" @(filter?.PageSize == 100 ? "selected" : "")>100 thông tin</!option>
                        </select>
                    </div>
                </div>
                <div class="col-xl-9">
                    <div class="form-group fv-plugins-icon-container">
                        <label class="text-blue">Tìm kiếm</label>
                        <div class="input-group">
                            <input class="form-control h-40px" name="Search" id="txt_Search" placeholder="Tìm kiếm theo số quyết định, ghi chú..." value="@filter?.Search">
                            <div class="input-group-prepend">
                                <button class="btn btn-danger" type="button" onclick="ClearTxtSearch()"><i class="las la-times-circle"></i></button>
                            </div>
                            <div class="input-group-append">
                                <button class="btn btn-primary" type="submit"><i class="las la-search"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <input hidden id="sort_current" name="sort_current" value="@Model.Sort" />
            <input hidden id="PageCurrent" name="PageCurrent" value="@Model.PageCurrent" />
        </form>
        <!--begin: Datatable-->
        <div class="table-responsive border rounded-lg mb-8">
            <table class="table table-striped table-hover table-responsive-lg rounded-lg m-0">
                <thead class="thead-light">
                    <tr style="text-align:center;" class="table-active">
                        <th width="5%">#</th>
                        <th width="15%" style="font-weight: bold;">Cơ sở kinh doanh / Doanh nghiệp</th>
                        <th style="font-weight: bold;">Nghề kinh doanh</th>
                        <th width="12%" style="font-weight: bold;">Số quyết định</th>
                        <th style="font-weight: bold;">Ngày chuyển</th>
                        <th style="font-weight: bold;">Đơn vị nhận hồ sơ</th>
                        <th width="10%" style="font-weight: bold;">Trạng thái</th>
                        <th width="15%" style="font-weight: bold;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Data != null && Model.Data.Any())
                    {
                        foreach (var item in Model.Data)
                        {
                            var donVi = listDonVi.FirstOrDefault(d => d.Id == item.DonViQuanLyId);
                            <tr class="@FuntionGlobal.GetClassTableWithStatus(item.TrangThai)">
                                <td class="text-center" style="vertical-align: middle">
                                    @(record_id++)
                                </td>
                                <td style="vertical-align: middle">
                                    <strong>@item.DoanhNghiepQuanLy?.TenDoanhNghiep</strong>
                                </td>
                                <td style="vertical-align: middle">
                                    Kê khai giá @listKinhDoanh.FirstOrDefault(x => x.MaNghe == item.MaNghe)?.TenNghe
                                </td>
                                <td class="text-nowrap text-primary font-weight-boldest" style="vertical-align: middle">
                                    @item.SoQd
                                </td>
                                <td class="text-center text-nowrap text-primary font-weight-boldest" style="vertical-align: middle">
                                    @FuntionGlobal.ConvertDateToStr(item.NgayChuyen)
                                </td>
                                <td style="vertical-align: middle">@(donVi?.TenDonVi ?? "")</td>
                                <td class="text-center text-nowrap" style="vertical-align: middle">
                                    @if (item.TrangThai == "CD")
                                    {
                                        <span class="label label-lg label-inline font-weight-bolder label-warning">Chờ duyệt</span>
                                        if (!string.IsNullOrEmpty(item.ThongTinNguoiChuyen))
                                        {
                                            <br />
                                            <span class="text-info font-weight-bold">Người chuyển: @item.ThongTinNguoiChuyen</span>
                                        }
                                        if (!string.IsNullOrEmpty(item.SoDtNguoiChuyen))
                                        {
                                            <br />
                                            <span class="text-info font-weight-bold">SĐT: @item.SoDtNguoiChuyen</span>
                                        }
                                        <br />
                                        <span>Ngày chuyển: @FuntionGlobal.ConvertDateToStr(item.NgayChuyen)</span>
                                    }
                                    else if (item.TrangThai == "DD")
                                    {
                                        <span class="label label-lg label-inline font-weight-bolder label-success">Đã duyệt</span>
                                        if (!string.IsNullOrEmpty(item.SoHsDuyet))
                                        {
                                            <br />
                                            <span class="text-success font-weight-bold">Số hồ sơ duyệt: @item.SoHsDuyet</span>
                                        }
                                        <br />
                                        <span>Ngày duyệt: @FuntionGlobal.ConvertDateToStr(item.NgayDuyet)</span>
                                    }
                                    else if (item.TrangThai == "BTL")
                                    {
                                        <span class="label label-lg label-inline font-weight-bolder label-danger">Bị trả lại</span>
                                        <br />
                                        <span>Ngày bị trả lại: @FuntionGlobal.ConvertDateToStr(item.NgayTraHoSo)</span>
                                    }
                                    else if (item.TrangThai == "CB")
                                    {
                                        <span class="label label-lg label-inline font-weight-bolder label-success">Công bố</span>
                                        if (!string.IsNullOrEmpty(item.SoHsDuyet))
                                        {
                                            <br />
                                            <span class="text-success font-weight-bold">Số hồ sơ duyệt: @item.SoHsDuyet</span>
                                        }
                                        <br />
                                        <span>Ngày duyệt: @FuntionGlobal.ConvertDateToStr(item.NgayDuyet)</span>
                                    }
                                </td>
                                <td class="text-center text-nowrap" style="vertical-align: middle">
                                    <a class="btn btn-sm btn-clean btn-icon" title="Xem chi tiết" target="_blank"
                                       asp-controller="KeKhaiDangKyGia" asp-action="Show" asp-route-id="@item.Id">
                                        <i class="icon-lg la la-eye text-success"></i>
                                    </a>

                                    @if (item.TrangThai == "CD")
                                    {
                                        if (session != null && FuntionGlobal.CheckPermission(session, role, "Approve"))
                                        {
                                            <button type="button" class="btn btn-sm btn-clean btn-icon" title="Duyệt" onclick="HandleDuyet('@item.Id')">
                                                <i class="icon-lg la la-check text-success"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-clean btn-icon" title="Trả lại" onclick="HandleTraLai('@item.Id', '@item.SoQd')">
                                                <i class="icon-lg la la-reply text-danger"></i>
                                            </button>
                                        }
                                    }
                                    else if (item.TrangThai == "DD")
                                    {
                                        if (session != null && FuntionGlobal.CheckPermission(session, role, "Approve"))
                                        {
                                            <button type="button" class="btn btn-sm btn-clean btn-icon" title="Hủy duyệt" onclick="HandleHuyDuyet('@item.Id', '@item.SoQd')">
                                                <i class="icon-lg la la-times text-danger"></i>
                                            </button>
                                        }
                                        if (session != null && FuntionGlobal.CheckPermission(session, role, "Public"))
                                        {
                                            <button type="button" class="btn btn-sm btn-clean btn-icon" title="Công bố" onclick="HandleCongBo('@item.Id', '@item.SoQd')">
                                                <i class="icon-lg la la-globe text-primary"></i>
                                            </button>
                                        }
                                    }
                                    else if (item.TrangThai == "CB")
                                    {
                                        if (session != null && FuntionGlobal.CheckPermission(session, role, "Public"))
                                        {
                                            <button type="button" class="btn btn-sm btn-clean btn-icon" title="Hủy công bố" onclick="HandleHuyCongBo('@item.Id', '@item.SoQd')">
                                                <i class="icon-lg la la-times text-danger"></i>
                                            </button>
                                        }
                                    }
                                    else if (item.TrangThai == "HCB")
                                    {
                                        if (session != null && FuntionGlobal.CheckPermission(session, role, "Approve"))
                                        {
                                            <button type="button" class="btn btn-sm btn-clean btn-icon" title="Hủy duyệt" onclick="HandleHuyDuyet('@item.Id', '@item.SoQd')">
                                                <i class="icon-lg la la-times text-danger"></i>
                                            </button>
                                        }
                                        if (session != null && FuntionGlobal.CheckPermission(session, role, "Public"))
                                        {
                                            <button type="button" class="btn btn-sm btn-clean btn-icon" title="Công bố" onclick="HandleCongBo('@item.Id', '@item.SoQd')">
                                                <i class="icon-lg la la-globe text-primary"></i>
                                            </button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td style="text-align:center" colspan="9">Không tìm thấy thông tin!!!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!--end: Datatable-->
        <div id="Pagination">
            @await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
        </div>
    </div>
</div>
@await Html.PartialAsync("~/Views/Admin/KeKhaiDangKyGia/XetDuyet/_Modal.cshtml")

@section custom_style {
}

@section custom_script {
    <script src="~/js/site.js"></script>
    <script>
        $(document).ready(function () {
            SetupSelect2('#TargetYear_Select', 'Lựa Chọn Năm Làm Việc', { enableSearch: false, enableClear: false });
            SetupSelect2('#DonViQuanLyId_Select', 'Lựa Chọn Đơn Vị Quản Lý', { enableSearch: true, enableClear: false });
            SetupSelect2('#TrangThai_Select', 'Lựa Chọn Trạng Thái', { enableSearch: false, enableClear: false });
            SetupSelect2('#MaNghe_Select', 'Lựa Chọn Mã Nghề', { enableSearch: true, enableClear: false });
            HandleRegisterFormFilter('#FilterForm', '#Pagination', '/KeKhaiDangKyGiaXetDuyet');
        });

        function ClearTxtSearch() {
            $('#txt_Search').val('');
            $('#FilterForm').submit();
        }

        const HandleDuyet = (hoSoId) => {
            $.ajax({
                url: '/KeKhaiDangKyGiaXetDuyet/LayThongTinHoSo',
                type: 'GET',
                data: { id: hoSoId },
                success: function (res) {
                    if (res.success) {
                        $('#soqd_duyet_input').val(res.soQd);
                        $('#soqd_duyet').text(res.soQd);
                        $('#sohsduyet_input').val(res.soHsDuyet);
                        $('#sohsduyet').text(res.soHsDuyet);
                        $('#duyetId').val(hoSoId);
                        $('#Duyet_Modal').modal('show');
                    } else {
                        toastr.error(res.message);
                    }
                },
                error: function () {
                    toastr.error('Có lỗi xảy ra khi lấy thông tin hồ sơ.');
                }
            });
        }

        const SubmitDuyetForm = (e) => {
            e.preventDefault();
            const urlPost = $('#DuyetForm').attr('action');
            HandlePostAjax({
                url: urlPost,
                data: new FormData($('#DuyetForm')[0]),
                successCallback: (res) => {
                    if (res.isValid) {
                        $('#Duyet_Modal').modal('hide');
                        Swal.fire({
                            icon: "success",
                            title: "<span class='font-weight-boldest font-size-h1 text-capitalize text-blue mb-n5'>Thành công!</span>",
                            text: res.message,
                            confirmButtonText: "Tiếp tục",
                            confirmButtonClass: 'btn btn-primary font-weight-bold',
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        toastr.warning(res.message || 'Có lỗi khi thao tác với dữ liệu', 'Cảnh Báo!');
                    }
                },
                errorCallback: () => {
                    toastr.error('Không nhận được phản hồi từ máy chủ. Vui lòng thử lại sau.');
                }
            });
        }

        const HandleHuyDuyet = (hoSoId, soQd) => {
            $('#soqd_huyduyet').text(soQd);
            $('#huyduyetId').val(hoSoId);
            $('#HuyDuyet_Modal').modal('show');
        }

        const SubmitHuyDuyetForm = (e) => {
            e.preventDefault();
            const urlPost = $('#HuyDuyetForm').attr('action');
            HandlePostAjax({
                url: urlPost,
                data: new FormData($('#HuyDuyetForm')[0]),
                successCallback: (res) => {
                    if (res.isValid) {
                        $('#HuyDuyet_Modal').modal('hide');
                        Swal.fire({
                            icon: "success",
                            title: "<span class='font-weight-boldest font-size-h1 text-capitalize text-blue mb-n5'>Thành công!</span>",
                            text: res.message,
                            confirmButtonText: "Tiếp tục",
                            confirmButtonClass: 'btn btn-primary font-weight-bold',
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        toastr.warning(res.message || 'Có lỗi khi thao tác với dữ liệu', 'Cảnh Báo!');
                    }
                },
                errorCallback: () => {
                    toastr.error('Không nhận được phản hồi từ máy chủ. Vui lòng thử lại sau.');
                }
            });
        }

        const HandleTraLai = (hoSoId, soQd) => {
            $('#soqd_tralai').text(soQd);
            $('#tralaiId').val(hoSoId);
            $('#Lydo_Input').val('');
            $('#TraLai_Modal').modal('show');
        }

        const SubmitTraLaiForm = (e) => {
            e.preventDefault();
            const urlPost = $('#TraLaiForm').attr('action');
            HandlePostAjax({
                url: urlPost,
                data: new FormData($('#TraLaiForm')[0]),
                successCallback: (res) => {
                    if (res.isValid) {
                        $('#TraLai_Modal').modal('hide');
                        Swal.fire({
                            icon: "success",
                            title: "<span class='font-weight-boldest font-size-h1 text-capitalize text-blue mb-n5'>Thành công!</span>",
                            text: res.message,
                            confirmButtonText: "Tiếp tục",
                            confirmButtonClass: 'btn btn-primary font-weight-bold',
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        toastr.warning(res.message || 'Có lỗi khi thao tác với dữ liệu', 'Cảnh Báo!');
                    }
                },
                errorCallback: () => {
                    toastr.error('Không nhận được phản hồi từ máy chủ. Vui lòng thử lại sau.');
                }
            });
        }

        const HandleCongBo = (hoSoId, soQd) => {
            $('#soqd_congbo').text(soQd);
            $('#congboId').val(hoSoId);
            $('#CongBo_Modal').modal('show');
        }

        const SubmitCongBoForm = (e) => {
            e.preventDefault();
            const urlPost = $('#CongBoForm').attr('action');
            HandlePostAjax({
                url: urlPost,
                data: new FormData($('#CongBoForm')[0]),
                successCallback: (res) => {
                    if (res.isValid) {
                        $('#CongBo_Modal').modal('hide');
                        Swal.fire({
                            icon: "success",
                            title: "<span class='font-weight-boldest font-size-h1 text-capitalize text-blue mb-n5'>Thành công!</span>",
                            text: res.message,
                            confirmButtonText: "Tiếp tục",
                            confirmButtonClass: 'btn btn-primary font-weight-bold',
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        toastr.warning(res.message || 'Có lỗi khi thao tác với dữ liệu', 'Cảnh Báo!');
                    }
                },
                errorCallback: () => {
                    toastr.error('Không nhận được phản hồi từ máy chủ. Vui lòng thử lại sau.');
                }
            });
        }

        const HandleHuyCongBo = (hoSoId, soQd) => {
            $('#soqd_huycongbo').text(soQd);
            $('#huycongboId').val(hoSoId);
            $('#HuyCongBo_Modal').modal('show');
        }

        const SubmitHuyCongBoForm = (e) => {
            e.preventDefault();
            const urlPost = $('#HuyCongBoForm').attr('action');
            HandlePostAjax({
                url: urlPost,
                data: new FormData($('#HuyCongBoForm')[0]),
                successCallback: (res) => {
                    if (res.isValid) {
                        $('#HuyCongBo_Modal').modal('hide');
                        Swal.fire({
                            icon: "success",
                            title: "<span class='font-weight-boldest font-size-h1 text-capitalize text-blue mb-n5'>Thành công!</span>",
                            text: res.message,
                            confirmButtonText: "Tiếp tục",
                            confirmButtonClass: 'btn btn-primary font-weight-bold',
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        toastr.warning(res.message || 'Có lỗi khi thao tác với dữ liệu', 'Cảnh Báo!');
                    }
                },
                errorCallback: () => {
                    toastr.error('Không nhận được phản hồi từ máy chủ. Vui lòng thử lại sau.');
                }
            });
        }
    </script>
}
