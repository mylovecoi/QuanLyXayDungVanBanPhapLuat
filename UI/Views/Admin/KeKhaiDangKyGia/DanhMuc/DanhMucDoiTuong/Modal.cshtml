@using DataAccess.Entities.KeKhaiDangKyGia;

<script>
    function Create(dnId) {
        $('#frm_create')[0].reset();
        $('#DoanhNghiepQuanLyID_create').val(dnId);
        $('#Create_Modal').modal('show');
    }

    function Store() {
        var form = document.getElementById('frm_create');
        if ($('#MaDT_create').val().trim() === '') {
            toastr.error("Mã đối tượng không được bỏ trống!", "Lỗi!");
            return;
        }
        if ($('#TenDT_create').val().trim() === '') {
            toastr.error("Tên đối tượng không được bỏ trống!", "Lỗi!");
            return;
        }

        const csrfToken = $('input[name="__RequestVerificationToken"]').val();
        const formData = new FormData(form);
        $.ajax({
            url: '/KeKhaiDangKyGiaDMDT/Store',
            type: 'POST',
            headers: {
                'RequestVerificationToken': csrfToken
            },
            data: formData,
            processData: false,
            contentType: false,
            dataType: 'JSON',
            success: function (data) {
                if (data.status == 'success') {
                    toastr.success(data.message);
                    location.reload();
                } else {
                    toastr.error(data.message, "Lỗi!");
                }
            }
        });
    }

    function Edit(id) {
        const csrfToken = $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url: '/KeKhaiDangKyGiaDMDT/Edit',
            type: 'POST',
            headers: {
                'RequestVerificationToken': csrfToken
            },
            data: { id: id },
            success: function (res) {
                if (res.status == 'success') {
                    $('#Id_edit').val(res.data.id);
                    $('#DoanhNghiepQuanLyID_edit').val(res.data.doanhNghiepQuanLyID);
                    $('#MaDT_edit').val(res.data.maDT);
                    $('#TenDT_edit').val(res.data.tenDT);
                    $('#GhiChu_edit').val(res.data.ghiChu);
                    $('#Edit_Modal').modal('show');
                } else {
                    toastr.error(res.message);
                }
            },
            error: function (xhr) {
                toastr.error("Không thể tải dữ liệu!", "Lỗi!");
            }
        });
    }

    function Update() {
        var form = document.getElementById('frm_edit');
        if ($('#MaDT_edit').val().trim() === '') {
            toastr.error("Mã đối tượng không được bỏ trống!", "Lỗi!");
            return;
        }
        if ($('#TenDT_edit').val().trim() === '') {
            toastr.error("Tên đối tượng không được bỏ trống!", "Lỗi!");
            return;
        }

        const csrfToken = $('input[name="__RequestVerificationToken"]').val();
        const formData = new FormData(form);
        $.ajax({
            url: '/KeKhaiDangKyGiaDMDT/Update',
            type: 'POST',
            headers: {
                'RequestVerificationToken': csrfToken
            },
            data: formData,
            processData: false,
            contentType: false,
            dataType: 'JSON',
            success: function (data) {
                if (data.status == 'success') {
                    toastr.success(data.message);
                    location.reload();
                } else {
                    toastr.error(data.message, "Lỗi!");
                }
            }
        });
    }

    function Delete(id, name) {
        $('#id_delete').val(id);
        $('#ten_delete').html(name);
        $('#Delete_Modal').modal('show');
    }
</script>

<!-- Create Modal -->
<div class="modal fade" id="Create_Modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="card-label">
                    Danh mục đối tượng
                    <span class="d-block text-muted pt-2 font-size-sm">Thêm mới đối tượng sử dụng</span>
                </h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">
                <form id="frm_create">
                    <input type="hidden" name="DoanhNghiepQuanLyID" id="DoanhNghiepQuanLyID_create" />
                    <div class="row">
                        <div class="col-xl-12">
                            <div class="form-group">
                                <label>Mã đối tượng <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="MaDT" id="MaDT_create" required />
                            </div>
                        </div>
                        <div class="col-xl-12">
                            <div class="form-group">
                                <label>Tên đối tượng <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="TenDT" id="TenDT_create" required />
                            </div>
                        </div>
                        <div class="col-xl-12">
                            <div class="form-group">
                                <label>Ghi chú</label>
                                <textarea class="form-control" name="GhiChu" id="GhiChu_create" rows="3"></textarea>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary font-weight-bold" onclick="Store()">Thêm mới</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="Edit_Modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="card-label">
                    Danh mục đối tượng
                    <span class="d-block text-muted pt-2 font-size-sm">Chỉnh sửa đối tượng sử dụng</span>
                </h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">
                <form id="frm_edit">
                    <input type="hidden" name="Id" id="Id_edit" />
                    <input type="hidden" name="DoanhNghiepQuanLyID" id="DoanhNghiepQuanLyID_edit" />
                    <div class="row">
                        <div class="col-xl-12">
                            <div class="form-group">
                                <label>Mã đối tượng <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="MaDT" id="MaDT_edit" required />
                            </div>
                        </div>
                        <div class="col-xl-12">
                            <div class="form-group">
                                <label>Tên đối tượng <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="TenDT" id="TenDT_edit" required />
                            </div>
                        </div>
                        <div class="col-xl-12">
                            <div class="form-group">
                                <label>Ghi chú</label>
                                <textarea class="form-control" name="GhiChu" id="GhiChu_edit" rows="3"></textarea>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary font-weight-bold" onclick="Update()">Cập nhật</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="Delete_Modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="card-label">
                    Danh mục đối tượng
                    <span class="d-block text-muted pt-2 font-size-sm">Xóa đối tượng sử dụng</span>
                </h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <form action="/KeKhaiDangKyGiaDMDT/Delete" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="form-group">
                        <label>
                            Bạn có chắc chắn muốn xóa đối tượng: <b id="ten_delete" style="color: red"></b>?
                        </label>
                    </div>
                    <input type="hidden" id="id_delete" name="id_delete" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light-primary font-weight-bold" data-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger font-weight-bold">Đồng ý</button>
                </div>
            </form>
        </div>
    </div>
</div>
