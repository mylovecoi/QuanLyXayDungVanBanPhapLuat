@using UI.ViewModels;
@using DataAccess.Entities.KeKhaiDangKyGia;
@using DataAccess.Entities.Settings;

@model VMPageInfoWithData<KeKhaiDangKyGiaDMHH>

@{
    var session = HttpContextAccessor?.HttpContext?.Session ?? null;
    string role = "KeKhaiDangKyGia";
    int pageSize = Model.PageSize;
    string timKiem = ViewData["Search"] as string ?? "";
    int pageCurrent = Model.PageCurrent;
    string selectedDnId = ViewData["DoanhNghiepQuanLyId"] as string ?? "all";
    bool isDnSelected = !string.IsNullOrEmpty(selectedDnId) && selectedDnId != "all";
    var doanhNghieps = ViewData["DoanhNghieps"] as List<DoanhNghiep> ?? new List<DoanhNghiep>();
    var donViTinhs = ViewData["DonViTinhs"] as List<DanhMucDonViTinh> ?? new List<DanhMucDonViTinh>();
    ViewData["PageInfo"] = Model;
}

@section custom_style {
}

@section custom_script {
    <script src="~/js/site.js"></script>
    <script>
        $(document).ready(function () {
            HandleRegisterFormFilter('#FilterForm', '#Pagination', '/KeKhaiDangKyGiaDMHH');
            SetupSelect2('#DoanhNghiepQuanLyId_Select', 'Lựa Chọn Doanh Nghiệp', { enableSearch: true, enableClear: false });
        });

        // Add event triggers
        function ClearTxtSearch() {
            $('#txt_Search').val('');
            $('#FilterForm').submit();
        }
    </script>
}

<div class="card card-custom">
    <div class="card-header flex-nowrap border-0 pt-6 pb-0">
        <div class="card-title" style="min-width: 0; flex: 1;">
            <h3 class="card-label" style="text-overflow: ellipsis; overflow: hidden; white-space: nowrap; width: 100%;">
                <b>DANH MỤC HÀNG HÓA, DỊCH VỤ CUNG ỨNG</b>
                <!-- <span class="d-block text-muted pt-2 font-size-sm">Quản lý danh mục hàng hóa, dịch vụ cung ứng</span> -->
            </h3>
        </div>
        <div class="card-toolbar" style="flex-shrink: 0;">
            @if (isDnSelected && session != null && FuntionGlobal.CheckPermission(session, role, "Create"))
            {
                <button type="button" class="btn btn-primary font-weight-bolder" onclick="Create('@selectedDnId')">
                    <i class="la la-plus"></i>Thêm mới
                </button>
            }
        </div>
    </div>
    @Html.AntiForgeryToken()
    <div class="card-body pt-0">
        <form id="FilterForm" method="GET" action="/KeKhaiDangKyGiaDMHH">
            <div class="row">
                <div class="col-xl-6">
                    <div class="form-group fv-plugins-icon-container">
                        <label style="font-weight:bold; color:blue">Doanh nghiệp:</label>
                        <select class="form-control h-40px" name="DoanhNghiepQuanLyId" id="DoanhNghiepQuanLyId_Select" onchange="$('#FilterForm').submit()">
                            @if (session == null || FuntionGlobal.GetSsAdmin(session, "Level") != "Doanh nghiệp")
                            {
                                <!option value="all" @(selectedDnId == "all" ? "selected" : "")>--- Tất cả ---</!option>
                            }
                            @foreach (var dn in doanhNghieps)
                            {
                                <!option value="@dn.Id" @(selectedDnId == dn.Id.ToString() ? "selected" : "")>@dn.TenDoanhNghiep</!option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="col-xl-3" style="text-align:left">
                    <div class="form-group fv-plugins-icon-container">
                        <label class="text-blue">Hiển thị</label>
                        <select class="form-control h-40px" name="PageSize" id="PageSize_Select">
                            <!option value="5" @(pageSize == 5 ? "selected" : "")>5 thông tin</!option>
                            <!option value="10" @(pageSize == 10 ? "selected" : "")>10 thông tin</!option>
                            <!option value="20" @(pageSize == 20 ? "selected" : "")>20 thông tin</!option>
                            <!option value="50" @(pageSize == 50 ? "selected" : "")>50 thông tin</!option>
                            <!option value="100" @(pageSize == 100 ? "selected" : "")>100 thông tin</!option>
                        </select>
                    </div>
                </div>

                <div class="col-xl-9">
                    <div class="form-group fv-plugins-icon-container">
                        <label class="text-blue">Tìm kiếm</label>
                        <div class="input-group">
                            <input class="form-control h-40px" name="timKiem" id="txt_Search" placeholder="Tìm kiếm theo mã, tên hàng hóa/dịch vụ..." value="@timKiem">
                            <div class="input-group-prepend">
                                <button class="btn btn-danger" type="button" onclick="ClearTxtSearch()"><i class="las la-times-circle"></i></button>
                            </div>
                            <div class="input-group-append">
                                <button class="btn btn-primary" type="submit"><i class="las la-search"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <input hidden id="PageCurrent" name="PageCurrent" value="@pageCurrent" />
        </form>

        <div class="table-responsive border rounded-lg mb-8">
            <table class="table table-striped table-hover rounded-lg">
                <thead>
                    <tr style="text-align:center;" class="table-active">
                        <th style="font-weight: bold;" width="5%">STT</th>
                        <th style="font-weight: bold;">Doanh nghiệp quản lý</th>
                        <th style="font-weight: bold;" width="12%">Mã hàng hóa/DV</th>
                        <th style="font-weight: bold;">Tên hàng hóa/dịch vụ</th>
                        <th style="font-weight: bold;" width="15%">Quy cách chất lượng</th>
                        <th style="font-weight: bold;" width="10%">ĐVT</th>
                        <th style="font-weight: bold;" width="12%">Mã BTC</th>
                        <th style="font-weight: bold;">Ghi chú</th>
                        <th style="font-weight: bold;" width="10%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Data != null && Model.Data.Any())
                    {
                        int stt = (Model.PageCurrent - 1) * Model.PageSize + 1;
                        foreach (var item in Model.Data)
                        {
                            var dnName = doanhNghieps.FirstOrDefault(d => d.Id == item.DoanhNghiepQuanLyID)?.TenDoanhNghiep ?? "Không xác định";
                            var dvt = donViTinhs.FirstOrDefault(d => d.MaDonViTinh == item.DonViTinh);
                            var dvtName = dvt != null ? $"{dvt.TenDonViTinh} ({dvt.MaDonViTinh})" : item.DonViTinh;
                            <tr>
                                <td style="text-align: center; vertical-align: middle">@stt</td>
                                <td style="vertical-align: middle">@dnName</td>
                                <td style="text-align: center; font-weight: bold; vertical-align: middle">@item.MaDVCU</td>
                                <td style="font-weight: bold; vertical-align: middle">@item.TenDvCungUng</td>
                                <td style="vertical-align: middle">@item.QuyCachChatLuong</td>
                                <td style="text-align: center; vertical-align: middle">@dvtName</td>
                                <td style="text-align: center; vertical-align: middle">@item.MaHH_BTC</td>
                                <td style="vertical-align: middle">@item.GhiChu</td>
                                <td class="text-center" style="vertical-align: middle; white-space: nowrap;">
                                    @if (session != null && FuntionGlobal.CheckPermission(session, role, "Edit"))
                                    {
                                        <button type="button" onclick="Edit('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Chỉnh sửa">
                                            <i class="icon-lg la la-edit text-success"></i>
                                        </button>
                                    }
                                    @if (session != null && FuntionGlobal.CheckPermission(session, role, "Delete"))
                                    {
                                        <button type="button" class="btn btn-sm btn-clean btn-icon" title="Xóa" onclick="Delete('@item.Id', '@item.TenDvCungUng')">
                                            <i class="icon-lg la la-trash text-danger"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td style="text-align:center" colspan="9">Không tìm thấy thông tin!!!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div id="Pagination">
            @await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
        </div>
    </div>
</div>

@await Html.PartialAsync("~/Views/Admin/KeKhaiDangKyGia/DanhMuc/DanhMucHangHoa/Modal.cshtml")
