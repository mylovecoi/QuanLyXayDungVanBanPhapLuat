                    <span class="d-block text-muted pt-2 font-size-sm">Chỉnh sửa hàng hóa, dịch vụ cung ứng</span>
                </h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">
                <form id="frm_edit">
                    <input type="hidden" name="Id" id="Id_edit" />
                    <input type="hidden" name="DoanhNghiepQuanLyID" id="DoanhNghiepQuanLyID_edit" />
                    <div class="row">
                        <div class="col-xl-6">
                            <div class="form-group">
                                <label>Mã hàng hóa/dịch vụ <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="MaDVCU" id="MaDVCU_edit" required />
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group">
                                <label>Mã ngành/Mã nghề</label>
                                <input type="text" class="form-control" name="MaNghe" id="MaNghe_edit" />
                            </div>
                        </div>
                        <div class="col-xl-12">
                            <div class="form-group">
                                <label>Tên hàng hóa, dịch vụ cung ứng <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="TenDvCungUng" id="TenDvCungUng_edit" required />
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group">
                                <label>Quy cách chất lượng</label>
                                <input type="text" class="form-control" name="QuyCachChatLuong" id="QuyCachChatLuong_edit" />
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group">
                                <label>Đơn vị tính</label>
                                <select class="form-control select2multi" name="DonViTinh" id="DonViTinh_edit">
                                    <option value="">-- Chọn đơn vị tính --</option>
                                    @foreach (var dvt in donViTinhs)
                                    {
                                        <option value="@dvt.MaDonViTinh">@dvt.TenDonViTinh</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-xl-12">
                            <div class="form-group">
                                <label>Mã kê khai theo BTC</label>
                                <input type="text" class="form-control" name="MaHH_BTC" id="MaHH_BTC_edit" />
                            </div>
                        </div>
                        <div class="col-xl-12">
                            <div class="form-group">
                                <label>Ghi chú</label>
                                <textarea class="form-control" name="GhiChu" id="GhiChu_edit" rows="3"></textarea>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary font-weight-bold" onclick="Update()">Cập nhật</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="Delete_Modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="card-label">
                    Danh mục hàng hóa, dịch vụ
                    <span class="d-block text-muted pt-2 font-size-sm">Xóa hàng hóa, dịch vụ cung ứng</span>
                </h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <form action="/KeKhaiDangKyGiaDMHH/Delete" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="form-group">
                        <label>
                            Bạn có chắc chắn muốn xóa hàng hóa, dịch vụ: <b id="ten_delete" style="color: red"></b>?
                        </label>
                    </div>
                    <input type="hidden" id="id_delete" name="id_delete" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light-primary font-weight-bold" data-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger font-weight-bold">Đồng ý</button>
                </div>
            </form>
        </div>
    </div>
</div>
