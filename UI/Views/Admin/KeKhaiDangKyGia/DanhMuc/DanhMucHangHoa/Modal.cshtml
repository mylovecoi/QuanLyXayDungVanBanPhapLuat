@using DataAccess.Entities.KeKhaiDangKyGia;
@using DataAccess.Entities.Settings;

@{
    var donViTinhs = ViewData["DonViTinhs"] as List<DanhMucDonViTinh> ?? new List<DanhMucDonViTinh>();
}

<script>
    function Create(dnId) {
        $('#frm_create')[0].reset();
        $('#DoanhNghiepQuanLyID_create').val(dnId);
        $('#DonViTinh_create').val('').trigger('change');
        $('#Create_Modal').modal('show');
        $('#frm_create').find('.select2multi').select2({ width: '100%' });
    }

    function Store() {
        var form = document.getElementById('frm_create');
        if ($('#MaDVCU_create').val().trim() === '') {
            toastr.error("Mã dịch vụ cung ứng không được bỏ trống!", "Lỗi!");
            return;
        }
        if ($('#TenDvCungUng_create').val().trim() === '') {
            toastr.error("Tên hàng hóa/dịch vụ cung ứng không được bỏ trống!", "Lỗi!");
            return;
        }

        const csrfToken = $('input[name="__RequestVerificationToken"]').val();
        const formData = new FormData(form);
        $.ajax({
            url: '/KeKhaiDangKyGiaDMHH/Store',
            type: 'POST',
            headers: {
                'RequestVerificationToken': csrfToken
            },
            data: formData,
            processData: false,
            contentType: false,
            dataType: 'JSON',
            success: function (data) {
                if (data.status == 'success') {
                    toastr.success(data.message);
                    location.reload();
                } else {
                    toastr.error(data.message, "Lỗi!");
                }
            }
        });
    }

    function Edit(id) {
        const csrfToken = $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url: '/KeKhaiDangKyGiaDMHH/Edit',
            type: 'POST',
            headers: {
                'RequestVerificationToken': csrfToken
            },
            data: { id: id },
            success: function (res) {
                if (res.status == 'success') {
                    $('#Id_edit').val(res.data.id);
                    $('#DoanhNghiepQuanLyID_edit').val(res.data.doanhNghiepQuanLyID);
                    $('#MaNghe_edit').val(res.data.maNghe);
                    $('#MaDVCU_edit').val(res.data.maDVCU);
                    $('#TenDvCungUng_edit').val(res.data.tenDvCungUng);
                    $('#QuyCachChatLuong_edit').val(res.data.quyCachChatLuong);
                    $('#DonViTinh_edit').val(res.data.donViTinh).trigger('change');
                    $('#MaHH_BTC_edit').val(res.data.maHH_BTC);
                    $('#GhiChu_edit').val(res.data.ghiChu);
                    $('#Edit_Modal').modal('show');
                    $('#frm_edit').find('.select2multi').select2({ width: '100%' });
                } else {
                    toastr.error(res.message);
                }
            },
            error: function (xhr) {
                toastr.error("Không thể tải dữ liệu!", "Lỗi!");
            }
        });
    }

    function Update() {
        var form = document.getElementById('frm_edit');
        if ($('#MaDVCU_edit').val().trim() === '') {
            toastr.error("Mã dịch vụ cung ứng không được bỏ trống!", "Lỗi!");
            return;
        }
        if ($('#TenDvCungUng_edit').val().trim() === '') {
            toastr.error("Tên hàng hóa/dịch vụ cung ứng không được bỏ trống!", "Lỗi!");
            return;
        }

        const csrfToken = $('input[name="__RequestVerificationToken"]').val();
        const formData = new FormData(form);
        $.ajax({
            url: '/KeKhaiDangKyGiaDMHH/Update',
            type: 'POST',
            headers: {
                'RequestVerificationToken': csrfToken
            },
            data: formData,
            processData: false,
            contentType: false,
            dataType: 'JSON',
            success: function (data) {
                if (data.status == 'success') {
                    toastr.success(data.message);
                    location.reload();
                } else {
                    toastr.error(data.message, "Lỗi!");
                }
            }
        });
    }

    function Delete(id, name) {
        $('#id_delete').val(id);
        $('#ten_delete').html(name);
        $('#Delete_Modal').modal('show');
    }
</script>

<!-- Create Modal -->
<div class="modal fade" id="Create_Modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="card-label">
                    Danh mục hàng hóa, dịch vụ
                    <span class="d-block text-muted pt-2 font-size-sm">Thêm mới hàng hóa, dịch vụ cung ứng</span>
                </h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">
                <form id="frm_create">
                    <input type="hidden" name="DoanhNghiepQuanLyID" id="DoanhNghiepQuanLyID_create" />
                    <div class="row">
                        <div class="col-xl-6">
                            <div class="form-group">
                                <label>Mã hàng hóa/dịch vụ <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="MaDVCU" id="MaDVCU_create" required />
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group">
                                <label>Mã ngành/Mã nghề</label>
                                <input type="text" class="form-control" name="MaNghe" id="MaNghe_create" />
                            </div>
                        </div>
                        <div class="col-xl-12">
                            <div class="form-group">
                                <label>Tên hàng hóa, dịch vụ cung ứng <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="TenDvCungUng" id="TenDvCungUng_create" required />
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group">
                                <label>Quy cách chất lượng</label>
                                <input type="text" class="form-control" name="QuyCachChatLuong" id="QuyCachChatLuong_create" />
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group">
                                <label>Đơn vị tính</label>
                                <select class="form-control select2multi" name="DonViTinh" id="DonViTinh_create">
                                    <option value="">-- Chọn đơn vị tính --</option>
                                    @foreach (var dvt in donViTinhs)
                                    {
                                        <option value="@dvt.MaDonViTinh">@dvt.TenDonViTinh</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-xl-12">
                            <div class="form-group">
                                <label>Mã kê khai theo BTC</label>
                                <input type="text" class="form-control" name="MaHH_BTC" id="MaHH_BTC_create" />
                            </div>
                        </div>
                        <div class="col-xl-12">
                            <div class="form-group">
                                <label>Ghi chú</label>
                                <textarea class="form-control" name="GhiChu" id="GhiChu_create" rows="3"></textarea>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary font-weight-bold" onclick="Store()">Thêm mới</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal -->
