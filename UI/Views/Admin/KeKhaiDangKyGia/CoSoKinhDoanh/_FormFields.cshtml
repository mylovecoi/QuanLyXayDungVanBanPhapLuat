@using DataAccess.Entities.KeKhaiDangKyGia
@model KeKhaiDangKyGiaCsKd

@{
    var doanhNghieps = ViewData["DoanhNghieps"] as List<DoanhNghiep> ?? new List<DoanhNghiep>();
}

<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="MaNghe" />

<div class="row">
    <div class="col-xl-12">
        <div class="form-group">
            <label style="font-weight: bold;">Doanh nghiệp quản lý <span class="text-danger">*</span></label>
            <select class="form-control select2multi" asp-for="DoanhNghiepQuanLyId">
                <option value="">-- Chọn doanh nghiệp --</option>
                @foreach (var dn in doanhNghieps)
                {
                    <option value="@dn.Id">@dn.TenDoanhNghiep</option>
                }
            </select>
        </div>
    </div>
    <div class="col-xl-12">
        <div class="form-group">
            <label style="font-weight: bold;">Tên cơ sở kinh doanh <span class="text-danger">*</span></label>
            <input type="text" class="form-control" asp-for="TenCsKd" placeholder="Nhập tên cơ sở kinh doanh" />
        </div>
    </div>
    <div class="col-xl-12">
        <div class="form-group">
            <label style="font-weight: bold;">Địa chỉ <span class="text-danger">*</span></label>
            <input type="text" class="form-control" asp-for="DiaChi" placeholder="Nhập địa chỉ" />
        </div>
    </div>
    <div class="col-xl-12">
        <div class="form-group">
            <label style="font-weight: bold;">Số điện thoại <span class="text-danger">*</span></label>
            <input type="text" class="form-control" asp-for="SoDienThoai" placeholder="Nhập số điện thoại" />
        </div>
    </div>
</div>
