@using UI.ViewModels;
@using DataAccess.Entities.KeKhaiDangKyGia;

@model VMPageInfoWithData<KeKhaiDangKyGiaCsKd>

@{
	var session = HttpContextAccessor?.HttpContext?.Session ?? null;
	string role = ViewData["Role"] as string ?? "KeKhaiDangKyGiaCsKd";
	int pageSize = Model.PageSize;
	string timKiem = Model.Search ?? "";
	int pageCurrent = Model.PageCurrent;
	string maNghe = ViewData["MaNghe"] as string ?? "";
	ViewData["PageInfo"] = Model;
}

@section custom_style {
}

@section custom_script {
	<script src="~/js/site.js"></script>
	<script>
		$(document).ready(function () {
			$('.select2multi').select2();
			HandleRegisterFormFilter('#FilterForm', '#Pagination', '/KeKhaiDangKyGia/CoSoKinhDoanh');
		});

		function ClearTxtSearch() {
			$('#txt_Search').val('');
			$('#FilterForm').submit();
		}
	</script>
}

<div class="card card-custom">
	<div class="card-header flex-nowrap border-0 pt-6 pb-0">
		<div class="card-title" style="min-width: 0; flex: 1;">
			<h3 class="card-label" style="text-overflow: ellipsis; overflow: hidden; white-space: nowrap; width: 100%;">
				Quản lý <b title="Thông tin Cơ sở kinh doanh @ViewData["Title"]?.ToString()?.ToUpper()">Thông tin Cơ sở kinh doanh @ViewData["Title"]?.ToString()?.ToUpper()</b>
			</h3>
		</div>
		<div class="card-toolbar" style="flex-shrink: 0;">
			@if (session != null && FuntionGlobal.CheckPermission(session, role, "Create"))
			{
				<button type="button" class="btn btn-primary font-weight-bolder" onclick="Create('@maNghe')">
					<i class="la la-plus"></i>Thêm mới
				</button>
			}
		</div>
	</div>
	@Html.AntiForgeryToken()
	<div class="card-body pt-0">
		<hr />
		<form id="FilterForm" method="GET" action="/KeKhaiDangKyGia/CoSoKinhDoanh">
			<input type="hidden" name="MaNghe" value="@maNghe" />
			<div class="row">
				<div class="col-xl-3" style="text-align:left">
					<div class="form-group fv-plugins-icon-container">
						<label class="text-blue">Hiển thị</label>
						<select class="form-control h-40px" name="PageSize" id="PageSize_Select">
							<!option value="5" @(pageSize == 5 ? "selected" : "")>5 thông tin</!option>
							<!option value="10" @(pageSize == 10 ? "selected" : "")>10 thông tin</!option>
							<!option value="20" @(pageSize == 20 ? "selected" : "")>20 thông tin</!option>
							<!option value="50" @(pageSize == 50 ? "selected" : "")>50 thông tin</!option>
							<!option value="100" @(pageSize == 100 ? "selected" : "")>100 thông tin</!option>
						</select>
					</div>
				</div>

				<div class="col-xl-9">
					<div class="form-group fv-plugins-icon-container">
						<label class="text-blue">Tìm kiếm</label>
						<div class="input-group">
							<input class="form-control h-40px" name="Search" id="txt_Search" placeholder="Tìm kiếm theo tên cơ sở, địa chỉ, số điện thoại, doanh nghiệp..." value="@timKiem">
							<div class="input-group-prepend">
								<button class="btn btn-danger" type="button" onclick="ClearTxtSearch()"><i class="las la-times-circle"></i></button>
							</div>
							<div class="input-group-append">
								<button class="btn btn-primary" type="submit"><i class="las la-search"></i></button>
							</div>
						</div>
					</div>
				</div>
			</div>
			<input hidden id="PageCurrent" name="PageCurrent" value="@pageCurrent" />
		</form>
		<!--begin: Datatable-->
		<div class="table-responsive border rounded-lg mb-8">
			<table class="table table-striped table-hover table-responsive-lg rounded-lg">
				<thead>
					<tr style="text-align:center;" class="table-active">
						<th style="font-weight: bold;" width="5%">STT</th>
						<th style="font-weight: bold;">Doanh nghiệp quản lý</th>
						<th style="font-weight: bold;">Tên cơ sở kinh doanh</th>
						<th style="font-weight: bold;">Địa chỉ</th>
						<th style="font-weight: bold;">Số điện thoại</th>
						<th style="font-weight: bold;" width="10%">Thao tác</th>
					</tr>
				</thead>
				<tbody>
					@if (Model.Data != null && Model.Data.Any())
					{
						int stt = (Model.PageCurrent - 1) * Model.PageSize + 1;
						@foreach (var item in Model.Data)
						{
							<tr>
								<td style="text-align: center; vertical-align: middle">@stt</td>
								<td style="vertical-align: middle">
									@(item.DoanhNghiepQuanLy?.TenDoanhNghiep ?? "Không xác định")
								</td>
								<td style="font-weight: bold; vertical-align: middle">@item.TenCsKd</td>
								<td style="vertical-align: middle">@item.DiaChi</td>
								<td style="vertical-align: middle">@item.SoDienThoai</td>
								<td class="text-center" style="vertical-align: middle">
									<a asp-controller="KeKhaiDangKyGia" asp-action="Index" asp-route-CoSoKinhDoanhQuanLyId="@item.Id" asp-route-MaNghe="@maNghe" class="btn btn-sm btn-clean btn-icon" title="Xem chi tiết">
										<i class="icon-lg la la-eye text-success"></i>
									</a>
									@if (session != null && FuntionGlobal.CheckPermission(session, role, "Edit"))
									{
										<button type="button" onclick="Edit('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Chỉnh sửa">
											<i class="icon-lg la la-edit text-success"></i>
										</button>
									}
									@if (session != null && FuntionGlobal.CheckPermission(session, role, "Delete"))
									{
										<button type="button" class="btn btn-sm btn-clean btn-icon" title="Xóa" onclick="Delete('@item.Id', '@item.TenCsKd')">
											<i class="icon-lg la la-trash text-danger"></i>
										</button>
									}
								</td>
							</tr>
							stt++;
						}
					}
					else
					{
						<tr>
							<td style="text-align:center" colspan="6">Không tìm thấy thông tin!!!</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<!--end: Datatable-->
		<div id="Pagination">
			@await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
		</div>
	</div>
</div>
@await Html.PartialAsync("~/Views/Admin/KeKhaiDangKyGia/CoSoKinhDoanh/Modal.cshtml")
