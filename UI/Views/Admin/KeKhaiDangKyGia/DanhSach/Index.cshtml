@using UI.ViewModels;
@using DataAccess.Entities.KeKhaiDangKyGia;

@model VMPageInfoWithData<KeKhaiDangKyGia>

@{
	var session = HttpContextAccessor?.HttpContext?.Session ?? null;
	string role = ViewData["Role"] as string ?? "KeKhaiDangKyGia";
	int pageSize = Model.PageSize;
	string timKiem = Model.Search ?? "";
	int pageCurrent = Model.PageCurrent;
	string maNghe = ViewData["MaNghe"] as string ?? "";
	Guid doanhNghiepQuanLyId = (Guid)(ViewData["DoanhNghiepQuanLyId"] ?? Guid.Empty);
	var dn = ViewData["DoanhNghiep"] as DoanhNghiep;
	var filter = ViewData["Filter"] as Services.DTOs.KeKhaiDangKyGia.KeKhaiDangKyGiaFilter;
	ViewData["PageInfo"] = Model;
}

@section custom_style {
}

@section custom_script {
	<script src="~/js/site.js"></script>
	<script>
		$(document).ready(function () {
			HandleRegisterFormFilter('#FilterForm', '#Pagination', '/KeKhaiDangKyGia');
			SetupSelect2('#DoanhNghiepQuanLyId_Select', 'Lựa Chọn Doanh Nghiệp', { enableSearch: true, enableClear: false });
			SetupSelect2('#TargetYear_Select', 'Lựa Chọn Năm', { enableSearch: false, enableClear: false });
		});

		function ClearTxtSearch() {
			$('#txt_Search').val('');
			$('#FilterForm').submit();
		}

		const HandleConfirmChuyen = (hoSoId, soQd) => {
			$('#soqd_chuyen').text(soQd);
			$('#chuyenId').val(hoSoId);
			$('#Chuyen_Modal').modal('show');
		}

		const SubmitChuyenForm = (e) => {
			e.preventDefault();
			const urlPost = $('#ChuyenForm').attr('action');
			HandlePostAjax({
				url: urlPost,
				data: new FormData($('#ChuyenForm')[0]),
				successCallback: (res) => {
					if (res.isValid) {
						$('#Chuyen_Modal').modal('hide');
						Swal.fire({
							icon: "success",
							title: "<span class='font-weight-boldest font-size-h1 text-capitalize text-blue mb-n5'>Thành công!</span>",
							text: res.message,
							confirmButtonText: "Tiếp tục",
							confirmButtonClass: 'btn btn-primary font-weight-bold',
						}).then(() => {
							window.location.reload();
						});
					}
					else {
						toastr.warning(res.message || 'Có lỗi khi thao tác với dữ liệu', 'Cảnh Báo!');
					}
				},
				errorCallback: (xhr, status, error) => {
					toastr.error('Không nhận được phản hồi từ máy chủ. Vui lòng thử lại sau.');
				},
			});
		}

		const HandleShowModelLyDoTraLai = (maHoSo, soQuyetDinh, lyDoTraLai) => {
			$('#LyDoTraLai_Modal #soQuyetDinh').html(soQuyetDinh);
			$('#LyDoTraLai_Modal #lyDoTraLai').html(lyDoTraLai);
			$('#LyDoTraLai_Modal').modal('show');
		}
	</script>
}

<div class="card card-custom">
	<div class="card-header flex-nowrap border-0 pt-6 pb-0">
		<div class="card-title" style="min-width: 0; flex: 1;">
			<h3 class="card-label" style="text-overflow: ellipsis; overflow: hidden; white-space: nowrap; width: 100%;">
				Quản lý<b title="Thông tin hồ sơ kê khai đăng ký giá @ViewData["TenNghe"]?.ToString()?.ToUpper()">Thông tin hồ sơ kê khai đăng ký giá @ViewData["TenNghe"]?.ToString()?.ToUpper()</b>
				@if (dn != null)
				{
					<span class="d-block text-muted pt-2 font-size-sm" style="text-overflow: ellipsis; overflow: hidden; white-space: nowrap;" title="Doanh nghiệp: @dn.TenDoanhNghiep">
						Doanh nghiệp: <strong>@dn.TenDoanhNghiep</strong>
					</span>
				}
			</h3>
		</div>
		<div class="card-toolbar" style="flex-shrink: 0;">
			@if (doanhNghiepQuanLyId != Guid.Empty && session != null && FuntionGlobal.CheckPermission(session, role, "Create"))
			{
				<a href="/KeKhaiDangKyGia/Create?DoanhNghiepQuanLyId=@doanhNghiepQuanLyId&MaNghe=@maNghe" class="btn btn-primary font-weight-bolder">
					<i class="la la-plus"></i>Thêm mới
				</a>
			}
		</div>
	</div>
	@Html.AntiForgeryToken()
	<div class="card-body pt-0">
		<form id="FilterForm" method="GET" action="/KeKhaiDangKyGia">
			<input type="hidden" name="MaNghe" value="@maNghe" />
			
			<div class="row">
				<div class="col-xl-3">
					<div class="form-group fv-plugins-icon-container">
						<label style="font-weight:bold; color:blue">Năm:</label>
						<select class="form-control h-40px" name="Year" id="TargetYear_Select" onchange="$('#FilterForm').submit()">
							@for (int year = DateTime.Now.Year - 5; year <= DateTime.Now.Year; year++)
							{
								<!option value="@year" @(filter?.TargetYear == year ? "selected" : "")>Năm @year</!option>
							}
						</select>
					</div>
				</div>
				<div class="col-xl-6">
					<div class="form-group fv-plugins-icon-container">
						<label style="font-weight:bold; color:blue">Doanh nghiệp:</label>
						<select class="form-control h-40px" name="DoanhNghiepQuanLyId" id="DoanhNghiepQuanLyId_Select" onchange="$('#FilterForm').submit()">
							@if (FuntionGlobal.GetSsAdmin(session, "Level") != "Doanh nghiệp")
							{
								<!option value="all" @(doanhNghiepQuanLyId == Guid.Empty ? "selected" : "")>--- Tất cả ---</!option>
							}
							@foreach (var item in ViewData["DoanhNghieps"] as List<DoanhNghiep> ?? new List<DoanhNghiep>())
							{
								<!option value="@item.Id" @(doanhNghiepQuanLyId == item.Id ? "selected" : "")>@item.TenDoanhNghiep</!option>
							}
						</select>
					</div>
				</div>
			</div>
			<hr />
			<div class="row">
				<div class="col-xl-3" style="text-align:left">
					<div class="form-group fv-plugins-icon-container">
						<label class="text-blue">Hiển thị</label>
						<select class="form-control h-40px" name="PageSize" id="PageSize_Select">
							<!option value="5" @(pageSize == 5 ? "selected" : "")>5 thông tin</!option>
							<!option value="10" @(pageSize == 10 ? "selected" : "")>10 thông tin</!option>
							<!option value="20" @(pageSize == 20 ? "selected" : "")>20 thông tin</!option>
							<!option value="50" @(pageSize == 50 ? "selected" : "")>50 thông tin</!option>
							<!option value="100" @(pageSize == 100 ? "selected" : "")>100 thông tin</!option>
						</select>
					</div>
				</div>

				<div class="col-xl-9">
					<div class="form-group fv-plugins-icon-container">
						<label class="text-blue">Tìm kiếm</label>
						<div class="input-group">
							<input class="form-control h-40px" name="Search" id="txt_Search" placeholder="Tìm kiếm theo số quyết định, đơn vị tính, ghi chú..." value="@timKiem">
							<div class="input-group-prepend">
								<button class="btn btn-danger" type="button" onclick="ClearTxtSearch()"><i class="las la-times-circle"></i></button>
							</div>
							<div class="input-group-append">
								<button class="btn btn-primary" type="submit"><i class="las la-search"></i></button>
							</div>
						</div>
					</div>
				</div>
			</div>
			<input hidden id="sort_current" name="sort_current" value="@Model.Sort" />
			<input hidden id="PageCurrent" name="PageCurrent" value="@pageCurrent" />
		</form>
		<!--begin: Datatable-->
		<div class="table-responsive border rounded-lg mb-8">
			@await Html.PartialAsync("~/Views/Admin/KeKhaiDangKyGia/DanhSach/_DataTable.cshtml", Model.Data)
		</div>
		<!--end: Datatable-->
		<div id="Pagination">
			@await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
		</div>
	</div>
</div>
@await Html.PartialAsync("~/Views/Admin/KeKhaiDangKyGia/DanhSach/Modal.cshtml")
