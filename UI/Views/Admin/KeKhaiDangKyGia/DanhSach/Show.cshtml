<p>1. Mức giá kê khai bán trong nước:</p>
<div style="width: 100%; overflow-x: auto; margin-bottom: 20px;">
    @if (details != null && details.Any())
    {
        <table cellspacing="0" cellpadding="5" border="1" style="margin: 20px auto; border-collapse: collapse; font: normal 14px Times, serif; width: 100%;" id="data">
            <thead>
                <tr style="background-color: #f2f2f2; text-align: center; font-weight: bold;">
                    <th width="3%">STT</th>
                    <th>Tên hàng hóa, dịch vụ</th>
                    <th>Đặc điểm kinh tế - <br />kỹ thuật, quy cách</th>
                    <th>Đơn vị<br>tính</th>
                    <th>Loại giá<br /> (bán buôn, bán lẻ)</th>
                    <th width="10%">Giá kê khai kỳ liền kề trước<br /> (kèm số văn bản kê khai)</th>
                    <th width="10%">Giá kê khai<br /> kỳ này</th>
                    <th>Thời điểm định giá,<br />điều chỉnh giá</th>
                    <th>Mức tăng/ giảm so với<br /> kỳ liền kề trước</th>
                    <th>Tỷ lệ tăng/ giảm so với<br /> kỳ liền kề trước</th>
                    <th>Ghi chú</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in details)
                {
                    <tr>
                        <td style="text-align: center">@(record_id++)</td>
                        <td>@item.TenDvCungUng</td>
                        <td>@item.QuyCachChatLuong</td>
                        <td style="text-align: center">@item.DonViTinh</td>
                        <td style="text-align: center">@item.LoaiGia</td>
                        <td style="text-align: right">@FormatNumber(item.MucGiaKeKhaiLk)</td>
                        <td style="text-align: right">@FormatNumber(item.MucGiaKeKhai)</td>
                        <td style="text-align: center"></td>
                        <td style="text-align: right">@FormatNumber(item.MucGiaKeKhai - item.MucGiaKeKhaiLk)</td>
                        @if (item.MucGiaKeKhaiLk == 0)
                        {
                            <td style="text-align: right">100%</td>
                        }
                        else
                        {
                            <td style="text-align: right">
                                @FormatPercent((item.MucGiaKeKhai - item.MucGiaKeKhaiLk) / item.MucGiaKeKhaiLk * 100)%
                            </td>
                        }
                        <td>@item.GhiChu</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else if (cellData != null && rowIndices.Any())
    {
        var headerRowIdx = rowIndices.FirstOrDefault();
        <table cellspacing="0" cellpadding="5" border="1" style="width: 100%; border-collapse: collapse; font: normal 14px Times, serif;" id="data_render">
            <tbody>
                @foreach (var r in rowIndices)
                {
                    <tr>
                        @for (int c = 0; c <= maxCol; c++)
                        {
                            string cellKey = $"{r}_{c}";
                            bool skipCell = false;
                            int rowSpan = 1;
                            int colSpan = 1;

                            if (mergeLookup.TryGetValue(cellKey, out var mergeInfo))
                            {
                                if (mergeInfo.isChild)
                                {
                                    skipCell = true;
                                }
                                else if (mergeInfo.isParent)
                                {
                                    rowSpan = mergeInfo.rowSpan;
                                    colSpan = mergeInfo.colSpan;
                                }
                            }

                            if (!skipCell)
                            {
                                var cell = cellData[r.ToString()]?[c.ToString()];
                                var cellVal = cell?["v"]?.ToString() ?? "";
                                
                                var styleKey = cell?["s"]?.ToString();
                                JObject? style = null;
                                if (!string.IsNullOrEmpty(styleKey) && styles != null)
                                {
                                    style = styles[styleKey] as JObject;
                                }

                                string align = "";
                                if (style != null && style["ht"] != null)
                                {
                                    var ht = style["ht"]?.ToString() ?? "";
                                    if (ht == "1") align = "text-align: left;";
                                    else if (ht == "2") align = "text-align: center;";
                                    else if (ht == "3") align = "text-align: right;";
                                }
                                
                                if (string.IsNullOrEmpty(align) && double.TryParse(cellVal, out _))
                                {
                                    align = "text-align: right;";
                                }
                                
                                string weight = "";
                                if (style != null && style["bl"] != null && style["bl"]?.ToString() == "1")
                                {
                                    weight = "font-weight: bold;";
                                }
                                
                                string fontStyle = "";
                                if (style != null && style["it"] != null && style["it"]?.ToString() == "1")
                                {
                                    fontStyle = "font-style: italic;";
                                }

                                if (r == headerRowIdx)
                                {
                                    <th rowspan="@rowSpan" colspan="@colSpan" style="background-color: #f2f2f2; text-align: center; @align @weight @fontStyle">@cellVal</th>
                                }
                                else
                                {
                                    <td rowspan="@rowSpan" colspan="@colSpan" style="@align @weight @fontStyle">@cellVal</td>
                                }
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <table cellspacing="0" cellpadding="5" border="1" style="width: 100%; border-collapse: collapse; font: normal 14px Times, serif;">
            <tbody>
                <tr>
                    <td style="text-align: center; padding: 20px;">Không có dữ liệu chi tiết!</td>
                </tr>
            </tbody>
        </table>
    }
</div>

<p>2. Mức giá kê khai bán xuất khẩu:</p>
<p>
    3. Phân tích nguyên nhân điều chỉnh giá bán giữa lần kê khai giá kỳ này so với kỳ liền kề trước:
    nêu cụ thể nguyên nhân do biến động của các yếu tố hình thành giá và các nguyên nhân khác tác động làm
    tăng hoặc giảm giá hàng hóa, dịch vụ.
</p>
<p>
    4. Ghi rõ mức thuế giá trị gia tăng đã bao gồm trong giá.
</p>