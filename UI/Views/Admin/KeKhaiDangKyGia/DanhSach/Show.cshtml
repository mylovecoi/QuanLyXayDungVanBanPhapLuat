@using Newtonsoft.Json.Linq
@using System.Reflection
@using UI.Helper
@model DataAccess.Entities.KeKhaiDangKyGia.KeKhaiDangKyGia
@{
    Layout = "_LayoutReport";
    var record_id = 1;
    var details = ViewData["Details"] as IEnumerable<DataAccess.Entities.KeKhaiDangKyGia.KeKhaiDangKyGiaCt>;
    var donViQuanLy = ViewData["DonViQuanLy"] as DataAccess.Entities.Settings.DanhMucDonVi;

    Func<double, string> FormatNumber = (val) => val.ToString("N0", new System.Globalization.CultureInfo("vi-VN"));
    Func<double, string> FormatPercent = (val) => val.ToString("N2", new System.Globalization.CultureInfo("vi-VN"));

    JObject? excelData = null;
    JToken? cellData = null;
    JObject? styles = null;
    int maxCol = 0;
    List<int> rowIndices = new List<int>();
    var mergeLookup = new Dictionary<string, (bool isParent, bool isChild, int rowSpan, int colSpan)>();

    var spreadsheetJson = Model.ChiTietExcel;
    if (!string.IsNullOrEmpty(spreadsheetJson))
    {
        try
        {
            excelData = JObject.Parse(spreadsheetJson);
            styles = excelData["styles"] as JObject;
            var sheets = excelData["sheets"] as JObject;
            var firstSheet = sheets?.Properties()?.FirstOrDefault()?.Value as JObject;
            cellData = firstSheet?["cellData"];
            
            var mergeData = firstSheet?["mergeData"] as JArray;
            if (mergeData != null)
            {
                foreach (var m in mergeData)
                {
                    int sR = m["startRow"]?.Value<int>() ?? 0;
                    int eR = m["endRow"]?.Value<int>() ?? 0;
                    int sC = m["startColumn"]?.Value<int>() ?? 0;
                    int eC = m["endColumn"]?.Value<int>() ?? 0;

                    int rSpan = eR - sR + 1;
                    int cSpan = eC - sC + 1;

                    for (int r = sR; r <= eR; r++)
                    {
                        for (int c = sC; c <= eC; c++)
                        {
                            string key = $"{r}_{c}";
                            if (r == sR && c == sC)
                            {
                                mergeLookup[key] = (true, false, rSpan, cSpan);
                            }
                            else
                            {
                                mergeLookup[key] = (false, true, 0, 0);
                            }
                        }
                    }
                }
            }

            if (cellData != null)
            {
                foreach (var rowProp in cellData.Children<JProperty>())
                {
                    if (int.TryParse(rowProp.Name, out int rIdx))
                    {
                        rowIndices.Add(rIdx);
                        var colProps = rowProp.Value as JObject;
                        if (colProps != null)
                        {
                            foreach (var colProp in colProps.Properties())
                            {
                                if (int.TryParse(colProp.Name, out int cIdx))
                                {
                                    if (cIdx > maxCol)
                                    {
                                        maxCol = cIdx;
                                    }
                                }
                            }
                        }
                    }
                }
                rowIndices.Sort();
            }
        }
        catch { }
    }

    var tenDn = Model.DoanhNghiepQuanLy?.TenDoanhNghiep ?? "";
    var diaChiDn = Model.DoanhNghiepQuanLy?.DiaChi ?? "";
    var soDienThoaiDn = Model.DoanhNghiepQuanLy?.SoDienThoai ?? "";
    var emailDn = Model.DoanhNghiepQuanLy?.Email ?? "";
    var tenDvHienThi = donViQuanLy?.TenDonVi ?? "";
}

