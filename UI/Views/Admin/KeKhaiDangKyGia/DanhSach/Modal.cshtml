<!--Delete Modal-->
<div class="modal fade" id="Delete_Modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="card-label">
                    Xóa hồ sơ kê khai giá
                    <span class="d-block text-muted pt-2 font-size-sm">Xóa hồ sơ kê khai đăng ký giá</span>
                </h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <form asp-controller="KeKhaiDangKyGia" asp-action="Delete" method="post">
                <div class="modal-body">
                    <div class="form-group fv-plugins-icon-container">
                        <label>
                            Số quyết định:&nbsp;<b id="ten_delete" name="ten_delete" style="color: #0000FF"></b>
                        </label>
                    </div>
                    <input hidden id="id_delete" name="id_delete" />
                    <input hidden id="doanhnghiep_delete" name="DoanhNghiepQuanLyId" value="@ViewData["DoanhNghiepQuanLyId"]" />
                    <input hidden id="manghe_delete" name="MaNghe" value="@ViewData["MaNghe"]" />
                    @Html.AntiForgeryToken()
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light-primary font-weight-bold" data-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger font-weight-bold">Đồng ý</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!--Chuyen Modal-->
<div class="modal fade" id="Chuyen_Modal" data-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <form id="ChuyenForm" method="post" asp-controller="KeKhaiDangKyGia" asp-action="Chuyen" onsubmit="SubmitChuyenForm(event)">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h3 class="card-label">
                        Chuyển thông tin hồ sơ kê khai giá
                        <span class="d-block text-muted pt-2 font-size-sm">
                            Chuyển thông tin hồ sơ kê khai đăng ký giá
                        </span>
                    </h3>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <i aria-hidden="true" class="ki ki-close"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-custom alert-light-primary fade show mb-5" role="alert">
                        <div class="alert-text font-weight-bold text-primary">
                            Hồ sơ đã hoàn thành sẽ được chuyển lên đơn vị tiếp nhận. Bạn cần liên hệ đơn vị tiếp nhận để chỉnh sửa hồ sơ nếu cần!
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xl-12 mb-3">
                            <div class="form-group m-0">
                                <label>Số QĐ:&nbsp;<b id="soqd_chuyen" style="color: #0000FF"></b></label>
                            </div>
                        </div>
                        <div class="col-xl-12 mb-3">
                            <div class="form-group">
                                <label class="control-label font-weight-bold">Họ và tên người nộp biểu mẫu:</label>
                                <input type="text" class="form-control" name="thongTinNguoiChuyen" required />
                            </div>
                        </div>
                        <div class="col-xl-12 mb-3">
                            <div class="form-group">
                                <label class="control-label font-weight-bold">Số điện thoại liên lạc:</label>
                                <input type="text" class="form-control" name="soDtNguoiChuyen" required />
                            </div>
                        </div>
                    </div>
                    <input id="chuyenId" name="hoSoId" type="hidden" />
                    <input id="donvi_chuyen" name="donViQuanLyId" type="hidden" value="@ViewData["DonViQuanLyId"]" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Hủy thao tác</button>
                    <button type="submit" class="btn btn-primary font-weight-bold">Hoàn thành</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!--LyDoTraLai Modal-->
<div class="modal fade" id="LyDoTraLai_Modal" data-backdrop="static" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="card-label">
                    Lý do trả lại hồ sơ
                    <span class="d-block text-muted pt-2 font-size-sm">
                        Chi tiết lý do trả lại hồ sơ
                    </span>
                </h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-xl-12 col-md-12 mb-3">
                    <div class="form-group m-0">
                        <label>Số QĐ:&nbsp;<b id="soQuyetDinh" style="color: #0000FF"></b></label>
                    </div>
                </div>
                <div class="col-xl-12 col-md-12">
                    <div class="form-group m-0">
                        <label>Lý do trả lại:&nbsp;<b id="lyDoTraLai" style="color: #FF0000"></b></label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-primary font-weight-bold" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<script>
    function Delete(id, name) {
        document.getElementById("id_delete").value = id;
        document.getElementById("ten_delete").innerHTML = name;
        $('#Delete_Modal').modal('show');
    }
</script>
