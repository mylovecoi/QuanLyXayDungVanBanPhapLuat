							icon: "success",
							title: "<span class='font-weight-boldest font-size-h1 text-capitalize text-blue mb-n5'>Thành công!</span>",
							text: res.message,
							confirmButtonText: "Tiếp tục",
							confirmButtonClass: 'btn btn-primary font-weight-bold',
						}).then(() => {
							window.location.reload();
						});
					} else {
						toastr.warning(res.message || 'Có lỗi khi thao tác với dữ liệu', 'Cảnh Báo!');
					}
				},
				errorCallback: (xhr, status, error) => {
					toastr.error('Không nhận được phản hồi từ máy chủ. Vui lòng thử lại sau.');
				},
			});
		}

		const HandleTraLai = (hoSoId, soQd) => {
			$('#soqd_tralai').text(soQd);
			$('#tralaiId').val(hoSoId);
			$('#Lydo_Input').val('');
			$('#TraLai_Modal').modal('show');
		}

		const SubmitTraLaiForm = (e) => {
			e.preventDefault();
			const urlPost = $('#TraLaiForm').attr('action');
			HandlePostAjax({
				url: urlPost,
				data: new FormData($('#TraLaiForm')[0]),
				successCallback: (res) => {
					if (res.isValid) {
						$('#TraLai_Modal').modal('hide');
						Swal.fire({
							icon: "success",
							title: "<span class='font-weight-boldest font-size-h1 text-capitalize text-blue mb-n5'>Thành công!</span>",
							text: res.message,
							confirmButtonText: "Tiếp tục",
							confirmButtonClass: 'btn btn-primary font-weight-bold',
						}).then(() => {
							window.location.reload();
						});
					} else {
						toastr.warning(res.message || 'Có lỗi khi thao tác với dữ liệu', 'Cảnh Báo!');
					}
				},
				errorCallback: (xhr, status, error) => {
					toastr.error('Không nhận được phản hồi từ máy chủ. Vui lòng thử lại sau.');
				},
			});
		}

		const HandleCongBo = (hoSoId, soQd) => {
			$('#soqd_congbo').text(soQd);
			$('#congboId').val(hoSoId);
			$('#CongBo_Modal').modal('show');
		}

		const SubmitCongBoForm = (e) => {
			e.preventDefault();
			const urlPost = $('#CongBoForm').attr('action');
			HandlePostAjax({
				url: urlPost,
				data: new FormData($('#CongBoForm')[0]),
				successCallback: (res) => {
					if (res.isValid) {
						$('#CongBo_Modal').modal('hide');
						Swal.fire({
							icon: "success",
							title: "<span class='font-weight-boldest font-size-h1 text-capitalize text-blue mb-n5'>Thành công!</span>",
							text: res.message,
							confirmButtonText: "Tiếp tục",
							confirmButtonClass: 'btn btn-primary font-weight-bold',
						}).then(() => {
							window.location.reload();
						});
					} else {
						toastr.warning(res.message || 'Có lỗi khi thao tác với dữ liệu', 'Cảnh Báo!');
					}
				},
				errorCallback: (xhr, status, error) => {
					toastr.error('Không nhận được phản hồi từ máy chủ. Vui lòng thử lại sau.');
				},
			});
		}

		const HandleHuyCongBo = (hoSoId, soQd) => {
			$('#soqd_huycongbo').text(soQd);
			$('#huycongboId').val(hoSoId);
			$('#HuyCongBo_Modal').modal('show');
		}

		const SubmitHuyCongBoForm = (e) => {
			e.preventDefault();
			const urlPost = $('#HuyCongBoForm').attr('action');
			HandlePostAjax({
				url: urlPost,
				data: new FormData($('#HuyCongBoForm')[0]),
				successCallback: (res) => {
					if (res.isValid) {
						$('#HuyCongBo_Modal').modal('hide');
						Swal.fire({
							icon: "success",
							title: "<span class='font-weight-boldest font-size-h1 text-capitalize text-blue mb-n5'>Thành công!</span>",
							text: res.message,
							confirmButtonText: "Tiếp tục",
							confirmButtonClass: 'btn btn-primary font-weight-bold',
						}).then(() => {
							window.location.reload();
						});
					} else {
						toastr.warning(res.message || 'Có lỗi khi thao tác với dữ liệu', 'Cảnh Báo!');
					}
				},
				errorCallback: (xhr, status, error) => {
					toastr.error('Không nhận được phản hồi từ máy chủ. Vui lòng thử lại sau.');
				},
			});
		}
	</script>
}
