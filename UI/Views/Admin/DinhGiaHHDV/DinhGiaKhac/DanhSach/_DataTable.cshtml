@model List<DataAccess.Entities.DinhGiaHHDV.DinhGia>
@{
    var session = HttpContextAccessor?.HttpContext?.Session ?? null;
    string role = ViewData["Role"] as string ?? "";
}
<table class="table table-striped table-hover table-responsive-lg rounded-lg m-0">
    <thead class="thead-light">
        <tr style="text-align:center;" class="table-active">
            <th width="5%">#</th>
            <th width="10%" style="font-weight: bold;">@Html.DisplayNameFor(x => x.First().DonViQuanLyId)</th>
            <th width="10%" style="font-weight: bold;">@Html.DisplayNameFor(x => x.First().SoQd)</th>
            <th style="font-weight: bold;">@Html.DisplayNameFor(x => x.First().ThoiDiem)</th>
            <th style="font-weight: bold;">@Html.DisplayNameFor(x => x.First().MoTa)</th>
            <th style="font-weight: bold;">@Html.DisplayNameFor(x => x.First().GhiChu)</th>
            <th width="10%" style="font-weight: bold;">@Html.DisplayNameFor(x => x.First().TrangThai)</th>
            <th width="15%" style="font-weight: bold;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count() > 0)
        {
            var pageInfo = ViewData["PageInfo"] as VMPageInfo;
            foreach (var item in Model)
            {
                <tr class="@FuntionGlobal.GetClassTableWithStatus(item.TrangThai)">
                    <td class="text-center" style="vertical-align: middle">
                        @(pageInfo!.RecordStart++)
                    </td>
                    <td style="vertical-align: middle">@item.DonViQuanLy?.TenDonVi</td>
                    <td class="text-nowrap text-primary font-weight-boldest" style="vertical-align: middle">
                        @item.SoQd
                    </td>
                    <td class="text-center text-nowrap text-primary font-weight-boldest" style="vertical-align: middle">
                        @FuntionGlobal.ConvertDateToStr(item.ThoiDiem)
                    </td>
                    <td style="vertical-align: middle">@item.MoTa</td>
                    <td style="vertical-align: middle">@item.GhiChu</td>
                    <td class="text-center text-nowrap" style="vertical-align: middle">
                        @{
                            string labelText = "";
                            string labelClass = "label label-lg label-inline font-weight-bolder";
                            string ngayTitle = "";
                            string ngayValue = FuntionGlobal.ConvertDateToStr(item.ThoiDiem);

                            if (item.TrangThai == "CC")
                            {
                                labelText = "Chờ chuyển";
                                labelClass += " label-info";
                            }
                            else if (item.TrangThai == "CD")
                            {
                                labelText = "Chờ duyệt";
                                labelClass += " label-warning";
                                ngayTitle = "Ngày chuyển";
                            }
                            else if (item.TrangThai == "DD")
                            {
                                labelText = "Đã duyệt";
                                labelClass += " label-success";
                                ngayTitle = "Ngày duyệt";
                            }
                            else if (item.TrangThai == "BTL")
                            {
                                labelText = "Bị trả lại";
                                labelClass += " label-danger";
                                ngayTitle = "Ngày bị trả lại";
                            }
                            else if (item.TrangThai == "CB")
                            {
                                labelText = "Công bố";
                                labelClass += " label-success";
                                ngayTitle = "Ngày công bố";
                            }
                            else if(item.TrangThai == "HCB")
                            {
                                labelText = "Hủy công bố";
                                labelClass += " label-danger";
                                ngayTitle = "Ngày hủy công bố";
                            }

                            if (!string.IsNullOrEmpty(labelText))
                            {
                                <span class="@labelClass">@labelText</span>

                                if (!string.IsNullOrEmpty(ngayTitle))
                                {
                                    <br />
                                    <span>@ngayTitle</span>
                                    <br />
                                    <span>@ngayValue</span>
                                }
                            }
                        }
                    </td>
                    <td class="text-center text-nowrap" style="vertical-align: middle" id="tdAction_@item.Id">
                        <a class="btn btn-sm btn-clean btn-icon" title="Xem chi tiết" target="_blank"
                           asp-controller="DinhGia" asp-action="Show" asp-route-hoSoId="@item.Id">
                            <i class="icon-lg la la-eye text-success"></i>
                        </a>
                        @if (item.TrangThai == "CC" || item.TrangThai == "BTL")
                        {
                            if (session != null && FuntionGlobal.CheckPermission(session, role, "Edit"))
                            {
                                <a class="btn btn-sm btn-clean btn-icon" title="Chỉnh sửa" asp-controller="DinhGia" asp-action="Edit" asp-route-hoSoId="@item.Id">
                                    <i class="icon-lg la la-edit text-blue"></i>
                                </a>
                            }

                            if (session != null && FuntionGlobal.CheckPermission(session, role, "Edit"))
                            {
                                <button type="button" class="btn btn-sm btn-clean btn-icon" title="Chuyển" onclick="HandleConfirmChuyen('@item.Id', '@item.SoQd')">
                                    <i class="icon-lg la la-mail-forward text-warning"></i>
                                </button>
                            }

                            if (item.TrangThai == "BTL")
                            {
                                <button type="button" class="btn btn-sm btn-clean btn-icon" title="Lý do trả lại"
                                        onclick="HandleShowModelLyDoTraLai('@item.MaHoSo', '@item.SoQd', '@item.LyDo')">
                                    <i class="icon-lg la la-file text-danger"></i>
                                </button>
                            }

                            if (item.TrangThai == "CC")
                            {
                                if (session != null && FuntionGlobal.CheckPermission(session, role, "Delete"))
                                {
                                    <button type="button" class="btn btn-sm btn-clean btn-icon" title="Xóa" onclick="HandleConfirmDelteRow('@item.Id')">
                                        <i class="icon-lg la la-trash text-danger"></i>
                                    </button>
                                }
                            }
                        }
                     </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td style="text-align:center" colspan="8">Không tìm thấy thông tin!!!</td>
            </tr>
        }
    </tbody>
</table>