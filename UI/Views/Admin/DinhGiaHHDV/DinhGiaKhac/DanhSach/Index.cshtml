@using Services.DTOs.DinhGiaHHDV.ThongTinHoSo;
@model VMPageInfoWithData<DataAccess.Entities.DinhGiaHHDV.DinhGia>
@{
	ViewData["PageInfo"] = Model;
    var maNghe = ViewData["MaNghe"];
	var session = HttpContextAccessor?.HttpContext?.Session ?? null;
	string role = ViewData["Role"] as string ?? "";
	var filter = ViewData["Filter"] as DinhGiaFilter;
}

<div class="card card-custom">
	<div class="card-header flex-nowrap border-0 pt-6 pb-0">
		<div class="card-title" style="min-width: 0; flex: 1;">
			<h3 class="card-label" style="text-overflow: ellipsis; overflow: hidden; white-space: nowrap; width: 100%;">
				Quản lý <b title="@ViewData["Title"]?.ToString()?.ToUpper()">@ViewData["Title"]?.ToString()?.ToUpper()</b>
				@* <span class="d-block text-muted pt-2 font-size-sm" style="text-overflow: ellipsis; overflow: hidden; white-space: nowrap;" title="Quản Lý @FuntionGlobal.CapitalizeAll(ViewData["Title"]?.ToString())">
					Quản Lý @FuntionGlobal.CapitalizeAll(ViewData["Title"]?.ToString())
				</span> *@
			</h3>
		</div>
		<div class="card-toolbar" style="flex-shrink: 0;">
			@if (session != null && FuntionGlobal.CheckPermission(session, role, "Create"))
			{
				<button type="button" class="btn btn-sm btn-primary font-weight-bolder mr-2" id="btnCreateNew" style="display:none;" onclick="HandleBtnCreate()">
					<i class="la la-plus"></i>Thêm mới
				</button>
			}
		</div>
	</div>

	<div class="card-body pt-0">
        <form id="FilterForm">
			<div class="row">
				<div class="col-xl-3">
					<div class="form-group fv-plugins-icon-container">
						<label style="font-weight:bold; color:blue">Năm:</label>
						<select class="form-control h-40px" name="Year" id="TargetYear_Select">
							@for (int year = DateTime.Now.Year - 5; year <= DateTime.Now.Year; year++)
							{
								<!option value="@year" @(filter?.TargetYear == year ? "selected" : "")>Năm @year</!option>
							}
						</select>
					</div>
				</div>
				<div class="col-xl-3">
					<div class="form-group fv-plugins-icon-container">
						<label style="font-weight:bold; color:blue">Đơn vị:</label>
						<select class="form-control h-40px" name="DonViId" id="DanhMucDonVi_Select">
							@{
								var dmDonVi = ViewData["DanhMucDonVi"] as List<DataAccess.Entities.Settings.DanhMucDonVi>;
								if (dmDonVi != null && dmDonVi.Any())
									foreach (var item in dmDonVi)
									{
										string backIn = FuntionGlobal.GetBackIn(item.Level);
										bool selected = filter?.DonViId == item.Id;
										<option value="@item.Id" selected="@selected">
											@Html.Raw(backIn)
											@item.TenDonVi
										</option>
									}
							}
						</select>
					</div>
				</div>
			</div>
			<hr />
			<div class="row">
				<div class="col-xl-3" style="text-align:left">
					<div class="form-group fv-plugins-icon-container">
						<label class="text-blue">Hiển thị</label>
						<select class="form-control h-40px" name="PageSize" id="PageSize_Select">
							<!option value="5" @(filter?.PageSize == 5 ? "selected" : "")>5 thông tin</!option>
							<!option value="10" @(filter?.PageSize == 10 ? "selected" : "")>10 thông tin</!option>
							<!option value="20" @(filter?.PageSize == 20 ? "selected" : "")>20 thông tin</!option>
							<!option value="50" @(filter?.PageSize == 50 ? "selected" : "")>50 thông tin</!option>
							<!option value="100" @(filter?.PageSize == 100 ? "selected" : "")> 100 thông tin</!option>
						</select>
					</div>
				</div>
				<div class="col-xl-9">
					<div class="form-group fv-plugins-icon-container">
						<label class="text-blue">Tìm kiếm</label>
						<div class="input-group">
							<input class="form-control h-40px" name="Search" id="txt_Search" placeholder="Tìm kiếm..." value="@filter?.Search">
							<div class="input-group-prepend">
								<button class="btn btn-danger" type="reset"><i class="las la-times-circle"></i></button>
							</div>
							<div class="input-group-append">
								<button class="btn btn-primary" type="submit"><i class="las la-search"></i></button>
							</div>
						</div>
					</div>
				</div>
			</div>
			<input hidden id="sort_current" name="sort_current" value="@Model.Sort" />
			<input hidden id="PageCurrent" name="PageCurrent" value="@Model.PageCurrent" />
            <input hidden name="MaNghe" id="MaNghe_Selected" value="@maNghe">
		</form>
		<!--begin: Datatable-->
		<div class="table-responsive border rounded-lg mb-8">
			@await Html.PartialAsync("~/Views/Admin/DinhGiaHHDV/DinhGiaKhac/DanhSach/_DataTable.cshtml", Model.Data)
			<form id="DeleteForm" method="post" style="display:none;" asp-controller="DinhGia" asp-action="Delete">
				<input type="hidden" name="hoSoId" id="recordId" />
			</form>

		</div>
		<!--end: Datatable-->
		<div id="Pagination">
			@await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
		</div>
	</div>
</div>
@await Html.PartialAsync("~/Views/Shared/_ModalPartial.cshtml")
@await Html.PartialAsync("~/Views/Admin/DinhGiaHHDV/DinhGiaKhac/DanhSach/_Modal.cshtml")

@section custom_style {

}

@section custom_script {
@* page *@
	<script src="~/js/site.js"></script>
	<script>
		$(document).ready(function () {
			// 1. Khởi tạo các Select2
			SetupSelect2('#TargetYear_Select', 'Lựa Chọn Năm Làm Việc', { enableSearch: false, enableClear: false });
			SetupSelect2('#DanhMucDonVi_Select', 'Lựa Chọn Đơn Vị Làm Việc');

			// 2. Đăng ký sự kiện Filter (Lưu ý: Nếu hàm này dùng serialize, nó sẽ tự lấy MaNghe trong input hidden)
			HandleRegisterFormFilter('#FilterForm', '#Pagination', '');

			// 3. Xử lý logic validation cho form khác (giữ nguyên logic của bạn)
			$('#NamKetXuat, #DonViId').on('change', (event) => {
				const ele = event.currentTarget;
				DisplayValidationErrors.des('frmExportZip', ele.id);
			});

			// Toggle Create button based on chosen DonViId
			function toggleCreateButton() {
				var donviVal = $('#DanhMucDonVi_Select').val();
				if (donviVal && donviVal !== "all" && donviVal !== "") {
					$('#btnCreateNew').show();
				} else {
					$('#btnCreateNew').hide();
				}
			}
			toggleCreateButton();

			// 4. MỚI: Đảm bảo MaNghe không bị mất khi thao tác
			// Đôi khi các script khác làm thay đổi form, đoạn này ép buộc giá trị MaNghe 
			// luôn được lấy từ input hidden khi bắt đầu submit form lọc
			$('#FilterForm').on('submit', function () {
				var maNgheValue = $('#MaNghe_Selected').val();

				// Kiểm tra nếu input hidden trống nhưng trên URL còn MaNghe, thì sync lại
				if (!maNgheValue) {
					const urlParams = new URLSearchParams(window.location.search);
					const maNgheFromUrl = urlParams.get('MaNghe');
					if (maNgheFromUrl) {
						$('#MaNghe_Selected').val(maNgheFromUrl);
					}
				}
			});
		});

		const HandleBtnCreate = () => {
			const donViId = $('#DanhMucDonVi_Select').val();
			if (!donViId) {
				toastr.warning('Hiện tại bạn chưa thuộc quản lý của đơn vị/ phòng ban.');
				return;
			}

			const maNghe = $('#MaNghe_Selected').val();

			// AJAX to get categories
			$.ajax({
				url: '/DinhGia/GetCategories',
				type: 'POST',
				data: { maNghe: maNghe },
				headers: {
					'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
				},
				success: function (res) {
					if (res.status === 'success') {
						var $select = $('#danhMucSelection');
						$select.empty();
						$select.append('<option value="">--Chọn danh mục--</option>');
						$.each(res.data, function (i, item) {
							var selectedAttr = "";
							if (item.maNghe && maNghe && item.maNghe.toLowerCase() === maNghe.toLowerCase()) {
								selectedAttr = " selected";
							}
							$select.append('<option value="' + item.id + '"' + selectedAttr + '>' + item.tenDanhMuc + ' (' + item.maDanhMuc + ')</option>');
						});
						$select.trigger('change');
						$('#SelectCategory_Modal').modal('show');
					} else {
						toastr.error(res.message || 'Lỗi khi tải danh mục!');
					}
				},
				error: function () {
					toastr.error('Lỗi kết nối máy chủ!');
				}
			});
		}

		const SubmitCreateWithCategory = () => {
			const donViId = $('#DanhMucDonVi_Select').val();
			const maNghe = $('#MaNghe_Selected').val();
			const danhMucId = $('#danhMucSelection').val();

			if (!danhMucId) {
				toastr.warning('Vui lòng chọn danh mục áp dụng!');
				return;
			}

			$('#SelectCategory_Modal').modal('hide');

			const form = document.createElement('form');
			form.method = 'POST';
			form.action = '/DinhGia/Create';

			const inputDonVi = document.createElement('input');
			inputDonVi.type = 'hidden';
			inputDonVi.name = 'donViId';
			inputDonVi.value = donViId;
			form.appendChild(inputDonVi);

			const inputMaNghe = document.createElement('input');
			inputMaNghe.type = 'hidden';
			inputMaNghe.name = 'MaNghe';
			inputMaNghe.value = maNghe;
			form.appendChild(inputMaNghe);

			const inputDanhMuc = document.createElement('input');
			inputDanhMuc.type = 'hidden';
			inputDanhMuc.name = 'danhMucId';
			inputDanhMuc.value = danhMucId;
			form.appendChild(inputDanhMuc);

			const csrfToken = $('input[name="__RequestVerificationToken"]').val();
			if (csrfToken) {
				const inputCsrf = document.createElement('input');
				inputCsrf.type = 'hidden';
				inputCsrf.name = '__RequestVerificationToken';
				inputCsrf.value = csrfToken;
				form.appendChild(inputCsrf);
			}

			document.body.appendChild(form);
			form.submit();
		}

		const HandleConfirmChuyen = (hoSoId, soQd) => {
			$('#soqd_chuyen').text(soQd);
			$('#chuyenId').val(hoSoId);
			$('#Chuyen_Modal').modal('show');
		}

		const SubmitChuyenForm = (e) => {
			e.preventDefault();
			const urlPost = $('#ChuyenForm').attr('action');
			HandlePostAjax({
				url: urlPost,
				data: new FormData($('#ChuyenForm')[0]),
				successCallback: (res) => {
					if (res.isValid) {
						$('#Chuyen_Modal').modal('hide');
						Swal.fire({
							icon: "success",
							title: "<span class='font-weight-boldest font-size-h1 text-capitalize text-blue mb-n5'>Thành công!</span>",
							text: res.message,
							confirmButtonText: "Tiếp tục",
							confirmButtonClass: 'btn btn-primary font-weight-bold',
						}).then(() => {
							window.location.reload();
						});
					}
					else {
						toastr.warning(res.message || 'Có lỗi khi thao tác với dữ liệu', 'Cảnh Báo!');
					}
				},
				errorCallback: (xhr, status, error) => {
					toastr.error('Không nhận được phản hồi từ máy chủ. Vui lòng thử lại sau.');
				},
			});
		}

		const HandleShowModelLyDoTraLai = (maHoSo, soQuyetDinh, lyDoTraLai) => {
			$('#LyDoTraLai_Modal #soQuyetDinh').html(soQuyetDinh);
			$('#LyDoTraLai_Modal #lyDoTraLai').html(lyDoTraLai);
			$('#LyDoTraLai_Modal').modal('show');
		}
	</script>
@* lib *@
}