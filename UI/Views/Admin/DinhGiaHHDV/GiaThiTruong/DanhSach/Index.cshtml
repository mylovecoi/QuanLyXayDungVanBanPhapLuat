@using UI.ViewModels;
@using DataAccess.Entities.DinhGiaHHDV;
@using DataAccess.Entities.Settings;

@{
    var session = HttpContextAccessor?.HttpContext?.Session ?? null;
    string role = ViewData["Role"] as string ?? "";
    int year = (int)(ViewData["Year"] ?? DateTime.Now.Year);
    string thang = (string)(ViewData["Thang"] ?? "all");
    Guid donViId = (Guid)(ViewData["DonViId"] ?? Guid.Empty);
    string search = (string)(ViewData["Search"] ?? "");
    int pageSize = (int)(ViewData["PageSize"] ?? 5);
    int pageCurrent = (int)(ViewData["PageCurrent"] ?? 1);
    
    var dmDonVi = ViewData["DanhMucDonVi"] as List<DanhMucDonVi> ?? new List<DanhMucDonVi>();
    var dmDanhMuc = ViewData["GiaThiTruongDanhMuc"] as List<GiaThiTruongDanhMuc> ?? new List<GiaThiTruongDanhMuc>();

    int record_id = 1;
}

@model VMPageInfoWithData<GiaThiTruong>

<div class="card card-custom">
    <div class="card-header flex-nowrap border-0 pt-6 pb-0">
        <div class="card-title" style="min-width: 0; flex: 1;">
            <h3 class="card-label" style="text-overflow: ellipsis; overflow: hidden; white-space: nowrap; width: 100%;">
                Quản lý <b title="@ViewData["Title"]?.ToString()?.ToUpper()">@ViewData["Title"]?.ToString()?.ToUpper()</b>
                @* <span class="d-block text-muted pt-2 font-size-sm" style="text-overflow: ellipsis; overflow: hidden; white-space: nowrap;" title="Quản lý thêm, sửa, xóa thông tin hồ sơ giá thị trường">
                    Quản lý thêm, sửa, xóa thông tin hồ sơ giá thị trường
                </span> *@
            </h3>
        </div>
        <div class="card-toolbar" style="flex-shrink: 0;">
            @if (session != null && FuntionGlobal.CheckPermission(session, role, "Create"))
            {
                <button type="button" class="btn btn-sm btn-primary font-weight-bolder mr-2" id="btnCreateNew" style="display:none;" onclick="OpenCreateModal()">
                    <i class="la la-plus"></i>Thêm mới
                </button>
            }
        </div>
    </div>

    <div class="card-body pt-0">
        <form id="FilterForm" method="get" asp-controller="GiaThiTruong" asp-action="Index">
            <div class="row">
                <div class="col-xl-3">
                    <div class="form-group">
                        <label style="font-weight:bold; color:blue">Tháng:</label>
                        <select class="form-control h-40px" name="Thang" id="FilterThang_Select">
                            <!option value="all" @(thang == "all" ? "selected" : "")>-- Tất cả --</!option>
                            @for (int m = 1; m <= 12; m++)
                            {
                                <!option value="@m" @(thang == m.ToString() ? "selected" : "")>Tháng @m</!option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-xl-3">
                    <div class="form-group">
                        <label style="font-weight:bold; color:blue">Năm:</label>
                        <select class="form-control h-40px" name="Year" id="FilterYear_Select">
                            <!option value="all" @(year == 0 ? "selected" : "")>-- Tất cả --</!option>
                            @for (int y = DateTime.Now.Year - 5; y <= DateTime.Now.Year; y++)
                            {
                                <!option value="@y" @(year == y ? "selected" : "")>Năm @y</!option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-xl-4">
                    <div class="form-group">
                        <label style="font-weight:bold; color:blue">Đơn vị quản lý:</label>
                        <select class="form-control h-40px" name="DonViId" id="FilterDonVi_Select">
                            <!option value="all" @(donViId == Guid.Empty ? "selected" : "")>-- Tất cả --</!option>
                            @foreach (var item in dmDonVi)
                            {
                                string backIn = FuntionGlobal.GetBackIn(item.Level);
                                <!option value="@item.Id" @(donViId == item.Id ? "selected" : "")>
                                    @Html.Raw(backIn) @item.TenDonVi
                                </!option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="col-xl-3" style="text-align:left">
                    <div class="form-group">
                        <label class="text-blue">Hiển thị</label>
                        <select class="form-control h-40px" name="PageSize" id="PageSize_Select">
                            <!option value="5" @(pageSize == 5 ? "selected" : "")>5 thông tin</!option>
                            <!option value="10" @(pageSize == 10 ? "selected" : "")>10 thông tin</!option>
                            <!option value="20" @(pageSize == 20 ? "selected" : "")>20 thông tin</!option>
                            <!option value="50" @(pageSize == 50 ? "selected" : "")>50 thông tin</!option>
                            <!option value="100" @(pageSize == 100 ? "selected" : "")>100 thông tin</!option>
                        </select>
                    </div>
                </div>
                <div class="col-xl-9">
                    <div class="form-group">
                        <label class="text-blue">Tìm kiếm</label>
                        <div class="input-group">
                            <input class="form-control h-40px" name="Search" id="txt_Search" placeholder="Tìm kiếm theo số quyết định, ghi chú..." value="@search">
                            <div class="input-group-prepend">
                                <button class="btn btn-danger" type="button" onclick="ClearSearch()"><i class="las la-times-circle"></i></button>
                            </div>
                            <div class="input-group-append">
                                <button class="btn btn-primary" type="submit"><i class="las la-search"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <input hidden id="PageCurrent" name="PageCurrent" value="@pageCurrent" />
        </form>

        <!--begin: Datatable-->
        <div class="table-responsive border rounded-lg mb-8">
            <table class="table table-striped table-hover table-responsive-lg rounded-lg m-0">
                <thead class="thead-light">
                    <tr style="text-align:center;" class="table-active">
                        <th width="3%">#</th>
                        <th>Thời điểm báo cáo</th>
                        <th>Nhóm hàng hóa dịch vụ</th>
                        <th>Số quyết định/<br/>Ngày báo cáo</th>
                        <th>Số quyết định liền kề/<br/>Ngày báo cáo liền kề</th>
                        <th>Trạng thái</th>
                        <th width="10%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Data != null && Model.Data.Any())
                    {
                        @foreach (var item in Model.Data)
                        {
                            var catalogName = dmDanhMuc.FirstOrDefault(x => x.Id == item.ThongTuId)?.TenTT ?? "";
                            //var donViName = dmDonVi.FirstOrDefault(x => x.Id == item.DonViQuanLyId)?.TenDonVi ?? "";
                            <tr>
                                <td style="text-align:center; vertical-align:middle">@(record_id++)</td>
                                <td style="text-align: center; vertical-align: middle">Tháng @item.Thang / Năm @item.Nam</td>
                                <td style="font-weight: bold; vertical-align: middle;">@catalogName</td>
                                <td style="vertical-align: middle; text-align: center">
                                    <span class="text-primary font-weight-bold">@item.SoQd</span><br/>
                                    <span class="text-muted">@item.Thoidiem.ToString("dd/MM/yyyy")</span>
                                </td>
                                <td style="vertical-align: middle; text-align: center">
                                    <span class="text-primary font-weight-bold">@item.SoQdLk</span><br/>
                                    <span class="text-muted">@item.ThoiDiemLk.ToString("dd/MM/yyyy")</span>
                                </td>
                                <td style="text-align: center; vertical-align: middle">
                                    @if (item.TrangThai == "CC")
                                    {
                                        <span class="label font-weight-bold label-lg label-light-warning label-inline">Chờ chuyển</span>
                                    }
                                    else if (item.TrangThai == "CD")
                                    {
                                        <span class="label font-weight-bold label-lg label-light-primary label-inline">Chờ duyệt</span>
                                    }
                                    else if (item.TrangThai == "BTL")
                                    {
                                        <span class="label font-weight-bold label-lg label-light-danger label-inline">Bị trả lại</span>
                                    }
                                    else if (item.TrangThai == "DD")
                                    {
                                        <span class="label font-weight-bold label-lg label-light-success label-inline">Đã duyệt</span>
                                    }
                                    else if (item.TrangThai == "CB")
                                    {
                                        <span class="label font-weight-bold label-lg label-light-info label-inline">Công bố</span>
                                    }
                                    else if (item.TrangThai == "HCB")
                                    {
                                        <span class="label font-weight-bold label-lg label-danger label-inline text-white" style="background-color: #f64e60 !important;">Hủy công bố</span>
                                    }
                                    else
                                    {
                                        <span class="label font-weight-bold label-lg label-light-secondary label-inline">@item.TrangThai</span>
                                    }
                                </td>
                                <td style="vertical-align: middle; text-align: center">
                                    <a class="btn btn-sm btn-clean btn-icon" title="Xem chi tiết" target="_blank"
                                       asp-controller="GiaThiTruong" asp-action="Show" asp-route-hoSoId="@item.Id">
                                        <i class="icon-lg la la-eye text-primary"></i>
                                    </a>
                                    @if (item.TrangThai == "CC" || item.TrangThai == "BTL")
                                    {
                                        @if (session != null && FuntionGlobal.CheckPermission(session, role, "Edit"))
                                        {
                                            <a asp-controller="GiaThiTruong" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-clean btn-icon" title="Chỉnh sửa">
                                                <i class="icon-lg la la-edit text-success"></i>
                                            </a>
                                        }
                                        @if (session != null && FuntionGlobal.CheckPermission(session, role, "Edit"))
                                        {
                                            <button type="button" class="btn btn-sm btn-clean btn-icon" title="Chuyển" onclick="HandleConfirmChuyen('@item.Id', '@item.SoQd')">
                                                <i class="icon-lg la la-share text-warning"></i>
                                            </button>
                                        }
                                        @if (item.TrangThai == "CC")
                                        {
                                            @if (session != null && FuntionGlobal.CheckPermission(session, role, "Delete"))
                                            {
                                                <button type="button" class="btn btn-sm btn-clean btn-icon" title="Xóa" onclick="DeleteRecord('@item.Id')">
                                                    <i class="icon-lg la la-trash text-danger"></i>
                                                </button>
                                            }
                                        }
                                        @if (item.TrangThai == "BTL")
                                        {
                                            <button type="button" class="btn btn-sm btn-clean btn-icon" title="Lý do trả lại" onclick="HandleShowModelLyDoTraLai('@item.Id', '@item.SoQd', '@item.LyDo')">
                                                <i class="icon-lg la la-file text-danger"></i>
                                            </button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td style="text-align:center" colspan="8">Không tìm thấy thông tin!!!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!--end: Datatable-->
        <div id="Pagination">
            @await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
        </div>
    </div>
</div>

<!-- Modal Thêm mới -->
<div class="modal fade" id="CreateModal" tabindex="-1" role="dialog" aria-labelledby="createModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <form asp-controller="GiaThiTruong" asp-action="Create" method="post" id="CreateForm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="createModalLabel" style="font-weight:bold; color:blue">THÊM MỚI HỒ SƠ GIÁ THỊ TRƯỜNG</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="font-weight-bold">Đơn vị báo cáo:</label>
                        <select class="form-control select2multi" name="donViId" id="ModalDonVi_Select" style="width:100%" required>
                            @foreach (var item in dmDonVi)
                            {
                                string backIn = FuntionGlobal.GetBackIn(item.Level);
                                <!option value="@item.Id" @(donViId == item.Id ? "selected" : "")>
                                    @Html.Raw(backIn) @item.TenDonVi
                                </!option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Danh mục giá thị trường (Thông tư/Quyết định):</label>
                        <select class="form-control select2multi" name="thongTuId" id="ModalDanhMuc_Select" style="width:100%" required>
                            <option value="">-- Chọn danh mục --</option>
                            @foreach (var item in dmDanhMuc)
                            {
                                <option value="@item.Id">@item.TenTT</option>
                            }
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Tháng:</label>
                                <select class="form-control" name="thang" id="ModalThang_Select" required>
                                    @for (int m = 1; m <= 12; m++)
                                    {
                                        <!option value="@m" @(thang == m.ToString() || (thang == "all" && m == DateTime.Now.Month) ? "selected" : "")>Tháng @m</!option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Năm:</label>
                                <select class="form-control" name="nam" id="ModalNam_Select" required>
                                    @for (int y = DateTime.Now.Year - 5; y <= DateTime.Now.Year; y++)
                                    {
                                        <!option value="@y" @(year == y ? "selected" : "")>Năm @y</!option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary">Đồng ý</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!--Chuyen Modal-->
<div class="modal fade" id="Chuyen_Modal" data-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="chuyenModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <form id="ChuyenForm" method="post" asp-controller="GiaThiTruong" asp-action="Chuyen" onsubmit="SubmitChuyenForm(event)">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="chuyenModalLabel" style="font-weight:bold; color:blue">CHUYỂN HỒ SƠ GIÁ THỊ TRƯỜNG</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-custom alert-light-primary fade show mb-5" role="alert">
                        <div class="alert-text font-weight-bold text-primary">
                            Hồ sơ đã hoàn thành sẽ được chuyển lên đơn vị tiếp nhận. Bạn cần liên hệ đơn vị tiếp nhận để chỉnh sửa hồ sơ nếu cần!
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xl-12 mb-3">
                            <div class="form-group m-0">
                                <label>Số QĐ:&nbsp;<b id="soqd_chuyen" style="color: #0000FF"></b></label>
                            </div>
                        </div>
                        <div class="col-xl-12">
                            <div class="form-group m-0">
                                <label class="control-label font-weight-bold">Trạng thái hồ sơ:</label>
                                <select class="form-control" id="trangthai_chuyen" name="trangThai">
                                    <option value="CD">Chờ duyệt</option>
                                    @if (session != null && FuntionGlobal.CheckPermission(session, role, "Approve"))
                                    {
                                        <option value="DD">Đã duyệt</option>
                                    }
                                    @if (session != null && FuntionGlobal.CheckPermission(session, role, "Public"))
                                    {
                                        <option value="CB">Công bố</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <input id="chuyenId" name="hoSoId" type="hidden" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy thao tác</button>
                    <button type="submit" class="btn btn-primary">Hoàn thành</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!--LyDoTraLai Modal-->
<div class="modal fade" id="LyDoTraLai_Modal" data-backdrop="static" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thông tin hồ sơ bị trả lại</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-xl-12">
                        <label>Số quyết định:&nbsp;<b id="soQuyetDinh" style="color: #0000FF"></b></label>
                    </div>
                    <div class="col-xl-12">
                        <label>Lý do trả lại:&nbsp;<b id="lyDoTraLai" style="color: #FF0000"></b></label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<form id="DeleteForm" method="post" asp-controller="GiaThiTruong" asp-action="Delete" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="DeleteRecordId" />
</form>

@section custom_script {
    <script src="~/js/site.js"></script>
    <script>
        $(document).ready(function () {
            SetupSelect2('#FilterYear_Select', 'Lựa Chọn Năm', { enableSearch: false, enableClear: false });
            SetupSelect2('#FilterThang_Select', 'Lựa Chọn Tháng', { enableSearch: false, enableClear: false });
            SetupSelect2('#FilterDonVi_Select', 'Lựa Chọn Đơn Vị');
            SetupSelect2('#PageSize_Select', 'Hiển thị', { enableSearch: false, enableClear: false });
            
            $('#FilterYear_Select, #FilterThang_Select, #FilterDonVi_Select, #PageSize_Select').change(function() {
                $('#PageCurrent').val(1);
                $('#FilterForm').submit();
            });

            // Toggle Create button based on chosen DonViId
            function toggleCreateButton() {
                var donviVal = $('#FilterDonVi_Select').val();
                if (donviVal && donviVal !== "all" && donviVal !== "") {
                    $('#btnCreateNew').show();
                } else {
                    $('#btnCreateNew').hide();
                }
            }
            toggleCreateButton();
        });

        function ClearSearch() {
            $('#txt_Search').val('');
            $('#FilterForm').submit();
        }

        function OpenCreateModal() {
            // Sync values from filter to modal
            var selectedDonVi = $('#FilterDonVi_Select').val();
            var selectedYear = $('#FilterYear_Select').val();
            var selectedThang = $('#FilterThang_Select').val();

            if (selectedDonVi) {
                $('#ModalDonVi_Select').val(selectedDonVi).trigger('change');
            }
            if (selectedYear) {
                $('#ModalNam_Select').val(selectedYear);
            }
            if (selectedThang && selectedThang !== 'all') {
                $('#ModalThang_Select').val(selectedThang);
            }

            $('#CreateModal').modal('show');
            setTimeout(function() {
                $('.select2multi').select2({
                    dropdownParent: $('#CreateModal')
                });
            }, 200);
        }

        function DeleteRecord(id) {
            Swal.fire({
                title: 'Bạn có chắc chắn muốn xóa hồ sơ này?',
                text: "Dữ liệu chi tiết và file đính kèm liên quan sẽ bị xóa vĩnh viễn!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Hủy bỏ'
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#DeleteRecordId').val(id);
                    var form = $('#DeleteForm');
                    
                    $.ajax({
                        url: form.attr('action'),
                        type: 'POST',
                        data: form.serialize(),
                        success: function (res) {
                            if (res.isValid) {
                                Swal.fire(
                                    'Đã xóa!',
                                    res.message,
                                    'success'
                                ).then(() => {
                                    window.location.reload();
                                });
                            } else {
                                toastr.error(res.message || 'Có lỗi khi xóa hồ sơ');
                            }
                        },
                        error: function () {
                            toastr.error('Lỗi kết nối máy chủ!');
                        }
                    });
                }
            });
        }

        function HandleConfirmChuyen(hoSoId, soQd) {
            $('#soqd_chuyen').text(soQd || 'Chưa xác định');
            $('#chuyenId').val(hoSoId);
            $('#Chuyen_Modal').modal('show');
        }

        function SubmitChuyenForm(e) {
            e.preventDefault();
            var form = $('#ChuyenForm');
            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),
                success: function (res) {
                    if (res.isValid) {
                        $('#Chuyen_Modal').modal('hide');
                        toastr.success(res.message);
                        setTimeout(function () {
                            window.location.reload();
                        }, 1000);
                    } else {
                        toastr.error(res.message);
                    }
                },
                error: function () {
                    toastr.error('Lỗi kết nối máy chủ!');
                }
            });
        }

        function HandleShowModelLyDoTraLai(maHoSo, soQuyetDinh, lyDoTraLai) {
            $('#LyDoTraLai_Modal #soQuyetDinh').html(soQuyetDinh);
            $('#LyDoTraLai_Modal #lyDoTraLai').html(lyDoTraLai);
            $('#LyDoTraLai_Modal').modal('show');
        }
    </script>
}
