@model DataAccess.Entities.DinhGiaHHDV.GiaThiTruongTongHop

@section custom_style {
    <link rel="stylesheet" type="text/css" href="~/Admin/assets/datatables/bootstrap/dataTables.bootstrap.css" />
    <link rel="stylesheet" type="text/css" href="~/Admin/assets/datatables/bootstrap/dataTables.css" />
    <link rel="stylesheet" href="https://unpkg.com/@@univerjs/preset-sheets-core/lib/index.css" />
}

@section custom_script {
    <script src="~/js/site.js"></script>
    <script src="~/js/agent-scan.js"></script>
    <script src="~/Admin/assets/js/pages/crud/forms/widgets/jquery-mask.js"></script>
    <script type="text/javascript" src="~/Admin/assets/datatables/js/jquery.dataTables.min.js"></script>
    <script type="text/javascript" src="~/Admin/assets/datatables/bootstrap/dataTables.bootstrap.js"></script>
    <script src="~/Admin/assets/datatables/scripts/table-managed.js"></script>
    <script src="~/Admin/assets/js/pages/crud/forms/widgets/select2.js"></script>
    
    <!-- Univer CDN -->
    <script src="https://unpkg.com/react@18.3.1/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/rxjs/dist/bundles/rxjs.umd.min.js"></script>
    <script src="https://unpkg.com/echarts@5.6.0/dist/echarts.min.js"></script>
    <script src="https://unpkg.com/@@univerjs/presets/lib/umd/index.js"></script>
    <script src="https://unpkg.com/@@univerjs/preset-sheets-core/lib/umd/index.js"></script>
    <script src="https://unpkg.com/@@univerjs/preset-sheets-core/lib/umd/locales/en-US.js"></script>
    <script src="https://unpkg.com/@@univerjs/preset-sheets-core/lib/umd/locales/vi-VN.js"></script>
    
    <script>
        $(document).ready(function () {
            MoneyDecimalMask();
            SetupSelect2('#DiaBanId', 'Lựa Chọn Địa Bàn');
        });

        window.addEventListener('load', function () {
            const appUniver = document.getElementById('app-univer');
            if (!appUniver) return;

            const { createUniver } = UniverPresets;
            const { LocaleType, mergeLocales } = UniverCore;
            const { UniverSheetsCorePreset } = UniverPresetSheetsCore;

            const { univerAPI } = createUniver({
                locale: LocaleType.EN_US,
                locales: {
                    [LocaleType.EN_US]: mergeLocales(UniverPresetSheetsCoreEnUS),
                    [LocaleType.VI_VN]: mergeLocales(UniverPresetSheetsCoreViVN),
                },
                presets: [
                    UniverSheetsCorePreset({ 
                        container: 'app-univer',
                        footer: false
                    })
                ],
            });

            const mahs = appUniver.dataset.mahs;
            const $statusTxt = $('#save-status');

            window.autoFitAllRows = function() {
                setTimeout(() => {
                    try {
                        const workbook = univerAPI.getActiveWorkbook();
                        if (workbook) {
                            const sheet = workbook.getActiveSheet();
                            if (sheet) {
                                const rowCount = typeof sheet.getRowCount === 'function' ? sheet.getRowCount() : (sheet.rowCount || 100);
                                const colCount = typeof sheet.getColumnCount === 'function' ? sheet.getColumnCount() : (sheet.columnCount || 20);

                                let resized = false;
                                if (typeof sheet.autoResizeRows === 'function') {
                                    sheet.autoResizeRows(1, rowCount - 1);
                                    resized = true;
                                }

                                try {
                                    const range = sheet.getRange(1, 0, rowCount - 1, colCount);
                                    if (range && typeof range.setAutoHeight === 'function') {
                                        range.setAutoHeight();
                                        resized = true;
                                    }
                                } catch (errRange) {
                                    console.error("Lỗi khi gọi range.setAutoHeight:", errRange);
                                }
                            }
                        }
                    } catch (e) {
                        console.error("Lỗi khi tự động co giãn hàng:", e);
                    }
                }, 500);
            };

            const loadData = async () => {
                try {
                    $statusTxt.text("Đang tải dữ liệu...");
                    const res = await fetch(`/GiaThiTruongTongHop/GetCodeExcel/${mahs}`);
                    const data = await res.json();
                    if (Object.keys(data).length === 0) {
                        univerAPI.createWorkbook({
                            id: 'workbook_' + Date.now(),
                            name: "Bảng giá chi tiết tổng hợp",
                            sheetOrder: ['sheet1'],
                            styles: {
                                "default_wrap": {
                                    vt: 2,
                                    tb: 3
                                }
                            },
                            sheets: {
                                'sheet1': {
                                    id: 'sheet1',
                                    name: 'Sheet1',
                                    cellData: {},
                                    rowCount: 100,
                                    columnCount: 20
                                }
                            },
                            locale: 'vi-VN'
                        });
                    } else {
                        if (data.styles) {
                            for (const key in data.styles) {
                                if (data.styles[key]) {
                                    data.styles[key].tb = 3;
                                }
                            }
                        }
                        if (data.sheets) {
                            for (const sheetId in data.sheets) {
                                const sheet = data.sheets[sheetId];
                                if (sheet && sheet.cellData) {
                                    if (!sheet.rowData) {
                                        sheet.rowData = {};
                                    }
                                    if (!sheet.rowData["0"]) {
                                        sheet.rowData["0"] = { "h": 80 };
                                    }
                                    for (const r in sheet.cellData) {
                                        if (r !== "0") {
                                            if (!sheet.rowData[r]) {
                                                sheet.rowData[r] = { "ia": 1 };
                                            } else {
                                                delete sheet.rowData[r].h;
                                                sheet.rowData[r].ia = 1;
                                            }
                                        }
                                        const row = sheet.cellData[r];
                                        for (const c in row) {
                                            const cell = row[c];
                                            if (cell) {
                                                if (cell.s === undefined || cell.s === null) {
                                                    if (!data.styles) data.styles = {};
                                                    data.styles["default_wrap"] = { vt: 2, tb: 3 };
                                                    cell.s = "default_wrap";
                                                } else if (typeof cell.s === 'string') {
                                                    if (!data.styles) data.styles = {};
                                                    if (!data.styles[cell.s]) {
                                                        data.styles[cell.s] = { vt: 2, tb: 3 };
                                                    } else {
                                                        data.styles[cell.s].tb = 3;
                                                    }
                                                } else if (typeof cell.s === 'object') {
                                                    cell.s.tb = 3;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        univerAPI.createWorkbook(data);
                    }
                    $statusTxt.text("");
                    window.autoFitAllRows();
                } catch (err) {
                    console.error("Lỗi khi load dữ liệu", err);
                    $statusTxt.text("Lỗi tải dữ liệu!");
                    univerAPI.createWorkbook({ name: "Bảng giá chi tiết tổng hợp" });
                }
            };

            loadData();

            const $form = $('#form-tonghop');
            if ($form.length) {
                $('#btn-import-excel').on('click', () => {
                    $('#file-import-excel').click();
                });

                window.univerAPIInstance = univerAPI;

                $('#file-import-excel').on('change', function (e) {
                    const file = e.target.files[0];
                    if (!file) return;
                    handleExcelFileSelect(file, $statusTxt);
                    $(this).val('');
                });

                $form.on('submit', async function (e) {
                    if (!this.checkValidity()) {
                        this.reportValidity();
                        e.preventDefault();
                        return;
                    }
                    e.preventDefault();
                    try {
                        $statusTxt.text('Đang chuẩn bị dữ liệu Excel...');
                        const snapshot = univerAPI.getActiveWorkbook().save();
                        $('#CodeExcel').val(JSON.stringify(snapshot));
                    } catch (err) {
                        console.error('Lỗi chuẩn bị dữ liệu Excel', err);
                    }
                    this.submit();
                });
            }
        });
        
        document.addEventListener("DOMContentLoaded", function () {
            startAgentConnection();
        });
    </script>
}

<div class="card card-custom">
    <div class="card-header ribbon ribbon-top ribbon-ver">
        <div class="card-title">
            <h3 class="card-label">
                @ViewData["Title"]
                <span class="d-block text-muted pt-2 font-size-sm">
                    @((Model.TrangThai == "CXD") ? "Thêm mới" : "Cập nhật") thông tin hồ sơ tổng hợp báo cáo giá thị trường
                </span>
            </h3>
        </div>
        <div class="card-toolbar">
            <a asp-controller="GiaThiTruongTongHop" asp-action="Index" class="btn btn-light-primary font-weight-bolder mr-2">
                <i class="la la-reply"></i>Quay lại
            </a>
        </div>
    </div>

    <form asp-controller="GiaThiTruongTongHop" asp-action="@((Model.TrangThai == "CXD") ? "Store" : "Update")" method="post" id="form-tonghop">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="MaHoSo" />
        <input type="hidden" asp-for="ThongTuId" />
        <input type="hidden" asp-for="DonViQuanLyId" />
        <input type="hidden" asp-for="Thang" />
        <input type="hidden" asp-for="Nam" />
        <input type="hidden" asp-for="MaHoSoTongHop" />

        <div class="card-body">
            @await Html.PartialAsync("~/Views/Admin/DinhGiaHHDV/GiaThiTruong/TongHop/_FormFields.cshtml", Model)
        </div>

        <div class="card-footer" style="text-align:center">
            <a asp-controller="GiaThiTruongTongHop" asp-action="Index" class="btn btn-danger">
                <i class="la la-reply"></i>Quay lại
            </a>&ensp;
            <button type="reset" class="btn btn-secondary"><i class="la la-refresh"></i>Nhập lại</button>&ensp;
            <button type="submit" class="btn btn-primary mr-2"><i class="la la-check"></i>Hoàn thành</button>
        </div>
    </form>
</div>

@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
