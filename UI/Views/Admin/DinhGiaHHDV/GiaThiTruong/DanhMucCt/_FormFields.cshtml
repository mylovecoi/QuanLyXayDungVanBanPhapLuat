@model DataAccess.Entities.DinhGiaHHDV.GiaThiTruongDanhMucCt

<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="ThongTuId" value="@(Model.ThongTuId == Guid.Empty ? ViewData["ThongTuId"] : Model.ThongTuId)" />

@{
    var donViTinhs = ViewData["DonViTinhs"] as IEnumerable<DataAccess.Entities.Settings.DanhMucDonViTinh> ?? new List<DataAccess.Entities.Settings.DanhMucDonViTinh>();
}

<div class="row">
    <div class="col-xl-2">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">STT sắp xếp:</label>
            <input type="text" class="form-control" asp-for="STTSapXep" />
        </div>
    </div>
    <div class="col-xl-4">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Mã hàng hóa dịch vụ:</label>
            <input type="text" class="form-control" asp-for="MaHhDv" required />
        </div>
    </div>
    <div class="col-xl-6">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Tên hàng hóa dịch vụ:</label>
            <input type="text" class="form-control" asp-for="TenHhDv" required />
        </div>
    </div>
    <div class="col-xl-12">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Đặc điểm kỹ thuật:</label>
            <textarea class="form-control" asp-for="DacDiemKt" rows="2"></textarea>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Đơn vị tính:</label>
            <select class="form-control select2multi" asp-for="DonViTinh">
                <option value="">-- Chọn đơn vị tính --</option>
                @foreach (var item in donViTinhs)
                {
                    <!option value="@item.MaDonViTinh" @(Model.DonViTinh == item.MaDonViTinh ? "selected" : "")>@item.TenDonViTinh</!option>
                }
            </select>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:black">Theo dõi:</label>
            <select class="form-control" asp-for="TheoDoi">
                <option value="TD">Đang theo dõi</option>
                <option value="KTD">Dừng theo dõi</option>
            </select>
        </div>
    </div>
</div>
