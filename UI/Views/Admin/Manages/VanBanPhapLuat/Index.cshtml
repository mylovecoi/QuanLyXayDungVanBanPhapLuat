@using Services.Manages
@using UI.ViewModels

@{
    var session = HttpContextAccessor?.HttpContext?.Session ?? null;
    int pageSize = (ViewData["PageInfo"] as VMPageInfo)?.PageSize ?? 5;
    string timKiem = (ViewData["PageInfo"] as VMPageInfo)?.Search ?? "";
    string role = ViewData["Role"]?.ToString() ?? "";
    int recordId = 1;
    var donViOptions = ViewData["DonViOptions"] as List<DonViOptionModel> ?? new List<DonViOptionModel>();
    Guid? selectedDonViId = ViewData["SelectedDonViId"] is Guid selected ? selected : ViewData["SelectedDonViId"] as Guid?;
    var selectedDonViName = ViewData["SelectedDonViName"]?.ToString();
    var isSSA = ViewData["IsSSA"] is bool flag && flag;
}

@model IEnumerable<DataAccess.Entities.Manages.AttachedFile>

@section custom_script {
    <script>
        $(document).ready(function () {
            $('#PageSize_Search').change(function () {
                ReloadFrm();
            });

            $('#DonViId_Search').change(function () {
                ReloadFrm();
            });

            $('#txt_Search').keypress(function (e) {
                if (e.which == 13) {
                    e.preventDefault();
                    SubmitTxtSearch();
                }
            });
        });

        function ClearTxtSearch() {
            $('#txt_Search').val('');
            ReloadFrm();
        }

        function SubmitTxtSearch() {
            ReloadFrm();
        }

        function ReloadFrm() {
            var currentPathUrl = window.location.pathname + '?';
            var timKiem = '&TimKiem=' + $('#txt_Search').val();
            var pageSize = '&PageSize=' + $('#PageSize_Search').val();
            var donViId = $('#DonViId_Search').length ? '&DonViId=' + ($('#DonViId_Search').val() || '') : '';
            window.location.href = currentPathUrl + timKiem + pageSize + donViId;
        }

        function ClickPage(pageSelect) {
            var currentPathUrl = window.location.pathname + '?';
            var timKiem = '&TimKiem=' + $('#txt_Search').val();
            var pageSize = '&PageSize=' + $('#PageSize_Search').val();
            var donViId = $('#DonViId_Search').length ? '&DonViId=' + ($('#DonViId_Search').val() || '') : '';
            var pageCurrent = '&PageCurrent=' + pageSelect;
            window.location.href = currentPathUrl + timKiem + pageSize + donViId + pageCurrent;
        }
    </script>
}

<div class="card card-custom">
    <div class="card-header flex-wrap border-0 pt-6 pb-0">
        <div class="card-title">
            <h3 class="card-label">
                <b>@ViewData["Title"]?.ToString()?.ToUpper()</b>
                <span class="d-block text-muted pt-2 font-size-sm">
                    Quản lý @ViewData["Title"]
                </span>
            </h3>
        </div>
        <div class="card-toolbar">
            @if (session != null && FuntionGlobal.CheckPermission(session, role, "Create"))
            {
                <button type="button" class="btn btn-primary font-weight-bolder" title="Thêm mới" onclick="Create()">
                    <i class="la la-plus"></i>Thêm mới
                </button>
            }
        </div>
    </div>
    @Html.AntiForgeryToken()
    <div class="card-body pt-0">
        <hr />

        @if (!string.IsNullOrWhiteSpace(selectedDonViName))
        {
            <div class="alert alert-light-primary d-flex align-items-center mb-6">
                <i class="la la-building icon-xl mr-3 text-primary"></i>
                <div>
                    <div class="font-weight-bold">Đang xem dữ liệu của đơn vị</div>
                    <div>@selectedDonViName</div>
                </div>
            </div>
        }
        else if (isSSA)
        {
            <div class="alert alert-light-warning d-flex align-items-center mb-6">
                <i class="la la-sitemap icon-xl mr-3 text-warning"></i>
                <div>
                    <div class="font-weight-bold">Đang xem dữ liệu toàn bộ đơn vị</div>
                    <div>Tài khoản SSA có thể lọc theo từng đơn vị hoặc xem tất cả.</div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-xl-3">
                <div class="form-group fv-plugins-icon-container">
                    <label class="text-blue font-weight-bold">Hiển thị</label>
                    <select class="form-control" name="PageSize_Search" id="PageSize_Search">
                        <!option value="5" @(pageSize == 5 ? "selected" : "")>5 thông tin</!option>
                        <!option value="10" @(pageSize == 10 ? "selected" : "")>10 thông tin</!option>
                        <!option value="20" @(pageSize == 20 ? "selected" : "")>20 thông tin</!option>
                        <!option value="50" @(pageSize == 50 ? "selected" : "")>50 thông tin</!option>
                        <!option value="100" @(pageSize == 100 ? "selected" : "")>100 thông tin</!option>
                    </select>
                </div>
            </div>
            <div class="col-xl-9">
                <div class="row">
                    <div class="col-xl-5">
                        <div class="form-group fv-plugins-icon-container">
                            <label class="text-blue font-weight-bold">Đơn vị</label>
                            <select class="form-control" name="DonViId_Search" id="DonViId_Search" @(isSSA ? "" : "disabled")>
                                @if (isSSA)
                                {
                                    <option value="">-- Tất cả đơn vị --</option>
                                }
                                @foreach (var item in donViOptions)
                                {
                                    <option value="@item.Id" selected="@(selectedDonViId.HasValue && selectedDonViId.Value == item.Id ? "selected" : null)">@item.TenDonVi</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-7">
                        <div class="form-group fv-plugins-icon-container">
                            <label class="text-blue font-weight-bold">Tìm kiếm</label>
                            <div class="input-group">
                                <input class="form-control" name="txt_Search" id="txt_Search" placeholder="Tìm kiếm..." value="@timKiem">
                                <div class="input-group-prepend">
                                    <button class="btn btn-danger" type="button" onclick="ClearTxtSearch()"><i class="las la-times-circle"></i></button>
                                </div>
                                <div class="input-group-append">
                                    <button class="btn btn-primary" type="button" onclick="SubmitTxtSearch()"><i class="las la-search"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive border rounded-lg mb-8">
            <table class="table table-striped table-hover table-responsive-lg rounded-lg">
                <thead>
                    <tr style="text-align:center;" class="table-active">
                        <th width="4%">#</th>
                        <th width="24%">Thông tin văn bản pháp luật</th>
                        <th width="34%">Mô tả</th>
                        <th width="12%">Công khai</th>
                        <th width="14%">File đính kèm</th>
                        <th width="12%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            var record = recordId++;
                            <tr class="@FuntionGlobal.GetClassTable(record)">
                                <td class="text-center align-middle">@record</td>
                                <td class="font-weight-bold align-middle">
                                    <div>Số văn bản: <span class="text-blue">@item.SoVanBan</span></div>
                                    <div>Ngày ban hành: <span class="text-blue">@FuntionGlobal.ConvertDateToStr(item.NgayBanHanh)</span></div>
                                    <div>Ngày áp dụng: <span class="text-blue">@FuntionGlobal.ConvertDateToStr(item.NgayApDung)</span></div>
                                    @if (!string.IsNullOrEmpty(item.Url))
                                    {
                                        <div>Đường dẫn: <span class="text-blue">@item.Url</span></div>
                                    }
                                </td>
                                <td class="font-weight-bold align-middle">@item.MoTa</td>
                                <td class="font-weight-bold align-middle text-center">
                                    @if (item.Public)
                                    {
                                        <span class="label font-weight-bold label-lg label-light-primary label-inline">Công bố</span>
                                    }
                                    else
                                    {
                                        <span class="label font-weight-bold label-lg label-light-success label-inline">Nội bộ</span>
                                    }
                                </td>
                                <td class="align-middle">@item.FileName</td>
                                <td class="align-middle">
                                    @if (session != null && FuntionGlobal.CheckPermission(session, role, "Index"))
                                    {
                                        <button type="button" onclick="Show('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Xem chi tiết">
                                            <i class="icon-lg la la-eye text-primary"></i>
                                        </button>
                                    }
                                    @if (session != null && FuntionGlobal.CheckPermission(session, role, "Edit"))
                                    {
                                        <button type="button" onclick="Edit('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Chỉnh sửa">
                                            <i class="icon-lg la la-edit text-success"></i>
                                        </button>
                                    }
                                    @if (session != null && FuntionGlobal.CheckPermission(session, role, "Delete"))
                                    {
                                        <button type="button" class="btn btn-sm btn-clean btn-icon" title="Xóa" onclick="Delete('@item.Id', '@item.SoVanBan')">
                                            <i class="icon-lg la la-trash text-danger"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td style="text-align:center" colspan="6">Không tìm thấy thông tin.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
    </div>
</div>

@await Html.PartialAsync("~/Views/Admin/Manages/VanBanPhapLuat/Modal.cshtml")
