@using UI.ViewModels;
@{
    var session = HttpContextAccessor?.HttpContext?.Session ?? null;
    int pageSize = (ViewData["PageInfo"] as VMPageInfo)?.PageSize ?? 5;
    string timKiem = (ViewData["PageInfo"] as VMPageInfo)?.Search ?? "";
    string sort = (ViewData["PageInfo"] as VMPageInfo)?.Sort ?? "";
    string role = ViewData["Role"]?.ToString() ?? "";
    int record_id = 1;
}

@model IEnumerable<DataAccess.Entities.Manages.AttachedFile>

@section custom_style {
}

@section custom_script {
    <script>
        $(document).ready(function () {
            $('#PageSize_Search').change(function () {
                ReloadFrm();
            });

            // Handle Enter key press on search input
            $('#txt_Search').keypress(function (e) {
                if (e.which == 13) { // Enter key
                    e.preventDefault();
                    SubmitTxtSearch();
                }
            });
        });

        function ClearTxtSearch() {
            $('#txt_Search').val('');
            ReloadFrm(); // Automatically reload after clearing
        }

        function SubmitTxtSearch() {
            ReloadFrm();
        }

        function ReloadFrm() {
            var current_path_url = window.location.pathname + '?';
            var timkiem = '&TimKiem=' + $('#txt_Search').val();
            var pageSize = '&PageSize=' + $('#PageSize_Search').val();
            var url = current_path_url + timkiem + pageSize;
            window.location.href = url;
        }

        function ClickPage(pageSelect) {
            var current_path_url = window.location.pathname + '?';
            var timkiem = '&TimKiem=' + $('#txt_Search').val();
            var pageSize = '&PageSize=' + $('#PageSize_Search').val();
            var pageCurrent = '&PageCurrent=' + pageSelect;
            var url = current_path_url + timkiem + pageSize + pageCurrent;
            window.location.href = url;
        }
    </script>
}

<div class="card card-custom">
    <div class="card-header flex-wrap border-0 pt-6 pb-0">
         <div class="card-title">
            <h3 class="card-label">
                <b>@ViewData["Title"]?.ToString()?.ToUpper()</b>
                <span class="d-block text-muted pt-2 font-size-sm">
                    Quản lý @ViewData["Title"]
                </span>
            </h3>
        </div>
        <div class="card-toolbar">
            @if (session != null && FuntionGlobal.CheckPermission(session, role, "Create"))
            {
                <button type="button" class="btn btn-primary font-weight-bolder" title="Thêm mới" onclick="Create()">
                    <i class="la la-plus"></i>Thêm mới
                </button>
            }
        </div>
    </div>
    @Html.AntiForgeryToken()
    <div class="card-body pt-0">
        <hr />
        <div class="row">
            <div class="col-xl-3">
                <div class="form-group fv-plugins-icon-container">
                    <label class="text-blue font-weight-bold">Hiển thị</label>
                    <select class="form-control" name="PageSize_Search" id="PageSize_Search">
                        <!option value="5" @(pageSize == 5 ? "selected" : "")>5 thông tin</!option>
                        <!option value="10" @(pageSize == 10 ? "selected" : "")>10 thông tin</!option>
                        <!option value="20" @(pageSize == 20 ? "selected" : "")>20 thông tin</!option>
                        <!option value="50" @(pageSize == 50 ? "selected" : "")>50 thông tin</!option>
                        <!option value="100" @(pageSize == 100 ? "selected" : "")> 100 thông tin</!option>
                    </select>
                </div>
            </div>
            <div class="col-xl-9">
                <div class="form-group fv-plugins-icon-container">
                    <label class="text-blue font-weight-bold">Tìm kiếm</label>
                    <div class="input-group">
                        <input class="form-control" name="txt_Search" id="txt_Search" placeholder="Tìm kiếm..." value="@timKiem">
                        <div class="input-group-prepend">
                            <button class="btn btn-danger" type="button" onclick="ClearTxtSearch()"><i class="las la-times-circle"></i></button>
                        </div>
                        <div class="input-group-append">
                            <button class="btn btn-primary" type="submit" onclick="SubmitTxtSearch()"><i class="las la-search"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <input hidden id="sort_current" name="sort_current" value="@ViewData["Sort"]" />
        <input hidden id="PageCurrent" name="PageCurrent" value="@ViewData["PageCurrent"]" />
        <!--begin: Datatable-->
        <div class="table-responsive border rounded-lg mb-8">
            <table class="table table-striped table-hover table-responsive-lg rounded-lg">
                <thead>
                    <tr style="text-align:center;" class="table-active">
                        <th style="font-weight: bold;" width="2%">#</th>
                        <th style="font-weight: bold;" width="25%">Thông tin văn bản pháp luật</th>
                        <th style="font-weight: bold;" width="40%">Mô tả</th>
                        <th style="font-weight: bold;">Công khai văn bản:</th>
                        <th style="font-weight: bold;" width="10%">File đính kèm</th>
                        <th style="font-weight: bold;" width="10%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count() > 0)
                    {
                        @foreach (var item in Model)
                        {
                            int record = record_id++;
                            <tr class="@FuntionGlobal.GetClassTable(record)">
                                <td style="text-align: center; vertical-align:middle" width="5%">@record</td>
                                <td style="font-weight: bold; vertical-align: middle">
                                    Số văn bản: <span class="text-blue">@item.SoVanBan</span><br />
                                    Ngày ban hành: <span class="text-blue">@FuntionGlobal.ConvertDateToStr(item.NgayBanHanh)</span><br />
                                    Ngày áp dụng: <span class="text-blue">@FuntionGlobal.ConvertDateToStr(item.NgayApDung)</span><br />
                                    @if (!string.IsNullOrEmpty(item.Url))
                                    {
                                        <span>Đường dẫn: </span>
                                        <span class="text-blue">@item.Url</span>
    
                                        <br />
                                    }
                                </td>
                                <td style="font-weight: bold; vertical-align: middle">@item.MoTa</td>
                                <td style="font-weight: bold; vertical-align: middle; text-align: center">
                                    @if (item.Public)
                                    {
                                        <span style="width: 109px;"><span class="label font-weight-bold label-lg  label-light-primary label-inline">Công bố</span></span>
                                    }
                                    else
                                    {
                                        <span style="width: 109px;"><span class="label font-weight-bold label-lg  label-light-success label-inline">Nội bộ</span></span>
                                    }


                                </td>
                                <td style="vertical-align: middle">@item.FileName</td>
                                <td style="vertical-align: middle">
                                    @if (session != null && FuntionGlobal.CheckPermission(session, role, "Index"))
                                    {
                                        <button type="button" onclick="Show('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Xem chi tiết">
                                            <i class="icon-lg la la-eye text-primary"></i>
                                        </button>
                                    }
                                    @if (session != null && FuntionGlobal.CheckPermission(session, role, "Edit"))
                                    {
                                        <button type="button" onclick="Edit('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Chỉnh sửa">
                                            <i class="icon-lg la la-edit text-success"></i>
                                        </button>
                                    }

                                    @if (session != null && FuntionGlobal.CheckPermission(session, role, "Delete"))
                                    {
                                        <button type="button" class="btn btn-sm btn-clean btn-icon" title="Xóa" onclick="Delete('@item.Id', '@item.SoVanBan')">
                                            <i class="icon-lg la la-trash text-danger"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td style="text-align:center" colspan="6">Không tìm thấy thông tin!!!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!--end: Datatable-->
        @await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
    </div>
</div>
@await Html.PartialAsync("~/Views/Admin/Manages/VanBanPhapLuat/Modal.cshtml")
