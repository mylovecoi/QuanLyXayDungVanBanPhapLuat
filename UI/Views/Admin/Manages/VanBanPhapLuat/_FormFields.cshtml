@model DataAccess.Entities.Manages.AttachedFile
<div class="modal-body">
    @Html.AntiForgeryToken()
    <input hidden asp-for="Id" />
    <input hidden asp-for="TableName" />
    <div class="row">
        <div class="col-xl-4">
            <div class="form-group fv-plugins-icon-container">
                <label style="font-weight:bold; color:blue">Số văn bản: </label>
                <input type="text" asp-for="SoVanBan" class="form-control" />
                <span id="SoVanBanError" class="text-danger"></span>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="form-group fv-plugins-icon-container">
                <label style="font-weight:bold; color:blue">Ngày ban hành: </label>
                <input type="date" asp-for="NgayBanHanh" class="form-control" onkeydown="return false;" />
                <span id="NgayBanHanhError" class="text-danger"></span>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="form-group fv-plugins-icon-container">
                <label style="font-weight:bold; color:blue">Ngày áp dụng: </label>
                <input type="date" asp-for="NgayApDung" class="form-control" onkeydown="return false;" />
                <span id="NgayApDungError" class="text-danger"></span>
            </div>
        </div>
    
        <div class="col-xl-8">
            <div class="form-group fv-plugins-icon-container">
                <label style="font-weight:bold; color:blue">Mô tả: </label>
                <input type="text" asp-for="MoTa" class="form-control" />
                <span id="MoTaError" class="text-danger"></span>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="form-group fv-plugins-icon-container">
                <label style="font-weight:bold; color:blue">Công khai văn bản:</label>
                <select asp-for="Public" class="form-control">
                    <!option value="false" selected>Nội bộ</!option>
                    <!option value="true" @(Model.Public ? "selected" : "")>Công bố</!option>
                </select>
                <span asp-validation-for="Public" class="text-danger"></span>
            </div>
        </div>
        <div class="col-xl-12">
            <div class="form-group fv-plugins-icon-container">
                <label style="font-weight:bold; color:blue">Đường dẫn: </label>
                <input type="text" asp-for="Url" class="form-control" />
            </div>
        </div>
        <div class="col-xl-12">
            <div class="form-group fv-plugins-icon-container">
                <label style="font-weight:bold; color:blue">
                    File Upload:
                    @if (!string.IsNullOrEmpty(Model.FileName))
                    {
                        <a href="/Manages/Download/AttachedFile?id=@Model.Id" target="_blank" ; font-weight: bold;
                           color: red; text-decoration: underline;">
                            📎 File hiện tại (@Model.FileName)
                        </a>
                    }
                </label>
                <input type="file" asp-for="FileUpLoad" class="form-control" />
            </div>
        </div>
    </div>
</div>