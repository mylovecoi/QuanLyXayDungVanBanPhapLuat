	<div class="modal-dialog modal-dialog-centered" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h3 class="card-label">
					<b>@FuntionGlobal.CapitalizeAll(ViewData["Title"]?.ToString()).ToUpper()</b>
					<span class="d-block text-muted pt-2 font-size-sm">
						<span id="modalExportData_Title">Lý Do Trả Lại Thông Tin Hồ Sơ Công Chứng</span>
					</span>
				</h3>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close">
					<i class="ki ki-close"></i>
				</button>
			</div>
			<div class="modal-body">
				<div class="col-xl-12">
					<div class="form-group m-0">
						<label>
							Số Hợp Đồng:&nbsp;<b id="maHopDong" style="color: #0000FF"></b>
							- Tên Hợp Đồng:&nbsp;<b id="tenHopDong" style="color: #0000FF"></b>
						</label>
					</div>
				</div>
				<div class="col-xl-12">
					<div class="form-group m-0">
						<label>Lý do trả lại:&nbsp;<b id="lyDoTraLai" style="color: #0000FF"></b></label>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-light-primary font-weight-bold" data-dismiss="modal">Đóng</button>
			</div>

		</div>
	</div>
</div>
