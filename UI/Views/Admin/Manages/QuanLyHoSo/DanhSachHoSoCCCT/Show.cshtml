@model Services.DTOs.Manages.ThongTinHoSo.HoSoCCCTDto
@{
	Layout = "_LayoutReport";
}
@if (Model != null)
{
	<div>
		<table>
			@{
				#region Thông tin tiêu đề
				{
					<tr>
						<td><p style="text-align: center;"><strong>CÔNG TY TNHH PHẦN MỀM CUỘC SỐNG</strong></p></td>
						<td><p style="text-align: center;"><strong>CỘNG HÓA XÃ HỘI CHỦ NGHĨA VIỆT NAM</strong></p></td>
					</tr>
					<tr>
						<td><p style="text-align: center;"><strong>Số:</strong></p></td>
						<td><p style="text-align: center;"><strong>Độc lập - Tự Do - Hạnh Phúc</strong></p></td>
					</tr>
					<tr>
						<td></td>
						<td>
							@{
								var ngayConChung = Model.NgayDuyet;
								if (ngayConChung.HasValue && Model.Status == "HT")
								{
									<p style="text-align: right; font-style: italic;">
										Hà Nội, ngày @ngayConChung.Value.Day tháng @ngayConChung.Value.Month năm @ngayConChung.Value.Year
									</p>
								}
								else
								{
									<p style="text-align: right; font-style: italic;">
										Hà Nội, ngày ... tháng... năm @DateTime.Now.Year
									</p>
								}
							}
						</td>
					</tr>
					<tr>
						<td colspan="2"><p style="text-align: center;"><strong>HỢP ĐỒNG CÔNG CHỨNG</strong></p></td>
					</tr>
					<tr>
						<td colspan="2"><p style="text-align: center;"><span>@Model.LoaiHopDong?.TenHopDong</span></p></td>
					</tr>

				}
				#endregion

				#region Thông tin cơ bản
				{
					<tr>
						<td colspan="2">
							<p style="text-align: left;">
								<strong>A. Thông tin hợp đồng</strong>
							</p>
						</td>
					</tr>
					<tr>
						<td width="30%">
							<p style="text-align: left;">
								@Html.Raw(FuntionGlobal.GetBackIn(3))
								<strong>Nhóm hợp đồng:</strong>
							</p>
						</td>
						<td>
							<p style="text-align: left;">
								<span>@Model.LoaiHopDong?.Parent?.TenHopDong</span>
							</p>
						</td>
					</tr>
					<tr>
						<td width="30%">
							<p style="text-align: left;">
								@Html.Raw(FuntionGlobal.GetBackIn(3))
								<strong>@Html.DisplayNameFor(x => x.LoaiHopDong!.TenHopDong):</strong>
							</p>
						</td>
						<td>
							<p style="text-align: left;">
								<span>@Model.LoaiHopDong!.TenHopDong</span>
							</p>
						</td>
					</tr>
					<tr>
						<td width="30%">
							<p style="text-align: left;">
								@Html.Raw(FuntionGlobal.GetBackIn(3))
								<strong>@Html.DisplayNameFor(x => x.MaSoHoSo):</strong>
							</p>
						</td>
						<td>
							<p style="text-align: left;">
								<span>@Model.MaSoHoSo</span>
							</p>
						</td>
					</tr>
					<tr>
						<td width="30%">
							<p style="text-align: left;">
								@Html.Raw(FuntionGlobal.GetBackIn(3))
								<strong>@Html.DisplayNameFor(x => x.NgayThuLy):</strong>
							</p>
						</td>
						<td>
							<p style="text-align: left;">
								<span>@FuntionGlobal.ConvertDateToStr(Model.NgayThuLy)</span>
							</p>
						</td>
					</tr>
					// <tr>
					// 	<td width="30%">
					// 		<p style="text-align: left;">
					// 			@Html.Raw(FuntionGlobal.GetBackIn(3))
					// 			<strong>Ngày công chứng:</strong>
					// 		</p>
					// 	</td>
					// 	<td>
					// 		<p style="text-align: left;">
					// 			@* <span>@FuntionGlobal.ConvertDateToStr(Model.NgayDuyet)</span> *@
					// 		</p>
					// 	</td>
					// </tr>
					<tr>
						<td width="30%">
							<p style="text-align: left;">
								@Html.Raw(FuntionGlobal.GetBackIn(3))
								<strong>@Html.DisplayNameFor(x => x.GiaTriHopDong):</strong>
							</p>
						</td>
						<td>
							<p style="text-align: left;">
								<span>@Model.StrSoTienMienThue VNĐ</span>
							</p>
						</td>
					</tr>
					<tr>
						<td width="30%">
							<p style="text-align: left;">
								@Html.Raw(FuntionGlobal.GetBackIn(3))
								<strong>@Html.DisplayNameFor(x => x.PhuongThucCongChung):</strong>
							</p>
						</td>
						<td>
							<p style="text-align: left;">
								<span>@(string.Format("Công Chứng {0}", Model.PhuongThucCongChung ? "Bản Giấy" : "Điện Tử"))</span>
							</p>
						</td>
					</tr>
				}
				#endregion

				#region Thông tin người yêu cầu công chưng
				{
					<tr>
						<td colspan="2">
							<p style="text-align: left;">
								<strong>B. Thông tin tài sản người yêu cầu công chức</strong>
							</p>
						</td>
					</tr>
					<tr>
						<td width="30%">
							<p style="text-align: left;">
								@Html.Raw(FuntionGlobal.GetBackIn(3))
								<strong>@Html.DisplayNameFor(x => x.HoTenNguoiNop):</strong>
							</p>
						</td>
						<td>
							<p style="text-align: left;">
								<span>@Model.HoTenNguoiNop</span>
							</p>
						</td>
					</tr>
					<tr>
						<td width="30%">
							<p style="text-align: left;">
								@Html.Raw(FuntionGlobal.GetBackIn(3))
								<strong>@Html.DisplayNameFor(x => x.SoCCCDNguoiNop):</strong>
							</p>
						</td>
						<td>
							<p style="text-align: left;">
								<span>@Model.SoCCCDNguoiNop</span>
							</p>
						</td>
					</tr>
					<tr>
						<td width="30%">
							<p style="text-align: left;">
								@Html.Raw(FuntionGlobal.GetBackIn(3))
								<strong>Tên, Mã Số Doanh Nghiệp:</strong>
							</p>
						</td>
						<td>
							<p style="text-align: left;">
								<span>@Model.ThongTinDonVi</span>
							</p>
						</td>
					</tr>
				}
				#endregion

				#region Thông tin chi tiết
				{
					<tr>
						<td colspan="2">
							<p style="text-align: left;">
								<strong>C. Thông tin chi tiêt hợp đồng</strong>
							</p>
						</td>
					</tr>
					foreach (var chiTiet in Model.HoSoCCCTChiTietDtos)
					{
						if (!string.IsNullOrEmpty(chiTiet.Code))
						{
							<tr>
								<td width="30%">
									<p style="text-align: left;">
										@Html.Raw(FuntionGlobal.GetBackIn(3))
										<strong>@chiTiet.Title:</strong>
									</p>
								</td>

								@switch (chiTiet.Code)
								{
									case "LoaiTaiSan":
										<td>
											<p style="text-align: left;">
												@{
													var loaiTaiSan = chiTiet.Options.Where(x => x.Id.ToString() == chiTiet.Value).FirstOrDefault();
													<span>@(loaiTaiSan != null ? loaiTaiSan.DisplayName : "")</span>
												}
											</p>
										</td>
										break;
									case "DiaDanh":
										<td>
											<p style="text-align: left;">
												<span>@chiTiet.Value</span>
											</p>
										</td>
										break;
								}

							</tr>
						}
						else
						{
							<tr>
								<td width="30%">
									<p style="text-align: left;">
										@Html.Raw(FuntionGlobal.GetBackIn(3))
										<strong>@chiTiet.Title:</strong>
									</p>
								</td>
								<td>
									<p style="text-align: left;">
										<span>@chiTiet.Value</span>
									</p>
								</td>
							</tr>
						}
					}
				}
				#endregion

				#region Thông tin khác
				{
					<tr>
						<td colspan="2">
							<p style="text-align: left;">
								<strong>D. Thông tin khác trong hợp đồng</strong>
							</p>
						</td>
					</tr>
					#region Thông tin phí lệ phí
					{

					}
					#endregion

					#region Thông tin tệp đính kèm
					{
						if (Model.AttachedFiles.Any())
						{
							<tr>
								<td colspan="2">
									<p style="text-align: left;">
										@Html.Raw(FuntionGlobal.GetBackIn(3))
										<strong>Thông tin tệp đính kèm</strong>
									</p>
								</td>
							</tr>
							var chuKyDienTu = Model.AttachedFiles.FirstOrDefault(x => x.TableName == "ChuKyDienTu");
							int recordFile = 1;
							<tr>
								<td colspan="2">
									<table style="margin-left: 100px;">
										<thead>
											<tr>
												<th width="2%">STT</th>
												<th width="60%">Mô tả</th>
												<th>File đính kèm</th>
											</tr>
										</thead>
										<tbody>
										</tbody>
										@if (chuKyDienTu != null)
										{
											<tr>
												<td>@recordFile</td>
												<td class="text-left text-nowrap">
													@Html.Raw(FuntionGlobal.GetBackIn(3))
													@chuKyDienTu.MoTa
												</td>
												<td class="text-left text-nowrap">
													<a href="/Manages/Download/AttachedFile?Id=@chuKyDienTu.Id" target="_blank">@chuKyDienTu.FileName</a>
												</td>
											</tr>
											Model.AttachedFiles.Remove(chuKyDienTu);
											recordFile++;
										}

										@foreach (var file in Model.AttachedFiles)
										{
											<tr>
												<td>@recordFile</td>
												<td class="text-left text-nowrap">
													@Html.Raw(FuntionGlobal.GetBackIn(3))
													@file.MoTa
												</td>
												<td class="text-left text-nowrap">
													<a href="/Manages/Download/AttachedFile?Id=@file.Id" target="_blank">@file.FileName</a>
												</td>
											</tr>
											recordFile++;
										}
									</table>
								</td>
							</tr>
						}

					}
					#endregion
				}
				#endregion
			}

		</table>

	</div>
}
else
{

}
