<!--Edit Le Phi Modal-->
<div class="modal fade" id="EditLePhi_Modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="card-label">
                    @ViewData["Title"]
                    <span class="d-block text-muted pt-2 font-size-sm">Chỉnh sửa thông tin lệ phí</span>
                </h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">
                <form id="frm_edit_lephi"></form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary font-weight-bold" onclick="UpdateLePhi()">Cập nhật</button>
            </div>
        </div>
    </div>
</div>

<script>
    function convertValue(inputId) {
        if (!inputId.startsWith("#")) {
            inputId = "#" + inputId;
        }

        let raw = $(inputId).val() || "";
        raw = raw.replace(/\./g, "").replace(/,/g, ".");
        return parseFloat(raw) || 0;
    }

    function EditLePhi(idLePhi){
        const csrfToken = $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url: '/Manages/QuanLyHoSo/DanhSachHoSoCCCT/ThongTinLePhi/Edit',
            type: 'POST',
            headers: {
                'RequestVerificationToken': csrfToken // Gửi token qua header
            },
            data: {
                IdLePhi: idLePhi,
            },
            success: function (data) {
                $('#frm_edit_lephi').html(data.html);
                MoneyDecimalMask();
                $('#EditLePhi_Modal').modal('show');
            },
            error: function () {
                toastr.error("Không thể tải dữ liệu!", "Lỗi!");
            }
        })
    }

    function UpdateLePhi() {
        var form = document.getElementById('frm_edit_lephi');
        var idHoSo = $('#frm_edit_lephi #HoSoId').val();
        var giaTriHopDong = convertValue('#FormFields #StrSoTienMienThue');
        if (!form) {
            toastr.error("Không tìm thấy form với id 'frm_edit_lephi'", "Lỗi!");
            return;
        }
        const csrfToken = $('input[name="__RequestVerificationToken"]').val();
        const formData = new FormData(form);
        formData.append("GiaTriHopDong", giaTriHopDong);
        $.ajax({
            url: '/Manages/QuanLyHoSo/DanhSachHoSoCCCT/ThongTinLePhi/Update',
            type: 'POST',
            headers: {
                'RequestVerificationToken': csrfToken // Gửi token qua header
            },
            data: formData,
            processData: false,
            contentType: false,
            dataType: 'JSON',
            success: function (data) {
                if (data.status == 'success') {
                    toastr.success(data.message);
                    LoadLePhiDataTable(idHoSo);
                    $('#EditLePhi_Modal').modal('hide');
                } else {
                    toastr.error(data.message, "Lỗi!");
                }
            }
        })
    }

    function LoadLePhiDataTable(idHoSo) {
        const csrfToken = $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url: '/Manages/QuanLyHoSo/DanhSachHoSoCCCT/ThongTinLePhi/DanhSach',
            type: 'POST',
            headers: {
                'RequestVerificationToken': csrfToken
            },
            data: {
                idHoSo: idHoSo
            },
            dataType: 'html',
            success: function (data) {
                $('#frmThongTinLePhi').html(data);
            }
        });
    }
</script>