@model DataAccess.Entities.Manages.ThongTinHoSo.HoSoCCCTChiPhi

<div class="row">
    <div class="col-xl-12">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:blue">Mô tả: </label>
            <input class="form-control" asp-for="MoTa" readonly />
        </div>
    </div>
    <div class="col-xl-4">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:blue">Phí cố định: </label>
            <input type="text" class="form-control money-decimal-mask" asp-for="strPhiCoDinh" readonly />
        </div>
    </div>
    <div class="col-xl-4">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:blue">Tỷ lệ khi vượt mức (%): </label>
            <input type="text" class="form-control money-decimal-mask" asp-for="strTyLeVuotMuc" readonly />
        </div>
    </div>
    <div class="col-xl-4">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:blue">Số lượng tối đa: </label>
            <input class="form-control" asp-for="SoLuongToiDa" readonly />
        </div>
    </div>
    <div class="col-xl-4">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:blue">Phí tối đa: </label>
            <input type="text" class="form-control money-decimal-mask" asp-for="strPhiToiDa" readonly />
        </div>
    </div>
    <div class="col-xl-4">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:blue">Ngưỡng vượt mức: </label>
            <input type="text" class="form-control money-decimal-mask" asp-for="strNguongVuotMuc" readonly />
        </div>
    </div>
    <div class="col-xl-4">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:blue">Đơn vị tính: </label>
            <input class="form-control" asp-for="DonViTinh" readonly />
        </div>
    </div>
    <div class="col-xl-12">
        <div class="form-group fv-plugins-icon-container">
            <label style="font-weight:bold; color:blue">Số lượng: </label>
            <input class="form-control" asp-for="SoLuong" />
        </div>
    </div>
    <input hidden asp-for="Id" />
    <input hidden asp-for="HoSoId" />
</div>