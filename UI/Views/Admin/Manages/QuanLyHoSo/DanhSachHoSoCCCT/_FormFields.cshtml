@model Services.DTOs.Manages.ThongTinHoSo.HoSoCCCTDto
@if (Model != null)
{
	var tinhNangThanhToan = Convert.ToBoolean(ViewData["TinhNangThanhToan"] ?? false);
	<div class="row">
		<div class="col-xl-12">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>
			@if (ViewData["Msg"] != null)
			{
				<div class="alert alert-danger" role="alert">@ViewData["Msg"]</div>
			}
			<input type="hidden" asp-for="Id" />
			<input type="hidden" asp-for="Status" />
			<input type="hidden" asp-for="LoaiHopDongId" />
			<input type="hidden" asp-for="DonViQuanLyId" />
			<input type="hidden" asp-for="LoaiHopDong.TenHopDong" />
			<input type="hidden" id="tableName" name="TableName" value="@ViewData["TableName"]" />
			@if (ViewData.ModelState["Level"]?.Errors.Count > 0)
			{
				<div class="alert alert-danger pb-0" role="alert">
					<h4 class="alert-heading">Cảnh báo</h4>
					<p>@ViewData.ModelState["Level"]?.Errors[0].ErrorMessage</p>
				</div>
			}
		</div>
	</div>

	<div class="mb-3 font-weight-bold font-size-lg">
		<label style="color: blue; text-decoration-line: underline; font-weight: bold">Thông tin cơ bản:</label>
	</div>

	<div id="frmThongTinChung">
		<div class="row">
			<div class="col-sm-12 col-md-12 col-lg-3 col-xl-3 col-xxl-3 form-group">
				<label class="form-label fs-6 font-weight-boldest" asp-for="LoaiHopDong.TenHopDong"></label>
				<label class="form-label font-weight-boldest">:</label>
				<label type="text" class="form-control">@Model?.LoaiHopDong?.TenHopDong</label>
			</div>

			<div class="col-sm-12 col-md-12 col-lg-3 col-xl-3 col-xxl-3 form-group">
				<label class="form-label fs-6 font-weight-boldest" asp-for="MaSoHoSo"></label>
				<label class="form-label font-weight-boldest">:</label><span class="text-danger"> (*)</span>
				<input type="text" asp-for="MaSoHoSo" class="form-control" placeholder="Nhập @Html.DisplayNameFor(x => x.MaSoHoSo).ToLower()">
				<span asp-validation-for="MaSoHoSo" class="text-danger mt-1"></span>
			</div>

			<div class="col-sm-12 col-md-12 col-lg-3 col-xl-3 col-xxl-3 form-group">
				<label class="form-label fs-6 font-weight-boldest" asp-for="NgayThuLy"></label>
				<label class="form-label font-weight-boldest">:</label><span class="text-danger"> (*)</span>
				<input type="date" asp-for="NgayThuLy" class="form-control" placeholder="Nhập @Html.DisplayNameFor(x => x.NgayThuLy).ToLower()">
				<span asp-validation-for="NgayThuLy" class="text-danger mt-1"></span>
			</div>

			<div class="col-sm-12 col-md-12 col-lg-3 col-xl-3 col-xxl-3 form-group">
				<label class="form-label fs-6 font-weight-boldest" asp-for="GiaTriHopDong"></label>
				<label class="form-label font-weight-boldest">:</label>
				<input type="text" asp-for="StrSoTienMienThue" class="form-control money-decimal-mask" placeholder="Nhập @Html.DisplayNameFor(x => x.GiaTriHopDong).ToLower()">
				<span asp-validation-for="GiaTriHopDong" class="text-danger mt-1"></span>
			</div>

			<div class="col-sm-12 col-md-12 col-lg-3 col-xl-3 col-xxl-3 form-group">
				<label class="form-label fs-6 font-weight-boldest" asp-for="PhuongThucCongChung"></label>
				<label class="form-label font-weight-boldest">:</label>
				<select class="form-control" asp-for="PhuongThucCongChung">
					<option value="true">Công Chứng Bản Giấy</option>
					<option value="false">Công chứng điện tử</option>
				</select>
				<span asp-validation-for="PhuongThucCongChung" class="text-danger mt-1"></span>
			</div>
		</div>
	</div>

	<div class="mb-3 font-weight-bold font-size-lg">
		<label style="color: blue; text-decoration-line: underline; font-weight: bold">Thông tin người yêu cầu công chứng:</label>
	</div>
	<div id="frmThongTinChung">
		<div class="row">
			<div class="col-sm-12 col-md-12 col-lg-4 col-xl-4 col-xxl-4 form-group">
				<label class="form-label fs-6 font-weight-boldest" asp-for="HoTenNguoiNop"></label>
				<label class="form-label font-weight-boldest">:</label><span class="text-danger"> (*)</span>
				<input type="text" asp-for="HoTenNguoiNop" class="form-control" placeholder="Nhập @Html.DisplayNameFor(x => x.HoTenNguoiNop).ToLower()">
				<span asp-validation-for="HoTenNguoiNop" class="text-danger mt-1"></span>
			</div>

			<div class="col-sm-12 col-md-12 col-lg-4 col-xl-4 col-xxl-4 form-group">
				<label class="form-label fs-6 font-weight-boldest" asp-for="SoCCCDNguoiNop"></label>
				<label class="form-label font-weight-boldest">:</label><span class="text-danger"> (*)</span>
				<input type="text" asp-for="SoCCCDNguoiNop" class="form-control" placeholder="Nhập @Html.DisplayNameFor(x => x.SoCCCDNguoiNop).ToLower()">
				<span asp-validation-for="SoCCCDNguoiNop" class="text-danger mt-1"></span>
			</div>

			<div class="col-sm-12 col-md-12 col-lg-4 col-xl-4 col-xxl-4 form-group">
				<label class="form-label fs-6 font-weight-boldest" asp-for="ThongTinDonVi">Tên, Mã Số Doanh Nghiệp</label>
				<label class="form-label font-weight-boldest">:</label><span class="text-danger"></span>
				<input type="text" asp-for="ThongTinDonVi" class="form-control" placeholder="Nhập @Html.DisplayNameFor(x => x.ThongTinDonVi).ToLower()">
				<span asp-validation-for="ThongTinDonVi" class="text-danger mt-1"></span>
			</div>
		</div>
	</div>

	@await Html.PartialAsync("~/Views/Admin/Manages/QuanLyHoSo/DanhSachHoSoCCCT/_DynamicFormFields.cshtml", Model?.HoSoCCCTChiTietDtos)

	@if (tinhNangThanhToan)
	{
		<div class="mb-3 font-weight-bold font-size-lg">
			<label style="color: blue; text-decoration-line: underline; font-weight: bold">Thông tin lệ phí:</label>
			<button type="button" class="btn btn-link" onclick="HandleShowHideFrom(this, '#frmThongTinLePhi')" style="font-style:italic">Hiển thị</button>
		</div>

		<div id="frmThongTinLePhi" style="display: none">
			@await Html.PartialAsync("~/Views/Admin/Manages/QuanLyHoSo/DanhSachHoSoCCCT/ChiTietPhiLePhi/_DataTable.cshtml", Model?.HoSoCCCTChiPhis)
		</div>
	}

	<div class="mb-3 font-weight-bold font-size-lg">
		<label style="color: blue; text-decoration-line: underline; font-weight: bold">Giấy Tờ Kèm Theo:</label>
		<button type="button" class="btn btn-link" onclick="HandleShowHideFrom(this, '#frmThongTinGiayToiKemTheo')" style="font-style:italic">Hiển thị</button>
	</div>
	<div id="frmThongTinGiayToiKemTheo" style="display: none" );">
		<div class="row">
			<div class="col-12" id="attachedFile_frm">
				@await Html.PartialAsync("~/Views/Admin/AttachedFile/Index.cshtml", Model!.AttachedFiles)
			</div>
		</div>
	</div>
}
else
{
	<div class="modal-body">
		<div class="row">
			<div class="col-xl-12">
				<div class="alert alert-danger d-flex align-items-center flex-wrap gap-1" role="alert">
					<span class="alert-icon rounded-circle"><i class="icon-base bx bx-error"></i></span>
					@(string.IsNullOrEmpty(ViewData["Msg"]?.ToString()) ? "Có lỗi trong quá trình xử lý. Hãy kiêm tra lại" : ViewData["Msg"])
				</div>
			</div>
		</div>
	</div>
	<div class="modal-footer">
		<button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Đóng</button>
	</div>
}
