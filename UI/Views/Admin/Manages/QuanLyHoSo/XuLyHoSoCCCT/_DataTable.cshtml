@model List<DataAccess.Entities.Manages.ThongTinHoSo.HoSoCCCT>
@{
	var session = HttpContextAccessor?.HttpContext?.Session ?? null;
	string role = ViewData["Role"] as string ?? "";
}
<table class="table table-striped table-hover table-responsive-lg rounded-lg m-0">
	<thead class="thead-light">
		<tr style="text-align:center;" class="table-active">
			<th width="5%">#</th>
			<th style="font-weight: bold;">@Html.DisplayNameFor(x => x.First().LoaiHopDong!.TenHopDong)</th>
			<th width="10%" style="font-weight: bold;">@Html.DisplayNameFor(x => x.First().MaSoHoSo)</th>
			<th style="font-weight: bold;">@Html.DisplayNameFor(x => x.First().NgayThuLy)</th>
			<th width="10%" style="font-weight: bold;">@Html.DisplayNameFor(x => x.First().TrangThai)</th>
			<th style="font-weight: bold;">@Html.DisplayNameFor(x => x.First().MoTa)</th>
			<th style="font-weight: bold;">Thao tác</th>
		</tr>
	</thead>
	<tbody>
		@if (Model.Count() > 0)
		{
			var pageInfo = ViewData["PageInfo"] as VMPageInfo;
			foreach (var item in Model)
			{
				<tr class="@FuntionGlobal.GetClassTableWithStatus(item.Status)">
					<td class="text-center" style="vertical-align: middle">
						@(pageInfo!.RecordStart++)
					</td>
					<td class="text-left" style="vertical-align: middle">
						<div class="row">
							<div class="col-2"></div>
							<div class="col-10">
								<span class="text-nowrap font-weight-boldest">
									@item.LoaiHopDong?.TenHopDong
								</span>
							</div>
						</div>
					</td>
					<td class="text-center text-nowrap text-primary font-weight-boldest" style="vertical-align: middle">
						@item.MaSoHoSo
					</td>
					<td class="text-center text-nowrap text-primary font-weight-boldest" style="vertical-align: middle">
						@FuntionGlobal.ConvertDateToStr(item.NgayThuLy)
					</td>
					<td class="text-center text-nowrap" style="vertical-align: middle">
						@{
							string labelText = "";
							string labelClass = "label label-lg label-inline font-weight-bolder";
							string ngayTitle = "";
							string ngayValue = FuntionGlobal.ConvertDateToStr(item.NgayChuyen);

							if (item.Status == "CC")
							{
								labelText = "Chờ chuyển";
								labelClass += " label-info";
							}
							else if (item.Status == "CTN")
							{
								labelText = "Chờ Tiếp Nhận";
								labelClass += " label-warning";
								ngayTitle = "Ngày chuyển";
							}
							else if (item.Status == "CTT")
							{
								labelText = (item.DaThanhToan.HasValue ? item.DaThanhToan.Value == false ? "Chờ" : "Đã" : "Chờ") + " Thanh Toán";
								labelClass += " label-warning";
								ngayTitle = "Ngày tiếp nhận";
							}
							else if (item.Status == "XL")
							{
								labelText = "Đang xử lý";
								labelClass += " label-primary";
								ngayTitle = "Ngày xử lý";
							}
							else if (item.Status == "HT")
							{
								labelText = "Hoàn thành";
								labelClass += " label-success";
								ngayTitle = "Ngày hoàn thành";
								ngayValue = FuntionGlobal.ConvertDateToStr(item.NgayDuyet);
							}
							else if (item.Status == "BTL")
							{
								labelText = "Bị trả lại";
								labelClass += " label-danger";
								ngayTitle = "Ngày bị trả lại";
							}

							if (!string.IsNullOrEmpty(labelText))
							{
								<span class="@labelClass">@labelText</span>

								if (!string.IsNullOrEmpty(ngayTitle))
								{
									<br />
									<span>@ngayTitle</span>
									<br />
									<span>@ngayValue</span>
									if (item.Status == "CTT" && item.DaThanhToan.HasValue && item.DaThanhToan.Value && item.NgayThanhToan.HasValue)
									{
										<br />
										<span>Ngày thành toán:</span>
										<br />
										<span>@FuntionGlobal.ConvertDateToStr(item.NgayThanhToan.Value)</span>
									}
								}
							}
						}
					</td>
					<td style="vertical-align: middle">@item.MoTa</td>
					<td class="text-center text-nowrap" style="vertical-align: middle" id="tdAction_@item.Id">
						<a class="btn btn-sm btn-clean btn-icon" title="Xem chi tiết" target="_blank"
						   asp-controller="DanhSachHoSoCCCT" asp-action="Show" asp-route-HoSoId="@item.Id">
							<i class="icon-lg la la-eye text-success"></i>
						</a>
						@if (session != null && FuntionGlobal.CheckPermission(session, role, "Approve"))
						{
							if (item.Status == "BTL")
							{
								<button type="button" class="btn btn-sm btn-clean btn-icon" title="Lý do trả lại"
										onclick="HandleShowModelLyDoTraLai('@item.MaSoHoSo', '@item.LoaiHopDong?.TenHopDong', '@item.LyDoTraLai')">
									<i class="icon-lg la la-file text-danger"></i>
								</button>
							}
							else if (item.Status == "CTN")
							{
								<button type="button" class="btn btn-sm btn-clean btn-icon" title="Trả lại" onclick="HandleConfirmTraLai('@item.Id', '@item.MaSoHoSo', '@item.LoaiHopDong?.TenHopDong')">
									<i class="icon-lg la la-reply text-danger"></i> <!-- Trả lại → màu cảnh báo -->
								</button>
								<button type="button" class="btn btn-sm btn-clean btn-icon" title="Tiếp nhận hồ sơ" onclick="HandleConfirmTiepNhan('@item.Id', '@item.MaSoHoSo', '@item.LoaiHopDong?.TenHopDong')">
									<i class="icon-lg la la-check text-warning"></i> <!-- Tiếp nhận → xanh lá -->
								</button>
							}
							else if (item.Status == "CTT")
							{
								if (item.DaThanhToan == true)
								{
									<button type="button" class="btn btn-sm btn-clean btn-icon" title="Xử lý hồ sơ" onclick="HandleConfirmChangeStatus('@item.Id', 'XacNhanForm', 'Xác nhận thông tin')">
										<i class="icon-lg la la-clipboard-check text-blue"></i> <!-- Xử lý → xanh dương -->
									</button>
								}
								else
								{
									<button type="button" class="btn btn-sm btn-clean btn-icon" title="Duyệt thanh toán thủ công"
									 onclick="HandleConfirmXacNhanThanhToan('@item.Id', '@item.MaSoHoSo', '@item.LoaiHopDong?.TenHopDong', '@item.HoSoCCCTChiPhis.Sum(x => x.ThanhTien)')">
										<i class="icon-lg la la-money-bill text-warning"></i>
									</button>

									<button type="button" class="btn btn-sm btn-clean btn-icon" title="Thanh toán online"
									 onclick="HandleShowModelThongTinThanhToan('@item.Id', '@item.MaSoHoSo', '@item.LoaiHopDong?.TenHopDong', '@item.HoSoCCCTChiPhis.Sum(x => x.ThanhTien)')">
										<i class="icon-lg la la-qrcode text-success"></i>
									</button>
								}
							}
							else if (item.Status == "XL")
							{
								<button type="button" class="btn btn-sm btn-clean btn-icon" title="Hoàn thành hồ sơ" onclick="HandleConfirmHoanThanh('@item.Id', '@item.MaSoHoSo', '@item.LoaiHopDong?.TenHopDong')">
									<i class="icon-lg la la-send text-primary"></i>
								</button>
							}
							else if (item.Status == "HT")
							{
								<button type="button" class="btn btn-sm btn-clean btn-icon" title="Hủy hồ sơ" onclick="HandleConfirmHuyDuyetHoSo('@item.Id', '@item.MaSoHoSo', '@item.LoaiHopDong?.TenHopDong')">
									<i class="icon-lg la la-close text-danger"></i>
								</button>
							}
						}
					</td>
				</tr>
			}
		}
		else
		{
			<tr>
				<td style="text-align:center" colspan="8">Không tìm thấy thông tin!!!</td>
			</tr>
		}
	</tbody>
</table>