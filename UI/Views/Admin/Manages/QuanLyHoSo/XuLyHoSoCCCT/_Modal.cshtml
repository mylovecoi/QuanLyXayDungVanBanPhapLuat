<script>
	const HandleThanhToanMoMo = () => {
		showLoadingOverlay();
		const hoSoId = $('#ThongTinThanhToan_Modal #hoSoId').val();

		// Loại bỏ các tham số message và resultCode từ URL hiện tại
		const url = new URL(window.location.href);
		url.searchParams.delete('message');
		url.searchParams.delete('resultCode');
		url.searchParams.delete('TrangThaiHoSo');
		const cleanRedirectUrl = url.toString();

		// Gọi API tạo yêu cầu thanh toán và chuyển hướng
		$.ajax({
			url: '/api/MoMoPayment/CreatePayment',
			type: 'POST',
			data: {
				hoSoId: hoSoId,
				redirectUrl: cleanRedirectUrl
			},
			success: function (res) {
				if (res.status === 'success' && res.data && res.data.payUrl) {
					// Chuyển hướng người dùng đến trang thanh toán MoMo
					window.location.href = res.data.payUrl;
				} else {
					toastr.error(res.message || 'Lỗi tạo yêu cầu thanh toán', 'Lỗi');
				}
			},
			error: function (xhr, status, error) {
				toastr.error('Không thể kết nối tới cổng thanh toán', 'Lỗi');
				console.error(error);
			},
			complete: function () {
				hideLoadingOverlay();
			}
		});
	}
</script>
