@model List<DataAccess.Entities.Manages.ThongTinHoSo.HoSoCCCT>
@{
	var session = HttpContextAccessor?.HttpContext?.Session ?? null;
	string role = ViewData["Role"] as string ?? "";
}
<table class="table table-striped table-hover table-responsive-lg rounded-lg m-0">
	<thead class="thead-light">
		<tr style="text-align:center;" class="table-active">
			<th width="5%">#</th>
			<th class="font-weight-boldest align-content-around">@Html.DisplayNameFor(x => x.First().MaSoHoSo)</th>
			<th class="font-weight-boldest align-content-around">@Html.DisplayNameFor(x => x.First().LoaiHopDong!.TenHopDong)</th>
			<th class="font-weight-boldest align-content-around">@Html.DisplayNameFor(x => x.First().GiaTriHopDong)</th>
			<th class="font-weight-boldest align-content-around" width="20%">Thông tin Công Chứng</th>
			<th class="font-weight-boldest align-content-around" width="30%">Thông tin yêu cầu</th>
			<th class="font-weight-boldest align-content-around" width="5%">Thao tác</th>
		</tr>
	</thead>
	<tbody>
		@if (Model.Count() > 0)
		{
			var pageInfo = ViewData["PageInfo"] as VMPageInfo;
			foreach (var item in Model)
			{
				<tr class="">
					<td class="text-center" style="vertical-align: middle">
						@(pageInfo!.RecordStart++)
					</td>
					<td class="text-center text-nowrap text-primary font-weight-boldest" style="vertical-align: middle">
						@item.MaSoHoSo
					</td>
					<td class="text-left" style="vertical-align: middle">
						<div class="row">
							<div class="col-2"></div>
							<div class="col-10">
								<span class="font-weight-boldest">
									@item.LoaiHopDong?.TenHopDong
								</span>
							</div>
						</div>
					</td>
					<td class="text-right" style="vertical-align: middle">
						<div class="row">
							<div class="col-10">
								<span class="">
									@(string.IsNullOrEmpty(item.StrSoTienMienThue) ? "" : item.StrSoTienMienThue + " VNĐ")
								</span>
							</div>
							<div class="col-2"></div>
						</div>
					</td>
					<td style="vertical-align: middle">
						<span class="text-primary text-nowrap font-weight-boldest">
							@*@Html.DisplayNameFor(x => item.SoQDDuyet):*@
							Số Công Chứng:
						</span>
						<span>
							@item.SoQDDuyet
						</span>
						<br />
						<span class="text-primary text-nowrap font-weight-boldest">
							Ngày Công Chứng:
						</span>
						<span>
							@FuntionGlobal.ConvertDateToStr(item.NgayDuyet)
						</span>
						<br />
						<span class="text-primary text-nowrap font-weight-boldest">
							@Html.DisplayNameFor(x => item.CongChungVienId):
						</span>
						<span>
							@item.CongChungVien?.TenCanBo
						</span>
					</td>
					<td style="vertical-align: middle">
						<span class="text-primary text-nowrap font-weight-boldest">
							@Html.DisplayNameFor(x => item.NgayThuLy):
						</span>
						<span>
							@FuntionGlobal.ConvertDateToStr(item.NgayThuLy)
						</span>
						<br />
						<span class="text-primary text-nowrap font-weight-boldest">
							@Html.DisplayNameFor(x => item.HoTenNguoiNop):
						</span>
						<span>
							@item.HoTenNguoiNop
						</span>
						<br />
						<span class="text-primary text-nowrap font-weight-boldest">
							@Html.DisplayNameFor(x => item.SoCCCDNguoiNop):
						</span>
						<span>
							@item.SoCCCDNguoiNop
						</span>
						<br />
						<span class="text-primary text-nowrap font-weight-boldest">
							@Html.DisplayNameFor(x => item.ThongTinDonVi):
						</span>
						<span>
							@item.ThongTinDonVi
						</span>
					</td>
					<td class="text-center text-nowrap" style="vertical-align: middle" id="tdAction_@item.Id">
						<a class="btn btn-sm btn-clean btn-icon" title="Xem chi tiết" target="_blank"
						   asp-controller="DanhSachHoSoCCCT" asp-action="Show" asp-route-HoSoId="@item.Id">
							<i class="icon-lg la la-eye text-success"></i>
						</a>
					</td>
				</tr>
			}
		}
		else
		{
			<tr>
				<td style="text-align:center" colspan="8">Không tìm thấy thông tin!!!</td>
			</tr>
		}
	</tbody>
</table>