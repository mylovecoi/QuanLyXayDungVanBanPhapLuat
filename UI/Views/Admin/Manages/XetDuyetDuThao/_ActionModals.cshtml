<script>
    function OpenThamDinhVanBan(id) {
        if ('@routePrefix' === '/Manages/XetDuyetVanBan') {
            window.location.href = '/Manages/XetDuyetVanBan/WorkflowPage?id=' + id;
            return;
        }

        OpenWorkflowAction(id);
    }

    function OpenTraLaiThamDinh(id) {
        $('#TraLaiDanhGiaId').val(id);
        $('#LyDoTraLaiDanhGia').val('');
        $('#GhiChuTraLaiDanhGia').val('');
        $('#TraLaiDanhGia_Modal').modal('show');
    }

    function SubmitTraLaiThamDinh() {
        if ('@routePrefix' === '/Manages/XetDuyetVanBan') {
            const csrfToken = $('input[name="__RequestVerificationToken"]').val();
            const id = $('#TraLaiDanhGiaId').val();
            const lyDoTraLai = $('#LyDoTraLaiDanhGia').val();
            const ghiChu = $('#GhiChuTraLaiDanhGia').val();

            if (!lyDoTraLai || !lyDoTraLai.trim()) {
                toastr.warning('Bạn cần nhập lý do trả lại hồ sơ.', 'Cảnh báo!');
                return;
            }

            $.ajax({
                url: '/Manages/XetDuyetVanBan/TraLaiHoSo',
                type: 'POST',
                data: {
                    __RequestVerificationToken: csrfToken,
                    id: id,
                    lyDoTraLai: lyDoTraLai,
                    ghiChu: ghiChu
                },
                success: function (response) {
                    if (response.status === 'success') {
                        toastr.success(response.message, 'Thành công!');
                        $('#TraLaiDanhGia_Modal').modal('hide');
                        window.location.reload();
                        return;
                    }

                    toastr.error(response.message, 'Lỗi!');
                },
                error: function () {
                    toastr.error('Không thể trả lại hồ sơ!', 'Lỗi!');
                }
            });
            return;
        }

        SubmitTraLaiDanhGia();
    }

    function toDateInputValue(date) {
        const pad = (value) => value.toString().padStart(2, '0');
        return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
    }

    function toDateTimeLocalValue(date) {
        const pad = (value) => value.toString().padStart(2, '0');
        return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
    }

    function OpenNhanHoSoDanhGia(id) {
        $('#NhanHoSoDanhGiaId').val(id);
        $('#NoiDungNhanHoSoDanhGia').val('');
        $('#GhiChuNhanHoSoDanhGia').val('');
        $('#NhanHoSoDanhGia_Modal').modal('show');
    }

    function SubmitNhanHoSoDanhGia() {
        const csrfToken = $('input[name="__RequestVerificationToken"]').val();
        const id = $('#NhanHoSoDanhGiaId').val();
        const noiDungXuLy = $('#NoiDungNhanHoSoDanhGia').val();
        const ghiChu = $('#GhiChuNhanHoSoDanhGia').val();

        $.ajax({
            url: '@($"{routePrefix}/NhanHoSo")',
            type: 'POST',
            data: {
                __RequestVerificationToken: csrfToken,
                id: id,
                actionType: 'NHAN_HO_SO',
                noiDungXuLy: noiDungXuLy,
                ghiChu: ghiChu
            },
            success: function (response) {
                if (response.status === 'success') {
                    toastr.success(response.message, 'Thành công!');
                    $('#NhanHoSoDanhGia_Modal').modal('hide');
                    if ('@routePrefix' === '/Manages/DanhGiaVanBan') {
                        window.setTimeout(function () {
                            window.location.href = '/Manages/XetDuyetVanBan';
                        }, 300);
                    } else {
                        window.location.reload();
                    }
                    return;
                }

                toastr.error(response.message, 'Lỗi!');
            },
            error: function () {
                toastr.error('Không thể nhận hồ sơ!', 'Lỗi!');
            }
        });
    }

    function OpenTraLaiDanhGia(id) {
        $('#TraLaiDanhGiaId').val(id);
        $('#LyDoTraLaiDanhGia').val('');
        $('#GhiChuTraLaiDanhGia').val('');
        $('#TraLaiDanhGia_Modal').modal('show');
    }

    function SubmitTraLaiDanhGia() {
        const csrfToken = $('input[name="__RequestVerificationToken"]').val();
        const id = $('#TraLaiDanhGiaId').val();
        const lyDoTraLai = $('#LyDoTraLaiDanhGia').val();
        const ghiChu = $('#GhiChuTraLaiDanhGia').val();

        if (!lyDoTraLai || !lyDoTraLai.trim()) {
            toastr.warning('Bạn cần nhập lý do trả lại hồ sơ.', 'Cảnh báo!');
            return;
        }

        $.ajax({
            url: '@($"{routePrefix}/TraLaiHoSo")',
            type: 'POST',
            data: {
                __RequestVerificationToken: csrfToken,
                id: id,
                lyDoTraLai: lyDoTraLai,
                ghiChu: ghiChu
            },
            success: function (response) {
                if (response.status === 'success') {
                    toastr.success(response.message, 'Thành công!');
                    $('#TraLaiDanhGia_Modal').modal('hide');
                    window.location.reload();
                    return;
                }

                toastr.error(response.message, 'Lỗi!');
            },
            error: function () {
                toastr.error('Không thể trả lại hồ sơ!', 'Lỗi!');
            }
        });
    }

    function ChuyenXetDuyetDanhGia(id, suggestedDeadline) {
        if ('@routePrefix' === '/Manages/DanhGiaVanBan') {
            $('#ChuyenDanhGiaId').val(id);
            $.ajax({
                url: '/Manages/DanhGiaVanBan/ChuyenDanhGiaModel',
                type: 'GET',
                data: { id: id },
                success: function (response) {
                    const now = new Date();
                    const defaultDeadline = new Date(now);
                    defaultDeadline.setDate(defaultDeadline.getDate() + 7);

                    if (response.status === 'success' && response.data) {
                        const model = response.data;
                        $('#NgayChuyenDanhGia').val(model.ngayXuLy
                            ? toDateTimeLocalValue(new Date(model.ngayXuLy))
                            : toDateTimeLocalValue(now));
                        $('#HanXuLyChuyenDanhGia').val(model.hanXuLy
                            ? toDateInputValue(new Date(model.hanXuLy))
                            : (suggestedDeadline || toDateInputValue(defaultDeadline)));
                    } else {
                        $('#NgayChuyenDanhGia').val(toDateTimeLocalValue(now));
                        $('#HanXuLyChuyenDanhGia').val(suggestedDeadline || toDateInputValue(defaultDeadline));
                    }

                    $('#ChuyenDanhGia_Modal').modal('show');
                },
                error: function () {
                    const now = new Date();
                    const defaultDeadline = new Date(now);
                    defaultDeadline.setDate(defaultDeadline.getDate() + 7);
                    $('#NgayChuyenDanhGia').val(toDateTimeLocalValue(now));
                    $('#HanXuLyChuyenDanhGia').val(suggestedDeadline || toDateInputValue(defaultDeadline));
                    $('#ChuyenDanhGia_Modal').modal('show');
                }
            });
            return;
        }

        const csrfToken = $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url: '@($"{routePrefix}/NhanHoSo")',
            type: 'POST',
            data: {
                __RequestVerificationToken: csrfToken,
                id: id,
                actionType: 'CHUYEN_XET_DUYET_DANH_GIA'
            },
            success: function (response) {
                if (response.status === 'success') {
                    if ('@routePrefix' === '/Manages/DanhGiaVanBan') {
                        toastr.success(response.message || 'Chuyển hồ sơ thành công!', 'Thành công!');
                        window.location.reload();
                        return;
                    }

                    OpenThamDinhVanBan(id);
                    return;
                }

                toastr.error(response.message, 'Lỗi!');
            },
            error: function () {
                toastr.error('Không thể chuyển hồ sơ sang màn hình thẩm định văn bản!', 'Lỗi!');
            }
        });
    }

    function SubmitChuyenDanhGia() {
        const csrfToken = $('input[name="__RequestVerificationToken"]').val();
        const id = $('#ChuyenDanhGiaId').val();
        const ngayXuLy = $('#NgayChuyenDanhGia').val();
        const hanXuLy = $('#HanXuLyChuyenDanhGia').val();

        if (!ngayXuLy) {
            toastr.warning('Bạn cần nhập thời gian chuyển hồ sơ.', 'Cảnh báo!');
            return;
        }

        if (!hanXuLy) {
            toastr.warning('Bạn cần nhập thời hạn xử lý.', 'Cảnh báo!');
            return;
        }

        $.ajax({
            url: '@($"{routePrefix}/NhanHoSo")',
            type: 'POST',
            data: {
                __RequestVerificationToken: csrfToken,
                id: id,
                actionType: 'CHUYEN_XET_DUYET_DANH_GIA',
                ngayXuLy: ngayXuLy,
                hanXuLy: hanXuLy
            },
            success: function (response) {
                if (response.status === 'success') {
                    toastr.success(response.message || 'Chuyển hồ sơ thành công!', 'Thành công!');
                    $('#ChuyenDanhGia_Modal').modal('hide');
                    window.location.reload();
                    return;
                }

                toastr.error(response.message, 'Lỗi!');
            },
            error: function () {
                toastr.error('Không thể chuyển hồ sơ sang màn hình thẩm định văn bản!', 'Lỗi!');
            }
        });
    }

    function OpenChuyenPheDuyetVanBan(id, suggestedDeadline) {
        if ('@routePrefix' !== '/Manages/XetDuyetVanBan') {
            return;
        }

        $('#ChuyenPheDuyetId').val(id);
        $.ajax({
            url: '/Manages/XetDuyetVanBan/ChuyenPheDuyetModel',
            type: 'GET',
            data: { id: id },
            success: function (response) {
                const now = new Date();
                const defaultDeadline = new Date(now);
                defaultDeadline.setDate(defaultDeadline.getDate() + 7);

                if (response.status === 'success' && response.data) {
                    const model = response.data;
                    $('#NgayChuyenPheDuyet').val(model.ngayXuLy
                        ? toDateTimeLocalValue(new Date(model.ngayXuLy))
                        : toDateTimeLocalValue(now));
                    $('#HanXuLyChuyenPheDuyet').val(model.hanXuLy
                        ? toDateInputValue(new Date(model.hanXuLy))
                        : (suggestedDeadline || toDateInputValue(defaultDeadline)));
                } else {
                    toastr.error(response.message || 'Không thể khởi tạo dữ liệu chuyển phê duyệt.', 'Lỗi!');
                    return;
                }

                $('#ChuyenPheDuyet_Modal').modal('show');
            },
            error: function () {
                const now = new Date();
                const defaultDeadline = new Date(now);
                defaultDeadline.setDate(defaultDeadline.getDate() + 7);
                $('#NgayChuyenPheDuyet').val(toDateTimeLocalValue(now));
                $('#HanXuLyChuyenPheDuyet').val(suggestedDeadline || toDateInputValue(defaultDeadline));
                $('#ChuyenPheDuyet_Modal').modal('show');
            }
        });
    }

    function SubmitChuyenPheDuyet() {
        const csrfToken = $('input[name="__RequestVerificationToken"]').val();
        const id = $('#ChuyenPheDuyetId').val();
        const ngayXuLy = $('#NgayChuyenPheDuyet').val();
        const hanXuLy = $('#HanXuLyChuyenPheDuyet').val();

        if (!ngayXuLy) {
            toastr.warning('Bạn cần nhập thời gian chuyển hồ sơ.', 'Cảnh báo!');
            return;
        }

        if (!hanXuLy) {
            toastr.warning('Bạn cần nhập thời hạn xử lý.', 'Cảnh báo!');
            return;
        }

        $.ajax({
            url: '/Manages/XetDuyetVanBan/NhanHoSo',
            type: 'POST',
            data: {
                __RequestVerificationToken: csrfToken,
                id: id,
                actionType: 'CHUYEN_PHE_DUYET',
                ngayXuLy: ngayXuLy,
                hanXuLy: hanXuLy
            },
            success: function (response) {
                if (response.status === 'success') {
                    toastr.success(response.message || 'Chuyển phê duyệt thành công!', 'Thành công!');
                    $('#ChuyenPheDuyet_Modal').modal('hide');
                    window.location.reload();
                    return;
                }

                toastr.error(response.message, 'Lỗi!');
            },
            error: function () {
                toastr.error('Không thể chuyển hồ sơ sang bước phê duyệt văn bản!', 'Lỗi!');
            }
        });
    }

    function OpenChuyenBanHanhVanBan(id, suggestedDeadline) {
        if ('@routePrefix' !== '/Manages/PheDuyetVanBan') {
            return;
