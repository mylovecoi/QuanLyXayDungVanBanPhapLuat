        <div class="modal-content">
            <div class="modal-header">
                <h3 class="card-label">
                    Chuyển ban hành
                    <span class="d-block text-muted pt-2 font-size-sm">Cập nhật thông tin trước khi chuyển hồ sơ sang bước ban hành văn bản</span>
                </h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <form id="frm_chuyen_banhanh">
                <div class="modal-body">
                    <input type="hidden" id="ChuyenBanHanhId" />
                    <div class="form-group">
                        <label class="font-weight-bold">Thời gian chuyển <span class="text-danger">*</span></label>
                        <input type="datetime-local" id="NgayChuyenBanHanh" class="form-control" />
                    </div>
                    <div class="form-group mb-0">
                        <label class="font-weight-bold">Thời hạn xử lý <span class="text-danger">*</span></label>
                        <input type="date" id="HanXuLyChuyenBanHanh" class="form-control" />
