@{
    var routePrefix = ViewData["RoutePrefix"]?.ToString() ?? "/Manages/XetDuyetDuThao";
}

<div class="modal fade" id="NhanHoSoDanhGia_Modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="card-label">
                    Nhận hồ sơ
                    <span class="d-block text-muted pt-2 font-size-sm">Xác nhận tiếp nhận hồ sơ chờ xử lý</span>
                </h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <form id="frm_nhanhoso_danhgia">
                <div class="modal-body">
                    <input type="hidden" id="NhanHoSoDanhGiaId" />
                    <div class="form-group">
                        <label class="font-weight-bold">Nội dung tiếp nhận</label>
                        <textarea id="NoiDungNhanHoSoDanhGia" class="form-control" rows="3" placeholder="Nhập nội dung tiếp nhận hồ sơ nếu cần"></textarea>
                    </div>
                    <div class="form-group mb-0">
                        <label class="font-weight-bold">Ghi chú</label>
                        <textarea id="GhiChuNhanHoSoDanhGia" class="form-control" rows="2" placeholder="Thông tin bổ sung nếu cần"></textarea>
                    </div>
                </div>
            </form>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-success font-weight-bold" onclick="SubmitNhanHoSoDanhGia()">Nhận hồ sơ</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="TraLaiDanhGia_Modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="card-label">
                    Trả lại hồ sơ
                    <span class="d-block text-muted pt-2 font-size-sm">Nhập lý do để trả hồ sơ về bước trước</span>
                </h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <form id="frm_tralai_danhgia">
                <div class="modal-body">
                    <input type="hidden" id="TraLaiDanhGiaId" />
                    <div class="form-group">
                        <label class="font-weight-bold">Lý do trả lại <span class="text-danger">*</span></label>
                        <textarea id="LyDoTraLaiDanhGia" class="form-control" rows="4" placeholder="Nhập rõ lý do trả lại hồ sơ"></textarea>
                    </div>
                    <div class="form-group mb-0">
                        <label class="font-weight-bold">Ghi chú</label>
                        <textarea id="GhiChuTraLaiDanhGia" class="form-control" rows="2" placeholder="Thông tin bổ sung nếu cần"></textarea>
                    </div>
                </div>
            </form>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-danger font-weight-bold" onclick="SubmitTraLaiThamDinh()">Trả lại hồ sơ</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ChuyenDanhGia_Modal" tabindex="-1" role="dialog" aria-hidden="true">
