                const now = new Date();
                const defaultDeadline = new Date(now);
                defaultDeadline.setDate(defaultDeadline.getDate() + 7);
                $('#NgayChuyenBanHanh').val(toDateTimeLocalValue(now));
                $('#HanXuLyChuyenBanHanh').val(suggestedDeadline || toDateInputValue(defaultDeadline));
                $('#ChuyenBanHanh_Modal').modal('show');
            }
        });
    }

    function SubmitChuyenBanHanh() {
        const csrfToken = $('input[name="__RequestVerificationToken"]').val();
        const id = $('#ChuyenBanHanhId').val();
        const ngayXuLy = $('#NgayChuyenBanHanh').val();
        const hanXuLy = $('#HanXuLyChuyenBanHanh').val();

        if (!ngayXuLy) {
            toastr.warning('Bạn cần nhập thời gian chuyển hồ sơ.', 'Cảnh báo!');
            return;
        }

        if (!hanXuLy) {
            toastr.warning('Bạn cần nhập thời hạn xử lý.', 'Cảnh báo!');
            return;
        }

        $.ajax({
            url: '/Manages/PheDuyetVanBan/NhanHoSo',
            type: 'POST',
            data: {
                __RequestVerificationToken: csrfToken,
                id: id,
                actionType: 'CHUYEN_BAN_HANH',
                ngayXuLy: ngayXuLy,
                hanXuLy: hanXuLy
            },
            success: function (response) {
                if (response.status === 'success') {
                    toastr.success(response.message || 'Chuyển ban hành thành công!', 'Thành công!');
                    $('#ChuyenBanHanh_Modal').modal('hide');
                    window.location.reload();
                    return;
                }

                toastr.error(response.message, 'Lỗi!');
            },
            error: function () {
                toastr.error('Không thể chuyển hồ sơ sang bước ban hành văn bản!', 'Lỗi!');
            }
        });
    }
</script>
