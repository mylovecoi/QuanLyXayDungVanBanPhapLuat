@using Services.Manages
@using DataAccess.Entities.Settings
@using UI.ViewModels
@model IEnumerable<ThiHanhPhapLuatKeHoachListItemModel>

@{
    var pageInfo = ViewData["PageInfo"] as VMPageInfo;
    var pageSize = pageInfo?.PageSize ?? 5;
    var timKiem = pageInfo?.Search ?? string.Empty;
    var donViOptions = ViewData["DonViOptions"] as List<DanhMucDonVi> ?? new();
    Guid? selectedDonViId = ViewData["SelectedDonViId"] is Guid selected ? selected : ViewData["SelectedDonViId"] as Guid?;
    var hideDonViFilter = ViewData["HideDonViFilter"] is bool hide && hide;
}

@section custom_script {
    <script>
        function ReloadFrm() {
            var currentPathUrl = window.location.pathname + '?';
            var timKiem = '&TimKiem=' + ($('#txt_Search').val() || '');
            var pageSize = '&PageSize=' + ($('#PageSize_Search').val() || '5');
            var donViId = $('#DonViId_Search').length ? '&DonViId=' + ($('#DonViId_Search').val() || '') : '';
            window.location.href = currentPathUrl + timKiem + pageSize + donViId;
        }

        function ClickPage(pageSelect) {
            var currentPathUrl = window.location.pathname + '?';
            var timKiem = '&TimKiem=' + ($('#txt_Search').val() || '');
            var pageSize = '&PageSize=' + ($('#PageSize_Search').val() || '5');
            var donViId = $('#DonViId_Search').length ? '&DonViId=' + ($('#DonViId_Search').val() || '') : '';
            var pageCurrent = '&PageCurrent=' + pageSelect;
            window.location.href = currentPathUrl + timKiem + pageSize + donViId + pageCurrent;
        }
    </script>
}

<div class="card card-custom">
    <div class="card-header flex-wrap border-0 pt-6 pb-0">
        <div class="card-title">
            <h3 class="card-label">
                <b>@ViewData["Title"]?.ToString()?.ToUpper()</b>
                <span class="d-block text-muted pt-2 font-size-sm">Quản lý kế hoạch, nhiệm vụ lớn và nhiệm vụ nhỏ của quá trình tổ chức thi hành pháp luật</span>
            </h3>
        </div>
        @if (Context.Request.Path.Value?.Contains("DanhSachKeHoachThiHanhPhapLuat") == true)
        {
            <div class="card-toolbar">
                <a href="/Manages/DanhSachKeHoachThiHanhPhapLuat/Edit" class="btn btn-primary font-weight-bolder">
                    <i class="la la-plus"></i>Thêm kế hoạch
                </a>
            </div>
        }
    </div>
    <div class="card-body pt-0">
        <hr />

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-light-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-light-danger">@TempData["ErrorMessage"]</div>
        }

        <div class="row">
            <div class="col-xl-3">
                <div class="form-group">
                    <label class="text-blue font-weight-bold">Hiển thị</label>
                    <select class="form-control" id="PageSize_Search">
                        <option value="5" selected="@(pageSize == 5 ? "selected" : null)">5</option>
                        <option value="10" selected="@(pageSize == 10 ? "selected" : null)">10</option>
                        <option value="20" selected="@(pageSize == 20 ? "selected" : null)">20</option>
                        <option value="50" selected="@(pageSize == 50 ? "selected" : null)">50</option>
                        <option value="100" selected="@(pageSize == 100 ? "selected" : null)">100</option>
                    </select>
                </div>
            </div>
            @if (!hideDonViFilter)
            {
                <div class="col-xl-4">
                    <div class="form-group">
                        <label class="text-blue font-weight-bold">Đơn vị chủ trì</label>
                        <select class="form-control" id="DonViId_Search">
                            <option value="">-- Tất cả đơn vị --</option>
                            @foreach (var item in donViOptions)
                            {
                                <option value="@item.Id" selected="@(selectedDonViId.HasValue && selectedDonViId.Value == item.Id ? "selected" : null)">@item.TenDonVi</option>
                            }
                        </select>
                    </div>
                </div>
            }
            <div class="col-xl-@(hideDonViFilter ? "9" : "5")">
                <div class="form-group">
                    <label class="text-blue font-weight-bold">Tìm kiếm</label>
                    <div class="input-group">
                        <input class="form-control" id="txt_Search" placeholder="Tìm theo mã, tên kế hoạch, căn cứ..." value="@timKiem" />
                        <div class="input-group-append">
                            <button class="btn btn-primary" type="button" onclick="ReloadFrm()"><i class="las la-search"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive border rounded-lg mb-8">
            <table class="table table-striped table-hover m-0">
                <thead>
                    <tr class="table-active text-center">
                        <th>Mã kế hoạch</th>
                        <th>Tên kế hoạch</th>
                        <th>Năm</th>
                        <th>Đơn vị chủ trì</th>
                        <th>Loại VB</th>
                        <th>Thời gian</th>
                        <th>Nhiệm vụ lớn</th>
                        <th>Nhiệm vụ nhỏ</th>
                        <th>Trạng thái</th>
                        <th width="12%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle font-weight-bold">@item.MaKeHoach</td>
                                <td class="align-middle">@item.TenKeHoach</td>
                                <td class="text-center align-middle">@item.Nam</td>
                                <td class="align-middle">@item.TenDonViChuTri</td>
                                <td class="align-middle">@(item.TenLoaiVanBan ?? "-")</td>
                                <td class="align-middle text-center">
                                    @(item.NgayBatDau?.ToString("dd/MM/yyyy") ?? "-")
                                    <br />
                                    @(item.NgayKetThuc?.ToString("dd/MM/yyyy") ?? "-")
                                </td>
                                <td class="text-center align-middle">@item.SoNhiemVuHoanThanh/@item.TongSoNhiemVu</td>
                                <td class="text-center align-middle">@item.SoChiTietHoanThanh/@item.TongSoChiTiet</td>
                                <td class="text-center align-middle">@item.TrangThai</td>
                                <td class="text-center align-middle">
                                    @if (Context.Request.Path.Value?.Contains("DanhSachKeHoachThiHanhPhapLuat") == true)
                                    {
                                        <a href="/Manages/DanhSachKeHoachThiHanhPhapLuat/Edit?id=@item.Id" class="btn btn-sm btn-clean btn-icon" title="Sửa">
                                            <i class="icon-lg la la-edit text-success"></i>
                                        </a>
                                    }
                                    <a href="@(Context.Request.Path.Value)/Details?id=@item.Id" class="btn btn-sm btn-clean btn-icon" title="Chi tiết">
                                        <i class="icon-lg la la-eye text-primary"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center">Không tìm thấy thông tin.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
    </div>
</div>
