@using Services.Manages
@using DataAccess.Entities.Settings
@using UI.ViewModels
@model IEnumerable<ThiHanhPhapLuatDanhGiaListItemModel>

@{
    var pageInfo = ViewData["PageInfo"] as VMPageInfo;
    var pageSize = pageInfo?.PageSize ?? 5;
    var timKiem = pageInfo?.Search ?? string.Empty;
    var donViOptions = ViewData["DonViOptions"] as List<DanhMucDonVi> ?? new();
    Guid? selectedDonViId = ViewData["SelectedDonViId"] is Guid selected ? selected : ViewData["SelectedDonViId"] as Guid?;
    var hideDonViFilter = ViewData["HideDonViFilter"] is bool hide && hide;
}

@section custom_script {
    <script>
        function ReloadFrm() {
            var currentPathUrl = window.location.pathname + '?';
            var timKiem = '&TimKiem=' + ($('#txt_Search').val() || '');
            var pageSize = '&PageSize=' + ($('#PageSize_Search').val() || '5');
            var donViId = $('#DonViId_Search').length ? '&DonViId=' + ($('#DonViId_Search').val() || '') : '';
            window.location.href = currentPathUrl + timKiem + pageSize + donViId;
        }
        function ClickPage(pageSelect) {
            var currentPathUrl = window.location.pathname + '?';
            var timKiem = '&TimKiem=' + ($('#txt_Search').val() || '');
            var pageSize = '&PageSize=' + ($('#PageSize_Search').val() || '5');
            var donViId = $('#DonViId_Search').length ? '&DonViId=' + ($('#DonViId_Search').val() || '') : '';
            var pageCurrent = '&PageCurrent=' + pageSelect;
            window.location.href = currentPathUrl + timKiem + pageSize + donViId + pageCurrent;
        }
        function getAlertClass(level) {
            if (level === 'QUA_HAN') return 'label-light-danger';
            if (level === 'CHAM_TIEN_DO') return 'label-light-warning';
            if (level === 'CHUA_NHAP_LIEU') return 'label-light-primary';
            if (level === 'CHUA_THUC_HIEN') return 'label-light-dark';
            return 'label-light-success';
        }
    </script>
}

<div class="card card-custom">
    <div class="card-header flex-wrap border-0 pt-6 pb-0">
        <div class="card-title">
            <h3 class="card-label">
                <b>@ViewData["Title"]?.ToString()?.ToUpper()</b>
                <span class="d-block text-muted pt-2 font-size-sm">Theo dõi cảnh báo chưa thực hiện, chưa nhập liệu, chậm tiến độ và quá hạn theo từng kế hoạch</span>
            </h3>
        </div>
    </div>
    <div class="card-body pt-0">
        <hr />
        <div class="row">
            <div class="col-xl-3">
                <div class="form-group">
                    <label class="text-blue font-weight-bold">Hiển thị</label>
                    <select class="form-control" id="PageSize_Search">
                        <option value="5" selected="@(pageSize == 5 ? "selected" : null)">5</option>
                        <option value="10" selected="@(pageSize == 10 ? "selected" : null)">10</option>
                        <option value="20" selected="@(pageSize == 20 ? "selected" : null)">20</option>
                        <option value="50" selected="@(pageSize == 50 ? "selected" : null)">50</option>
                        <option value="100" selected="@(pageSize == 100 ? "selected" : null)">100</option>
                    </select>
                </div>
            </div>
            @if (!hideDonViFilter)
            {
                <div class="col-xl-4">
                    <div class="form-group">
                        <label class="text-blue font-weight-bold">Đơn vị chủ trì</label>
                        <select class="form-control" id="DonViId_Search">
                            <option value="">-- Tất cả đơn vị --</option>
                            @foreach (var item in donViOptions)
                            {
                                <option value="@item.Id" selected="@(selectedDonViId.HasValue && selectedDonViId.Value == item.Id ? "selected" : null)">@item.TenDonVi</option>
                            }
                        </select>
                    </div>
                </div>
            }
            <div class="col-xl-@(hideDonViFilter ? "9" : "5")">
                <div class="form-group">
                    <label class="text-blue font-weight-bold">Tìm kiếm</label>
                    <div class="input-group">
                        <input class="form-control" id="txt_Search" placeholder="Tìm theo mã hoặc tên kế hoạch..." value="@timKiem" />
                        <div class="input-group-append">
                            <button class="btn btn-primary" type="button" onclick="ReloadFrm()"><i class="las la-search"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive border rounded-lg mb-8">
            <table class="table table-striped table-hover m-0">
                <thead>
                    <tr class="table-active text-center">
                        <th>Mã kế hoạch</th>
                        <th>Tên kế hoạch</th>
                        <th>Đơn vị</th>
                        <th>Tổng NV nhỏ</th>
                        <th>Hoàn thành</th>
                        <th>Chưa thực hiện</th>
                        <th>Chưa nhập liệu</th>
                        <th>Chậm tiến độ</th>
                        <th>Quá hạn</th>
                        <th>Tỷ lệ HT</th>
                        <th>Cảnh báo</th>
                        <th width="14%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var labelClass = item.MucDoCanhBao switch
                            {
                                "QUA_HAN" => "label-light-danger",
                                "CHAM_TIEN_DO" => "label-light-warning",
                                "CHUA_NHAP_LIEU" => "label-light-primary",
                                "CHUA_THUC_HIEN" => "label-light-dark",
                                _ => "label-light-success"
                            };
                            <tr>
                                <td class="align-middle font-weight-bold">@item.MaKeHoach</td>
                                <td class="align-middle">@item.TenKeHoach</td>
                                <td class="align-middle">@item.TenDonViChuTri</td>
                                <td class="text-center align-middle">@item.TongSoChiTiet</td>
                                <td class="text-center align-middle text-success font-weight-bold">@item.SoChiTietHoanThanh</td>
                                <td class="text-center align-middle">@item.SoChiTietChuaThucHien</td>
                                <td class="text-center align-middle text-primary font-weight-bold">@item.SoChiTietChuaNhapLieu</td>
                                <td class="text-center align-middle text-warning font-weight-bold">@item.SoChiTietChamTienDo</td>
                                <td class="text-center align-middle text-danger font-weight-bold">@item.SoChiTietQuaHan</td>
                                <td class="text-center align-middle">@item.TyLeHoanThanh%</td>
                                <td class="text-center align-middle">
                                    <span class="label label-lg @labelClass label-inline">@item.MucDoCanhBao</span>
                                </td>
                                <td class="text-center align-middle">
                                    <a href="/Manages/DanhGiaKetQuaThiHanhPhapLuat/Details?id=@item.KeHoachId" class="btn btn-sm btn-clean btn-icon" title="Chi tiết">
                                        <i class="icon-lg la la-eye text-primary"></i>
                                    </a>
                                    <a href="/Manages/DanhGiaKetQuaThiHanhPhapLuat/Edit?keHoachId=@item.KeHoachId" class="btn btn-sm btn-clean btn-icon" title="Đánh giá">
                                        <i class="icon-lg la la-check-square text-success"></i>
                                    </a>
                                    <a href="/Manages/DanhGiaKetQuaThiHanhPhapLuat/TongHop?keHoachId=@item.KeHoachId" class="btn btn-sm btn-clean btn-icon" title="Tổng hợp">
                                        <i class="icon-lg la la-file-text text-warning"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="12" class="text-center">Không tìm thấy thông tin.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
    </div>
</div>
