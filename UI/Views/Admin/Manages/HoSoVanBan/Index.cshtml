@using Services.Manages
@using Services.Model
@using UI.ViewModels
@model IEnumerable<HoSoVanBanListItemModel>

@{
    var session = HttpContextAccessor?.HttpContext?.Session;
    var pageInfo = ViewData["PageInfo"] as VMPageInfo;
    var pageSize = pageInfo?.PageSize ?? 5;
    var timKiem = pageInfo?.Search ?? string.Empty;
    var role = ViewData["Role"]?.ToString() ?? string.Empty;
    var recordId = pageInfo?.RecordStart ?? 1;
    var donViOptions = ViewData["DonViOptions"] as List<DonViOptionModel> ?? new List<DonViOptionModel>();
    Guid? selectedDonViId = ViewData["SelectedDonViId"] is Guid selected ? selected : ViewData["SelectedDonViId"] as Guid?;
    var selectedDonViName = ViewData["SelectedDonViName"]?.ToString();
    var isSSA = ViewData["IsSSA"] is bool flag && flag;
    var hideDonViFilter = ViewData["HideDonViFilter"] is bool hide && hide;
    var receiveModeMessage = ViewData["ReceiveModeMessage"]?.ToString();
    var routePrefix = ViewData["RoutePrefix"]?.ToString() ?? "/Manages/HoSoVanBan";
    var allowCreate = string.Equals(routePrefix, "/Manages/DangKyVanBan", StringComparison.OrdinalIgnoreCase)
        || string.Equals(routePrefix, "/Manages/DuThaoVanBan", StringComparison.OrdinalIgnoreCase)
        || string.Equals(routePrefix, "/Manages/HoSoVanBan", StringComparison.OrdinalIgnoreCase);
    var isXetDuyetDangKy = string.Equals(routePrefix, "/Manages/XetDuyetDangKy", StringComparison.OrdinalIgnoreCase);
    var isDangKyVanBan = string.Equals(routePrefix, "/Manages/DangKyVanBan", StringComparison.OrdinalIgnoreCase);
    var isSoanThaoVanBan = string.Equals(routePrefix, "/Manages/HoSoVanBan", StringComparison.OrdinalIgnoreCase);
    var isLayYKienVanBan = string.Equals(routePrefix, "/Manages/LayYKienVanBan", StringComparison.OrdinalIgnoreCase);
    var isLayYKienCoQuan = string.Equals(routePrefix, "/Manages/LayYKienUBND", StringComparison.OrdinalIgnoreCase)
        || string.Equals(routePrefix, "/Manages/LayYKienHDND", StringComparison.OrdinalIgnoreCase);
    var isLayYKienUBND = string.Equals(routePrefix, "/Manages/LayYKienUBND", StringComparison.OrdinalIgnoreCase);
    var isLayYKienHDND = string.Equals(routePrefix, "/Manages/LayYKienHDND", StringComparison.OrdinalIgnoreCase);
    var isDuThaoVanBan = string.Equals(routePrefix, "/Manages/DuThaoVanBan", StringComparison.OrdinalIgnoreCase);
    var isXetDuyetDuThao = string.Equals(routePrefix, "/Manages/XetDuyetDuThao", StringComparison.OrdinalIgnoreCase);
    var isXetDuyetVanBan = string.Equals(routePrefix, "/Manages/XetDuyetVanBan", StringComparison.OrdinalIgnoreCase);
    var isPheDuyetVanBan = string.Equals(routePrefix, "/Manages/PheDuyetVanBan", StringComparison.OrdinalIgnoreCase);
    var isDanhGiaVanBanList = string.Equals(routePrefix, "/Manages/DanhGiaVanBan", StringComparison.OrdinalIgnoreCase);
    var isDanhGiaVanBan = isXetDuyetDuThao || isXetDuyetVanBan || isDanhGiaVanBanList;
    var isTraCuuDangKy = string.Equals(routePrefix, "/Manages/TraCuuDangKyVanBan", StringComparison.OrdinalIgnoreCase);
    var trangThaiOptions = ViewData["TrangThaiOptions"] as List<SelectOptionModel> ?? new List<SelectOptionModel>();
    var buocDangKyOptions = ViewData["BuocDangKyOptions"] as List<SelectOptionModel> ?? new List<SelectOptionModel>();
    var selectedMaTrangThai = ViewData["SelectedMaTrangThai"]?.ToString();
    var selectedMaBuoc = ViewData["SelectedMaBuoc"]?.ToString();
    var tuNgayTao = ViewData["TuNgayTao"] as DateTime?;
    var denNgayTao = ViewData["DenNgayTao"] as DateTime?;
    var tuHanXuLy = ViewData["TuHanXuLy"] as DateTime?;
    var denHanXuLy = ViewData["DenHanXuLy"] as DateTime?;

    string GetTienDoLabel(HoSoVanBanListItemModel item) => item.TrangThaiTienDo switch
    {
        "DANG_XU_LY" => "Đang xử lý",
        "SAP_DEN_HAN" => "Sắp đến hạn",
        "QUA_HAN" => "Quá hạn",
        "HOAN_THANH_DUNG_HAN" => "Hoàn thành đúng hạn",
        "HOAN_THANH_QUA_HAN" => "Hoàn thành quá hạn",
        "CHUA_THUC_HIEN" => "Chưa thực hiện",
        _ => string.IsNullOrWhiteSpace(item.TenTrangThaiTienDo) ? "-" : item.TenTrangThaiTienDo
    };
}

@section custom_script {
    <script>
        $(document).ready(function () {
            $('#PageSize_Search').change(ReloadFrm);
            $('#DonViId_Search').change(ReloadFrm);
            $('#txt_Search').keypress(function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    ReloadFrm();
                }
            });
        });

        function ClearTxtSearch() {
            $('#txt_Search').val('');
            ReloadFrm();
        }

        function SubmitTxtSearch() {
            ReloadFrm();
        }

        function ReloadFrm() {
            var currentPathUrl = window.location.pathname + '?';
            var timKiem = '&TimKiem=' + ($('#txt_Search').val() || '');
            var pageSize = '&PageSize=' + ($('#PageSize_Search').val() || '5');
            var donViId = $('#DonViId_Search').length ? '&DonViId=' + ($('#DonViId_Search').val() || '') : '';
            var advancedFilters = buildAdvancedFilters();
            window.location.href = currentPathUrl + timKiem + pageSize + donViId + advancedFilters;
        }

        function ClickPage(pageSelect) {
            var currentPathUrl = window.location.pathname + '?';
            var timKiem = '&TimKiem=' + ($('#txt_Search').val() || '');
            var pageSize = '&PageSize=' + ($('#PageSize_Search').val() || '5');
            var donViId = $('#DonViId_Search').length ? '&DonViId=' + ($('#DonViId_Search').val() || '') : '';
            var pageCurrent = '&PageCurrent=' + pageSelect;
            var advancedFilters = buildAdvancedFilters();
            window.location.href = currentPathUrl + timKiem + pageSize + donViId + advancedFilters + pageCurrent;
        }

        function buildAdvancedFilters() {
            if ('@isTraCuuDangKy'.toLowerCase() !== 'true') {
                return '';
            }

            var maTrangThai = $('#MaTrangThai_Search').length ? '&MaTrangThai=' + ($('#MaTrangThai_Search').val() || '') : '';
            var maBuoc = $('#MaBuoc_Search').length ? '&MaBuoc=' + ($('#MaBuoc_Search').val() || '') : '';
            var tuNgayTao = $('#TuNgayTao_Search').length ? '&TuNgayTao=' + ($('#TuNgayTao_Search').val() || '') : '';
            var denNgayTao = $('#DenNgayTao_Search').length ? '&DenNgayTao=' + ($('#DenNgayTao_Search').val() || '') : '';
            var tuHanXuLy = $('#TuHanXuLy_Search').length ? '&TuHanXuLy=' + ($('#TuHanXuLy_Search').val() || '') : '';
            var denHanXuLy = $('#DenHanXuLy_Search').length ? '&DenHanXuLy=' + ($('#DenHanXuLy_Search').val() || '') : '';
            return maTrangThai + maBuoc + tuNgayTao + denNgayTao + tuHanXuLy + denHanXuLy;
        }

        function ChuyenLayYKien(id) {
            OpenChuyenLayGopY(id);
        }

        function ChuyenXetDuyetDuThao(id) {
            OpenChuyenHoSo(id);
        }

        function ChuyenPheDuyetVanBan(id, suggestedDeadline) {
            OpenChuyenPheDuyetVanBan(id, suggestedDeadline);
        }

        function ChuyenLayYKienUBND(id) {
            if (!confirm('Chuyển hồ sơ sang bước lấy ý kiến thành viên UBND?')) return;
            $.ajax({
                url: '/Manages/LayYKienUBND/Chuyen',
                type: 'POST',
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                data: { id: id },
                success: function (res) {
                    if (res.status === 'success') window.location.reload();
                    else toastr.error(res.message || 'Không thể chuyển hồ sơ.');
                },
                error: function () { toastr.error('Không thể chuyển hồ sơ sang lấy ý kiến UBND.'); }
            });
        }
    </script>
}

<div class="card card-custom">
    <div class="card-header flex-wrap border-0 pt-6 pb-0">
        <div class="card-title">
            <h3 class="card-label">
                <b>@ViewData["Title"]?.ToString()?.ToUpper()</b>
                <span class="d-block text-muted pt-2 font-size-sm">Quản lý @ViewData["Title"]</span>
            </h3>
        </div>
        <div class="card-toolbar">
            @if (allowCreate && session != null && FuntionGlobal.CheckPermission(session, role, "Create"))
            {
                <button type="button" class="btn btn-primary font-weight-bolder" onclick="Create()">
                    <i class="la la-plus"></i>Thêm mới
                </button>
            }
        </div>
    </div>

    @Html.AntiForgeryToken()

    <div class="card-body pt-0">
        <hr />

        @if (!isSoanThaoVanBan && !string.IsNullOrWhiteSpace(receiveModeMessage))
        {
            <div class="alert alert-light-info d-flex align-items-center mb-6">
                <i class="la la-inbox icon-xl mr-3 text-info"></i>
                <div class="font-weight-bold">@receiveModeMessage</div>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(selectedDonViName))
        {
            <div class="alert alert-light-primary d-flex align-items-center mb-6">
                <i class="la la-building icon-xl mr-3 text-primary"></i>
                <div>
                    <div class="font-weight-bold">Đang xem dữ liệu của đơn vị</div>
                    <div>@selectedDonViName</div>
                </div>
            </div>
        }
        else if (isSSA && !allowCreate)
        {
            <div class="alert alert-light-warning d-flex align-items-center mb-6">
                <i class="la la-sitemap icon-xl mr-3 text-warning"></i>
                <div>
                    <div class="font-weight-bold">Đang xem dữ liệu toàn bộ đơn vị</div>
                    <div>Tài khoản SSA có thể lọc theo từng đơn vị hoặc xem tất cả.</div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-xl-3">
                <div class="form-group">
                    <label class="text-blue font-weight-bold">Hiển thị</label>
                    <select class="form-control" id="PageSize_Search">
                        <option value="5" selected="@(pageSize == 5 ? "selected" : null)">5 thông tin</option>
                        <option value="10" selected="@(pageSize == 10 ? "selected" : null)">10 thông tin</option>
                        <option value="20" selected="@(pageSize == 20 ? "selected" : null)">20 thông tin</option>
                        <option value="50" selected="@(pageSize == 50 ? "selected" : null)">50 thông tin</option>
                        <option value="100" selected="@(pageSize == 100 ? "selected" : null)">100 thông tin</option>
                    </select>
                </div>
            </div>
            <div class="col-xl-9">
                <div class="row">
                    @if (!hideDonViFilter)
                    {
                        <div class="col-xl-5">
                            <div class="form-group">
                                <label class="text-blue font-weight-bold">Đơn vị</label>
                                <select class="form-control" id="DonViId_Search" @(isSSA ? null : "disabled")>
                                    @if (isSSA)
                                    {
                                        <option value="">-- Tất cả đơn vị --</option>
                                    }
                                    @foreach (var item in donViOptions)
                                    {
                                        <option value="@item.Id" selected="@(selectedDonViId.HasValue && selectedDonViId.Value == item.Id ? "selected" : null)">@item.TenDonVi</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }
                    <div class="col-xl-@(hideDonViFilter ? "12" : "7")">
                        <div class="form-group">
                            <label class="text-blue font-weight-bold">Tìm kiếm</label>
                            <div class="input-group">
                                <input class="form-control" id="txt_Search" placeholder="Tìm kiếm..." value="@timKiem" />
                                <div class="input-group-prepend">
                                    <button class="btn btn-danger" type="button" onclick="ClearTxtSearch()"><i class="las la-times-circle"></i></button>
                                </div>
                                <div class="input-group-append">
                                    <button class="btn btn-primary" type="button" onclick="SubmitTxtSearch()"><i class="las la-search"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (isTraCuuDangKy)
        {
            <div class="row">
                <div class="col-xl-3">
                    <div class="form-group">
                        <label class="text-blue font-weight-bold">Trạng thái</label>
                        <select class="form-control" id="MaTrangThai_Search">
                            <option value="">-- Tất cả trạng thái --</option>
                            @foreach (var item in trangThaiOptions)
                            {
                                <option value="@item.Value" selected="@(selectedMaTrangThai == item.Value ? "selected" : null)">@item.Text</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-xl-3">
                    <div class="form-group">
                        <label class="text-blue font-weight-bold">Bước hiện tại</label>
                        <select class="form-control" id="MaBuoc_Search">
                            <option value="">-- Tất cả bước --</option>
                            @foreach (var item in buocDangKyOptions)
                            {
                                <option value="@item.Value" selected="@(selectedMaBuoc == item.Value ? "selected" : null)">@item.Text</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-xl-3">
                    <div class="form-group">
                        <label class="text-blue font-weight-bold">Từ ngày tạo</label>
                        <input type="date" class="form-control" id="TuNgayTao_Search" value="@(tuNgayTao.HasValue ? tuNgayTao.Value.ToString("yyyy-MM-dd") : string.Empty)" />
                    </div>
                </div>
                <div class="col-xl-3">
                    <div class="form-group">
                        <label class="text-blue font-weight-bold">Đến ngày tạo</label>
                        <input type="date" class="form-control" id="DenNgayTao_Search" value="@(denNgayTao.HasValue ? denNgayTao.Value.ToString("yyyy-MM-dd") : string.Empty)" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-xl-3">
                    <div class="form-group">
                        <label class="text-blue font-weight-bold">Từ hạn xử lý</label>
                        <input type="date" class="form-control" id="TuHanXuLy_Search" value="@(tuHanXuLy.HasValue ? tuHanXuLy.Value.ToString("yyyy-MM-dd") : string.Empty)" />
                    </div>
                </div>
                <div class="col-xl-3">
                    <div class="form-group">
                        <label class="text-blue font-weight-bold">Đến hạn xử lý</label>
                        <input type="date" class="form-control" id="DenHanXuLy_Search" value="@(denHanXuLy.HasValue ? denHanXuLy.Value.ToString("yyyy-MM-dd") : string.Empty)" />
                    </div>
                </div>
                <div class="col-xl-6 d-flex align-items-end justify-content-end">
                    <div class="form-group mb-0">
                        <button type="button" class="btn btn-light-danger mr-2" onclick="window.location.href='@routePrefix'">
                            Xóa lọc
                        </button>
                        <button type="button" class="btn btn-primary" onclick="ReloadFrm()">
                            Áp dụng bộ lọc
                        </button>
                    </div>
                </div>
            </div>
        }

        <div class="table-responsive border rounded-lg mb-8">
            <table class="table table-striped table-hover table-responsive-lg rounded-lg m-0">
                <thead>
                    <tr class="table-active text-center">
                        <th width="4%">#</th>
                        <th width="26%">Thông tin hồ sơ</th>
                        <th width="15%">Loại VB / Quy trình</th>
                        <th width="15%">Bước hiện tại</th>
                        <th width="12%">Đơn vị</th>
                        <th width="12%">Trạng thái</th>
                        <th width="8%">Tiến độ</th>
                        <th width="8%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            var record = recordId++;
                            <tr class="@FuntionGlobal.GetClassTable(record)">
                                <td class="text-center align-middle">@record</td>
                                <td class="align-middle">
                                    <div class="font-weight-bold text-primary">@item.TenHoSo</div>
                                    <div>Tạo ngày: @FuntionGlobal.ConvertDateTimeToStr(item.NgayTaoHoSo)</div>
                                    @if (item.NgayNhanHienTai.HasValue && item.NguoiXuLyHienTaiId.HasValue)
                                    {
                                        <div>Ngày nhận: @FuntionGlobal.ConvertDateTimeToStr(item.NgayNhanHienTai.Value)</div>
                                    }
                                    @if (item.HanXuLy.HasValue)
                                    {
                                        <div>Hạn xử lý: @FuntionGlobal.ConvertDateToStr(item.HanXuLy.Value)</div>
                                    }
                                    @if (isDangKyVanBan && item.TrangThaiNghiepVuTiepNhan == "TRA_LAI_HO_SO")
                                    {
                                        <div class="mt-2">
                                            <span class="badge badge-danger" style="padding:8px 12px;">Bị trả lại</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(item.NoiDungXuLyHienTai))
                                        {
                                            <div class="text-danger mt-1"><span class="font-weight-bold">Lý do:</span> @item.NoiDungXuLyHienTai</div>
                                        }
                                    }
                                </td>
                                <td class="align-middle">
                                    <div>@item.TenLoaiVanBan</div>
                                    @if (isLayYKienCoQuan)
                                    {
                                        <div class="mt-1">
                                            <span class="badge badge-light-primary">@(string.Equals(item.ChuTheBanHanh, "HĐND", StringComparison.OrdinalIgnoreCase) ? "HĐND" : "UBND")</span>
                                        </div>
                                    }
                                    <div class="text-muted">@item.TenQuyTrinh</div>
                                </td>
                                <td class="align-middle">
                                    <div>@item.TenBuocHienTai</div>
                                    @if (isXetDuyetDangKy && !string.IsNullOrWhiteSpace(item.TenTrangThaiNghiepVuTiepNhan))
                                    {
                                        <div class="text-info font-weight-bold mt-1">@item.TenTrangThaiNghiepVuTiepNhan</div>
                                    }
                                    else if (isDanhGiaVanBan && !item.DaNhanHoSo)
                                    {
                                        <div class="text-warning font-weight-bold mt-1">Chờ nhận hồ sơ</div>
                                    }
                                    else if (!isDangKyVanBan && !isSoanThaoVanBan && !isLayYKienVanBan && !isLayYKienCoQuan && item.CanNhanHoSo)
                                    {
                                        <div class="text-warning font-weight-bold mt-1">Chưa nhận hồ sơ</div>
                                    }
                                </td>
                                <td class="align-middle">
                                    <div><span class="font-weight-bold">Khởi tạo:</span> @(string.IsNullOrWhiteSpace(item.TenDonViSoanThao) ? "-" : item.TenDonViSoanThao)</div>
                                    <div><span class="font-weight-bold">Đang xử lý:</span> @(string.IsNullOrWhiteSpace(item.TenDonViXuLyHienTai) ? "-" : item.TenDonViXuLyHienTai)</div>
                                </td>
                                <td class="text-center align-middle">
                                    @if (isDangKyVanBan && item.TrangThaiNghiepVuTiepNhan == "TRA_LAI_HO_SO")
                                    {
                                        <span class="badge" style="background-color:#DC3545;color:#FFFFFF;padding:8px 12px;">Bị trả lại</span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(item.TenTrangThai))
                                    {
                                        <span class="badge" style="background-color:@(string.IsNullOrWhiteSpace(item.MaMauTrangThai) ? "#6c757d" : item.MaMauTrangThai);color:#212529;padding:8px 12px;">
                                            @item.TenTrangThai
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-light">-</span>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    <div class="mb-2">
                                        <span class="badge" style="background-color:@item.MaMauTienDo;color:#212529;padding:8px 12px;">
                                            @GetTienDoLabel(item)
                                        </span>
                                    </div>
                                    <div class="font-weight-bold">@item.SoBuocHoanThanh/@item.TongSoBuoc bước</div>
                                    <div class="progress mt-2" style="height:8px;">
                                        <div class="progress-bar" role="progressbar" style="width:@item.TyLeHoanThanh%;background-color:@(item.SoBuocQuaHan > 0 ? "#DC3545" : "#28A745");"></div>
                                    </div>
                                    <div class="mt-2 small">
                                        <div>Quá hạn: @item.SoBuocQuaHan</div>
                                        <div>Chưa làm: @item.SoBuocChuaThucHien</div>
                                        <div>Trả lại: @item.SoLanTraLaiHienTai</div>
                                    </div>
                                </td>
                                <td class="text-center align-middle">
                                    @if (isDuThaoVanBan)
                                    {
                                        @if (session != null && FuntionGlobal.CheckPermission(session, role, "Index"))
                                        {
                                            @if (FuntionGlobal.CheckPermission(session, role, "Edit") && item.CanXuLyBuocHienTai)
                                            {
                                                <button type="button" onclick="window.location.href='/Manages/HoSoVanBanDuThao/EditPage?id=@item.Id'" class="btn btn-sm btn-clean btn-icon" title="Cập nhật dự thảo">
                                                    <i class="icon-lg la la-file-text text-warning"></i>
                                                </button>
                                                <button type="button" onclick="ChuyenXetDuyetDuThao('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Chuyển xét duyệt dự thảo">
                                                    <i class="icon-lg la la-share-square text-success"></i>
                                                </button>
                                            }
                                            <button type="button" onclick="Show('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Xem chi tiết">
                                                <i class="icon-lg la la-eye text-primary"></i>
                                            </button>
                                            <button type="button" onclick="ShowTimeline('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Xem timeline">
                                                <i class="icon-lg la la-stream text-info"></i>
                                            </button>
                                        }
                                    }
                                    else if (session != null && FuntionGlobal.CheckPermission(session, role, "Index"))
                                    {
                                        @if (isDanhGiaVanBanList &&
                                             item.MaBuocHienTai == "BUOC_02_GUI_THAM_DINH" &&
                                             FuntionGlobal.CheckPermission(session, role, "Edit"))
                                        {
                                            @if (item.CanNhanHoSo)
                                            {
                                                <button type="button" onclick="OpenNhanHoSoDanhGia('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Nhận hồ sơ">
                                                    <i class="icon-lg la la-inbox text-success"></i>
                                                </button>
                                                <button type="button" onclick="OpenTraLaiDanhGia('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Trả lại hồ sơ">
                                                    <i class="icon-lg la la-reply text-danger"></i>
                                                </button>
                                            }
                                            else if (item.DaNhanHoSo && item.CanXuLyBuocHienTai)
                                            {
                                                <button type="button" onclick="ChuyenXetDuyetDanhGia('@item.Id', '@(item.HanXuLy.HasValue ? item.HanXuLy.Value.ToString("yyyy-MM-dd") : string.Empty)')" class="btn btn-sm btn-clean btn-icon" title="Chuyển hồ sơ">
                                                    <i class="icon-lg la la-share-square text-warning"></i>
                                                </button>
                                            }
                                        }

                                        @if (isXetDuyetVanBan && FuntionGlobal.CheckPermission(session, role, "Edit") && item.CanXuLyBuocHienTai)
                                        {
                                            <button type="button" onclick="OpenThamDinhVanBan('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Xét duyệt hồ sơ">
                                                <i class="icon-lg la la-edit text-success"></i>
                                            </button>
                                            @if (item.DaCoBanGhiDanhGia)
                                            {
                                                <button type="button" onclick="ChuyenPheDuyetVanBan('@item.Id', '@(item.HanXuLy.HasValue ? item.HanXuLy.Value.ToString("yyyy-MM-dd") : string.Empty)')" class="btn btn-sm btn-clean btn-icon" title="Chuyển phê duyệt">
                                                    <i class="icon-lg la la-share-square text-warning"></i>
                                                </button>
                                            }
                                            <button type="button" onclick="OpenTraLaiThamDinh('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Trả lại hồ sơ">
                                                <i class="icon-lg la la-reply text-danger"></i>
                                            </button>
                                            <button type="button" onclick="window.location.href='/Manages/XetDuyetVanBan/SoSanhDuThao?id=@item.Id'" class="btn btn-sm btn-clean btn-icon" title="So sánh dự thảo">
                                                <i class="icon-lg la la-columns text-info"></i>
                                            </button>
                                        }

                                        @if (isPheDuyetVanBan && FuntionGlobal.CheckPermission(session, role, "Edit") && item.CanXuLyBuocHienTai)
                                        {
                                            <button type="button" onclick="window.location.href='/Manages/PheDuyetVanBan/WorkflowPage?id=@item.Id'" class="btn btn-sm btn-clean btn-icon" title="Phê duyệt hồ sơ">
                                                <i class="icon-lg la la-edit text-success"></i>
                                            </button>
                                            <button type="button" onclick="OpenChuyenBanHanhVanBan('@item.Id', '@(item.HanXuLy.HasValue ? item.HanXuLy.Value.ToString("yyyy-MM-dd") : string.Empty)')" class="btn btn-sm btn-clean btn-icon" title="Hoàn thành/Chuyển ban hành">
                                                <i class="icon-lg la la-share-square text-warning"></i>
                                            </button>
                                        }

                                        @if ((isSoanThaoVanBan || isDuThaoVanBan) && FuntionGlobal.CheckPermission(session, role, "Edit") && item.CanXuLyBuocHienTai)
                                        {
                                            <button type="button" onclick="window.location.href='/Manages/HoSoVanBanDuThao/EditPage?id=@item.Id'" class="btn btn-sm btn-clean btn-icon" title="Cập nhật dự thảo">
                                                <i class="icon-lg la la-file-text text-warning"></i>
                                            </button>
                                        }
                                        @if (isSoanThaoVanBan && item.CanXuLyBuocHienTai && item.DaCoDuThao)
                                        {
                                            <button type="button" onclick="ChuyenLayYKien('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Chuyển lấy ý kiến">
                                                <i class="icon-lg la la-share-square text-success"></i>
                                            </button>
                                        }
                                        @if (isDuThaoVanBan && item.CanXuLyBuocHienTai)
                                        {
                                            <button type="button" onclick="ChuyenXetDuyetDuThao('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Chuyển xét duyệt dự thảo">
                                                <i class="icon-lg la la-share-square text-success"></i>
                                            </button>
                                        }
                                        @if (isLayYKienVanBan && item.CoThePhanHoiLayYKien)
                                        {
                                            <button type="button" onclick="window.location.href='/Manages/LayYKienVanBan/PhanHoi?id=@item.Id'" class="btn btn-sm btn-clean btn-icon" title="Phản hồi góp ý">
                                                <i class="icon-lg la la-commenting text-warning"></i>
                                            </button>
                                        }
                                        @if (isLayYKienVanBan && item.CoTheTongHopLayYKien)
                                        {
                                            <button type="button" onclick="window.location.href='/Manages/LayYKienVanBan/TongHop?id=@item.Id'" class="btn btn-sm btn-clean btn-icon" title="Tổng hợp góp ý">
                                                <i class="icon-lg la la-check-square text-success"></i>
                                            </button>
                                        }
                                        @if (isLayYKienCoQuan && FuntionGlobal.CheckPermission(session, role, "Edit") && item.CanXuLyBuocHienTai)
                                        {
                                            @if (isLayYKienUBND && item.MaBuocHienTai == "BUOC_04_TRINH_HO_SO_XAY_DUNG")
                                            {
                                                <button type="button" onclick="ChuyenLayYKienUBND('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Chuyển lấy ý kiến UBND">
                                                    <i class="icon-lg la la-share-square text-warning"></i>
                                                </button>
                                            }
                                            @if (isLayYKienUBND && item.MaBuocHienTai == "BUOC_05_LAY_Y_KIEN_THANH_VIEN_UBND")
                                            {
                                                <button type="button" onclick="window.location.href='/Manages/LayYKienUBND/KetQua?id=@item.Id'" class="btn btn-sm btn-clean btn-icon" title="Nhập kết quả lấy ý kiến UBND">
                                                    <i class="icon-lg la la-edit text-success"></i>
                                                </button>
                                            }
                                            @if (isLayYKienHDND && item.MaBuocHienTai == "BUOC_06_TRINH_HDND_HOP")
                                            {
                                                <button type="button" onclick="window.location.href='/Manages/LayYKienHDND/KetQua?id=@item.Id'" class="btn btn-sm btn-clean btn-icon" title="Nhập kết quả lấy ý kiến HĐND">
                                                    <i class="icon-lg la la-edit text-primary"></i>
                                                </button>
                                            }
                                        }
                                        @if (isXetDuyetDangKy &&
                                             item.MaBuocHienTai == "BUOC_02_THONG_NHAT" &&
                                             item.CanXuLyBuocHienTai)
                                        {
                                            <button type="button" onclick="OpenWorkflowAction('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Phê duyệt kết quả">
                                                <i class="icon-lg la la-check-circle text-success"></i>
                                            </button>
                                            <button type="button" onclick="OpenTraLaiHoSo('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Trả lại">
                                                <i class="icon-lg la la-reply text-danger"></i>
                                            </button>
                                        }
                                        @if (isXetDuyetDangKy && item.NgayHoanThanh.HasValue)
                                        {
                                            <button type="button" onclick="TaoHoSoSoanThao('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Tạo hồ sơ soạn thảo">
                                                <i class="icon-lg la la-files-o text-success"></i>
                                            </button>
                                            <button type="button" onclick="HuyXetDuyetDangKy('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Hủy xét duyệt">
                                                <i class="icon-lg la la-undo text-warning"></i>
                                            </button>
                                        }
                                        <button type="button" onclick="Show('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Xem chi tiết">
                                            <i class="icon-lg la la-eye text-primary"></i>
                                        </button>
                                        <button type="button" onclick="ShowTimeline('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Xem timeline">
                                            <i class="icon-lg la la-stream text-info"></i>
                                        </button>
                                    }

                                    @if (session != null &&
                                         FuntionGlobal.CheckPermission(session, role, "Edit") &&
                                         isDangKyVanBan &&
                                         item.CanXuLyBuocHienTai &&
                                         item.MaBuocHienTai == "BUOC_01_DANG_KY")
                                    {
                                        <button type="button" onclick="EditDangKyHoSo('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Chỉnh sửa hồ sơ">
                                            <i class="icon-lg la la-edit text-warning"></i>
                                        </button>
                                        <button type="button" onclick="OpenChuyenHoSo('@item.Id')" class="btn btn-sm btn-clean btn-icon" title="Chuyển hồ sơ">
                                            <i class="icon-lg la la-share text-success"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td class="text-center" colspan="8">Không tìm thấy thông tin.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
    </div>
</div>

@await Html.PartialAsync("~/Views/Admin/Manages/HoSoVanBan/Modal.cshtml")
@if (isDanhGiaVanBan)
{
    @await Html.PartialAsync("~/Views/Admin/Manages/XetDuyetDuThao/_ActionModals.cshtml")
}
