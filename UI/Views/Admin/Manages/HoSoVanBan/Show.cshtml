@using Services.Manages
@model HoSoVanBanWorkflowDetailModel

@{
    var routePrefix = ViewData["RoutePrefix"]?.ToString() ?? "/Manages/HoSoVanBan";
    var workflowActionTitle = ViewData["WorkflowActionTitle"]?.ToString();
    workflowActionTitle = string.IsNullOrWhiteSpace(workflowActionTitle)
        ? (string.IsNullOrWhiteSpace(Model.TieuDeXuLyBuoc) ? "Cập nhật bước hiện tại" : Model.TieuDeXuLyBuoc)
        : workflowActionTitle;

    var approvalReviewMode = ViewData["ApprovalReviewMode"]?.ToString();
    var isDangKyApprovalMode = approvalReviewMode == "DangKy" && Model.MaBuocHienTai == "BUOC_02_THONG_NHAT";
    var isXetDuyetDangKy = string.Equals(routePrefix, "/Manages/XetDuyetDangKy", StringComparison.OrdinalIgnoreCase);
    var reviewMode = ViewData["ReviewMode"]?.ToString();
    var isXetDuyetDuThao = string.Equals(routePrefix, "/Manages/XetDuyetDuThao", StringComparison.OrdinalIgnoreCase);
    var isXetDuyetVanBan = string.Equals(routePrefix, "/Manages/XetDuyetVanBan", StringComparison.OrdinalIgnoreCase);
    var isDanhGiaVanBanList = string.Equals(routePrefix, "/Manages/DanhGiaVanBan", StringComparison.OrdinalIgnoreCase);
    var forceWorkflowAction = string.Equals(ViewData["ForceWorkflowAction"]?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
    var hideWorkflowAction = string.Equals(ViewData["HideWorkflowAction"]?.ToString(), "true", StringComparison.OrdinalIgnoreCase)
        || (!forceWorkflowAction && !Model.CanXuLyBuocHienTai);
    var isCompactWorkflowPage = string.Equals(ViewData["CompactWorkflowPage"]?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
    var isCompactApprovalView = isXetDuyetDangKy && isDangKyApprovalMode && !hideWorkflowAction;
    var isDraftReviewMode = (isXetDuyetDuThao || isXetDuyetVanBan) && reviewMode == "DuThao" && !hideWorkflowAction;
    var showDraftReadonlySection = isDraftReviewMode || isDanhGiaVanBanList || isXetDuyetVanBan;
}

@Html.AntiForgeryToken()

<style>
    .hoso-detail-shell {
        display: grid;
        gap: 20px;
    }

    .hoso-detail-summary {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
    }

    .hoso-summary-card,
    .hoso-info-card,
    .hoso-attachment-card,
    .hoso-action-card {
        border: 1px solid #e7ebf3;
        border-radius: 16px;
        background: linear-gradient(180deg, #ffffff 0%, #fbfcff 100%);
        box-shadow: 0 10px 26px rgba(27, 39, 94, 0.06);
    }

    .hoso-summary-card {
        padding: 16px 18px;
    }

    .hoso-summary-label {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: #7e8299;
        margin-bottom: 8px;
        font-weight: 700;
    }

    .hoso-summary-value {
        font-size: 16px;
        font-weight: 700;
        color: #181c32;
        line-height: 1.4;
    }

    .hoso-info-card,
    .hoso-attachment-card,
    .hoso-action-card {
        padding: 20px 22px;
    }

    .hoso-section-title {
        font-size: 18px;
        font-weight: 700;
        color: #0f4c81;
        margin-bottom: 16px;
    }

    .hoso-info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .hoso-info-item {
        padding: 14px 16px;
        border-radius: 12px;
        background: #f8faff;
        border: 1px solid #edf1f7;
    }

    .hoso-info-label {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: #7e8299;
        margin-bottom: 6px;
        font-weight: 700;
    }

    .hoso-info-value {
        font-size: 15px;
        color: #181c32;
        word-break: break-word;
    }

    .empty-attachment-state {
        padding: 18px;
        border-radius: 14px;
        background: #f8f9fc;
        color: #7e8299;
        text-align: center;
        border: 1px dashed #dbe3ef;
    }

    .draft-version-list {
        display: grid;
        gap: 14px;
    }

    .draft-version-card {
        border: 1px solid #e7ebf3;
        border-radius: 14px;
        background: #f8fbff;
        padding: 16px 18px;
    }

    .draft-version-header {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: flex-start;
        margin-bottom: 10px;
    }

    .draft-version-title {
        font-size: 15px;
        font-weight: 700;
        color: #181c32;
    }

    .draft-version-meta {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 12px;
    }

    .draft-version-meta-item {
        padding: 10px 12px;
        border-radius: 10px;
        background: #fff;
        border: 1px solid #edf1f7;
    }

    .draft-version-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: #7e8299;
        margin-bottom: 4px;
        font-weight: 700;
    }

    .draft-version-value {
        font-size: 14px;
        color: #181c32;
        word-break: break-word;
    }

    .workflow-action-buttons {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .hoso-history-list {
        display: grid;
        gap: 12px;
    }

    .hoso-history-card {
        border: 1px solid #e7ebf3;
        border-radius: 14px;
        background: #f8fbff;
        padding: 16px 18px;
    }

    .hoso-history-header {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: center;
        margin-bottom: 8px;
    }

    .hoso-history-title {
        font-size: 15px;
        font-weight: 700;
        color: #181c32;
    }

    .hoso-history-meta {
        color: #7e8299;
        font-size: 13px;
        margin-bottom: 8px;
    }

    .hoso-history-body {
        color: #181c32;
        white-space: pre-line;
    }

    @@media (max-width: 991.98px) {
        .hoso-detail-summary,
        .hoso-info-grid,
        .draft-version-meta {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="hoso-detail-shell">
    @if (!isCompactApprovalView && !isCompactWorkflowPage)
    {
        <div class="hoso-detail-summary">
            <div class="hoso-summary-card">
                <div class="hoso-summary-label">Tên hồ sơ</div>
                <div class="hoso-summary-value">@Model.TenHoSo</div>
            </div>
            <div class="hoso-summary-card">
                <div class="hoso-summary-label">Đơn vị soạn thảo</div>
                <div class="hoso-summary-value">@Model.TenDonViSoanThao</div>
            </div>
            <div class="hoso-summary-card">
                <div class="hoso-summary-label">Bước hiện tại</div>
                <div class="hoso-summary-value">@(string.IsNullOrWhiteSpace(Model.TenBuocHienTai) ? "Đã hoàn thành" : Model.TenBuocHienTai)</div>
            </div>
            <div class="hoso-summary-card">
                <div class="hoso-summary-label">Trạng thái</div>
                <div class="hoso-summary-value">
                    @if (!string.IsNullOrWhiteSpace(Model.TenTrangThai))
                    {
                        <span class="badge" style="background-color:@(string.IsNullOrWhiteSpace(Model.MaMauTrangThai) ? "#6c757d" : Model.MaMauTrangThai);color:#212529;padding:8px 12px;">
                            @Model.TenTrangThai
                        </span>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </div>
            </div>
        </div>

        <div class="hoso-info-card">
            <div class="hoso-section-title">Thông tin hồ sơ</div>
            <div class="hoso-info-grid">
                <div class="hoso-info-item">
                    <div class="hoso-info-label">Loại văn bản</div>
                    <div class="hoso-info-value">@Model.TenLoaiVanBan</div>
                </div>
                <div class="hoso-info-item">
                    <div class="hoso-info-label">Quy trình</div>
                    <div class="hoso-info-value">@Model.TenQuyTrinh</div>
                </div>
                @if (Model.HoSoDangKyNguonId.HasValue)
                {
                    <div class="hoso-info-item">
                        <div class="hoso-info-label">Hồ sơ đăng ký nguồn</div>
                        <div class="hoso-info-value">@(!string.IsNullOrWhiteSpace(Model.TenHoSoDangKyNguon) ? Model.TenHoSoDangKyNguon : Model.HoSoDangKyNguonId.ToString())</div>
                    </div>
                }
                <div class="hoso-info-item">
                    <div class="hoso-info-label">Ngày tạo hồ sơ</div>
                    <div class="hoso-info-value">@FuntionGlobal.ConvertDateTimeToStr(Model.NgayTaoHoSo)</div>
                </div>
                <div class="hoso-info-item">
                    <div class="hoso-info-label">Ngày nhận hồ sơ</div>
                    <div class="hoso-info-value">@(Model.NgayNhanHienTai.HasValue ? FuntionGlobal.ConvertDateTimeToStr(Model.NgayNhanHienTai.Value) : "-")</div>
                </div>
                <div class="hoso-info-item">
                    <div class="hoso-info-label">Hạn xử lý</div>
                    <div class="hoso-info-value">@(Model.HanXuLy.HasValue ? FuntionGlobal.ConvertDateToStr(Model.HanXuLy.Value) : "-")</div>
                </div>
                <div class="hoso-info-item">
                    <div class="hoso-info-label">Ngày hoàn thành</div>
                    <div class="hoso-info-value">@(Model.NgayHoanThanh.HasValue ? FuntionGlobal.ConvertDateTimeToStr(Model.NgayHoanThanh.Value) : "-")</div>
                </div>
                <div class="hoso-info-item">
                    <div class="hoso-info-label">Trạng thái tiếp nhận</div>
                    <div class="hoso-info-value">@(string.IsNullOrWhiteSpace(Model.TenTrangThaiNghiepVuTiepNhan) ? "-" : Model.TenTrangThaiNghiepVuTiepNhan)</div>
                </div>
                <div class="hoso-info-item">
                    <div class="hoso-info-label">Ghi chú</div>
                    <div class="hoso-info-value">@(string.IsNullOrWhiteSpace(Model.GhiChu) ? "-" : Model.GhiChu)</div>
                </div>
                <div class="hoso-info-item" style="grid-column: 1 / -1;">
                    <div class="hoso-info-label">Mô tả</div>
                    <div class="hoso-info-value">@(string.IsNullOrWhiteSpace(Model.MoTa) ? "-" : Model.MoTa)</div>
                </div>
                @if (Model.TrangThaiNghiepVuTiepNhan == "TRA_LAI_HO_SO" && !string.IsNullOrWhiteSpace(Model.NoiDungXuLyHienTai))
                {
                    <div class="hoso-info-item" style="grid-column: 1 / -1; border-color:#ffd4d4; background:#fff7f7;">
                        <div class="hoso-info-label" style="color:#dc3545;">Lý do trả lại</div>
                        <div class="hoso-info-value text-danger">@Model.NoiDungXuLyHienTai</div>
                    </div>
                }
            </div>
        </div>

        <div class="hoso-attachment-card">
            <div class="hoso-section-title">File đính kèm</div>
            <div id="attachedFileReadonlyContainer">
                <div class="empty-attachment-state">Đang tải danh sách file đính kèm...</div>
            </div>
        </div>

        <div class="hoso-attachment-card">
            <div class="hoso-section-title">Lịch sử đôn đốc</div>
            @if (Model.LichSuDonDocs.Any())
            {
                <div class="hoso-history-list">
                    @foreach (var item in Model.LichSuDonDocs)
                    {
                        <div class="hoso-history-card">
                            <div class="hoso-history-header">
                                <div class="hoso-history-title">Đôn đốc tiến độ</div>
                                <span class="badge @(item.DaXem ? "badge-light-success" : "badge-light-warning")">
                                    @(item.DaXem ? "Đã xem" : "Chưa xem")
                                </span>
                            </div>
                            <div class="hoso-history-meta">
                                <div><span class="font-weight-bold">Thời gian:</span> @FuntionGlobal.ConvertDateTimeToStr(item.CreatedDate)</div>
                                <div><span class="font-weight-bold">Đơn vị gửi:</span> @(string.IsNullOrWhiteSpace(item.TenDonViGui) ? "-" : item.TenDonViGui)</div>
                                <div><span class="font-weight-bold">Đơn vị nhận:</span> @(string.IsNullOrWhiteSpace(item.TenDonViNhan) ? "-" : item.TenDonViNhan)</div>
                            </div>
                            <div class="hoso-history-body">@item.NoiDung</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-attachment-state">Chưa phát sinh lịch sử đôn đốc nào cho hồ sơ này.</div>
            }
        </div>

        <div class="hoso-attachment-card">
            <div class="hoso-section-title">Lá»‹ch sá»­ gia háº¡n</div>
            @if (Model.LichSuGiaHans.Any())
            {
                <div class="hoso-history-list">
                    @foreach (var item in Model.LichSuGiaHans)
                    {
                        <div class="hoso-history-card">
                            <div class="hoso-history-header">
                                <div class="hoso-history-title">Gia háº¡n tiáº¿n Ä‘á»™</div>
                                <span class="badge badge-light-info">+@item.SoNgayGiaHan ngĂ y</span>
                            </div>
                            <div class="hoso-history-meta">
                                <div><span class="font-weight-bold">Thá»i gian gia háº¡n:</span> @FuntionGlobal.ConvertDateTimeToStr(item.CreatedDate)</div>
                                <div><span class="font-weight-bold">NgÆ°á»i gia háº¡n:</span> @(string.IsNullOrWhiteSpace(item.TenNguoiGiaHan) ? "-" : item.TenNguoiGiaHan)</div>
                                <div><span class="font-weight-bold">Háº¡n cÅ©:</span> @FuntionGlobal.ConvertDateToStr(item.HanXuLyCu)</div>
                                <div><span class="font-weight-bold">Háº¡n má»›i:</span> @FuntionGlobal.ConvertDateToStr(item.HanXuLyMoi)</div>
                            </div>
                            <div class="hoso-history-body">
                                <div><span class="font-weight-bold">LĂ½ do:</span> @(string.IsNullOrWhiteSpace(item.LyDoGiaHan) ? "-" : item.LyDoGiaHan)</div>
                                <div class="mt-2"><span class="font-weight-bold">Ghi chĂº:</span> @(string.IsNullOrWhiteSpace(item.GhiChu) ? "-" : item.GhiChu)</div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-attachment-state">ChÆ°a phĂ¡t sinh láº§n gia háº¡n nĂ o cho há»“ sÆ¡ nĂ y.</div>
            }
        </div>
    }

    @if (Model.BuocHienTaiId.HasValue && !hideWorkflowAction && isDangKyApprovalMode)
    {
        <div class="hoso-action-card">
            <div class="hoso-section-title">@workflowActionTitle</div>

            <div class="alert alert-light-warning mb-6">
                Chọn phê duyệt kết quả để hoàn thành quy trình đăng ký. Nếu cần trả lại, hãy dùng nút Trả lại ở danh sách hồ sơ.
            </div>

            <div class="card border mb-6">
                <div class="card-body">
                    <form id="frm_step_approve_dangky">
                        <input type="hidden" name="HoSoVanBanId" value="@Model.Id" />
                        <input type="hidden" name="KetQuaXuLy" value="DONG_Y" />
                        <input type="hidden" name="AttachedFileGroupId" value="@Model.Id" />
                        <div class="row">
                            <div class="col-xl-4">
                                <div class="form-group">
                                    <label>Thời gian phê duyệt</label>
                                    <input type="datetime-local" name="NgayXuLy" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                                </div>
                            </div>
                            <div class="col-xl-8">
                                <div class="form-group">
                                    <label>Thời hạn hoàn thành xây dựng văn bản</label>
                                    <input type="date" name="HanXuLy" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xl-6">
                                <div class="form-group">
                                    <label>Nội dung phê duyệt</label>
                                    <textarea name="NoiDungXuLy" class="form-control" rows="3"></textarea>
                                </div>
                            </div>
                            <div class="col-xl-6">
                                <div class="form-group">
                                    <label>Ghi chú</label>
                                    <textarea name="GhiChu" class="form-control" rows="3"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>File đính kèm bổ sung (nếu có)</label>
                            <div class="small text-muted mb-3">
                                File được gắn theo đúng hồ sơ hiện tại và sẽ đi cùng hồ sơ khi hoàn thành quy trình.
                            </div>
                            <input type="hidden" id="Id" value="@Model.Id" />
                            <input type="hidden" id="tableName" value="HoSoVanBan" />
                            <input type="hidden" id="ApprovalFileGroupId" value="@Model.Id" />
                            <input type="hidden" id="ApprovalFileTableName" value="HoSoVanBan" />
                            <div id="attachedFile_frm">
                                <div class="empty-attachment-state">Đang tải khu vực đính kèm file...</div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-success" onclick="submitApprovalDangKy()">Phê duyệt kết quả</button>
                    </form>
                </div>
            </div>
        </div>
    }

    @if (showDraftReadonlySection)
    {
        <div class="hoso-attachment-card">
            <div class="hoso-section-title">File dự thảo hiện tại</div>
            <div id="draftAttachedFileReadonlyContainer">
                <div class="empty-attachment-state">Đang tải file dự thảo...</div>
            </div>
        </div>

        <div class="hoso-attachment-card">
            <div class="hoso-section-title">Lịch sử phiên bản dự thảo</div>
            @if (Model.CacVersionDuThao.Any())
            {
                <div class="draft-version-list">
                    @foreach (var version in Model.CacVersionDuThao)
                    {
                        var filesContainerId = $"draftVersionFiles_{version.Id:N}";
                        <div class="draft-version-card">
                            <div class="draft-version-header">
                                <div>
                                    <div class="draft-version-title">@version.TenVersion</div>
                                    <div class="text-muted small">@version.LoaiVersion</div>
                                </div>
                                <span class="badge badge-light-danger">Trả lại: @version.SoLanTraLai lần</span>
                            </div>
                            <div class="draft-version-meta">
                                <div class="draft-version-meta-item">
                                    <div class="draft-version-label">Ngày tạo</div>
                                    <div class="draft-version-value">@FuntionGlobal.ConvertDateTimeToStr(version.NgayTaoVersion)</div>
                                </div>
                                <div class="draft-version-meta-item">
                                    <div class="draft-version-label">Đơn vị lưu</div>
                                    <div class="draft-version-value">@(string.IsNullOrWhiteSpace(version.TenDonViTao) ? "-" : version.TenDonViTao)</div>
                                </div>
                                <div class="draft-version-meta-item">
                                    <div class="draft-version-label">Ghi chú</div>
                                    <div class="draft-version-value">@(string.IsNullOrWhiteSpace(version.GhiChu) ? "-" : version.GhiChu)</div>
                                </div>
                            </div>
                            <div id="@filesContainerId">
                                <div class="empty-attachment-state">Đang tải file của phiên bản này...</div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-attachment-state">Chưa phát sinh phiên bản dự thảo nào được lưu lại.</div>
            }
        </div>

        @if (Model.BuocHienTaiId.HasValue && isDraftReviewMode)
        {
            var reviewFileGroupId = Guid.NewGuid();
            <div class="hoso-action-card">
                <div class="hoso-section-title">@workflowActionTitle</div>
                <div class="alert alert-light-info mb-6">
                    Đơn vị thẩm định có thể kết luận đạt để chuyển bước tiếp theo hoặc trả lại dự thảo tối đa 3 lần để đơn vị soạn thảo chỉnh sửa lại.
                </div>
                <form id="frm_step_review_duthao">
                    <input type="hidden" name="HoSoVanBanId" value="@Model.Id" />
                    <input type="hidden" name="AttachedFileGroupId" value="@reviewFileGroupId" />
                    <div class="row">
                        <div class="col-xl-4">
                            <div class="form-group">
                                <label>Kết quả thẩm định</label>
                                <select name="KetQuaDanhGia" class="form-control">
                                    <option value="DAT">Đạt</option>
                                    <option value="KHONG_DAT_LAN_1">Không đạt - trả lại lần 1</option>
                                    <option value="KHONG_DAT_LAN_2">Không đạt - trả lại lần 2</option>
                                    <option value="KHONG_DAT_LAN_3">Không đạt - trả lại lần 3</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-xl-8">
                            <div class="form-group">
                                <label>Ghi chú</label>
                                <input type="text" name="GhiChu" class="form-control" placeholder="Nhập ghi chú xử lý nếu có" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xl-6">
                            <div class="form-group">
                                <label>Nội dung thẩm định</label>
                                <textarea name="NoiDungDanhGia" class="form-control" rows="4" placeholder="Kết luận, nội dung thẩm định"></textarea>
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <div class="form-group">
                                <label>Yêu cầu chỉnh sửa</label>
                                <textarea name="YeuCauChinhSua" class="form-control" rows="4" placeholder="Nêu rõ nội dung cần chỉnh sửa khi trả lại dự thảo"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>File đính kèm thẩm định</label>
                        <div class="small text-muted mb-3">
                            Có thể đính kèm phiếu thẩm định, tài liệu góp ý nội bộ hoặc bản nhận xét để lưu cùng lần thẩm định này.
                        </div>
                        <input type="hidden" id="Id" value="@reviewFileGroupId" />
                        <input type="hidden" id="tableName" value="HoSoVanBanDanhGia" />
                        <input type="hidden" id="DraftReviewFileGroupId" value="@reviewFileGroupId" />
                        <input type="hidden" id="DraftReviewFileTableName" value="HoSoVanBanDanhGia" />
                        <div id="attachedFile_frm">
                            <div class="empty-attachment-state">Đang tải khu vực đính kèm file...</div>
                        </div>
                    </div>
                    <div class="workflow-action-buttons">
                        <button type="button" class="btn btn-warning" onclick="submitDraftReview()">Gửi kết quả thẩm định</button>
                    </div>
                </form>
            </div>
        }
    }
</div>

<script>
    function submitApprovalDangKy() {
        submitCurrentStep('@($"{routePrefix}/HoanThanhXuLy")', 'frm_step_approve_dangky');
    }

    function submitDraftReview() {
        submitCurrentStep('@($"{routePrefix}/HoanThanhDanhGia")', 'frm_step_review_duthao');
    }

    function submitCurrentStep(url, formId) {
        const form = document.getElementById(formId);
        if (!form) {
            return;
        }

        const workflowPageMode = '@(ViewData["WorkflowPageMode"]?.ToString() ?? "false")'.toLowerCase() === 'true';
        const token = document.querySelector('#frm_show input[name="__RequestVerificationToken"]')?.value
            || document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        $.ajax({
            url: url,
            type: 'POST',
            headers: {
                'RequestVerificationToken': token
            },
            data: $(form).serialize(),
            success: function (res) {
                if (res.status === 'success') {
                    toastr.success(res.message || 'Thành công');
                    if (workflowPageMode) {
                        window.setTimeout(function () {
                            window.location.href = '@routePrefix';
                        }, 300);
                    } else {
                        $('#Show_Modal').modal('hide');
                        window.setTimeout(function () {
                            window.location.reload();
                        }, 300);
                    }
                } else {
                    toastr.error(res.message || 'Có lỗi xảy ra');
                }
            },
            error: function () {
                toastr.error('Không thể cập nhật bước hiện tại');
            }
        });
    }

    function loadAttachedFilesReadonly() {
        const container = $('#attachedFileReadonlyContainer');
        if (!container.length) {
            return;
        }

        const url = '@Url.Action("GetAttachedFilesReadonly", "AttachedFile")' + '?GroupId=@Model.Id&TableName=HoSoVanBan';
        container.load(url);
    }

    function loadApprovalAttachedFilesEditor() {
        const container = $('#attachedFile_frm');
        const groupId = $('#ApprovalFileGroupId').val();
        const tableName = $('#ApprovalFileTableName').val();
        if (!container.length || !groupId || !tableName) {
            return;
        }

        $('#Id').val(groupId);
        $('#tableName').val(tableName);

        const url = '@Url.Action("GetAttachedFiles", "AttachedFile")' + '?GroupId=' + groupId + '&TableName=' + tableName;
        container.load(url, function () {
            $('.select2basic').select2();
        });
    }

    function loadDraftAttachedFilesReadonly() {
        const container = $('#draftAttachedFileReadonlyContainer');
        if (!container.length) {
            return;
        }

        const url = '@Url.Action("GetAttachedFilesReadonly", "AttachedFile")' + '?GroupId=@Model.Id&TableName=HoSoVanBanDuThao';
        container.load(url);
    }

    function loadDraftVersionFilesReadonly() {
        @foreach (var version in Model.CacVersionDuThao)
        {
            var filesContainerId = $"draftVersionFiles_{version.Id:N}";
            <text>
            $('#@filesContainerId').load('@Url.Action("GetAttachedFilesReadonly", "AttachedFile")?GroupId=@version.AttachedFileGroupId&TableName=HoSoVanBanDuThaoVersion');
            </text>
        }
    }

    function loadDraftReviewAttachedFilesEditor() {
        const container = $('#attachedFile_frm');
        const groupId = $('#DraftReviewFileGroupId').val();
        const tableName = $('#DraftReviewFileTableName').val();
        if (!container.length || !groupId || !tableName) {
            return;
        }

        $('#Id').val(groupId);
        $('#tableName').val(tableName);

        const url = '@Url.Action("GetAttachedFiles", "AttachedFile")' + '?GroupId=' + groupId + '&TableName=' + tableName;
        container.load(url, function () {
            $('.select2basic').select2();
        });
    }

    function initXetDuyetVanBanForm() {
        if ('@routePrefix' !== '/Manages/XetDuyetVanBan') {
            return;
        }

        const select = document.querySelector('#frm_step_review_duthao select[name="KetQuaDanhGia"]');
        if (select) {
            const firstOption = select.querySelector('option');
            if (firstOption) {
                firstOption.textContent = 'Lưu thẩm định';
            }
            select.value = 'THAM_DINH_XONG';
        }

        const submitButton = document.querySelector('#frm_step_review_duthao button.btn-warning');
        if (submitButton) {
            submitButton.textContent = 'Lưu thẩm định';
        }

        const returnButtonOverride = document.getElementById('btnTraLaiHoSoXetDuyet');
        if (returnButtonOverride) {
            returnButtonOverride.remove();
        }
    }

    loadAttachedFilesReadonly();
    loadApprovalAttachedFilesEditor();
    loadDraftAttachedFilesReadonly();
    loadDraftVersionFilesReadonly();
    loadDraftReviewAttachedFilesEditor();
    initXetDuyetVanBanForm();
</script>
