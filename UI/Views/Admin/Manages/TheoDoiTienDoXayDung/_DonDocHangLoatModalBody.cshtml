@model Services.Manages.HoSoVanBanDonDocHangLoatFormModel

@Html.AntiForgeryToken()

@for (var i = 0; i < Model.HoSoVanBanIds.Count; i++)
{
    <input type="hidden" name="HoSoVanBanIds[@i]" value="@Model.HoSoVanBanIds[i]" />
}

<div class="alert alert-light-warning mb-5">
    Bạn đang chuẩn bị gửi đôn đốc cho <span class="font-weight-bold">@Model.TongSoHoSo</span> hồ sơ.
</div>

<div class="table-responsive border rounded mb-5" style="max-height:300px;">
    <table class="table table-striped m-0">
        <thead>
            <tr class="table-active text-center">
                <th>Mã hồ sơ</th>
                <th>Tên hồ sơ</th>
                <th>Bước hiện tại</th>
                <th>Đơn vị xử lý</th>
                <th>Cảnh báo</th>
                <th>Hạn xử lý</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.HoSos)
            {
                <tr>
                    <td>@item.MaHoSo</td>
                    <td>@item.TenHoSo</td>
                    <td>@(item.TenBuocHienTai ?? "-")</td>
                    <td>@(item.TenDonViXuLyHienTai ?? "-")</td>
                    <td>@(item.TenMucCanhBao ?? "-")</td>
                    <td class="text-center">@(item.HanXuLy.HasValue ? item.HanXuLy.Value.ToString("dd/MM/yyyy") : "-")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="form-group mb-0">
    <label class="font-weight-bold">Nội dung đôn đốc <span class="text-danger">*</span></label>
    <textarea class="form-control" name="NoiDungDonDoc" id="NoiDungDonDocHangLoat" rows="5" placeholder="Nhập nội dung đôn đốc hàng loạt...">@Model.NoiDungDonDoc</textarea>
</div>
