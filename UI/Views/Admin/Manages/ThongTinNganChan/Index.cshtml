@using UI.ViewModels;
@using DataAccess.Entities.Settings;
@using DataAccess.Enums;

@{
    int pageSize = (ViewData["PageInfo"] as VMPageInfo)?.PageSize ?? 5;
    string timKiem = (ViewData["PageInfo"] as VMPageInfo)?.Search ?? "";
    string sort = (ViewData["PageInfo"] as VMPageInfo)?.Sort ?? "";
    var session = HttpContextAccessor?.HttpContext?.Session ?? null;
    string role = ViewData["Role"]?.ToString() ?? "";
    int record_id = 1;
}

@model IEnumerable<DataAccess.Entities.Manages.ThongTinNganChan>

@section custom_style {
}

<div class="card card-custom">
    <div class="card-header flex-wrap border-0 pt-6 pb-0">
        <div class="card-title">
            <h3 class="card-label">
                <b>@ViewData["Title"]?.ToString()?.ToUpper() NGĂN CHẶN</b>
                <span class="d-block text-muted pt-2 font-size-sm">
                    Quản Lý @FuntionGlobal.CapitalizeAll(ViewData["Title"]?.ToString()) Ngăn Chặn
                </span>
            </h3>
        </div>
        <div class="card-toolbar">
            <a class="btn btn-primary font-weight-bolder" asp-controller="ThongTinNganChan" asp-action="Create">
                <i class="la la-plus"></i>Thêm mới
            </a>
        </div>
    </div>
    @Html.AntiForgeryToken()
    <div class="card-body pt-0">
        <!--begin::Search Form-->
        <hr />
        <div class="row">
            <div class="col-xl-3" style="text-align:left">
                <div class="form-group fv-plugins-icon-container">
                    <label style="color:blue">Hiển thị</label>
                    <select class="form-control" name="PageSize" id="PageSize_Search">
                        <!option value="5" @(pageSize == 5 ? "selected" : "")>5 thông tin</!option>
                        <!option value="10" @(pageSize == 10 ? "selected" : "")>10 thông tin</!option>
                        <!option value="20" @(pageSize == 20 ? "selected" : "")>20 thông tin</!option>
                        <!option value="50" @(pageSize == 50 ? "selected" : "")>50 thông tin</!option>
                        <!option value="100" @(pageSize == 100 ? "selected" : "")> 100 thông tin</!option>
                    </select>
                </div>
            </div>
            <div class="col-xl-9" style="text-align:right">
                <div class="form-group fv-plugins-icon-container">
                    <label style="color:blue">Tìm kiếm</label>
                    <input class="form-control" name="txt_Search" id="txt_Search" placeholder="Tìm kiếm..." value="@timKiem">
                </div>
            </div>
        </div>
        <input hidden id="sortCurrent" name="sortCurrent" value="@ViewData["Sort"]" />
        <input hidden id="PageCurrent" name="PageCurrent" value="@ViewData["PageCurrent"]" />
        <!--begin: Datatable-->
        <div class="table-responsive border rounded-lg mb-8">
            <table class="table table-striped table-hover table-responsive-lg rounded-lg m-0">
                <thead class="thead-light">
                    <tr style="text-align:center;" class="table-active">
                        <th style="font-weight: bold;" width="2%">#</th>
                        <th style="font-weight: bold;" width="15%">Đơn vị ban hành</th>
                        <th style="font-weight: bold;" width="30%">Quyết định</th>
                        <th style="font-weight: bold;" width="30%">Thông tin tài sản</th>
                        <th style="font-weight: bold;" width="10%">Trạng thái</th>
                        <th style="font-weight: bold;" width="10%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td style="text-align: center; vertical-align:middle">@(record_id++)</td>
                                <td style="text-align: left; vertical-align:middle">@(item.DonViBanHanh?.TenDonVi)</td>
                                <td style="vertical-align: middle">
                                    <div><strong>Số QĐ:</strong> <span style="color:blue">@item.SoQuyetDinh</span></div>
                                    <div><strong>Ngày QĐ:</strong> <span style="color:blue">@FuntionGlobal.ConvertDateToStr(item.NgayQuyetDinh)</span></div>
                                    <div><strong>Ngày áp dụng:</strong> <span style="color:blue">@FuntionGlobal.ConvertDateToStr(item.NgayApDung)</span></div>

                                    @if (item.TrangThai == TrangThaiNganChan.KhongApDung && !string.IsNullOrEmpty(item.SoQuyetDinhDung))
                                    {
                                        <hr class="my-2" />
                                        <div class="mt-1">
                                            <div><strong>Số QĐ dừng:</strong> <span style="color:red">@item.SoQuyetDinhDung</span></div>
                                            <div><strong>Ngày QĐ dừng:</strong> <span style="color:red">@FuntionGlobal.ConvertDateToStr(item.NgayQuyetDinhDung!.Value)</span></div>
                                            <div><strong>Ngày áp dụng dừng:</strong> <span style="color:red">@FuntionGlobal.ConvertDateToStr(item.NgayApDungDung!.Value)</span></div>
                                        </div>
                                    }
                                </td>
                                <td style="vertical-align: middle">@item.ThongTinTaiSan</td>
                                <td style="text-align: center; vertical-align: middle">
                                    @if (item.TrangThai == DataAccess.Enums.TrangThaiNganChan.ApDung)
                                    {
                                        <span class="label label-lg font-weight-bold label-light-success label-inline">Đang Áp Dụng</span>
                                    }
                                    else
                                    {
                                        <span class="label label-lg font-weight-bold label-light-danger label-inline">Không Áp Dụng</span>
                                    }
                                </td>
                                <td style="text-align: center; vertical-align: middle">
                                    <a class="btn btn-sm btn-clean btn-icon" title="Xem chi tiết" target="_blank"
                                       asp-controller="ThongTinNganChan" asp-action="Show" asp-route-Id="@item.Id">
                                        <i class="icon-lg la la-eye text-success"></i>
                                    </a>
                                    @if (session != null && FuntionGlobal.CheckPermission(session, role ?? "", "Edit"))
                                    {
                                        <a class="btn btn-sm btn-clean btn-icon" title="Chỉnh sửa"
                                           asp-controller="ThongTinNganChan" asp-action="Edit" asp-route-Id="@item.Id">
                                            <i class="icon-lg la la-edit text-primary"></i>
                                        </a>
                                    }

                                    @if (session != null && FuntionGlobal.CheckPermission(session, role ?? "", "Delete"))
                                    {
                                        <button type="button" class="btn btn-sm btn-clean btn-icon" title="Xóa"
                                                onclick="Delete('@item.Id', '@item.ThongTinTaiSan', '@item.SoQuyetDinh')">
                                            <i class="icon-lg la la-trash text-danger"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td style="text-align:center" colspan="6">Không tìm thấy thông tin!!!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!--end: Datatable-->
        @await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
    </div>
</div>
@await Html.PartialAsync("~/Views/Admin/Manages/ThongTinNganChan/Modal.cshtml")

<script>
    $(document).ready(function () {
        $('#PageSize_Search, #txt_Search').change(function () {
            var current_path_url = '/Manages/ThongTinNganChan?';
            var timkiem = 'TimKiem=' + $('#txt_Search').val();
            var pageSize = '&PageSize=' + $('#PageSize_Search').val();
            var url = current_path_url + timkiem + pageSize;
            window.location.href = url;
        });
    });

    function ClickPage(pageSelect) {
        var current_path_url = '/Manages/ThongTinNganChan?';
        var timkiem = 'TimKiem=' + $('#txt_Search').val();
        var pageSize = '&PageSize=' + $('#PageSize_Search').val();
        var pageCurrent = '&PageCurrent=' + pageSelect;
        var url = current_path_url + timkiem + pageSize + pageCurrent;
        window.location.href = url;
    }

    function Delete(id, thongTinTaiSan, soQuyetDinh) {
        $('#id_delete').val(id);
        $('#titleDelete').text('Bạn có chắc chắn muốn xóa thông tin "' + thongTinTaiSan + ' - ' + soQuyetDinh + '"?');
        $('#kt_modal_Delete').modal('show');
    }
</script>
