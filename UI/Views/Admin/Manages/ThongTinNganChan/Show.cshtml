@using DataAccess.Enums;
@{
	Layout = "_LayoutReport";
	int record_id = 1;
}
@model DataAccess.Entities.Manages.ThongTinNganChan

<div class="container mt-4">
	<h2 class="text-center">THÔNG TIN NGĂN CHẶN</h2>

	<h4>1. Thông tin chung</h4>
	<p><strong>Cơ quan ban hành:</strong> @Model.CoQuanBanHanh</p>
	<p><strong>Số quyết định:</strong> @Model.SoQuyetDinh</p>
	<p><strong>Ngày quyết định:</strong> @FuntionGlobal.ConvertDateToStr(Model.NgayQuyetDinh)</p>
	<p><strong>Ngày áp dụng:</strong> @FuntionGlobal.ConvertDateToStr(Model.NgayApDung)</p>

	<h4>2. Thông tin chi tiết</h4>
	<p><strong>Thông tin tài sản:</strong></p>
	<p>@Model.ThongTinTaiSan</p>
	<p>
		<strong>Trạng thái:</strong>
		@if (Model.TrangThai == TrangThaiNganChan.KhongApDung)
		{
			<span class="badge badge-info">Không áp dụng</span>
		}
		else
		{
			<span class="badge badge-success">Đang áp dụng</span>
		}
	</p>

	@if (Model.TrangThai == TrangThaiNganChan.KhongApDung && !string.IsNullOrEmpty(Model.SoQuyetDinhDung))
	{
		<h4>3. Thông tin dừng áp dụng</h4>
		<p><strong>Cơ quan dừng:</strong> @Model.CoQuanDung</p>
		<p><strong>Số quyết định dừng:</strong> @Model.SoQuyetDinhDung</p>
		<p><strong>Ngày quyết định dừng:</strong> @FuntionGlobal.ConvertDateToStr(Model.NgayQuyetDinhDung.Value)</p>
		<p><strong>Ngày áp dụng dừng:</strong> @FuntionGlobal.ConvertDateToStr(Model.NgayApDungDung.Value)</p>
	}

	<h4>@(Model.TrangThai == TrangThaiNganChan.KhongApDung && !string.IsNullOrEmpty(Model.SoQuyetDinhDung) ? "4" : "3"). Tài liệu đính kèm</h4>
	@if (Model.DSHopDongDinhKem != null && Model.DSHopDongDinhKem.Any())
	{
		<table class="table table-bordered" border="1">
			<thead>
				<tr>
					<th width="2%">STT</th>
					<th width="60%">Mô tả</th>
					<th width="20%">Đường dẫn</th>
					<th>File đính kèm</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var file in Model.DSHopDongDinhKem)
				{
					<tr>
						<td>@(record_id++)</td>
						<td style="text-align:left">@file.MoTa</td>
						<td style="text-align:left"><a href="@file.Url" target="_blank">@file.Url</a></td>
						<td>
							@if (!string.IsNullOrEmpty(file.FileName))
							{
								<a href="/Manages/Download/AttachedFile?Id=@file.Id" target="_blank">Tải xuống</a>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
	else
	{
		<p>Không có tài liệu đính kèm.</p>
	}
</div>