@model List<DataAccess.Entities.Manages.ThongTinNganChan>
@{
	int count = 1;
}

<table class="table table-striped table-hover table-responsive-lg rounded-lg m-0">
	<thead class="thead-light">
		<tr style="text-align:center;" class="table-active">
			<th width="5%">#</th>
			<th class="font-weight-boldest align-content-around">Số Quyết Định</th>
			<th class="font-weight-boldest align-content-around">Cơ Quan Ban Hành</th>
			<th class="font-weight-boldest align-content-around">Ngày Quyết Định</th>
			<th class="font-weight-boldest align-content-around">Ngày Áp Dụng</th>
			<th class="font-weight-boldest align-content-around">Trạng Thái</th>
			<th class="font-weight-boldest align-content-around" width="30%">Thông Tin Tài Sản</th>
			<th class="font-weight-boldest align-content-around" width="5%">Thao tác</th>
		</tr>
	</thead>
	<tbody>
		@if (Model.Count() > 0)
		{
			foreach (var item in Model)
			{
				<tr class="">
					<td class="text-center" style="vertical-align: middle">
						@(count++)
					</td>
					<td class="text-center text-nowrap" style="vertical-align: middle">
						@item.SoQuyetDinh
					</td>
					<td class="text-center text-nowrap" style="vertical-align: middle">
						@item.CoQuanBanHanh
					</td>
					<td class="text-center text-nowrap" style="vertical-align: middle">
						<span>@FuntionGlobal.ConvertDateToStr(item.NgayQuyetDinh)</span>
					</td>
					<td class="text-center text-nowrap" style="vertical-align: middle">
						<span>@FuntionGlobal.ConvertDateToStr(item.NgayApDung)</span>
					</td>
					<td class="text-center text-nowrap" style="vertical-align: middle">
						@if (item.TrangThai == DataAccess.Enums.TrangThaiNganChan.ApDung)
						{
							<span class="label label-lg font-weight-bold label-light-success label-inline">Đang Áp Dụng</span>
						}
						else
						{
							<span class="label label-lg font-weight-bold label-light-danger label-inline">Không Áp Dụng</span>
						}
					</td>
					<td class="text-center text-nowrap" style="vertical-align: middle">
						<span>
							@item.ThongTinTaiSan
						</span>
					</td>
					<td class="text-center text-nowrap" style="vertical-align: middle" id="tdAction_@item.Id">
						<a class="btn btn-sm btn-clean btn-icon" title="Xem chi tiết"
						   asp-controller="ThongTinNganChan" asp-action="Show" asp-route-Id="@item.Id">
							<i class="icon-lg la la-eye text-success"></i>
						</a>
					</td>
				</tr>
			}
		}
		else
		{
			<tr>
				<td style="text-align:center" colspan="8">Không tìm thấy thông tin!!!</td>
			</tr>
		}
	</tbody>
</table> 