@section custom_style {
}
@section custom_script{   
}
<div class="card card-custom">
    <div class="card-header ribbon ribbon-top ribbon-ver">
        <div class="card-title">
            <h3 class="card-label">
                <b>@ViewData["Title"]?.ToString()?.ToUpper() NGĂN CHẶN</b>
                <span class="d-block text-muted pt-2 font-size-sm">
                    Cập Nhật Thông Tin Hồ Sơ Ngăn Chặn
                </span>
            </h3>
        </div>
    </div>
    <!--begin::Form-->
    <form asp-controller="ThongTinNganChan" asp-action="Update" method="post">
        <div class="card-body">
            @await Html.PartialAsync("~/Views/Admin/Manages/ThongTinNganChan/Detail/Index.cshtml")
        </div>
        <div class="card-footer" style="text-align:center">
            <a asp-controller="ThongTinNganChan" asp-action="Index" class="btn btn-danger">
                <i class="la la-reply"></i>Quay lại
            </a>&ensp;
            <button type="reset" class="btn btn-secondary"><i class="la la-refresh"></i>Nhập lại</button>&ensp;
            <button type="submit" class="btn btn-primary mr-2"><i class="la la-check"></i>Cập nhật</button>
        </div>
    </form>
    <!--end::Form-->
</div>
@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}