@using DataAccess.Entities.Settings;
@using DataAccess.Enums;
@model VMPageInfoWithData<DataAccess.Entities.Manages.ThongTinNganChan>
@{
	ViewData["PageInfo"] = Model;
}
<div class="card card-custom">
	<div class="card-header flex-wrap border-0 pt-6 pb-0">
		<div class="card-title">
			<h3 class="card-label">
				<b>@ViewData["Title"]?.ToString()?.ToUpper() NGĂN CHẶN</b>
				<span class="d-block text-muted pt-2 font-size-sm">
					Quản lý Tìm kiếm thông tin Ngăn Chặn
				</span>
			</h3>
		</div>
	</div>
	<div class="card-body pt-0">
		<form id="FilterForm">
			<hr />
			<div class="row">
				<div class="col-xl-3">
					<div class="form-group fv-plugins-icon-container">
						<label style="font-weight:bold; color:blue" class="">Đơn Vị:</label>
						<select class="form-control h-40px" name="DonViBanHanhId" id="DanhMucDonVi_Select">
							@{
								var dmDonVi = ViewData["DanhMucDonVi"] as List<DanhMucDonVi>;
								if (dmDonVi != null && dmDonVi.Any())
									foreach (var item in dmDonVi)
									{
										string backIn = FuntionGlobal.GetBackIn(item.Level);
										<!option value="@item.Id" @(Convert.ToString(ViewData["DonViBanHanhId"]) == item.Id.ToString() ? "selected" : "")>@Html.Raw(backIn)@item.TenDonVi</!option>
									}
							}
						</select>
					</div>
				</div>
				<div class="col-xl-3">
					<div class="form-group fv-plugins-icon-container">
						<label style="font-weight:bold; color:blue" class="">Số Quyết Định:</label>
						<input class="form-control h-40px" name="SoQuyetDinh" id="SoQuyetDinh_Input" placeholder="Nhập số quyết định..." value="@ViewData["SoQuyetDinh"]">
					</div>
				</div>
				<div class="col-xl-3">
					<div class="form-group fv-plugins-icon-container">
						<label style="font-weight:bold; color:blue" class="">Cơ Quan Ban Hành:</label>
						<input class="form-control h-40px" name="CoQuanBanHanh" id="CoQuanBanHanh_Input" placeholder="Nhập cơ quan ban hành..." value="@ViewData["CoQuanBanHanh"]">
					</div>
				</div>
				<div class="col-xl-3">
					<div class="form-group fv-plugins-icon-container">
						<label style="font-weight:bold; color:blue" class="">Thông Tin Tài Sản:</label>
						<input class="form-control h-40px" name="ThongTinTaiSan" id="ThongTinTaiSan_Input" placeholder="Nhập thông tin tài sản..." value="@ViewData["ThongTinTaiSan"]">
					</div>
				</div>
				<div class="col-xl-3">
					<div class="form-group fv-plugins-icon-container">
						<label style="font-weight:bold; color:blue" class="">Năm Quyết Định:</label>
						<select class="form-control h-40px" name="NamQuyetDinh" id="NamQuyetDinh_Select">
							<option value="">-- Tất Cả --</option>
							@for (int year = DateTime.Now.Year; year >= DateTime.Now.Year - 10; year--)
							{
								<!option value="@year" @(Convert.ToString(ViewData["NamQuyetDinh"]) == year.ToString() ? "selected" : "")>Năm @year</!option>
							}
						</select>
					</div>
				</div>
				<div class="col-xl-3">
					<div class="form-group fv-plugins-icon-container">
						<label style="font-weight:bold; color:blue" class="">Năm Áp Dụng:</label>
						<select class="form-control h-40px" name="NamApDung" id="NamApDung_Select">
							<option value="">-- Tất Cả --</option>
							@for (int year = DateTime.Now.Year; year >= DateTime.Now.Year - 10; year--)
							{
								<!option value="@year" @(Convert.ToString(ViewData["NamApDung"]) == year.ToString() ? "selected" : "")>Năm @year</!option>
							}
						</select>
					</div>
				</div>
				<div class="col-xl-3">
					<div class="form-group fv-plugins-icon-container">
						<label style="font-weight:bold; color:blue" class="">Trạng Thái:</label>
						<select class="form-control h-40px" name="TrangThai" id="TrangThai_Select">
							<option value="">-- Tất Cả --</option>
							<!option value="@TrangThaiNganChan.ApDung" @(ViewData["TrangThai"] != null && (TrangThaiNganChan)ViewData["TrangThai"]! == TrangThaiNganChan.ApDung ? "selected" : "")>Đang Áp Dụng</!option>
							<!option value="@TrangThaiNganChan.KhongApDung" @(ViewData["TrangThai"] != null && (TrangThaiNganChan)ViewData["TrangThai"]! == TrangThaiNganChan.KhongApDung ? "selected" : "")>Không Áp Dụng</!option>
						</select>
					</div>
				</div>
				<div class="col-xl-3">
					<div class="form-group fv-plugins-icon-container">
						<label style="font-weight:bold; color:blue">Tìm Kiếm</label>
						<input class="form-control h-40px" name="TimKiem" id="Search_Input" placeholder="Tìm kiếm..." value="@Model.Search">
					</div>
				</div>
			</div>

			<!-- Các trường lọc cho thông tin dừng -->
			<div id="khongApDungFilters" class="row" style="display: @(ViewData["TrangThai"] != null && (TrangThaiNganChan)ViewData["TrangThai"]! == TrangThaiNganChan.KhongApDung ? "flex" : "none");">
				<div class="col-xl-3">
					<div class="form-group fv-plugins-icon-container">
						<label class="">Số Quyết Định Dừng</label>
						<input class="form-control h-40px" name="SoQuyetDinhDung_temp" id="SoQuyetDinhDung_Input" placeholder="Nhập số quyết định dừng..." value="@ViewData["SoQuyetDinhDung"]">
					</div>
				</div>
				<div class="col-xl-3">
					<div class="form-group fv-plugins-icon-container">
						<label class="">Cơ Quan Dừng</label>
						<input class="form-control h-40px" name="CoQuanDung_temp" id="CoQuanDung_Input" placeholder="Nhập cơ quan dừng..." value="@ViewData["CoQuanDung"]">
					</div>
				</div>
				<div class="col-xl-3">
					<div class="form-group fv-plugins-icon-container">
						<label class="">Năm Quyết Định Dừng</label>
						<select class="form-control h-40px" name="NamQuyetDinhDung_temp" id="NamQuyetDinhDung_Select">
							<option value="">-- Tất Cả --</option>
							@for (int year = DateTime.Now.Year; year >= DateTime.Now.Year - 10; year--)
							{
								<!option value="@year" @(Convert.ToString(ViewData["NamQuyetDinhDung"]) == year.ToString() ? "selected" : "")>Năm @year</!option>
							}
						</select>
					</div>
				</div>
				<div class="col-xl-3">
					<div class="form-group fv-plugins-icon-container">
						<label class="">Năm Áp Dụng Dừng</label>
						<select class="form-control h-40px" name="NamApDungDung_temp" id="NamApDungDung_Select">
							<option value="">-- Tất Cả --</option>
							@for (int year = DateTime.Now.Year; year >= DateTime.Now.Year - 10; year--)
							{
								<!option value="@year" @(Convert.ToString(ViewData["NamApDungDung"]) == year.ToString() ? "selected" : "")>Năm @year</!option>
							}
						</select>
					</div>
				</div>
			</div>

			<div class="row">
				<div class="col-xl-12 text-center">
					<button class="btn btn-secondary btn-pill font-weight-bold mr-1" type="reset" id="resetButton">
						<i class="las la-sync-alt"></i>
						<span class="font-weight-boldest">Nhập Lại</span>
					</button>
					<button class="btn btn-primary btn-pill font-weight-bold ml-1" type="submit" id="submitButton">
						<i class="las la-search"></i>
						<span class="font-weight-boldest">Tìm Kiếm</span>
					</button>
				</div>
			</div>
			<hr />
			<div class="row">
				<div class="col-xl-3" style="text-align:left">
					<div class="form-group fv-plugins-icon-container">
						<label class="text-blue">Hiển thị</label>
						<select class="form-control h-40px" name="PageSize" id="PageSize_Select">
							<!option value="5" @(Model.PageSize == 5 ? "selected" : "")>5 thông tin</!option>
							<!option value="10" @(Model.PageSize == 10 ? "selected" : "")>10 thông tin</!option>
							<!option value="20" @(Model.PageSize == 20 ? "selected" : "")>20 thông tin</!option>
							<!option value="50" @(Model.PageSize == 50 ? "selected" : "")>50 thông tin</!option>
							<!option value="100" @(Model.PageSize == 100 ? "selected" : "")> 100 thông tin</!option>
						</select>
					</div>
				</div>
			</div>
			<input hidden id="PageCurrent" name="PageCurrent" value="@Model.PageCurrent" />

			<!-- Các trường ẩn để lưu giá trị tạm thời -->
			<input type="hidden" id="hiddenSoQuyetDinhDung" name="hiddenSoQuyetDinhDung" value="@ViewData["SoQuyetDinhDung"]" />
			<input type="hidden" id="hiddenCoQuanDung" name="hiddenCoQuanDung" value="@ViewData["CoQuanDung"]" />
			<input type="hidden" id="hiddenNamQuyetDinhDung" name="hiddenNamQuyetDinhDung" value="@ViewData["NamQuyetDinhDung"]" />
			<input type="hidden" id="hiddenNamApDungDung" name="hiddenNamApDungDung" value="@ViewData["NamApDungDung"]" />

			<!-- Các trường ẩn chính thức để gửi dữ liệu -->
			<input type="hidden" id="SoQuyetDinhDung" name="SoQuyetDinhDung" value="@ViewData["SoQuyetDinhDung"]" />
			<input type="hidden" id="CoQuanDung" name="CoQuanDung" value="@ViewData["CoQuanDung"]" />
			<input type="hidden" id="NamQuyetDinhDung" name="NamQuyetDinhDung" value="@ViewData["NamQuyetDinhDung"]" />
			<input type="hidden" id="NamApDungDung" name="NamApDungDung" value="@ViewData["NamApDungDung"]" />
		</form>
		<!--begin: Datatable-->
		<div class="table-responsive border rounded-lg mb-8">
			@await Html.PartialAsync("~/Views/Admin/Manages/ThongTinNganChan/_DataTable.cshtml", Model.Data)
		</div>
		<!--end: Datatable-->
		<div id="Pagination">
			@await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
		</div>
	</div>
</div>

@section custom_style {

}

@section custom_script {
	@* page *@
	<script src="~/js/site.js"></script>
	@* lib *@

	<script>
		$(document).ready(function () {
			SetupSelect2('#DanhMucDonVi_Select', 'Lựa Chọn Đơn Vị Làm Việc');

			function toggleKhongApDungFilters() {
				var selectedValue = $('#TrangThai_Select').val();
				console.log('Selected value:', selectedValue); // Debug log

				if (selectedValue == 'KhongApDung') { // So sánh với tên enum
					$('#khongApDungFilters').show();
					$('#SoQuyetDinhDung_Input').val($('#hiddenSoQuyetDinhDung').val());
					$('#CoQuanDung_Input').val($('#hiddenCoQuanDung').val());
					$('#NamQuyetDinhDung_Select').val($('#hiddenNamQuyetDinhDung').val());
					$('#NamApDungDung_Select').val($('#hiddenNamApDungDung').val());
				} else {
					// Lưu giá trị hiện tại vào hidden fields trước khi ẩn
					$('#hiddenSoQuyetDinhDung').val($('#SoQuyetDinhDung_Input').val());
					$('#hiddenCoQuanDung').val($('#CoQuanDung_Input').val());
					$('#hiddenNamQuyetDinhDung').val($('#NamQuyetDinhDung_Select').val());
					$('#hiddenNamApDungDung').val($('#NamApDungDung_Select').val());
					$('#khongApDungFilters').hide();
				}
			}

			// Gọi hàm khi trang vừa load
			toggleKhongApDungFilters();

			// Xử lý khi thay đổi trạng thái
			$('#TrangThai_Select').on('change', function() {
				toggleKhongApDungFilters();
			});

			// Xử lý form submit
			$('#FilterForm').on('submit', function(e) {
				e.preventDefault();
				var selectedTrangThai = $('#TrangThai_Select').val();
				if (selectedTrangThai == 'KhongApDung') {
					$('#SoQuyetDinhDung').val($('#SoQuyetDinhDung_Input').val());
					$('#CoQuanDung').val($('#CoQuanDung_Input').val());
					$('#NamQuyetDinhDung').val($('#NamQuyetDinhDung_Select').val());
					$('#NamApDungDung').val($('#NamApDungDung_Select').val());
				} else {
					$('#SoQuyetDinhDung').val('');
					$('#CoQuanDung').val('');
					$('#NamQuyetDinhDung').val('');
					$('#NamApDungDung').val('');
				}
				this.submit();
			});

			// Xử lý nút reset
			$('#resetButton').click(function() {
				window.location.href = '@Url.Action("Search", "ThongTinNganChan")';
			});

			// Thêm xử lý phân trang
			HandleRegisterFormFilter('#FilterForm', '#Pagination', '@Url.Action("Search", "ThongTinNganChan")');
		});
	</script>
}