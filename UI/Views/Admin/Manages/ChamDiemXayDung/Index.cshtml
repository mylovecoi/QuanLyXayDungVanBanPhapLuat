@using Services.Manages
@using UI.ViewModels
@model IEnumerable<HoSoVanBanListItemModel>

@{
    int pageSize = (ViewData["PageInfo"] as VMPageInfo)?.PageSize ?? 5;
    string timKiem = (ViewData["PageInfo"] as VMPageInfo)?.Search ?? "";
}

@section custom_script {
    <script>
        function ClearTxtSearch() { $('#txt_Search').val(''); }
        function SubmitTxtSearch() { ReloadFrm(); }
        $('#PageSize_Search').change(function () { ReloadFrm(); });
        function ReloadFrm() {
            var currentPathUrl = window.location.pathname + '?';
            var timKiem = '&TimKiem=' + $('#txt_Search').val();
            var pageSize = '&PageSize=' + $('#PageSize_Search').val();
            window.location.href = currentPathUrl + timKiem + pageSize;
        }
        function ClickPage(pageSelect) {
            var currentPathUrl = window.location.pathname + '?';
            var timKiem = '&TimKiem=' + $('#txt_Search').val();
            var pageSize = '&PageSize=' + $('#PageSize_Search').val();
            var pageCurrent = '&PageCurrent=' + pageSelect;
            window.location.href = currentPathUrl + timKiem + pageSize + pageCurrent;
        }
    </script>
}

<div class="card card-custom">
    <div class="card-header flex-wrap border-0 pt-6 pb-0">
        <div class="card-title">
            <h3 class="card-label">
                <b>@ViewData["Title"]?.ToString()?.ToUpper()</b>
                <span class="d-block text-muted pt-2 font-size-sm">Danh sách văn bản xây dựng đã hoàn thành để chấm điểm</span>
            </h3>
        </div>
    </div>
    <div class="card-body pt-0">
        <hr />
        <div class="row">
            <div class="col-xl-3">
                <div class="form-group">
                    <label class="text-blue">Hiển thị</label>
                    <select class="form-control" name="PageSize_Search" id="PageSize_Search">
                        <!option value="5" @(pageSize == 5 ? "selected" : "")>5 thông tin</!option>
                        <!option value="10" @(pageSize == 10 ? "selected" : "")>10 thông tin</!option>
                        <!option value="20" @(pageSize == 20 ? "selected" : "")>20 thông tin</!option>
                        <!option value="50" @(pageSize == 50 ? "selected" : "")>50 thông tin</!option>
                        <!option value="100" @(pageSize == 100 ? "selected" : "")>100 thông tin</!option>
                    </select>
                </div>
            </div>
            <div class="col-xl-9">
                <div class="form-group">
                    <label class="text-blue">Tìm kiếm</label>
                    <div class="input-group">
                        <input class="form-control" name="txt_Search" id="txt_Search" placeholder="Tìm kiếm..." value="@timKiem">
                        <div class="input-group-prepend">
                            <button class="btn btn-danger" type="button" onclick="ClearTxtSearch()"><i class="las la-times-circle"></i></button>
                        </div>
                        <div class="input-group-append">
                            <button class="btn btn-primary" type="button" onclick="SubmitTxtSearch()"><i class="las la-search"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive border rounded-lg mb-8">
            <table class="table table-striped table-hover table-responsive-lg rounded-lg m-0">
                <thead class="thead-light">
                    <tr class="table-active text-center">
                        <th>Mã hồ sơ</th>
                        <th>Tên hồ sơ</th>
                        <th>Loại văn bản</th>
                        <th>Đơn vị soạn thảo</th>
                        <th>Ngày ban hành</th>
                        <th>Đã có bản ghi</th>
                        <th>Tổng điểm</th>
                        <th>Xếp loại</th>
                        <th width="10%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle font-weight-bold">@item.MaHoSo</td>
                                <td class="align-middle">@item.TenHoSo</td>
                                <td class="align-middle">@item.TenLoaiVanBan</td>
                                <td class="align-middle">@item.TenDonViSoanThao</td>
                                <td class="text-center align-middle">@item.NgayHoanThanh?.ToString("dd/MM/yyyy")</td>
                                <td class="text-center align-middle">
                                    @if (item.DaCoBanGhiChamDiem)
                                    {
                                        <span class="label label-lg label-light-success label-inline">Đã chấm</span>
                                    }
                                    else
                                    {
                                        <span class="label label-lg label-light-warning label-inline">Chưa chấm</span>
                                    }
                                </td>
                                <td class="text-center align-middle">@(item.TongDiemDanhGia?.ToString("0.##") ?? "-")</td>
                                <td class="text-center align-middle">@(item.XepLoaiDanhGia ?? "-")</td>
                                <td class="text-center align-middle">
                                    <button type="button" onclick="window.location.href='/Manages/ChamDiemXayDung/Edit?id=@item.Id'" class="btn btn-sm btn-clean btn-icon" title="Chấm điểm">
                                        <i class="icon-lg la la-edit text-primary"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center">Không tìm thấy thông tin!!!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("~/Views/Shared/Pagination.cshtml")
    </div>
</div>
