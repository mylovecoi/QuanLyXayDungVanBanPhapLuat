@using DataAccess.Entities.ThamDinhGia
@model IEnumerable<DataAccess.Entities.ThamDinhGia.ThamDinhGiaCt>

@{
    Layout = "_Layout";
    Guid hangHoaId = (Guid)(ViewData["HangHoaId"] ?? Guid.Empty);
    string tenDanhMucHangHoa = ViewData["TenDanhMucHangHoa"] as string ?? "";
    string tuNgay = ViewData["TuNgay"] as string ?? "";
    string denNgay = ViewData["DenNgay"] as string ?? "";
    string soTbKl = ViewData["SoTbKl"] as string ?? "";
    string dvYeuCau = ViewData["DvYeuCau"] as string ?? "";
    var parentMap = ViewData["ParentMap"] as Dictionary<Guid, DataAccess.Entities.ThamDinhGia.ThamDinhGia> ?? new Dictionary<Guid, DataAccess.Entities.ThamDinhGia.ThamDinhGia>();
    int stt = 1;
}

@section custom_style {
}

@section custom_script {
    <script>
        function handlePrint() {
            var url = '@Url.Action("PrintThamDinhGia", "TraCuu")' + 
                      '?hangHoaId=' + encodeURIComponent($('input[name="hangHoaId"]').val() || '') +
                      '&TuNgay=' + encodeURIComponent($('input[name="TuNgay"]').val() || '') +
                      '&DenNgay=' + encodeURIComponent($('input[name="DenNgay"]').val() || '') +
                      '&SoTbKl=' + encodeURIComponent($('input[name="SoTbKl"]').val() || '') +
                      '&DvYeuCau=' + encodeURIComponent($('input[name="DvYeuCau"]').val() || '') +
                      '&MaHoSo=' + encodeURIComponent($('input[name="MaHoSo"]').val() || '');
            window.open(url, '_blank');
        }
    </script>
}

<div class="card card-custom">
    <div class="card-header border-0 pt-6 pb-2">
        <div class="card-title">
            <h3 class="card-label">
                TRA CỨU CHI TIẾT HỒ SƠ THẨM ĐỊNH GIÁ: <span class="text-info">@tenDanhMucHangHoa</span>
                <span class="d-block text-muted pt-2 font-size-sm">Nhập các điều kiện lọc để tìm kiếm chi tiết hồ sơ thẩm định giá</span>
            </h3>
        </div>
        <div class="card-toolbar">
            <a href="@Url.Action("Index", "TraCuu")" class="btn btn-light-danger font-weight-bold">
                <i class="la la-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>
    <div class="card-body">
        <!-- Form Search -->
        <form method="get" action="@Url.Action("ThamDinhGia", "TraCuu")" class="mb-8">
            <input type="hidden" name="hangHoaId" value="@hangHoaId" />
            <input type="hidden" name="MaHoSo" value="@ViewData["MaHoSo"]" />
            <div class="row">
                <div class="col-md-3 form-group">
                    <label class="font-weight-bold">Từ ngày</label>
                    <input type="date" class="form-control" name="TuNgay" value="@tuNgay" />
                </div>
                <div class="col-md-3 form-group">
                    <label class="font-weight-bold">Đến ngày</label>
                    <input type="date" class="form-control" name="DenNgay" value="@denNgay" />
                </div>
                <div class="col-md-3 form-group">
                    <label class="font-weight-bold">Số TB kết luận</label>
                    <input type="text" class="form-control" name="SoTbKl" placeholder="Nhập số TB kết luận..." value="@soTbKl" />
                </div>
                <div class="col-md-3 form-group">
                    <label class="font-weight-bold">Đơn vị yêu cầu</label>
                    <input type="text" class="form-control" name="DvYeuCau" placeholder="Nhập đơn vị yêu cầu..." value="@dvYeuCau" />
                </div>
            </div>
            <div class="row justify-content-end">
                <div class="col-auto">
                    <button type="submit" class="btn btn-info text-white font-weight-bold px-6">
                        <i class="la la-search"></i> Tìm kiếm
                    </button>
                    <button type="button" class="btn btn-primary font-weight-bold px-6" onclick="handlePrint()">
                        <i class="la la-print"></i> In trang
                    </button>
                    <a href="@Url.Action("ThamDinhGia", "TraCuu", new { hangHoaId = hangHoaId })" class="btn btn-secondary font-weight-bold px-6">
                        <i class="la la-sync"></i> Reset
                    </a>
                </div>
            </div>
        </form>

        <!-- Table Results -->
        <div class="table-responsive border rounded-lg">
            <table class="table table-striped table-hover table-bordered m-0">
                <thead class="thead-light">
                    <tr class="text-center font-weight-bold">
                        <th width="3%">#</th>
                        <th>Đơn vị yêu cầu</th>
                        <th>Số TB kết luận</th>
                        <th>Thời điểm</th>
                        <th>Mã hàng hóa</th>
                        <th>Tên hàng hóa</th>
                        <th>Quy cách CL</th>
                        <th>Thông số KT</th>
                        <th>Xuất xứ</th>
                        <th>Đơn vị tính</th>
                        <th>Số lượng</th>
                        <th>Đơn giá thẩm định</th>
                        <th>Giá trị tài sản</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            parentMap.TryGetValue(item.MaHoSo, out var parent);
                            <tr>
                                <td class="text-center">@(stt++)</td>
                                <td>@(parent?.DvYeuCau ?? "")</td>
                                <td>@(parent?.SoTbKl ?? "")</td>
                                <td class="text-center">@(parent?.Thoidiem.ToString("dd/MM/yyyy") ?? "")</td>
                                <td>@item.MaHangHoa</td>
                                <td>@item.TenHangHoa</td>
                                <td>@item.QuyCachChatLuong</td>
                                <td>@item.ThongSoKt</td>
                                <td>@item.XuatXu</td>
                                <td class="text-center">@item.DonViTinh</td>
                                <td class="text-right">@item.SoLuong.ToString("N0")</td>
                                <td class="text-right">@item.DonGiaThamDinh.ToString("N0")</td>
                                <td class="text-right">@item.GiaTriTsThamDinh.ToString("N0")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="13" class="text-center text-muted">Không tìm thấy chi tiết hồ sơ thẩm định giá phù hợp.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
