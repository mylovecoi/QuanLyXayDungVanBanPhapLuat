@using System.Reflection
@using DataAccess.Entities.DinhGiaHHDV
@model IEnumerable<object>

@{
    Layout = "_Layout";
    string maNghe = ViewData["MaNghe"] as string ?? "";
    string tenNghe = ViewData["TenNghe"] as string ?? "";
    string tuNgay = ViewData["TuNgay"] as string ?? "";
    string denNgay = ViewData["DenNgay"] as string ?? "";
    string soQd = ViewData["SoQd"] as string ?? "";
    string moTa = ViewData["MoTa"] as string ?? "";
    var parentMap = ViewData["ParentMap"] as Dictionary<string, DinhGia> ?? new Dictionary<string, DinhGia>();
    int stt = 1;

    PropertyInfo[] detailProps = Array.Empty<PropertyInfo>();
    if (Model != null && Model.Any())
    {
        var firstDetailObj = Model.First();
        var type = firstDetailObj.GetType();
        var excludedNames = new HashSet<string> { "Id", "DonViQuanLyId", "DonViQuanLy", "MaHoSo", "TrangThai", "MaNghe", "MaChiTiet" };
        detailProps = type.GetProperties()
            .Where(p => !excludedNames.Contains(p.Name) && p.GetCustomAttribute<System.ComponentModel.DisplayNameAttribute>() != null)
            .ToArray();
    }
}

@section custom_style {
}

@section custom_script {
    <script>
        function handlePrint() {
            var url = '@Url.Action("PrintDinhGia", "TraCuu")' + 
                      '?MaNghe=' + encodeURIComponent($('input[name="MaNghe"]').val() || '') +
                      '&TuNgay=' + encodeURIComponent($('input[name="TuNgay"]').val() || '') +
                      '&DenNgay=' + encodeURIComponent($('input[name="DenNgay"]').val() || '') +
                      '&SoQd=' + encodeURIComponent($('input[name="SoQd"]').val() || '') +
                      '&MoTa=' + encodeURIComponent($('input[name="MoTa"]').val() || '') +
                      '&MaHoSo=' + encodeURIComponent($('input[name="MaHoSo"]').val() || '');
            window.open(url, '_blank');
        }
    </script>
}

<div class="card card-custom">
    <div class="card-header border-0 pt-6 pb-2">
        <div class="card-title">
            <h3 class="card-label">
                TRA CỨU CHI TIẾT HỒ SƠ ĐỊNH GIÁ: <span class="text-primary">@tenNghe</span>
                <span class="d-block text-muted pt-2 font-size-sm">Nhập các điều kiện lọc để tìm kiếm chi tiết hồ sơ định giá</span>
            </h3>
        </div>
        <div class="card-toolbar">
            <a href="@Url.Action("Index", "TraCuu")" class="btn btn-light-danger font-weight-bold">
                <i class="la la-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>
    <div class="card-body">
        <!-- Form Search -->
        <form method="get" action="@Url.Action("DinhGia", "TraCuu")" class="mb-8">
            <input type="hidden" name="MaNghe" value="@maNghe" />
            <input type="hidden" name="MaHoSo" value="@ViewData["MaHoSo"]" />
            <div class="row">
                <div class="col-md-3 form-group">
                    <label class="font-weight-bold">Từ ngày</label>
                    <input type="date" class="form-control" name="TuNgay" value="@tuNgay" />
                </div>
                <div class="col-md-3 form-group">
                    <label class="font-weight-bold">Đến ngày</label>
                    <input type="date" class="form-control" name="DenNgay" value="@denNgay" />
                </div>
                <div class="col-md-3 form-group">
                    <label class="font-weight-bold">Số quyết định</label>
                    <input type="text" class="form-control" name="SoQd" placeholder="Nhập số quyết định..." value="@soQd" />
                </div>
                <div class="col-md-3 form-group">
                    <label class="font-weight-bold">Mô tả/Tên hồ sơ</label>
                    <input type="text" class="form-control" name="MoTa" placeholder="Nhập mô tả hồ sơ..." value="@moTa" />
                </div>
            </div>
            <div class="row justify-content-end">
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary font-weight-bold px-6">
                        <i class="la la-search"></i> Tìm kiếm
                    </button>
                    <button type="button" class="btn btn-info font-weight-bold px-6" onclick="handlePrint()">
                        <i class="la la-print"></i> In trang
                    </button>
                    <a href="@Url.Action("DinhGia", "TraCuu", new { MaNghe = maNghe })" class="btn btn-secondary font-weight-bold px-6">
                        <i class="la la-sync"></i> Reset
                    </a>
                </div>
            </div>
        </form>

        <!-- Table Results -->
        <div class="table-responsive border rounded-lg">
            <table class="table table-striped table-hover table-bordered m-0">
                <thead class="thead-light">
                    <tr class="text-center font-weight-bold">
                        <th width="5%">#</th>
                        <th>Số quyết định</th>
                        <th>Thời điểm</th>
                        <th>Đơn vị quản lý</th>
                        @foreach (var prop in detailProps)
                        {
                            var displayNameAttr = prop.GetCustomAttribute<System.ComponentModel.DisplayNameAttribute>();
                            <th>@(displayNameAttr?.DisplayName ?? prop.Name)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            var maHoSo = item.GetType().GetProperty("MaHoSo")?.GetValue(item)?.ToString() ?? "";
                            parentMap.TryGetValue(maHoSo, out var parent);
                            <tr>
                                <td class="text-center">@(stt++)</td>
                                <td>@(parent?.SoQd ?? "")</td>
                                <td class="text-center">@(parent?.ThoiDiem.ToString("dd/MM/yyyy") ?? "")</td>
                                <td>@(parent?.DonViQuanLy?.TenDonVi ?? "")</td>
                                @foreach (var prop in detailProps)
                                {
                                    var val = prop.GetValue(item);
                                    string cellVal = val?.ToString() ?? "";
                                    <td>@cellVal</td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(4 + detailProps.Length)" class="text-center text-muted">Không tìm thấy chi tiết hồ sơ định giá phù hợp.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
