@using DataAccess.Entities.ThamDinhGia
@model IEnumerable<DataAccess.Entities.ThamDinhGia.ThamDinhGiaCt>

@{
    Layout = "_LayoutReport";
    string tenDanhMucHangHoa = ViewData["TenDanhMucHangHoa"] as string ?? "";
    string tuNgay = ViewData["TuNgay"] as string ?? "";
    string denNgay = ViewData["DenNgay"] as string ?? "";
    string soTbKl = ViewData["SoTbKl"] as string ?? "";
    string dvYeuCau = ViewData["DvYeuCau"] as string ?? "";
    var parentMap = ViewData["ParentMap"] as Dictionary<Guid, DataAccess.Entities.ThamDinhGia.ThamDinhGia> ?? new Dictionary<Guid, DataAccess.Entities.ThamDinhGia.ThamDinhGia>();
    int stt = 1;
}

<div style="margin: 15mm 15mm 20mm 20mm;">
    <div class="card-body">
        <div style="text-align: center; margin-bottom: 30px;">
            <h2 style="font-weight: bold; text-transform: uppercase;">KẾT QUẢ TRA CỨU CHI TIẾT HỒ SƠ THẨM ĐỊNH GIÁ</h2>
            <h4 style="font-style: italic;">Danh mục: @tenDanhMucHangHoa</h4>
            @if (!string.IsNullOrEmpty(tuNgay) || !string.IsNullOrEmpty(denNgay) || !string.IsNullOrEmpty(soTbKl) || !string.IsNullOrEmpty(dvYeuCau))
            {
                <p style="font-style: italic; font-size: 13px; margin: 5px 0;">
                    Điều kiện lọc: 
                    @(string.IsNullOrEmpty(tuNgay) ? "" : "Từ ngày: " + DateTime.Parse(tuNgay).ToString("dd/MM/yyyy") + "  ")
                    @(string.IsNullOrEmpty(denNgay) ? "" : "Đến ngày: " + DateTime.Parse(denNgay).ToString("dd/MM/yyyy") + "  ")
                    @(string.IsNullOrEmpty(soTbKl) ? "" : "Số TB kết luận: " + soTbKl + "  ")
                    @(string.IsNullOrEmpty(dvYeuCau) ? "" : "Đơn vị yêu cầu: " + dvYeuCau)
                </p>
            }
            <p>Ngày in: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
        </div>

        <table cellspacing="0" cellpadding="5" border="1" style="border-collapse: collapse; font-size: 13px; width: 100%;" id="data_render">
            <thead>
                <tr style="text-align: center; font-weight: bold; background-color: #f2f2f2;">
                    <th width="3%">#</th>
                    <th>Đơn vị yêu cầu</th>
                    <th>Số TB kết luận</th>
                    <th>Thời điểm</th>
                    <th>Mã hàng hóa</th>
                    <th>Tên hàng hóa</th>
                    <th>Quy cách CL</th>
                    <th>Thông số KT</th>
                    <th>Xuất xứ</th>
                    <th>Đơn vị tính</th>
                    <th>Số lượng</th>
                    <th>Đơn giá thẩm định</th>
                    <th>Giá trị tài sản</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        parentMap.TryGetValue(item.MaHoSo, out var parent);
                        <tr>
                            <td style="text-align: center;">@(stt++)</td>
                            <td>@(parent?.DvYeuCau ?? "")</td>
                            <td>@(parent?.SoTbKl ?? "")</td>
                            <td style="text-align: center;">@(parent?.Thoidiem.ToString("dd/MM/yyyy") ?? "")</td>
                            <td>@item.MaHangHoa</td>
                            <td>@item.TenHangHoa</td>
                            <td>@item.QuyCachChatLuong</td>
                            <td>@item.ThongSoKt</td>
                            <td>@item.XuatXu</td>
                            <td style="text-align: center;">@item.DonViTinh</td>
                            <td style="text-align: right;">@item.SoLuong.ToString("N0")</td>
                            <td style="text-align: right;">@item.DonGiaThamDinh.ToString("N0")</td>
                            <td style="text-align: right;">@item.GiaTriTsThamDinh.ToString("N0")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="13" style="text-align: center; font-style: italic;">Không tìm thấy chi tiết hồ sơ thẩm định giá phù hợp.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
