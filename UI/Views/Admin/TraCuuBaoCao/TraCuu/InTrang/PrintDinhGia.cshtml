@using System.Reflection
@using DataAccess.Entities.DinhGiaHHDV
@model IEnumerable<object>

@{
    Layout = "_LayoutReport";
    string tenNghe = ViewData["TenNghe"] as string ?? "";
    string tuNgay = ViewData["TuNgay"] as string ?? "";
    string denNgay = ViewData["DenNgay"] as string ?? "";
    string soQd = ViewData["SoQd"] as string ?? "";
    string moTa = ViewData["MoTa"] as string ?? "";
    var parentMap = ViewData["ParentMap"] as Dictionary<string, DinhGia> ?? new Dictionary<string, DinhGia>();
    int stt = 1;

    PropertyInfo[] detailProps = Array.Empty<PropertyInfo>();
    if (Model != null && Model.Any())
    {
        var firstDetailObj = Model.First();
        var type = firstDetailObj.GetType();
        var excludedNames = new HashSet<string> { "Id", "DonViQuanLyId", "DonViQuanLy", "MaHoSo", "TrangThai", "MaNghe", "MaChiTiet" };
        detailProps = type.GetProperties()
            .Where(p => !excludedNames.Contains(p.Name) && p.GetCustomAttribute<System.ComponentModel.DisplayNameAttribute>() != null)
            .ToArray();
    }
}

<div style="margin: 15mm 15mm 20mm 20mm;">
    <div class="card-body">
        <div style="text-align: center; margin-bottom: 30px;">
            <h2 style="font-weight: bold; text-transform: uppercase;">KẾT QUẢ TRA CỨU CHI TIẾT HỒ SƠ ĐỊNH GIÁ</h2>
            <h4 style="font-style: italic;">Danh mục: @tenNghe</h4>
            @if (!string.IsNullOrEmpty(tuNgay) || !string.IsNullOrEmpty(denNgay) || !string.IsNullOrEmpty(soQd) || !string.IsNullOrEmpty(moTa))
            {
                <p style="font-style: italic; font-size: 13px; margin: 5px 0;">
                    Điều kiện lọc: 
                    @(string.IsNullOrEmpty(tuNgay) ? "" : "Từ ngày: " + DateTime.Parse(tuNgay).ToString("dd/MM/yyyy") + "  ")
                    @(string.IsNullOrEmpty(denNgay) ? "" : "Đến ngày: " + DateTime.Parse(denNgay).ToString("dd/MM/yyyy") + "  ")
                    @(string.IsNullOrEmpty(soQd) ? "" : "Số quyết định: " + soQd + "  ")
                    @(string.IsNullOrEmpty(moTa) ? "" : "Từ khóa: " + moTa)
                </p>
            }
            <p>Ngày in: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
        </div>

        <table cellspacing="0" cellpadding="5" border="1" style="border-collapse: collapse; font-size: 14px; width: 100%;" id="data_render">
            <thead>
                <tr style="text-align: center; font-weight: bold; background-color: #f2f2f2;">
                    <th width="5%">#</th>
                    <th>Số quyết định</th>
                    <th>Thời điểm</th>
                    <th>Đơn vị quản lý</th>
                    @foreach (var prop in detailProps)
                    {
                        var displayNameAttr = prop.GetCustomAttribute<System.ComponentModel.DisplayNameAttribute>();
                        <th>@(displayNameAttr?.DisplayName ?? prop.Name)</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var maHoSo = item.GetType().GetProperty("MaHoSo")?.GetValue(item)?.ToString() ?? "";
                        parentMap.TryGetValue(maHoSo, out var parent);
                        <tr>
                            <td style="text-align: center;">@(stt++)</td>
                            <td>@(parent?.SoQd ?? "")</td>
                            <td style="text-align: center;">@(parent?.ThoiDiem.ToString("dd/MM/yyyy") ?? "")</td>
                            <td>@(parent?.DonViQuanLy?.TenDonVi ?? "")</td>
                            @foreach (var prop in detailProps)
                            {
                                var val = prop.GetValue(item);
                                string cellVal = val?.ToString() ?? "";
                                <td>@cellVal</td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(4 + detailProps.Length)" style="text-align: center; font-style: italic;">Không tìm thấy chi tiết hồ sơ định giá phù hợp.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
