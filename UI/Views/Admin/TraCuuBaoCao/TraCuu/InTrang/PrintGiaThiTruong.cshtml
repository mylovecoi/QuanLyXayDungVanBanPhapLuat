@model IEnumerable<DataAccess.Entities.DinhGiaHHDV.GiaThiTruongCt>

@{
    Layout = "_LayoutReport";
    string tenTT = ViewData["TenTT"] as string ?? "";
    string tuNgay = ViewData["TuNgay"] as string ?? "";
    string denNgay = ViewData["DenNgay"] as string ?? "";
    string soQd = ViewData["SoQd"] as string ?? "";
    string moTa = ViewData["MoTa"] as string ?? "";
    var parentMap = ViewData["ParentMap"] as Dictionary<string, DataAccess.Entities.DinhGiaHHDV.GiaThiTruong> ?? new Dictionary<string, DataAccess.Entities.DinhGiaHHDV.GiaThiTruong>();
    int stt = 1;
}

<div style="margin: 15mm 15mm 20mm 20mm;">
    <div class="card-body">
        <div style="text-align: center; margin-bottom: 30px;">
            <h2 style="font-weight: bold; text-transform: uppercase;">KẾT QUẢ TRA CỨU CHI TIẾT HỒ SƠ GIÁ THỊ TRƯỜNG</h2>
            <h4 style="font-style: italic;">Danh mục: @tenTT</h4>
            @if (!string.IsNullOrEmpty(tuNgay) || !string.IsNullOrEmpty(denNgay) || !string.IsNullOrEmpty(soQd) || !string.IsNullOrEmpty(moTa))
            {
                <p style="font-style: italic; font-size: 13px; margin: 5px 0;">
                    Điều kiện lọc: 
                    @(string.IsNullOrEmpty(tuNgay) ? "" : "Từ ngày: " + DateTime.Parse(tuNgay).ToString("dd/MM/yyyy") + "  ")
                    @(string.IsNullOrEmpty(denNgay) ? "" : "Đến ngày: " + DateTime.Parse(denNgay).ToString("dd/MM/yyyy") + "  ")
                    @(string.IsNullOrEmpty(soQd) ? "" : "Số quyết định: " + soQd + "  ")
                    @(string.IsNullOrEmpty(moTa) ? "" : "Từ khóa: " + moTa)
                </p>
            }
            <p>Ngày in: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
        </div>

        <table cellspacing="0" cellpadding="5" border="1" style="border-collapse: collapse; font-size: 14px; width: 100%;" id="data_render">
            <thead>
                <tr style="text-align: center; font-weight: bold; background-color: #f2f2f2;">
                    <th width="5%">#</th>
                    <th>Số quyết định</th>
                    <th>Thời điểm</th>
                    <th>Tên hàng hóa/dịch vụ</th>
                    <th>Đặc điểm kỹ thuật</th>
                    <th>Đơn vị tính</th>
                    <th>Giá báo cáo</th>
                    <th>Giá kỳ này</th>
                    <th>Nguồn thông tin</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        parentMap.TryGetValue(item.MaHoSo ?? "", out var parent);
                        <tr>
                            <td style="text-align: center;">@(stt++)</td>
                            <td>@(parent?.SoQd ?? "")</td>
                            <td style="text-align: center;">@(parent?.Thoidiem.ToString("dd/MM/yyyy") ?? "")</td>
                            <td>@item.TenHhDv</td>
                            <td>@item.DacDiemKt</td>
                            <td style="text-align: center;">@item.DonViTinh</td>
                            <td style="text-align: right;">@item.GiaBaoCao.ToString("#,##0")</td>
                            <td style="text-align: right; font-weight: bold;">@item.GiaKyNay.ToString("#,##0")</td>
                            <td>@item.NguonThongTin</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" style="text-align: center; font-style: italic;">Không tìm thấy chi tiết hồ sơ giá thị trường phù hợp.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
