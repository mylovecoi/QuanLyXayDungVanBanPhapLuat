@using UI.Controllers.Admin.Reports;
@{

	var session = HttpContextAccessor?.HttpContext?.Session ?? null;
	string role = ViewData["Role"] as string ?? "";
}

<div class="card card-custom wave wave-animate-slow wave-primary">
	<div class="card-header flex-wrap border-0 pt-6 pb-0">
		<div class="card-title">
			<h3 class="card-label">
				BÁO CÁO TỔNG HỢP @ViewData["Title"]?.ToString()?.ToUpper()
				<span class="d-block text-muted pt-2 font-size-sm">
					Thông tin báo cáo @((ViewData["Title"] as string)?.ToLower())
				</span>
			</h3>
		</div>
		<div class="card-toolbar">
		</div>
	</div>
	<div class="card-body">
		<ol>
			<li>
				<button type="button" class="btn btn-link" onclick="HandleShowModeSoBaoCao('@Url.Action(nameof(BaoCaoTT052025TTBTPController.SoYeuCauCongChung))', '@Url.Action(nameof(BaoCaoTT052025TTBTPController.SoCongChungFormFields))', 'Sổ Yêu Cầu Công Chứng')" style="text-align:left">
					<span style="font-size:16px; color:blue; font-weight: bold">
						Sổ Yêu Cầu Công Chứng
					</span>
					<br />
					<span>(Mẫu TP-CC-33|| Thông tư số 05/2025/TT-BTP)</span>
				</button>
			</li>
			<li>
				<button type="button" class="btn btn-link" onclick="HandleShowModeSoBaoCao('@Url.Action(nameof(BaoCaoTT052025TTBTPController.SoCongChungGiaoDich))', '@Url.Action(nameof(BaoCaoTT052025TTBTPController.SoCongChungFormFields))', 'Sổ Công Chứng Giao Dịch')" style="text-align:left">
					<span style="font-size:16px; color:blue; font-weight: bold">
						Sổ Công Chứng Giao Dịch
					</span>
					<br />
					<span>(Mẫu TP-CC-34|| Thông tư số 05/2025/TT-BTP)</span>
				</button>
			</li>
			<li>
				<button type="button" class="btn btn-link" onclick="HandleShowModeSoBaoCao('@Url.Action(nameof(BaoCaoTT052025TTBTPController.SoCongChungGiaoDichDienTu))', '@Url.Action(nameof(BaoCaoTT052025TTBTPController.SoCongChungFormFields))', 'Sổ Công Chứng Giao Dịch Điện Tử')" style="text-align:left">
					<span style="font-size:16px; color:blue; font-weight: bold">
						Sổ Công Chứng Giao Dịch Điện Tử
					</span>
					<br />
					<span>(Mẫu TP-CC-35|| Thông tư số 05/2025/TT-BTP)</span>
				</button>
			</li>
			<li>
				<button onclick="loadFormFields()" class="btn btn-link" style="text-align:left">
					<span style="font-size:16px; color:blue; font-weight: bold">
						Sổ theo dõi việc sử dụng lao động
					</span>
					<br />
					<span>(Mẫu TP-CC-36|| Thông tư số 05/2025/TT-BTP)</span>
				</button>
			</li>
		</ol>
	</div>
</div>
@await Html.PartialAsync("~/Views/Admin/Reports/BaoCaoTT052025TTBTP/SoCongChung/_Modal.cshtml")

@await Html.PartialAsync("~/Views/Admin/Reports/BaoCaoTT052025TTBTP/BaoCaoSuDungLaoDong/_Modal.cshtml")

@section custom_style {

}

@section custom_script {
	@* page *@
	<script src="~/js/site.js"></script>
	<script src="~/js/pages/Admin/Manages/QuanLyHoSo/BaoCaoThongKe.js"></script>

	<script>
		const loadFormFields = () => {
			const urlPost = "/Reports/BaoCaoTT052025TTBTP/BaoCaoSuDungLaoDong/GetFormFields";
			HandlePostAjax({
				url: urlPost,
				successCallback: (res) => {
					if (res.isValid) {
						// Cập nhật form fields content nếu có HTML
						if (res.html) {
							$('#modalBaoCaoSuDungLaoDong .modal-body').html(res.html);
						}

						// Hiển thị modal
						$('#modalBaoCaoSuDungLaoDong').modal('show');

						// Cập nhật form action để submit đến action Index
						$('#BaoCaoSuDungLaoDongForm').attr('action', '/Reports/BaoCaoTT052025TTBTP/BaoCaoSuDungLaoDong');
					}
					else {
						toastr.warning(res.message || 'Có lỗi khi khi thao tác với dữ liệu', 'Cảnh Báo!');
					}
				},
				errorCallback: (xhr, status, error) => {
					toastr.error('Không nhận được phản hồi từ máy chủ. Vui lòng thử lại sau.');
				}
			})
		}
	</script>
	@* lib *@
}