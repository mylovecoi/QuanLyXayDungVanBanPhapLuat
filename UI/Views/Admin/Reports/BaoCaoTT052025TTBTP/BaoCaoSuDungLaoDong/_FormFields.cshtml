@using Services.DTOs.BaoCaoKhac
@using UI.Helper
@model BaoCaoSuDungLaoDongRequest

<div class="row">
	<!-- Hàng 1 -->
	<div class="col-sm-12 col-md-6 col-lg-6 col-xl-6 col-xxl-6 form-group">
		<label class="form-label fs-6 font-weight-boldest" asp-for="DonViId"></label>
		<label class="form-label font-weight-boldest">:</label><span class="text-danger"> (*)</span>
		<select class="form-control select2-dropdown" asp-for="DonViId" required>
			<option value="">-- Chọn đơn vị --</option>
			@{
				var dmDonVi = ViewData["DanhMucDonVi"] as List<DataAccess.Entities.Settings.DanhMucDonVi>;
				if (dmDonVi != null && dmDonVi.Any())
					foreach (var item in dmDonVi)
					{
						string backIn = FuntionGlobal.GetBackIn(item.Level);
						if (Model.DonViId == item.Id)
						{
							<option value="@item.Id" selected>@Html.Raw(backIn)@item.TenDonVi</option>
						}
						else
						{
							<option value="@item.Id">@Html.Raw(backIn)@item.TenDonVi</option>
						}
					}
			}
		</select>
		<span asp-validation-for="DonViId" class="text-danger mt-1"></span>
	</div>

	<div class="col-sm-12 col-md-6 col-lg-6 col-xl-6 col-xxl-6 form-group">
		<label class="form-label fs-6 font-weight-boldest" asp-for="TuNgay"></label>
		<label class="form-label font-weight-boldest">:</label><span class="text-danger"> (*)</span>
		<input type="date" asp-for="TuNgay" class="form-control" required>
		<span asp-validation-for="TuNgay" class="text-danger mt-1"></span>
	</div>

	<!-- Hàng 2 -->
	<div class="col-sm-12 col-md-6 col-lg-6 col-xl-6 col-xxl-6 form-group">
		<label class="form-label fs-6 font-weight-boldest" asp-for="DenNgay"></label>
		<label class="form-label font-weight-boldest">:</label><span class="text-danger"> (*)</span>
		<input type="date" asp-for="DenNgay" class="form-control" required>
		<span asp-validation-for="DenNgay" class="text-danger mt-1"></span>
	</div>

	<div class="col-sm-12 col-md-6 col-lg-6 col-xl-6 col-xxl-6 form-group">
		<label class="form-label fs-6 font-weight-boldest" asp-for="QuyenSo"></label>
		<label class="form-label font-weight-boldest">:</label><span class="text-danger"> (*)</span>
		<input type="text" asp-for="QuyenSo" class="form-control" placeholder="Nhập quyển số (VD: 001/2024 TP/SDLĐ)" required>
		<span asp-validation-for="QuyenSo" class="text-danger mt-1"></span>
	</div>

	<!-- Hidden input for Nam field -->
	<input type="hidden" asp-for="Nam" />
</div>

<script>
	$(document).ready(function () {
		if ($.fn.select2) {
			$('.select2-dropdown').select2({
				placeholder: "-- Chọn đơn vị --",
				allowClear: true,
				width: '100%'
			});
		}
	});
</script>
