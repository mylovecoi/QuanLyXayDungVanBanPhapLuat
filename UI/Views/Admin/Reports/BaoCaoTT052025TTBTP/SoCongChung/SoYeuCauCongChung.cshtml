@model Services.DTOs.ReportResponseDto<DataAccess.Entities.Manages.ThongTinHoSo.HoSoCCCT>
@{
	Layout = "_LayoutReport";
	var session = HttpContextAccessor?.HttpContext?.Session ?? null;
}
@if (Model != null)
{
	<div style="margin: 20mm; font-family: 'Times New Roman', Times, serif; font-size: 13pt;">
		<div style="border: 1px solid black; padding: 5px 10px; font-size: 9pt; text-align: right;line-height: 1.4;width: max-content; text-align:center; background-color: white; margin-left: auto;">
			<div>Mẫu TP-CC-33</div>
			<div><em>(Ban hành kèm theo Thông tư số 05/2025/TT-BTP)</em></div>
		</div>

		<br /><br />

		<!-- Quốc hiệu, tiêu ngữ -->
		<p style="text-transform:uppercase; text-align:center; font-size:14pt;">
			<strong>CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</strong>
		</p>
		<p style="text-align:center; font-size:14pt;">
			<strong>Độ<span style="border-bottom: 1px solid black; padding-bottom: 0px;">c lập - Tự do - Hạnh ph</span>úc</strong>
		</p>

		<br /><br /><br /><br /><br /><br /><br /><br />

		<p style="font-size: 18pt; text-transform:uppercase;text-align:center">
			<strong>@Model.TenBaoCao</strong>
		</p>

		<br /><br />
		<div style="text-align: left; width: fit-content; margin: 0 auto; white-space: nowrap;">
			<p style="margin: 0 0 5px 0;">
				<strong>
					Tên tổ chức hành nghề công chứng:
					<span style="display: inline-block; border-bottom: 1px dotted #000; width: 280px;">
						@(Model.TenDonViChuQuan ?? "")
					</span>
				</strong>
			</p>
			<p style="margin: 0;">
				<strong>
					Tỉnh (thành phố):
					<span style="display: inline-block; border-bottom: 1px dotted #000; width: 410px;">
						@(Model.TenDiaDanh ?? "")
					</span>
				</strong>
			</p>
		</div>

		<br /><br /><br /><br /><br /><br /><br /><br /><br /><br /><br /><br /><br /><br />

		<div style="width: fit-content; margin: 0 auto; white-space: nowrap;">
			<p style="margin: 0 0 5px 0;">
				<em>
					Mở Sổ ngày @Model.NgayBaoCaoTu.Day tháng @Model.NgayBaoCaoTu.Month năm @Model.NgayBaoCaoTu.Year
				</em>
			</p>
			<p style="margin: 0;">
				<em>
					Khóa Sổ ngày @Model.NgayBaoCaoDen.Day tháng @Model.NgayBaoCaoDen.Month năm @Model.NgayBaoCaoDen.Year
				</em>
			</p>
		</div>

		<table style="width: 100%; border-collapse: collapse; font-size: 10pt;" border="1">
			<thead>
				<tr>
					<th rowspan="2" style="width: 5%; text-align: center; vertical-align: top;">STT</th>
					<th rowspan="2" style="width: 10%; text-align: center; vertical-align: top;">
						THỜI GIAN YÊU CẦU CÔNG CHỨNG
						<br>
						<span style="font-weight:normal;">
							<em>(Ghi rõ ngày, tháng, năm)</em>
						</span>
					</th>
					<th rowspan="2" style="width: 20%; text-align: center; vertical-align: top;">
						THÔNG TIN VỀ NGƯỜI YÊU CẦU CÔNG CHỨNG
						<br>
						(HỌ TÊN; THẺ CĂN CƯỚC CÔNG DÂN/THẺ CĂN CƯỚC/SỐ ĐỊNH DANH CÁ NHÂN; TÊN, MÃ SỐ DOANH NGHIỆP HOẶC SỐ GIẤY TỜ VỀ TỔ CHỨC)
					</th>
					<th rowspan="2" style="width: 15%; text-align: center; vertical-align: top;">NỘI DUNG YÊU CẦU</th>
					<th rowspan="2" style="width: 15%; text-align: center; vertical-align: top;">
						KẾT QUẢ GIẢI QUYẾT YÊU CẦU CÔNG CHỨNG:<br> TỪ CHỐI HOẶC TIẾP NHẬN
					</th>
					<th rowspan="2" style="width: 10%; text-align: center; vertical-align: top;">
						NGÀY TRẢ KẾT QUẢ CÔNG CHỨNG<br>
						<span style="font-weight:normal;">
							<em>(Đối với trường hợp tiếp nhận yêu cầu công chứng)</em>
						</span>
					</th>
					<th rowspan="2" style="width: 10%; text-align: center; vertical-align: top;">SỐ CÔNG CHỨNG</th>
					<th rowspan="2" style="width: 10%; text-align: center; vertical-align: top;">
						PHƯƠNG THỨC CÔNG CHỨNG<br>
						<span style="font-weight:normal;">
							<em>(Ghi rõ công chứng bản giấy hoặc công chứng điện tử)</em>
						</span>
					</th>
					<th rowspan="2" style="width: 5%; white-space: nowrap; text-align: center; vertical-align: top;">GHI CHÚ</th>
				</tr>
				<tr></tr>
				<tr>
					@for (int i = 1; i <= 9; i++)
					{
						<th style="font-weight:normal; text-align: center;">(@i)</th>
					}
				</tr>
			</thead>
			<tbody>
				@if (Model.Data.Any())
				{
					int record = 1;
					foreach (var hoSo in Model.Data)
					{
						<tr>
							<td style="text-align: center;">@record</td>
							<td>
								<p style="text-align: center; vertical-align: middle;">
									@FuntionGlobal.ConvertDateToStr(hoSo.NgayThuLy)
								</p>
							</td>
							<td>
								<div>
									<p>Họ tên: <span>@hoSo.HoTenNguoiNop</span></p>
									<p>Thẻ CCCD: <span>@hoSo.SoCCCDNguoiNop</span></p>
									<p>Tên, Mã số doanh nghiệp: <span>@hoSo.ThongTinDonVi</span></p>
								</div>
							</td>
							<td><p style="text-align: left; vertical-align: middle;">@hoSo.NoiDungHoSo</p></td>
							<td>
								<p style="text-align: center; vertical-align: middle;">
									@(hoSo.Status == "BTL" ? "Từ chối" : "Tiếp nhận")
								</p>
							</td>
							<td>
								<p style="text-align: center; vertical-align: middle;">
									@(hoSo.Status == "BTL" ? "" : "Ngày Trả Kết Quả")
								</p>
							</td>
							<td>
								<p style="text-align: center; vertical-align: middle;">
									@(hoSo.Status == "HT" ? FuntionGlobal.ConvertDateToStr(hoSo.NgayDuyet) : "Đang Xử Lý")
									
									
								</p>
							</td>
							<td>
								<p style="text-align: center; vertical-align: middle;">
									Công chứng
									<span>@(hoSo.PhuongThucCongChung ? " bản giấy" : " điện tử")</span>
								</p>
							</td>
							<td>@hoSo.MoTa</td>
						</tr>
						record++;
					}
				}
				else
				{
					for (int i = 1; i <= 10; i++)
					{
						<tr>
							<td style="text-align: center;">@i</td>
							<td></td>
							<td></td>
							<td></td>
							<td></td>
							<td></td>
							<td></td>
							<td></td>
							<td></td>
						</tr>
					}
				}
			</tbody>
		</table>

	</div>
}
else
{

}