@model Services.DTOs.Manages.ThongTinHoSo.ReportRequestDto
<div class="row">
	<div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 col-xxl-12 form-group">
		<label class="form-label fs-6 font-weight-boldest" asp-for="NgayBaoCao"></label>
		<label class="form-label font-weight-boldest">:</label>
		<input type="date" asp-for="NgayBaoCao" class="form-control" placeholder="Nhập @Html.DisplayNameFor(x=>x.NgayBaoCao).ToLower()">
		<span asp-validation-for="NgayBaoCao" class="text-danger mt-1"></span>
	</div>

	<div class="col-sm-12 col-md-12 col-lg-6 col-xl-6 col-xxl-6 form-group">
		<label class="form-label fs-6 font-weight-boldest">Ngày Mở Sổ</label>
		<label class="form-label font-weight-boldest">:</label>
		<input type="date" asp-for="NgayBaoCaoTu" class="form-control" placeholder="Nhập @Html.DisplayNameFor(x=>x.NgayBaoCaoTu).ToLower()">
		<span asp-validation-for="NgayBaoCaoTu" class="text-danger mt-1"></span>
	</div>

	<div class="col-sm-12 col-md-12 col-lg-6 col-xl-6 col-xxl-6 form-group">
		<label class="form-label fs-6 font-weight-boldest">Ngày Khóa Sổ</label>
		<label class="form-label font-weight-boldest">:</label>
		<input type="date" asp-for="NgayBaoCaoDen" class="form-control" placeholder="Nhập @Html.DisplayNameFor(x=>x.NgayBaoCaoDen).ToLower()">
		<span asp-validation-for="NgayBaoCaoDen" class="text-danger mt-1"></span>
	</div>
</div>