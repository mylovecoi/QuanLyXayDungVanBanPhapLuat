@using DataAccess.Enums
@using Services.DTOs.BaoCao17
@using UI.Helper
@model BaoCao17RequestDto

<div class="row">
	<!-- Phần chung cho tất cả loại báo cáo -->
	<div class="col-sm-12 col-md-6 col-lg-6 col-xl-6 col-xxl-6 form-group">
		<label class="form-label fs-6 font-weight-boldest" asp-for="NgayBaoCaoTu"></label>
		<label class="form-label font-weight-boldest">:</label><span class="text-danger"> (*)</span>
		<input type="date" asp-for="NgayBaoCaoTu" class="form-control" required>
		<span asp-validation-for="NgayBaoCaoTu" class="text-danger mt-1"></span>
	</div>

	<div class="col-sm-12 col-md-6 col-lg-6 col-xl-6 col-xxl-6 form-group">
		<label class="form-label fs-6 font-weight-boldest" asp-for="NgayBaoCaoDen"></label>
		<label class="form-label font-weight-boldest">:</label><span class="text-danger"> (*)</span>
		<input type="date" asp-for="NgayBaoCaoDen" class="form-control" required>
		<span asp-validation-for="NgayBaoCaoDen" class="text-danger mt-1"></span>
	</div>

	<div class="col-sm-12 col-md-6 col-lg-6 col-xl-6 col-xxl-6 form-group">
		<label class="form-label fs-6 font-weight-boldest" asp-for="KyBaoCao"></label>
		<label class="form-label font-weight-boldest">:</label><span class="text-danger"> (*)</span>
		<select class="form-control" asp-for="KyBaoCao" id="KyBaoCao" required>
			<option value="">-- Chọn kỳ báo cáo --</option>
			@{
				var kyBaoCaoList = ViewData["KyBaoCaoList"] as List<SelectListItem>;
				if (kyBaoCaoList != null && kyBaoCaoList.Any())
				{
					foreach (var item in kyBaoCaoList)
					{
						if (Model.KyBaoCao.ToString() == item.Value)
						{
							<option value="@item.Value" selected>@item.Text</option>
						}
						else
						{
							<option value="@item.Value">@item.Text</option>
						}
					}
				}
			}
		</select>
		<span asp-validation-for="KyBaoCao" class="text-danger mt-1" id="KyBaoCaoError"></span>
	</div>

	<div class="col-sm-12 col-md-6 col-lg-6 col-xl-6 col-xxl-6 form-group">
		<label class="form-label fs-6 font-weight-boldest" asp-for="NguoiLapBieu"></label>
		<label class="form-label font-weight-boldest">:</label><span class="text-danger"> (*)</span>
		<input type="text" asp-for="NguoiLapBieu" class="form-control" id="NguoiLapBieu" placeholder="Nhập tên người lập biểu" required>
		<span asp-validation-for="NguoiLapBieu" class="text-danger mt-1" id="NguoiLapBieuError"></span>
	</div>

	<!-- Section cho báo cáo 17a, 17b, 17c - cần đơn vị nhận báo cáo -->
	<div id="sectionDonViNhanBaoCao" class="col-sm-12 col-md-6 col-lg-6 col-xl-6 col-xxl-6 form-group" style="display: none;">
		<label class="form-label fs-6 font-weight-boldest" asp-for="TenDonViNhanBaoCao"></label>
		<label class="form-label font-weight-boldest">:</label><span class="text-danger validation-required"> (*)</span>
		<input type="text" asp-for="TenDonViNhanBaoCao" class="form-control" id="TenDonViNhanBaoCao" placeholder="Nhập tên đơn vị nhận báo cáo">
		<span asp-validation-for="TenDonViNhanBaoCao" class="text-danger mt-1" id="TenDonViNhanBaoCaoError"></span>
	</div>

	<!-- Section cho báo cáo 17a - cần địa danh -->
	<div id="sectionDiaDanh" class="col-sm-12 col-md-6 col-lg-6 col-xl-6 col-xxl-6 form-group" style="display: none;">
		<label class="form-label fs-6 font-weight-boldest" asp-for="DiaDanh"></label>
		<label class="form-label font-weight-boldest">:</label><span class="text-danger validation-required"> (*)</span>
		<input type="text" asp-for="DiaDanh" class="form-control" id="DiaDanh" placeholder="Nhập địa danh">
		<span asp-validation-for="DiaDanh" class="text-danger mt-1" id="DiaDanhError"></span>
	</div>

	<!-- Section cho báo cáo 17b, 17c, 17d - cần người kiểm tra -->
	<div id="sectionNguoiKiemTra" class="col-sm-12 col-md-6 col-lg-6 col-xl-6 col-xxl-6 form-group" style="display: none;">
		<label class="form-label fs-6 font-weight-boldest" asp-for="NguoiKiemTra"></label>
		<label class="form-label font-weight-boldest">:</label><span class="text-danger validation-required"> (*)</span>
		<input type="text" asp-for="NguoiKiemTra" class="form-control" id="NguoiKiemTra" placeholder="Nhập tên người kiểm tra">
		<span asp-validation-for="NguoiKiemTra" class="text-danger mt-1" id="NguoiKiemTraError"></span>
	</div>

	<div id="sectionChucVuNguoiKiemTra" class="col-sm-12 col-md-6 col-lg-6 col-xl-6 col-xxl-6 form-group" style="display: none;">
		<label class="form-label fs-6 font-weight-boldest" asp-for="ChucVuNguoiKiemTra"></label>
		<label class="form-label font-weight-boldest">:</label><span class="text-danger validation-required"> (*)</span>
		<input type="text" asp-for="ChucVuNguoiKiemTra" class="form-control" id="ChucVuNguoiKiemTra" placeholder="Nhập chức vụ người kiểm tra">
		<span asp-validation-for="ChucVuNguoiKiemTra" class="text-danger mt-1" id="ChucVuNguoiKiemTraError"></span>
	</div>

	<!-- Section lãnh đạo ký - 17a: Chủ tịch UBND -->
	<div id="sectionChuTichUBND" class="col-sm-12 col-md-6 col-lg-6 col-xl-6 col-xxl-6 form-group" style="display: none;">
		<label class="form-label fs-6 font-weight-boldest" asp-for="ChuTichUBND"></label>
		<label class="form-label font-weight-boldest">:</label><span class="text-danger validation-required"> (*)</span>
		<input type="text" asp-for="ChuTichUBND" class="form-control" id="ChuTichUBND" placeholder="Nhập tên Chủ tịch UBND">
		<span asp-validation-for="ChuTichUBND" class="text-danger mt-1" id="ChuTichUBNDError"></span>
	</div>

	<!-- Section lãnh đạo ký - 17b: Trưởng Phòng -->
	<div id="sectionTruongPhong" class="col-sm-12 col-md-6 col-lg-6 col-xl-6 col-xxl-6 form-group" style="display: none;">
		<label class="form-label fs-6 font-weight-boldest" asp-for="TruongPhong"></label>
		<label class="form-label font-weight-boldest">:</label><span class="text-danger validation-required"> (*)</span>
		<input type="text" asp-for="TruongPhong" class="form-control" id="TruongPhong" placeholder="Nhập tên Trưởng Phòng">
		<span asp-validation-for="TruongPhong" class="text-danger mt-1" id="TruongPhongError"></span>
	</div>

	<!-- Section lãnh đạo ký - 17c: Giám đốc -->
	<div id="sectionGiamDoc" class="col-sm-12 col-md-6 col-lg-6 col-xl-6 col-xxl-6 form-group" style="display: none;">
		<label class="form-label fs-6 font-weight-boldest" asp-for="GiamDoc"></label>
		<label class="form-label font-weight-boldest">:</label><span class="text-danger validation-required"> (*)</span>
		<input type="text" asp-for="GiamDoc" class="form-control" id="GiamDoc" placeholder="Nhập tên Giám đốc">
		<span asp-validation-for="GiamDoc" class="text-danger mt-1" id="GiamDocError"></span>
	</div>

	<!-- Section lãnh đạo ký - 17d: Bộ trưởng -->
	<div id="sectionBoTruong" class="col-sm-12 col-md-6 col-lg-6 col-xl-6 col-xxl-6 form-group" style="display: none;">
		<label class="form-label fs-6 font-weight-boldest" asp-for="BoTruong"></label>
		<label class="form-label font-weight-boldest">:</label><span class="text-danger validation-required"> (*)</span>
		<input type="text" asp-for="BoTruong" class="form-control" id="BoTruong" placeholder="Nhập tên Bộ trưởng">
		<span asp-validation-for="BoTruong" class="text-danger mt-1" id="BoTruongError"></span>
	</div>

	<!-- Hidden inputs -->
	<input type="hidden" asp-for="DonViId" />
	<input type="hidden" asp-for="NgayBaoCao" />
	<input type="hidden" asp-for="LoaiBaoCao" id="LoaiBaoCaoHidden" />
	<input type="hidden" asp-for="TenDonViBaoCao" id="TenDonViBaoCaoHidden" />
</div>

<script>
	$(document).ready(function () {
		SetupSelect2("#KyBaoCao", "-- Chọn kỳ báo cáo --");
		
		// Khởi tạo form theo loại báo cáo hiện tại
		var currentLoaiBaoCao = $('#LoaiBaoCaoHidden').val();
		if (currentLoaiBaoCao) {
			handleLoaiBaoCaoChange(currentLoaiBaoCao);
		}
	});

	// Hàm xử lý khi thay đổi loại báo cáo
	function handleLoaiBaoCaoChange(loaiBaoCao) {
		// Ẩn tất cả các section trước
		$('#sectionDonViNhanBaoCao, #sectionDiaDanh, #sectionNguoiKiemTra, #sectionChucVuNguoiKiemTra').hide();
		$('#sectionChuTichUBND, #sectionTruongPhong, #sectionGiamDoc, #sectionBoTruong').hide();
		
		// Xóa validation cho tất cả các trường
		clearAllValidation();
		
		// Hiển thị section tương ứng và thêm validation
		switch (loaiBaoCao) {
			case '@(LoaiBaoCao17.BaoCao17a)':
				// 17a: Người lập biểu + Đơn vị nhận báo cáo + Địa danh + Chủ tịch UBND
				$('#sectionDonViNhanBaoCao, #sectionDiaDanh, #sectionChuTichUBND').show();
				addValidationToFields(['TenDonViNhanBaoCao', 'DiaDanh', 'ChuTichUBND']);
				break;
				
			case '@(LoaiBaoCao17.BaoCao17b)':
				// 17b: Người lập biểu + Đơn vị nhận báo cáo + Người kiểm tra + Chức vụ người kiểm tra + Trưởng Phòng
				$('#sectionDonViNhanBaoCao, #sectionNguoiKiemTra, #sectionChucVuNguoiKiemTra, #sectionTruongPhong').show();
				addValidationToFields(['TenDonViNhanBaoCao', 'NguoiKiemTra', 'ChucVuNguoiKiemTra', 'TruongPhong']);
				break;
				
			case '@(LoaiBaoCao17.BaoCao17c)':
				// 17c: Người lập biểu + Đơn vị nhận báo cáo cố định + Người kiểm tra + Chức vụ người kiểm tra + Giám đốc
				$('#sectionNguoiKiemTra, #sectionChucVuNguoiKiemTra, #sectionGiamDoc').show();
				addValidationToFields(['NguoiKiemTra', 'ChucVuNguoiKiemTra', 'GiamDoc']);
				// Set đơn vị nhận báo cáo cố định cho 17c
				$('#TenDonViNhanBaoCao').val('Bộ Tư pháp (Cục Kế hoạch - Tài chính)');
				break;
				
			case '@(LoaiBaoCao17.BaoCao17d)':
				// 17d: Người lập biểu + Người kiểm tra + Chức vụ người kiểm tra + Bộ trưởng (đơn vị báo cáo và nhận cố định)
				$('#sectionNguoiKiemTra, #sectionChucVuNguoiKiemTra, #sectionBoTruong').show();
				addValidationToFields(['NguoiKiemTra', 'ChucVuNguoiKiemTra', 'BoTruong']);
				// Set đơn vị cố định cho 17d
				$('#TenDonViBaoCaoHidden').val('Bộ Ngoại giao');
				$('#TenDonViNhanBaoCao').val('Bộ Tư pháp (Cục Kế hoạch - Tài chính)');
				break;
		}
	}

	function clearAllValidation() {
		$('.form-control').removeAttr('data-validate').removeClass('is-invalid');
		$('.text-danger[id$="Error"]').text('');
	}

	function addValidationToFields(fieldIds) {
		fieldIds.forEach(function(fieldId) {
			$('#' + fieldId).attr('data-validate', 'true');
		});
	}

	// Function để validate form fields
	function validateFormFields() {
		var isValid = true;
		
		// Validate các trường cơ bản luôn cần
		var basicFields = ['KyBaoCao', 'NguoiLapBieu'];
		basicFields.forEach(function(fieldId) {
			if (!validateField(fieldId)) {
				isValid = false;
			}
		});
		
		// Validate các trường có attribute data-validate
		$('[data-validate="true"]').each(function() {
			if (!validateField(this.id)) {
				isValid = false;
			}
		});
		
		return isValid;
	}

	function validateField(fieldId) {
		var field = $('#' + fieldId);
		var errorElement = $('#' + fieldId + 'Error');
		var value = field.val();
		
		if (!value || value.trim() === '') {
			field.addClass('is-invalid');
			var label = field.closest('.form-group').find('label').first().text().replace(':', '').replace('*', '').trim();
			errorElement.text(label + ' không được bỏ trống');
			return false;
		} else {
			field.removeClass('is-invalid');
			errorElement.text('');
			return true;
		}
	}

	// Export function để sử dụng từ modal
	window.BaoCao17FormValidation = {
		validateFormFields: validateFormFields,
		handleLoaiBaoCaoChange: handleLoaiBaoCaoChange
	};
</script>