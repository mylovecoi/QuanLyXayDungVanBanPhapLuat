@using DataAccess.Enums
@model Services.DTOs.BaoCao17.BaoCao17ResponseDto

@{
	ViewData["Title"] = "Báo cáo 17b - Kết quả chứng thực của Phòng Tư pháp và UBND cấp xã trên địa bàn huyện";
	Layout = null;
	var bieuSo = ViewData["BieuSo"]?.ToString() ?? "17b/BTP/HTQTCT/CT";
	var thongTu = ViewData["ThongTuBanHanh"]?.ToString() ?? "Thông tư số 03/2019/TT-BTP ngày 20/3/2019";
}

<!DOCTYPE html>
<html lang="vi">
<head>
	<meta charset="UTF-8">
	<title>@ViewData["Title"]</title>
	<style>
		body {
			font-family: 'Times New Roman', serif;
			font-size: 13pt;
			line-height: 1.5;
			margin: 0;
			background: #000;
			color: #000;
		}

		.document {
			width: 297mm;
			min-width: 297mm;
			margin: 0 auto;
			background: white;
			min-height: 100vh;
			box-sizing: border-box;
			padding: 1.25cm 2cm 1cm 2cm;
		}

		/* Layout Grid 6x3 với tỷ lệ 25%-50%-25% */
		.grid-container {
			display: grid;
			grid-template-columns: 25% 50% 25%;
			grid-template-rows: auto auto auto auto auto auto;
			gap: 5px 10px;
			width: 100%;
		}

		/* Grid Items - Hàng 1 */
		.grid-item-1-1 {
			grid-column: 1;
			grid-row: 1;
		}

		.grid-item-2-3-1 {
			grid-column: 2;
			grid-row: 1;
		}

		.grid-item-4-1 {
			grid-column: 3;
			grid-row: 1;
		}

		/* Grid Items - Hàng 2 */
		.grid-item-full-row-2 {
			grid-column: 1 / 4;
			grid-row: 2;
			margin-top: 10px;
		}

		/* Grid Items - Hàng 3 */
		.grid-item-full-row-3 {
			grid-column: 1 / 4;
			grid-row: 3;
			margin-bottom: 20px;
		}

		/* Grid Items - Hàng 4 */
		.grid-item-full-row-4 {
			grid-column: 1 / 4;
			grid-row: 4;
		}

		/* Grid Items - Hàng 5 */
		.grid-item-full-row-5 {
			grid-column: 1 / 4;
			grid-row: 5;
			margin-bottom: 20px;
		}

		/* Grid Items - Hàng 6 với flexbox tỷ lệ 1:1:2 */
		.signature-row {
			display: flex;
			width: 100%;
			grid-column: 1 / 4;
			grid-row: 6;
		}

		.signature-row .grid-item-1-6 {
			flex: 1;
		}

		.signature-row .grid-item-2-6 {
			flex: 1;
		}

		.signature-row .grid-item-3-4-6 {
			flex: 2;
		}

		/* Header Form Styles */
		.header-form {
			text-align: left;
		}

		.form-number {
			font-weight: bold;
		}

		.form-note {
			font-weight: normal;
		}

		/* Title and Report Period */
		.main-title {
			text-align: center;
			font-weight: bold;
			font-size: 16pt;
		}

		.report-period {
			text-align: center;
			font-size: 13pt;
		}

		.report-info {
			font-size: 13pt;
			text-align: left;
		}

		.section-title {
			font-weight: bold;
			font-size: 13pt;
		}

		/* Data Table */
		.data-table {
			width: 100%;
			border-collapse: collapse;
			font-size: 13pt;
		}

		.data-table th,
		.data-table td {
			border: 1px solid #000;
			padding: 8px;
			text-align: center;
			vertical-align: middle;
			font-weight: normal;
		}

		/* Signature Styles */
		.signature-left {
			text-align: center;
		}

		.signature-center {
			text-align: center;
		}

		.signature-right {
			text-align: center;
		}

		.signature-date {
			font-style: italic;
		}

		.signature-title {
			font-weight: bold;
		}

		.signature-note {
			font-style: italic;
			margin-bottom: 100px;
		}

		.no-print {
			background: #007bff;
			color: white;
			padding: 10px 15px;
			border-radius: 5px;
			cursor: pointer;
			float: left;
			margin-bottom: 20px;
			box-shadow: 2px 2px 5px rgba(0,0,0,0.3);
			font-family: Arial, sans-serif;
		}

		@@media print {
			@@page {
				size: A4 landscape;
				margin: 1.25cm 2cm 1cm 2cm;
			}

			.no-print {
				display: none !important;
			}

			body {
				background: white;
			}

			.document {
				padding: 0;
				margin: 0;
			}

			.new-page {
				page-break-before: always !important;
				break-before: page !important;
			}

			.data-table {
				page-break-inside: avoid !important;
			}
		}
	</style>
</head>
<body>

<div class="document">
	<!-- Button In báo cáo -->
	<div class="no-print" onclick="window.print()">
		In báo cáo
	</div>

	<!-- Grid Container 6x4 Layout -->
	<div class="grid-container">
		@* Grid Item 1-1: Header Form (Hàng 1 Cột 1) *@
		<div class="grid-item-1-1">
			<div class="header-form">
				<div class="form-number">Biểu số: @bieuSo</div>
				<div class="form-note">Ban hành theo @thongTu</div>
				<div><strong>Ngày nhận báo cáo (BC):</strong></div>
				<div>BC 6 tháng: ngày 16 tháng 6 hàng năm</div>
				<div>BC năm: Ngày 18 tháng 11 hàng năm</div>
				<div>BC năm chính thức: Ngày 31 tháng 01 năm sau</div>
			</div>
		</div>

		@* Grid Item 2-3-1: Main Title và Report Period (Hàng 1 Cột 2-3) *@
		<div class="grid-item-2-3-1">
			<!-- Main Title -->
			<div class="main-title">
				KẾT QUẢ CHỨNG THỰC CỦA PHÒNG TƯ PHÁP VÀ ỦY BAN NHÂN DÂN (UBND) CẤP XÃ TRÊN ĐỊA BÀN HUYỆN<br>
				(6 tháng/năm)
			</div>

			<!-- Report Period -->
			<div class="report-period">
				Kỳ báo cáo: @(Model?.Request.KyBaoCao == KyBaoCao17.SauThang ? "6 tháng" : "năm")<br>
				(Từ ngày @Model?.Request.NgayBaoCaoTu.ToString("dd/MM/yyyy") đến ngày
				@Model?.Request.NgayBaoCaoDen.ToString("dd/MM/yyyy"))
			</div>
		</div>

		@* Grid Item 4-1: Report Info (Hàng 1 Cột 4) *@
		<div class="grid-item-4-1">
			<!-- Report Info -->
			<div class="report-info">
				<strong>Đơn vị báo cáo:</strong><br>
				- @Model?.Request.TenDonViBaoCao<br>
				<strong>Đơn vị nhận báo cáo:</strong><br>
				- @Model?.Request.TenDonViNhanBaoCao
			</div>
		</div>

		@* Grid Item Full Row 2: Section Title I (Hàng 2 cả 4 cột) *@
		<div class="grid-item-full-row-2">
			<div class="section-title">I. KẾT QUẢ CHỨNG THỰC TẠI PHÒNG TƯ PHÁP</div>
		</div>

		@* Grid Item Full Row 3: Data Table I (Hàng 3 cả 4 cột) *@
		<div class="grid-item-full-row-3">
			<table class="data-table">
				<thead>
					<tr>
						<th style="vertical-align: middle;">
							<b>Chứng thực bản sao</b><br>
							<em>(Bản)</em>
						</th>
						<th style="vertical-align: middle;">
							<b>Chứng thực chữ ký trong giấy tờ, văn bản</b><br>
							<em>(Việc)</em>
						</th>
						<th style="vertical-align: middle;">
							<b>Chứng thực chữ ký người dịch</b><br>
							<em>(Việc)</em>
						</th>
						<th style="vertical-align: middle;">
							<b>Chứng thực hợp đồng, giao dịch</b><br>
							<em>(Việc)</em>
						</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>@(Model?.BaoCao17b?.KetQuaPhongTuPhap.ChungThucBanSao ?? 0)</td>
						<td>@(Model?.BaoCao17b?.KetQuaPhongTuPhap.ChungThucChuKy ?? 0)</td>
						<td>@(Model?.BaoCao17b?.KetQuaPhongTuPhap.ChungThucChuKyNguoiDich ?? 0)</td>
						<td>@(Model?.BaoCao17b?.KetQuaPhongTuPhap.ChungThucHopDong ?? 0)</td>
					</tr>
				</tbody>
			</table>
		</div>

		@* Grid Item Full Row 4: Section Title II (Hàng 4 cả 4 cột) *@
		<div class="grid-item-full-row-4 new-page">
			<div class="section-title">II. KẾT QUẢ CHỨNG THỰC TẠI UBND CẤP XÃ TRÊN ĐỊA BÀN HUYỆN</div>
		</div>

		@* Grid Item Full Row 5: Data Table II (Hàng 5 cả 4 cột) *@
		<div class="grid-item-full-row-5">
			<table class="data-table">
				<thead>
					<tr>
						<th></th>
						<th style="vertical-align: middle;">
							<b>Chứng thực bản sao</b><br>
							<em>(Bản)</em>
						</th>
						<th style="vertical-align: middle;">
							<b>Chứng thực chữ ký trong giấy tờ, văn bản</b><br>
							<em>(Việc)</em>
						</th>
						<th style="vertical-align: middle;">
							<b>Chứng thực hợp đồng, giao dịch</b><br>
							<em>(Việc)</em>
						</th>
					</tr>
				</thead>
				<tbody>
					<!-- Tổng số -->
					<tr>
						<td style="text-align: left"><b>Tổng số</b></td>
						<td>@(Model?.BaoCao17b?.TongSoUBNDCapXa.ChungThucBanSao ?? 0)</td>
						<td>@(Model?.BaoCao17b?.TongSoUBNDCapXa.ChungThucChuKy ?? 0)</td>
						<td>@(Model?.BaoCao17b?.TongSoUBNDCapXa.ChungThucHopDong ?? 0)</td>
					</tr>

					<!-- Danh sách UBND cấp xã -->
					@if (Model?.BaoCao17b?.DanhSachUBNDCapXa != null)
					{
						@foreach (var ubnd in Model.BaoCao17b.DanhSachUBNDCapXa)
						{
							<tr>
								<td style="text-align: left;">UBND @ubnd.TenUBNDCapXa</td>
								<td>@ubnd.ChungThucBanSao</td>
								<td>@ubnd.ChungThucChuKy</td>
								<td>@ubnd.ChungThucHopDong</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>

		@* Grid Item Row 6: Signature section với tỷ lệ 1:1:2 *@
		<div class="signature-row">
			<div class="grid-item-1-6">
				<br>
				<div class="signature-left">
					<div class="signature-title">Người lập biểu</div>
					<div class="signature-note">(Ký, ghi rõ họ, tên)</div>
					@Model?.Request.NguoiLapBieu
				</div>
			</div>

			<div class="grid-item-2-6">
				<br>
				<div class="signature-center">
					<div class="signature-title">Người kiểm tra</div>
					<div class="signature-note">(Ký, ghi rõ họ, tên, chức vụ)</div>
					<div>@Model?.Request.ChucVuNguoiKiemTra</div>
					@Model?.Request.NguoiKiemTra
				</div>
			</div>

			<div class="grid-item-3-4-6">
				<div class="signature-right">
					<div class="signature-date">
						@(Model?.Request.DiaDanh ?? "...."), ngày @DateTime.Now.Day tháng @DateTime.Now.Month năm
						@DateTime.Now.Year
					</div>
					<div class="signature-title">TRƯỞNG PHÒNG</div>
					<div class="signature-note">(Ký, đóng dấu, ghi rõ họ, tên)</div>
					@Model?.Request.TruongPhong
				</div>
			</div>
		</div>
	</div>
</div>

</body>
</html>
