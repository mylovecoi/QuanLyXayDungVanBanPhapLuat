@model Services.DTOs.BaoCao17.BaoCao17ResponseDto

@{
	ViewData["Title"] = "Báo cáo 17d - Kết quả chứng thực của các cơ quan đại diện Việt Nam ở nước ngoài";
	Layout = null;
	var bieuSo = ViewData["BieuSo"]?.ToString() ?? "17d/BTP/HTQTCT/CT";
	var thongTu = ViewData["ThongTuBanHanh"]?.ToString() ?? "Thông tư số 03/2019/TT-BTP ngày 20/3/2019";
}

<!DOCTYPE html>
<html lang="vi">

<head>
	<meta charset="UTF-8">
	<title>@ViewData["Title"]</title>
	<style>
		body {
			font-family: 'Times New Roman', serif;
			font-size: 13pt;
			line-height: 1.5;
			margin: 0;
			background: #000;
			color: #000;
		}

		.document {
			width: 297mm;
			min-width: 297mm;
			margin: 0 auto;
			background: white;
			min-height: 100vh;
			box-sizing: border-box;
			padding: 1.25cm 2cm 1cm 2cm;
		}

		/* Layout Grid 3x4 với tỷ lệ 25%-50%-25% */
		.grid-container {
			display: grid;
			grid-template-columns: 25% 50% 25%;
			grid-template-rows: auto auto auto;
			gap: 5px 10px;
			width: 100%;
		}

		/* Grid Items - Hàng 1 */
		.grid-item-1-1 {
			grid-column: 1;
			grid-row: 1;
		}

		.grid-item-2-3-1 {
			grid-column: 2;
			grid-row: 1;
		}

		.grid-item-4-1 {
			grid-column: 3;
			grid-row: 1;
		}

		/* Grid Items - Hàng 2 */
		.grid-item-full-row-2 {
			grid-column: 1 / 4;
			grid-row: 2;
			margin-top: 20px;
			margin-bottom: 20px;
		}

		/* Grid Items - Hàng 3 với flexbox tỷ lệ 1:1:2 */
		.signature-row {
			display: flex;
			width: 100%;
			grid-column: 1 / 4;
			grid-row: 3;
		}

		.signature-row .grid-item-1-3 {
			flex: 1;
		}

		.signature-row .grid-item-2-3 {
			flex: 1;
		}

		.signature-row .grid-item-3-4-3 {
			flex: 2;
		}

		/* Header Form Styles */
		.header-form {
			text-align: left;
		}

		.form-number {
			font-weight: bold;
		}

		.form-note {
			font-weight: normal;
		}

		/* Title and Report Period */
		.main-title {
			text-align: center;
			font-weight: bold;
			font-size: 16pt;
			text-transform: uppercase;
		}

		.report-period {
			text-align: center;
			font-size: 13pt;
		}

		.report-info {
			font-size: 13pt;
			text-align: left;
		}

		.data-table {
			width: 100%;
			border-collapse: collapse;
			font-size: 13pt;
		}

		.data-table th,
		.data-table td {
			border: 1px solid #000;
			padding: 8px;
			text-align: center;
			vertical-align: middle;
		}

		.data-table th {
			font-weight: normal;
		}

		/* Signature Styles */
		.signature-left {
			text-align: center;
		}

		.signature-center {
			text-align: center;
		}

		.signature-right {
			text-align: center;
		}

		.signature-date {
			font-style: italic;
		}

		.signature-title {
			font-weight: bold;
		}

		.signature-note {
			font-style: italic;
			margin-bottom: 100px;
		}

		.no-print {
			background: #007bff;
			color: white;
			padding: 10px 15px;
			border-radius: 5px;
			cursor: pointer;
			float: left;
			margin-bottom: 20px;
			box-shadow: 2px 2px 5px rgba(0,0,0,0.3);
			font-family: Arial, sans-serif;
		}

		@@media print {
			@@page {
				size: A4 landscape;
				margin: 1.25cm 2cm 1cm 2cm;
			}

			.no-print {
				display: none !important;
			}

			body {
				background: white;
			}

			.document {
				padding: 0;
				margin: 0;
			}

			.data-table {
				page-break-inside: avoid !important;
			}
		}
			</style>
		</head>

		<body>

			<div class="document">
				<!-- Button In báo cáo -->
				<div class="no-print" onclick="window.print()">
					In báo cáo
				</div>

				<!-- Grid Container 3x4 Layout -->
				<div class="grid-container">
					@* Grid Item 1-1: Header Form (Hàng 1 Cột 1) *@
					<div class="grid-item-1-1">
						<div class="header-form">
							<div class="form-number">Biểu số: @bieuSo</div>
							<div class="form-note">Ban hành theo @thongTu</div>
							<div><strong>Ngày nhận báo cáo (BC):</strong></div>
							<div>BC năm chính thức: Ngày 31 tháng 01 năm sau</div>
						</div>
					</div>

					@* Grid Item 2-3-1: Main Title và Report Period (Hàng 1 Cột 2-3) *@
					<div class="grid-item-2-3-1">
						<!-- Main Title -->
						<div class="main-title">
							KẾT QUẢ CHỨNG THỰC CỦA CÁC CƠ QUAN ĐẠI DIỆN VIỆT NAM Ở NƯỚC NGOÀI<br>
							(Năm)
						</div>

						<!-- Report Period -->
						<div class="report-period">
							(Từ ngày 01 tháng 01 năm @Model?.Request.NgayBaoCaoTu.Year<br>
							đến ngày 31 tháng 12 năm @Model?.Request.NgayBaoCaoDen.Year)
						</div>
					</div>

					@* Grid Item 4-1: Report Info (Hàng 1 Cột 4) *@
					<div class="grid-item-4-1">
						<!-- Report Info -->
						<div class="report-info">
							<strong>Đơn vị báo cáo:</strong><br>
							- Bộ Ngoại giao<br>
							<strong>Đơn vị nhận báo cáo:</strong><br>
							- Bộ Tư pháp (Cục Kế hoạch - Tài chính)
						</div>
					</div>

					@* Grid Item Full Row 2: Data Table (Hàng 2 cả 4 cột) *@
					<div class="grid-item-full-row-2">
						<table class="data-table">
							<thead>
								<tr>
									<th></th>
									<th style="vertical-align: middle;">
										<b>Chứng thực bản sao</b><br>
										<em>(Bản)</em>
									</th>
									<th style="vertical-align: middle;">
										<b>Chứng thực chữ ký trong giấy tờ, văn bản</b><br>
										<em>(Việc)</em>
									</th>
									<th style="vertical-align: middle;">
										<b>Chứng thực chữ ký người dịch trong các giấy tờ, văn bản</b><br>
										<em>(Việc)</em>
									</th>
								</tr>
							</thead>
							<tbody>
								<!-- Tổng số -->
								<tr>
									<td style="text-align: left"><b>Tổng số</b></td>
									<td>@(Model?.BaoCao17d?.TongSo.ChungThucBanSao ?? 0)</td>
									<td>@(Model?.BaoCao17d?.TongSo.ChungThucChuKy ?? 0)</td>
									<td>@(Model?.BaoCao17d?.TongSo.ChungThucChuKyNguoiDich ?? 0)</td>
								</tr>

								<!-- Danh sách cơ quan đại diện -->
								@if (Model?.BaoCao17d?.DanhSachCoQuanDaiDien != null && Model.BaoCao17d.DanhSachCoQuanDaiDien.Any())
								{
									@foreach (var coQuan in Model.BaoCao17d.DanhSachCoQuanDaiDien)
									{
										<tr>
											<td style="text-align: left;">Cơ quan đại diện tại @coQuan.TenCoQuanDaiDien</td>
											<td>@coQuan.ChungThucBanSao</td>
											<td>@coQuan.ChungThucChuKy</td>
											<td>@coQuan.ChungThucChuKyNguoiDich</td>
										</tr>
									}
								}
							</tbody>
						</table>
					</div>

					@* Grid Item Row 3: Signature section với tỷ lệ 1:1:2 *@
					<div class="signature-row">
						<div class="grid-item-1-3">
							<br>
							<div class="signature-left">
								<div class="signature-title">Người lập biểu</div>
								<div class="signature-note">(Ký, ghi rõ họ, tên)</div>
								@Model?.Request.NguoiLapBieu
							</div>
						</div>

						<div class="grid-item-2-3">
							<br>
							<div class="signature-center">
								<div class="signature-title">Người kiểm tra</div>
								<div class="signature-note">(Ký, ghi rõ họ, tên, chức vụ)</div>
								<div>@Model?.Request.ChucVuNguoiKiemTra</div>
								@Model?.Request.NguoiKiemTra
							</div>
						</div>

						<div class="grid-item-3-4-3">
							<div class="signature-right">
								<div class="signature-date">
									@(Model?.Request.DiaDanh ?? "...."), ngày @DateTime.Now.Day tháng @DateTime.Now.Month năm
									@DateTime.Now.Year
								</div>
								<div class="signature-title">BỘ TRƯỞNG</div>
								<div class="signature-note">(Ký, đóng dấu, ghi rõ họ, tên)</div>
								@Model?.Request.BoTruong
							</div>
						</div>
					</div>
				</div>
			</div>

		</body>

		</html>
