@model Services.DTOs.BaoCao12.BaoCao12ResponseDto
@{
    Layout = "_LayoutReport";
    ViewData["Title"] = "Biểu số: 12b/BTP/BTTP/CC";
    var baoCao12b = Model?.BaoCao12b;
    var request = Model?.Request;
}

<div style="margin: 15mm 15mm 20mm 20mm;">
    <div class="card-body">
        <!-- Header với 3 cột theo mẫu chính thức -->
        <div style="display: flex; flex-direction: row; justify-content: space-between; align-items: flex-start; margin-bottom:30px">
            <div class="col-4">
                <div style=" padding: 10px; height: 120px;">
                    <div><strong>Biểu số: 12b/BTP/BTTP/CC</strong></div>
                    <div class="mt-2">Ban hành theo Thông tư số 03/2019/TT-BTP ngày 20/3/2019</div>
                    <div class="mt-2"><strong>Ngày nhận báo cáo (BC):</strong></div>
                    <div>BC 6 tháng: Ngày 25 tháng 6 hàng năm</div>
                    <div>BC năm: Ngày 28 tháng 11 hàng năm</div>
                    <div>BC năm chính thức: Ngày 20 tháng 02 năm sau</div>
                </div>
            </div>
            <div class="col-4" style="text-align:center">
                <div style="padding: 10px; height: 120px;">
                    <div style="margin-bottom:2px"><strong>TÌNH HÌNH TỔ CHỨC VÀ HOẠT ĐỘNG</strong></div>
                    <div style="margin-bottom:2px"><strong>CÔNG CHỨNG TRÊN ĐỊA BÀN TỈNH</strong></div>
                    <div class="text-center" style="margin-bottom:2px">(6 tháng, năm)</div>
                    <div class="mt-3" style="margin-bottom:2px">Kỳ báo cáo: @( request?.NgayBaoCao.ToString("dd/MM/yyyy") ?? "............" )</div>
                    <div>(Từ ngày @(request?.NgayBaoCaoTu.ToString("dd") ?? "..") tháng @(request?.NgayBaoCaoTu.ToString("MM") ?? "..") năm @(request?.NgayBaoCaoTu.ToString("yyyy") ?? "....")</div>
                    <div>đến ngày @(request?.NgayBaoCaoDen.ToString("dd") ?? "..") tháng @(request?.NgayBaoCaoDen.ToString("MM") ?? "..") năm @(request?.NgayBaoCaoDen.ToString("yyyy") ?? "...."))</div>
                </div>
            </div>
            <div class="col-4">
                <div style="padding: 10px; height: 120px;">
                    <div style="margin-bottom:2px"><strong>Đơn vị báo cáo:</strong></div>
                    <div style="margin-bottom:2px">Sở Tư pháp ....</div>
                    <div style="margin-bottom:2px"><strong>Đơn vị nhận báo cáo:</strong></div>
                    <div style="margin-bottom:2px">- Bộ Tư pháp (Cục Kế hoạch - Tài chính)</div>
                </div>
            </div>
        </div>
        <br />
        <!-- Bảng báo cáo chính theo mẫu chính thức -->

        <table cellspacing="0" cellpadding="0" border="1" style="border-collapse: collapse; font-size: 14px; width: 100%" id="data_render">
            <thead>
                <tr class="text-center">
                    <th rowspan="4" class="align-middle" style="width: 8%; border: 1px solid #000;">
                        A
                    </th>
                    <th rowspan="4" class="align-middle" style="width: 8%; border: 1px solid #000;">
                        Số công chứng viên<br>
                        <em>(người)</em>
                    </th>

                    <th colspan="5" style="border: 1px solid #000;">Công chứng</th>
                    <th colspan="4" style="border: 1px solid #000;">Chứng thực</th>
                    <th rowspan="4" class="align-middle" style="width: 10%; border: 1px solid #000;">
                        Tổng số tiền nộp vào ngân sách/thuế<br>
                        <em>(đồng)</em>
                    </th>
                </tr>
                <tr class="text-center">
                    <th colspan="3" style="border: 1px solid #000;">
                        Số việc công chứng<br>
                        <em>(việc)</em>
                    </th>
                    <th rowspan="3" class="align-middle" style="border: 1px solid #000;">
                        Tổng số thu lao công<br>
                        <em>(đồng)</em>
                    </th>
                    <th rowspan="3" class="align-middle" style="border: 1px solid #000;">
                        Tổng số phí công chứng<br>
                        <em>(đồng)</em>
                    </th>
                    <th colspan="2" style="border: 1px solid #000;">
                        Chứng thực bản sao<br>
                    </th>
                    <th colspan="2" style="border: 1px solid #000;">
                        Chứng thực chữ ký trong giấy tờ, văn bản<br>
                    </th>
                </tr>

                <tr class="text-center">
                    <th rowspan="2" class="align-middle" style="border: 1px solid #000;">
                        Tổng số<br>
                    </th>

                    <th colspan="2" style="border: 1px solid #000;">Chia ra</th>

                    <th rowspan="2" class="align-middle" style="border: 1px solid #000;">
                        Số bản sao<br>
                        <em>(bản sao)</em>
                    </th>
                    <th rowspan="2" class="align-middle" style="border: 1px solid #000;">
                        Phí chứng thực bản sao<br>
                        <em>(đồng)</em>
                    </th>
                    <th rowspan="2" class="align-middle" style="border: 1px solid #000;">
                        Số việc<br>
                        <em>(việc)</em>
                    </th>
                    <th rowspan="2" class="align-middle" style="border: 1px solid #000;">
                        Phí chứng thực chữ ký<br>
                        <em>(đồng)</em>
                    </th>
                </tr>
                <tr class="text-center">
                    <th style="border: 1px solid #000;">
                        Công chứng hợp đồng, giao dịch
                    </th>
                    <th style="border: 1px solid #000;">
                        Công chứng bản dịch và các loại việc khác
                    </th>
                </tr>
                <tr class="text-center font-weight-bold">
                    <td style="border: 1px solid #000;">A</td>
                    <td style="border: 1px solid #000;">(1)</td>
                    <td style="border: 1px solid #000;">(2)</td>
                    <td style="border: 1px solid #000;">(3)</td>
                    <td style="border: 1px solid #000;">(4)</td>
                    <td style="border: 1px solid #000;">(5)</td>
                    <td style="border: 1px solid #000;">(6)</td>
                    <td style="border: 1px solid #000;">(7)</td>
                    <td style="border: 1px solid #000;">(8)</td>
                    <td style="border: 1px solid #000;">(9)</td>
                    <td style="border: 1px solid #000;">(10)</td>
                    <td style="border: 1px solid #000;">(11)</td>
                </tr>
            </thead>

            <tbody>
                <!-- Tổng số -->
                <tr class="font-weight-bold">
                    <td style="border: 1px solid #000; text-align: left; padding-left: 5px;"><strong>Tổng số</strong></td>
                    <td class="text-center" style="border: 1px solid #000;">@((baoCao12b?.PhongCongChung_SoCongChungVien ?? 0) + (baoCao12b?.VanPhongCongChung_SoCongChungVien ?? 0))</td>
                    <td class="text-center" style="border: 1px solid #000;">@((baoCao12b?.PhongCongChung_SoViecCongChung ?? 0) + (baoCao12b?.VanPhongCongChung_SoViecCongChung ?? 0))</td>
                    <td class="text-center" style="border: 1px solid #000;">@((baoCao12b?.PhongCongChung_CongChungHopDong ?? 0) + (baoCao12b?.VanPhongCongChung_CongChungHopDong ?? 0))</td>
                    <td class="text-center" style="border: 1px solid #000;">@((baoCao12b?.PhongCongChung_CongChungBanDich ?? 0) + (baoCao12b?.VanPhongCongChung_CongChungBanDich ?? 0))</td>
                    <td class="text-center" style="border: 1px solid #000;">@(((baoCao12b?.PhongCongChung_TongThuLaoCong ?? 0) + (baoCao12b?.VanPhongCongChung_TongThuLaoCong ?? 0)).ToString("N0"))</td>
                    <td class="text-center" style="border: 1px solid #000;">@(((baoCao12b?.PhongCongChung_TongPhiCongChung ?? 0) + (baoCao12b?.VanPhongCongChung_TongPhiCongChung ?? 0)).ToString("N0"))</td>
                    <td class="text-center" style="border: 1px solid #000;">@((baoCao12b?.PhongCongChung_ChungThucBanSao ?? 0) + (baoCao12b?.VanPhongCongChung_ChungThucBanSao ?? 0))</td>
                    <td class="text-center" style="border: 1px solid #000;">@(((baoCao12b?.PhongCongChung_PhiChungThucBanSao ?? 0) + (baoCao12b?.VanPhongCongChung_PhiChungThucBanSao ?? 0)).ToString("N0"))</td>
                    <td class="text-center" style="border: 1px solid #000;">@((baoCao12b?.PhongCongChung_SoViecChungThucChuKy ?? 0) + (baoCao12b?.VanPhongCongChung_SoViecChungThucChuKy ?? 0))</td>
                    <td class="text-center" style="border: 1px solid #000;">@(((baoCao12b?.PhongCongChung_PhiChungThucChuKy ?? 0) + (baoCao12b?.VanPhongCongChung_PhiChungThucChuKy ?? 0)).ToString("N0"))</td>
                    <td class="text-center" style="border: 1px solid #000;">@(((baoCao12b?.PhongCongChung_TongTienNopNganSach ?? 0) + (baoCao12b?.VanPhongCongChung_TongTienNopNganSach ?? 0)).ToString("N0"))</td>
                </tr>

                <!-- I. Phòng Công chứng -->
                <tr>
                    <td style="border: 1px solid #000; text-align: left; padding-left: 5px;"><strong>I. Phòng Công chứng</strong></td>
                    <td class="text-center" style="border: 1px solid #000;">@(baoCao12b?.PhongCongChung_SoCongChungVien ?? 0)</td>
                    <td class="text-center" style="border: 1px solid #000;">@(baoCao12b?.PhongCongChung_SoViecCongChung ?? 0)</td>
                    <td class="text-center" style="border: 1px solid #000;">@(baoCao12b?.PhongCongChung_CongChungHopDong ?? 0)</td>
                    <td class="text-center" style="border: 1px solid #000;">@(baoCao12b?.PhongCongChung_CongChungBanDich ?? 0)</td>
                    <td class="text-center" style="border: 1px solid #000;">@((baoCao12b?.PhongCongChung_TongThuLaoCong ?? 0).ToString("N0"))</td>
                    <td class="text-center" style="border: 1px solid #000;">@((baoCao12b?.PhongCongChung_TongPhiCongChung ?? 0).ToString("N0"))</td>
                    <td class="text-center" style="border: 1px solid #000;">@(baoCao12b?.PhongCongChung_ChungThucBanSao ?? 0)</td>
                    <td class="text-center" style="border: 1px solid #000;">@((baoCao12b?.PhongCongChung_PhiChungThucBanSao ?? 0).ToString("N0"))</td>
                    <td class="text-center" style="border: 1px solid #000;">@(baoCao12b?.PhongCongChung_SoViecChungThucChuKy ?? 0)</td>
                    <td class="text-center" style="border: 1px solid #000;">@((baoCao12b?.PhongCongChung_PhiChungThucChuKy ?? 0).ToString("N0"))</td>
                    <td class="text-center" style="border: 1px solid #000;">@((baoCao12b?.PhongCongChung_TongTienNopNganSach ?? 0).ToString("N0"))</td>
                </tr>

                <!-- II. Văn phòng Công chứng -->
                <tr>
                    <td style="border: 1px solid #000; text-align: left; padding-left: 5px;"><strong>II. Văn phòng Công chứng</strong></td>
                    <td class="text-center" style="border: 1px solid #000;">@(baoCao12b?.VanPhongCongChung_SoCongChungVien ?? 0)</td>
                    <td class="text-center" style="border: 1px solid #000;">@(baoCao12b?.VanPhongCongChung_SoViecCongChung ?? 0)</td>
                    <td class="text-center" style="border: 1px solid #000;">@(baoCao12b?.VanPhongCongChung_CongChungHopDong ?? 0)</td>
                    <td class="text-center" style="border: 1px solid #000;">@(baoCao12b?.VanPhongCongChung_CongChungBanDich ?? 0)</td>
                    <td class="text-center" style="border: 1px solid #000;">@((baoCao12b?.VanPhongCongChung_TongThuLaoCong ?? 0).ToString("N0"))</td>
                    <td class="text-center" style="border: 1px solid #000;">@((baoCao12b?.VanPhongCongChung_TongPhiCongChung ?? 0).ToString("N0"))</td>
                    <td class="text-center" style="border: 1px solid #000;">@(baoCao12b?.VanPhongCongChung_ChungThucBanSao ?? 0)</td>
                    <td class="text-center" style="border: 1px solid #000;">@((baoCao12b?.VanPhongCongChung_PhiChungThucBanSao ?? 0).ToString("N0"))</td>
                    <td class="text-center" style="border: 1px solid #000;">@(baoCao12b?.VanPhongCongChung_SoViecChungThucChuKy ?? 0)</td>
                    <td class="text-center" style="border: 1px solid #000;">@((baoCao12b?.VanPhongCongChung_PhiChungThucChuKy ?? 0).ToString("N0"))</td>
                    <td class="text-center" style="border: 1px solid #000;">@((baoCao12b?.VanPhongCongChung_TongTienNopNganSach ?? 0).ToString("N0"))</td>
                </tr>
            </tbody>
        </table>

        <br />
        <!-- Ghi chú -->
        <div style="font-size: 14px; margin-top: 20px;">
            <div>+ Số liệu trong báo cáo này được tổng hợp từ báo cáo của ..../..... tổ chức hành nghề công chứng đang ký hoạt động tại Sở Tư pháp.</div>
            <div>+ Theo quan lý của Sở Tư pháp, số công chứng viên đang ký hành nghề là...........công chứng viên.</div>
        </div>

        <br />
        <table cellspacing="0" cellpadding="0" border="0" style="border-collapse: collapse;font-size:14px; width: 100%">
            <tr style="text-align: center">
                <td width="33%">
                    <span style="font-style: italic"></span>
                    <br /><span style="text-transform: uppercase; font-weight: bold">Người lập biểu</span>
                    <br /><span style="font-style: italic">(Ký, ghi rõ họ, tên)</span>
                    <br /><br />
                    <div style="height: 80px;"></div>
                    <div>@(request?.NguoiLapBieu ?? "................................")</div>
                </td>
                <td width="33%">
                    <span style="font-style: italic"></span>
                    <br /><span style="text-transform: uppercase; font-weight: bold">Người kiểm tra</span>
                    <br /><span style="font-style: italic">(Ký, ghi rõ họ, tên, chức vụ)</span>
                    <br />
                    <br />
                    <div>@(request?.ChucVuNguoiKiemTra ?? "................................")</div>
                    <div style="height: 60px;"></div>
                    <div>@(request?.NguoiKiemTra ?? "................................")</div>
                </td>
                <td width="34%">
                    <span style="font-style: italic; padding-bottom:2px">
                        ..., ngày ...... tháng ..... năm .......
                    </span>
                    <br /><span style="text-transform: uppercase; font-weight: bold">GIÁM ĐỐC</span>
                    <br /><span style="font-style: italic">(Ký, tên, đóng dấu)</span>
                    <br /><br />
                    <div style="height: 80px;"></div>
                    <div>@(request?.GiamDoc ?? "................................")</div>
                </td>
            </tr>
        </table>
    </div>
</div>

@section custom_style {

}

@section custom_script {
    <script>
        $(document).ready(function() {
            console.log('Mẫu báo cáo 12b - Biểu số: 12b/BTP/BTTP/CC loaded successfully');

            // Auto print nếu có query parameter
            if (window.location.search.includes('print=true')) {
                setTimeout(() => window.print(), 1000);
            }
        });

        // Format numbers khi hover
        $('.table tbody td').hover(
            function() {
                if ($(this).text().trim() && !isNaN($(this).text().replace(/,/g, ''))) {
                    $(this).attr('title', 'Số liệu: ' + $(this).text());
                }
            }
        );
    </script>
}