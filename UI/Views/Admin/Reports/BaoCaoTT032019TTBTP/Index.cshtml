@using DataAccess.Enums
@using UI.Controllers.Admin.Reports;
@{
	var session = HttpContextAccessor?.HttpContext?.Session ?? null;
	string role = ViewData["Role"] as string ?? "";
}

<div class="card card-custom wave wave-animate-slow wave-primary">
	<div class="card-header flex-wrap border-0 pt-6 pb-0">
		<div class="card-title">
			<h3 class="card-label">
				@ViewData["Title"]?.ToString()?.ToUpper()
				<span class="d-block text-muted pt-2 font-size-sm">
					Thông tin báo cáo @((ViewData["Title"] as string))
				</span>
			</h3>
		</div>
		<div class="card-toolbar">
		</div>
	</div>
	<div class="card-body">
		<ol>
			<li>
				<button type="button" class="btn btn-link" onclick="HandleShowModeSoBaoCao('@Url.Action(nameof(BaoCaoTT032019TTBTPController.MauSo12a))', '@Url.Action(nameof(BaoCaoTT032019TTBTPController.MauSo12FormFields))', 'TÌNH HÌNH TỔ CHỨC VÀ HOẠT ĐỘNG CÔNG CHỨNG')" style="text-align:left">
					<span style="font-size:16px; color:blue; font-weight: bold">
						Báo cáo 12a - Tình Hình Tổ Chức và Hoạt Động Công Chứng 
					</span>
					<br />
					<span>
						Biểu số: 12a/BTP/BTTP/CC || Thông tư số 03/2019/TT-BTP
					</span>
				</button>
			</li>
			<li>
				<button type="button" class="btn btn-link" onclick="HandleShowModeSoBaoCao('@Url.Action(nameof(BaoCaoTT032019TTBTPController.MauSo12b))', '@Url.Action(nameof(BaoCaoTT032019TTBTPController.MauSo12FormFields))', 'TÌNH HÌNH TỔ CHỨC VÀ HOẠT ĐỘNG CÔNG CHỨNG TRÊN ĐỊA BÀN TỈNH')" style="text-align:left">
					<span style="font-size:16px; color:blue; font-weight: bold">
						Báo cáo 12b - Tình Hình Tổ Chức và Hoạt Động Công Chứng Trên Địa Bàn Tỉnh
					</span>
					<br />
					<span>
						Biểu số: 12b/BTP/BTTP/CC || Thông tư số 03/2019/TT-BTP
					</span>
				</button>
			</li>
			<li>
				<button onclick="loadFormFields17a()" class="btn btn-link" style="text-align:left">
					<span style="font-size:16px; color:blue; font-weight: bold">
						Báo cáo 17a - Kết quả chứng thực tại UBND cấp xã
					</span>
					<br />
					Biểu số: 17a/BTP/HTQTCT/CT || Thông tư số 03/2019/TT-BTP
				</button>
			</li>
			<li>
				<button onclick="loadFormFields17b()" class="btn btn-link" style="text-align:left">
					<span style="font-size:16px; color:blue; font-weight: bold">
						Báo cáo 17b - Kết quả chứng thực của Phòng Tư pháp và UBND cấp xã trên địa bàn huyện
					</span>
					<br />
					Biểu số: 17b/BTP/HTQTCT/CT || Thông tư số 03/2019/TT-BTP
				</button>
			</li>
			<li>
				<button onclick="loadFormFields17c()" class="btn btn-link" style="text-align:left">
					<span style="font-size:16px; color:blue; font-weight: bold">
						Báo cáo 17c - Kết quả chứng thực của Phòng Tư pháp và UBND cấp xã trên địa bàn tỉnh
					</span>
					<br />
					Biểu số: 17c/BTP/HTQTCT/CT || Thông tư số 03/2019/TT-BTP
				</button>
			</li>
			<li>
				<button onclick="loadFormFields17d()" class="btn btn-link" style="text-align:left">
					<span style="font-size:16px; color:blue; font-weight: bold">
						Báo cáo 17d - Kết quả chứng thực của các cơ quan đại diện Việt Nam ở nước ngoài
					</span>
					<br />
					Biểu số: 17d/BTP/HTQTCT/CT || Thông tư số 03/2019/TT-BTP
				</button>
			</li>
		</ol>
	</div>
</div>

@await Html.PartialAsync("~/Views/Admin/Reports/BaoCaoTT032019TTBTP/MauSo17/_Modal.cshtml")

@await Html.PartialAsync("~/Views/Admin/Reports/BaoCaoTT032019TTBTP/MauSo12/_Modal.cshtml")


@section custom_script {
	<script src="~/js/site.js"></script>
	<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>

	<script>
		// Load form fields cho báo cáo với loại cụ thể
		const loadFormFields = (loaiBaoCao, title, action) => {
			const urlPost = "@Url.Action(nameof(BaoCaoTT032019TTBTPController.FormFields))";
			HandlePostAjax({
				url: urlPost,
				successCallback: (res) => {
					if (res.isValid) {
						// Cập nhật form fields content nếu có HTML
						if (res.html) {
							$('#modalBaoCao17 .modal-body').html(res.html);
						}

						// Set loại báo cáo
						$('#LoaiBaoCaoHidden').val(loaiBaoCao);

						// Trigger JavaScript để hiển thị form tương ứng
						if (window.BaoCao17FormValidation && window.BaoCao17FormValidation.handleLoaiBaoCaoChange) {
							window.BaoCao17FormValidation.handleLoaiBaoCaoChange(loaiBaoCao);
						}

						// Cập nhật title
						$('#modalBaoCao17_Title').text(title);

						// Hiển thị modal
						$('#modalBaoCao17').modal('show');

						// Cập nhật form action
						$('#BaoCao17Form').attr('action', action);

						// Override submit event để validate và đóng modal
						$('#BaoCao17Form').off('submit').on('submit', function(e) {
							if (window.BaoCao17FormValidation && window.BaoCao17FormValidation.validateFormFields) {
								if (!window.BaoCao17FormValidation.validateFormFields()) {
									e.preventDefault();
									toastr.warning('Vui lòng điền đầy đủ thông tin bắt buộc', 'Cảnh Báo!');
									return false;
								}
							}
							
							// Đóng modal sau khi submit thành công
							setTimeout(() => {
								$('#modalBaoCao17').modal('hide');
							}, 100);
							
							return true;
						});
					}
					else {
						toastr.warning(res.message || 'Có lỗi khi thao tác với dữ liệu', 'Cảnh Báo!');
					}
				},
				errorCallback: (xhr, status, error) => {
					toastr.error('Không nhận được phản hồi từ máy chủ. Vui lòng thử lại sau.');
				}
			})
		}

		// Load form fields cho từng loại báo cáo

		const loadFormFields17a = () => {
			loadFormFields('@LoaiBaoCao17.BaoCao17a', 
						  'Báo cáo 17a - Kết quả chứng thực tại UBND cấp xã',
						  '@Url.Action(nameof(BaoCaoTT032019TTBTPController.BaoCao17a))');
		}

		const loadFormFields17b = () => {
			loadFormFields('@LoaiBaoCao17.BaoCao17b', 
						  'Báo cáo 17b - Kết quả chứng thực của Phòng Tư pháp và UBND cấp xã trên địa bàn huyện', 
						  '@Url.Action(nameof(BaoCaoTT032019TTBTPController.BaoCao17b))');
		}

		const loadFormFields17c = () => {
			loadFormFields('@LoaiBaoCao17.BaoCao17c', 
						  'Báo cáo 17c - Kết quả chứng thực của Phòng Tư pháp và UBND cấp xã trên địa bàn tỉnh', 
						  '@Url.Action(nameof(BaoCaoTT032019TTBTPController.BaoCao17c))');
		}

		const loadFormFields17d = () => {
			loadFormFields('@LoaiBaoCao17.BaoCao17d', 
						  'Báo cáo 17d - Kết quả chứng thực của các cơ quan đại diện Việt Nam ở nước ngoài', 
						  '@Url.Action(nameof(BaoCaoTT032019TTBTPController.BaoCao17d))');
		}

        // js cua mau so 12
		$(document).ready(function () {
			$('#DynamicReportForm').on('submit', (e) => {
				//e.preventDefault();

				const form = $('#DynamicReportForm')[0];

				$('#modalDynamicForm').modal('hide');

				//$('#modalDynamicForm').on('hidden.bs.modal', () => {
				//    form.submit();
				//});
			});
		});
		const HandleShowModeSoBaoCao = (urlPost, urlGet, modalTitle) => {
			$('#DynamicReportForm').attr('action', urlPost);
			$('#modalDynamicForm').modal('hide');
			HandlePostAjax({
				url: urlGet,
				successCallback: (res) => {
					if (res.isValid) {
						$('#DynamicReportForm .modal-body').empty().html(res.html);
						SetupSelect2('#DanhMucHopDongIds');
						$('#modalDynamicForm').modal('show');
						$('#modalDynamicForm_Title').text(modalTitle);
						
						// Set loại báo cáo và trigger validation logic
						if (urlPost.includes('MauSo12a')) {
							$('#LoaiBaoCaoHidden').val('@(LoaiBaoCao12.BaoCao12a)');
							if (window.BaoCao12FormValidation && window.BaoCao12FormValidation.handleLoaiBaoCaoChange) {
								window.BaoCao12FormValidation.handleLoaiBaoCaoChange('@(LoaiBaoCao12.BaoCao12a)');
							}
						} else if (urlPost.includes('MauSo12b')) {
							$('#LoaiBaoCaoHidden').val('@(LoaiBaoCao12.BaoCao12b)');
							if (window.BaoCao12FormValidation && window.BaoCao12FormValidation.handleLoaiBaoCaoChange) {
								window.BaoCao12FormValidation.handleLoaiBaoCaoChange('@(LoaiBaoCao12.BaoCao12b)');
							}
						}
						
						// Override submit event để validate
						$('#DynamicReportForm').off('submit').on('submit', function(e) {
							if (window.BaoCao12FormValidation && window.BaoCao12FormValidation.validateFormFields) {
								if (!window.BaoCao12FormValidation.validateFormFields()) {
									e.preventDefault();
									toastr.warning('Vui lòng điền đầy đủ thông tin bắt buộc', 'Cảnh Báo!');
									return false;
								}
							}
							
							// Đóng modal sau khi submit thành công
							setTimeout(() => {
								$('#modalDynamicForm').modal('hide');
							}, 100);
							
							return true;
						});
					}
					else {
						toastr.warning(res.message || 'Có lỗi khi khi thao tác với dữ liệu', 'Cảnh Báo!');
					}
				},
				errorCallback: (xhr, status, error) => {
					toastr.error('Không nhận được phản hồi từ máy chủ. Vui lòng thử lại sau.');
				}
			})
		}
	</script>
}
