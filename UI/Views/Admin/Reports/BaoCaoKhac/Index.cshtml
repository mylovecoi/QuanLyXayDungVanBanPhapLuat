@using UI.Controllers.Admin.Reports;
@{

    var session = HttpContextAccessor?.HttpContext?.Session ?? null;
    string role = ViewData["Role"] as string ?? "";
    var tinhNangThanhToan = Convert.ToBoolean(ViewData["TinhNangThanhToan"] ?? false);
}

<div class="card card-custom wave wave-animate-slow wave-primary">
    <div class="card-header flex-wrap border-0 pt-6 pb-0">
        <div class="card-title">
            <h3 class="card-label">
                BÁO CÁO KHÁC
                <span class="d-block text-muted pt-2 font-size-sm">
                    Thông tin báo cáo khác
                </span>
            </h3>
        </div>
        <div class="card-toolbar">
        </div>
    </div>
    <div class="card-body">
        <ol>
            <li>
                <button type="button" class="btn btn-link" onclick="HandleBtnShowModalExportData()" style="text-align:left">
                    <span style="font-size:16px; color:blue; font-weight: bold">
                        Kết xuất dữ liệu đính kèm hồ sơ
                    </span>
                </button>
            </li>
            <li>
                <button type="button" class="btn btn-link" onclick="HandleShowModelReport('@Url.Action(nameof(BaoCaoKhacController.BaoCaoTongQuanData))', '@Url.Action(nameof(BaoCaoKhacController.GetFormFields))', 'Báo cáo tổng hợp @ViewData["Title"]?.ToString()?.ToLower()')" style="text-align:left">
                    <span style="font-size:16px; color:blue; font-weight: bold">
                        Báo cáo tổng hợp hồ sơ
                    </span>
                </button>
            </li>
            <li>
                <button type="button" class="btn btn-link" onclick="HandleShowModelReport('@Url.Action(nameof(BaoCaoKhacController.BaoCaoChiTietData))', '@Url.Action(nameof(BaoCaoKhacController.GetFormFields))','Báo cáo chi tiết @ViewData["Title"]?.ToString()?.ToLower()')" style="text-align:left">
                    <span style="font-size:16px; color:blue; font-weight: bold">
                        Báo cáo chi tiết hồ sơ
                    </span>
                </button>
            </li>
            @if (tinhNangThanhToan)
            {
                <li>
                    <button type="button" class="btn btn-link" onclick="HandleShowModelReport('@Url.Action(nameof(BaoCaoKhacController.BaoCaoChiPhiTongQuanData))', '@Url.Action(nameof(BaoCaoKhacController.GetFormFields))', 'Báo cáo tổng hợp phí, lệ phí @ViewData["Title"]?.ToString()?.ToLower()')" style="text-align:left">
                        <span style="font-size:16px; color:blue; font-weight: bold">
                            Báo cáo tổng hợp phí, lệ phí hồ sơ
                        </span>
                    </button>
                </li>
                <li>
                    <button type="button" class="btn btn-link" onclick="HandleShowModelReport('@Url.Action(nameof(BaoCaoKhacController.BaoCaoChiPhiChiTietData))', '@Url.Action(nameof(BaoCaoKhacController.GetFormFields))', 'Báo cáo phí, lệ phí @ViewData["Title"]?.ToString()?.ToLower()')" style="text-align:left">
                        <span style="font-size:16px; color:blue; font-weight: bold">
                            Báo cáo phí, lệ phí hồ sơ
                        </span>
                    </button>
                </li>
            }
        </ol>
    </div>
</div>
@await Html.PartialAsync("~/Views/Admin/Reports/BaoCaoKhac/_Modal.cshtml")

@section custom_style {

}

@section custom_script {
@* page *@
    <script src="~/js/site.js"></script>
    <script src="~/js/pages/Admin/Manages/QuanLyHoSo/BaoCaoThongKe.js"></script>
@* lib *@
}