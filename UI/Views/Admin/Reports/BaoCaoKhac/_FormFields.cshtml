@model Services.DTOs.Manages.ThongTinHoSo.ReportRequestDto
<div class="row">
	<div class="col-sm-12 col-md-12 col-lg-6 col-xl-6 col-xxl-6 form-group">
		<label class="form-label fs-6 font-weight-boldest" asp-for="DonViId"></label>
		<label class="form-label font-weight-boldest">:</label><span class="text-danger"> (*)</span>
		<select class="form-control" asp-for="DonViId">
			@{
				var dmDonVi = ViewData["DanhMucDonVi"] as List<DataAccess.Entities.Settings.DanhMucDonVi>;
				if (dmDonVi != null && dmDonVi.Any())
					foreach (var item in dmDonVi)
					{
						string backIn = FuntionGlobal.GetBackIn(item.Level);
						<option value="@item.Id">@Html.Raw(backIn)@item.TenDonVi</option>
					}
			}
		</select>
		<span asp-validation-for="DonViId" class="text-danger mt-1"></span>
	</div>

	<div class="col-sm-12 col-md-12 col-lg-6 col-xl-6 col-xxl-6 form-group">
		<label class="form-label fs-6 font-weight-boldest" asp-for="NgayBaoCao"></label>
		<label class="form-label font-weight-boldest">:</label>
		<input type="date" asp-for="NgayBaoCao" class="form-control" placeholder="Nhập @Html.DisplayNameFor(x=>x.NgayBaoCao).ToLower()">
		<span asp-validation-for="NgayBaoCao" class="text-danger mt-1"></span>
	</div>

	<div class="col-sm-12 col-md-12 col-lg-6 col-xl-6 col-xxl-6 form-group">
		<label class="form-label fs-6 font-weight-boldest" asp-for="NgayBaoCaoTu"></label>
		<label class="form-label font-weight-boldest">:</label>
		<input type="date" asp-for="NgayBaoCaoTu" class="form-control" placeholder="Nhập @Html.DisplayNameFor(x=>x.NgayBaoCaoTu).ToLower()">
		<span asp-validation-for="NgayBaoCaoTu" class="text-danger mt-1"></span>
	</div>

	<div class="col-sm-12 col-md-12 col-lg-6 col-xl-6 col-xxl-6 form-group">
		<label class="form-label fs-6 font-weight-boldest" asp-for="NgayBaoCaoDen"></label>
		<label class="form-label font-weight-boldest">:</label>
		<input type="date" asp-for="NgayBaoCaoDen" class="form-control" placeholder="Nhập @Html.DisplayNameFor(x=>x.NgayBaoCaoDen).ToLower()">
		<span asp-validation-for="NgayBaoCaoDen" class="text-danger mt-1"></span>
	</div>

	<div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 col-xxl-12 form-group">
		<label class="form-label fs-6 font-weight-boldest" asp-for="DanhMucHopDongIds"></label>
		<label class="form-label font-weight-boldest">:</label>
		<select class="form-control" asp-for="DanhMucHopDongIds">
			@{
				var dmHopDong = ViewData["DanhMucHopDong"] as List<DataAccess.Entities.Settings.DanhMucHopDong>;
				if (dmHopDong != null && dmHopDong.Any())
					foreach (var item in dmHopDong)
					{
						string backIn = FuntionGlobal.GetBackIn(item.Level);
						<option value="@item.Id">
							@Html.Raw(backIn)@item.TenHopDong
							@(item.ParentId == null || item.ParentId == Guid.Empty ? string.Format("(Hợp Đồng {0})", @item.IsCC ? "Công Chứng" : "Chứng Thực") : "")
						</option>
					}
			}
		</select>
		<span asp-validation-for="DanhMucHopDongIds" class="text-danger mt-1"></span>
	</div>
</div>