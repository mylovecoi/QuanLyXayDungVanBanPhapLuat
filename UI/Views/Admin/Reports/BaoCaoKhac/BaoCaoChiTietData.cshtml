@model Services.DTOs.ReportResponseDto<Services.DTOs.Manages.ThongTinHoSo.BaoCaoThongKe.BaoCaoTongQuatResponseDto>
@{
	Layout = "_LayoutReport";
	var session = HttpContextAccessor?.HttpContext?.Session ?? null;
}
@if (Model != null)
{
	<div style="margin: 15mm 15mm 20mm 20mm;">
		<table>
			<tr>
				<td style="padding: 0px 0px"><p style="text-align: center;"><strong style="text-transform: uppercase; ">@Html.Raw(Model.TenDonVi)</strong></p></td>
				<td style="padding: 0px 0px"><p style="text-align: center;"><strong>CỘNG HÓA XÃ HỘI CHỦ NGHĨA VIỆT NAM</strong></p></td>
			</tr>
			<tr>
				<td style="padding: 0px 0px">
					<p style="text-align: center;">
						<strong>
							Số: ... @(string.IsNullOrWhiteSpace(Model.KyHieuDonVi) ? "" : "/" + Model.KyHieuDonVi)
						</strong>
					</p>
				</td>
				<td style="padding: 0px 0px"><p style="text-align: center;"><strong>Độc lập - Tự Do - Hạnh Phúc</strong></p></td>
			</tr>
			<tr>
				<td></td>
				<td><p style="text-align: right; font-style: italic;">@Model.TenDiaDanh, ngày @Model.NgayBaoCao.Day tháng @Model.NgayBaoCao.Month năm @Model.NgayBaoCao.Year</p></td>
			</tr>
		</table>
		<br />
		<p style="font-size:16px; text-transform:uppercase; font-weight:bold; text-align:center">
			@Model.TenBaoCao
		</p>
		<p style="font-size:12px; font-weight:bold; text-align:center">
			@($"(Từ ngày {FuntionGlobal.ConvertDateToStr(Model.NgayBaoCaoTu)} đến ngày {FuntionGlobal.ConvertDateToStr(Model.NgayBaoCaoDen)})")
		</p>
		<br />
		<table cellspacing="0" cellpadding="0" border="1" style="border-collapse: collapse; font-size: 14px; width: 95%" id="data_render">
			<thead>
				<tr>
					<th style="text-align:center" width="2%">STT</th>
					<th style="text-align:center" width="10%">Số Hồ Sơ</th>
					<th style="text-align:center" width="15%">Ngày Xử Lý</th>
					<th style="text-align:center" width="50%">Mô Tả</th>
					<th style="text-align:center" width="15%">Giá Trị Hợp Đồng</th>
				</tr>
			</thead>
			<tbody>
				@if (Model.Data != null && Model.Data.Count() > 0)
				{
					int recordLevel1 = 1;
					int recordLevel2 = 1;
					foreach (var item in Model.Data)
					{
						if (item.SoLuong == 0) continue;
						if (item.Level == 0)
						{
							<tr>
								<td><strong>@FuntionGlobal.StrToRoman(recordLevel1)</strong></td>
								<td colspan="4" style="text-align: left">
									<strong>
										@Html.Raw(FuntionGlobal.GetBackIn(item.Level))@item.TenHopDong
										(Số hợp đồng: @item.SoLuong)
									</strong>
								</td>
							</tr>
							recordLevel1++;
							recordLevel2 = 1;
						}
						else if (item.Level == 1)
						{
							<tr>
								<td>@recordLevel2</td>
								<td colspan="4" style="text-align: left">
									<p>
										@Html.Raw(FuntionGlobal.GetBackIn(item.Level))@item.TenHopDong
										(Số hợp đồng: @item.SoLuong)
									</p>
								</td>
							</tr>
							if (item.ChiTiets.Count() > 0)
							{
								int recordLevel3 = 1;
								foreach (var hoso in item.ChiTiets)
								{
									<tr>
										<td>@recordLevel2.@recordLevel3</td>
										<td style="text-align: center">@hoso.MaSoHoSo/@Model.KyHieuDonVi</td>
										<td style="text-align: center">
											<p>
												@FuntionGlobal.ConvertDateToStr(hoso.NgayXuLy)
											</p>
										</td>
										<td>
											@if (!string.IsNullOrEmpty(hoso.LoaiTaiSan))
											{
												<p><strong>Loại tài sản: </strong>@hoso.LoaiTaiSan</p>
											}
											@if (!string.IsNullOrEmpty(hoso.DiaBan))
											{
												<p><strong>Địa bàn: </strong>@hoso.DiaBan</p>
											}
											@if (!string.IsNullOrEmpty(hoso.ThongTinTaiSan))
											{
												<p><strong>Thông tin tài sản: </strong>@hoso.ThongTinTaiSan</p>
											}
										</td>
										<td style="text-align: center;">
											@hoso.StrGiaTriHopDong VNĐ
										</td>
									</tr>
									recordLevel3++;
								}
							}
							recordLevel2++;
						}

					}
				}
				else
				{
					<tr><td style="text-align:center" colspan="4">Chưa Có Dữ Liệu</td></tr>
				}
			</tbody>
		</table>
		<br />
		<table cellspacing="0" cellpadding="0" border="0" style="border-collapse: collapse;font-size:14px">
			<tr style="text-align: center">
				<td width="45%">
					<span style="font-style: italic"></span>
					<br /><span style="text-transform: uppercase; font-weight: bold">Người lập</span>
					<br /><span style="font-style: italic">(Ký, ghi rõ họ và tên)</span>
				</td>
				<td width="55%">
					<span style="font-style: italic; padding-bottom:2px">
						@($"{Model.TenDiaDanh}, Ngày {Model.NgayBaoCao.Day} tháng {Model.NgayBaoCao.Month} năm {Model.NgayBaoCao.Year}")
					</span>
					<br />
					<span style="text-transform: uppercase; font-weight: bold">
						@Html.Raw(Model.ChucDanhNguoiKy)
					</span>
					<br />
					<span style="font-style: italic">(Ký, ghi rõ họ và tên, đóng dấu)</span>
				</td>
			</tr>
		</table>
	</div>
}
else
{

}