<div class="modal fade" id="Create_Modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="card-label">
                    @ViewData["Title"]
                    <span class="d-block text-muted pt-2 font-size-sm">Them moi @ViewData["Title"]</span>
                </h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">
                <form id="frm_create"></form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Dong</button>
                <button type="button" class="btn btn-primary font-weight-bold" onclick="Store()">Them moi</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="Edit_Modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="card-label">
                    @ViewData["Title"]
                    <span class="d-block text-muted pt-2 font-size-sm">Chinh sua @ViewData["Title"]</span>
                </h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">
                <form id="frm_edit"></form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Dong</button>
                <button type="button" class="btn btn-primary font-weight-bold" onclick="Update()">Cap nhat</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="Delete_Modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="card-label">
                    @ViewData["Title"]
                    <span class="d-block text-muted pt-2 font-size-sm">Xoa @ViewData["Title"]</span>
                </h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <form asp-controller="DanhMucTrangThai" asp-action="Delete" method="post">
                <div class="modal-body">
                    <div class="form-group fv-plugins-icon-container">
                        <label>
                            Ten trang thai:&nbsp;<b id="tentrangthai_delete" style="color: #0000FF"></b>
                        </label>
                    </div>
                    <input hidden id="id_delete" name="id_delete" />
                    @Html.AntiForgeryToken()
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light-primary font-weight-bold" data-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger font-weight-bold">Đồng ý</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/modal.validation.js"></script>
<script>
    function Create() {
        $.ajax({
            url: '/QuanLyDanhMuc/DanhMucTrangThai/Create',
            type: 'GET',
            success: function (data) {
                $('#frm_create').html(data);
                $('#Create_Modal').modal('show');
            },
            error: function () {
                toastr.error("Khong the tai du lieu!", "Loi!");
            }
        });
    }

    function Store() {
        var form = document.getElementById('frm_create');
        const fieldsToValidate = [
            { id: 'MaTrangThai', message: 'Ma trang thai khong duoc bo trong' },
            { id: 'TenTrangThai', message: 'Ten trang thai khong duoc bo trong' },
            { id: 'MaMauHex', message: 'Ma mau hien thi khong duoc bo trong' }
        ];

        if (validateModalFormFields(form, fieldsToValidate)) {
            const csrfToken = $('input[name="__RequestVerificationToken"]').val();
            const formData = new FormData(form);
            $.ajax({
                url: '/QuanLyDanhMuc/DanhMucTrangThai/Store',
                type: 'POST',
                headers: {
                    'RequestVerificationToken': csrfToken
                },
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'JSON',
                success: function (data) {
                    if (data.status == 'success') {
                        toastr.success(data.message);
                        location.reload();
                    } else {
                        toastr.error(data.message, "Loi!");
                    }
                }
            });
        }
    }

    function Edit(idEdit) {
        const csrfToken = $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
            url: '/QuanLyDanhMuc/DanhMucTrangThai/Edit',
            type: 'POST',
            headers: {
                'RequestVerificationToken': csrfToken
            },
            data: {
                id: idEdit
            },
            success: function (data) {
                $('#frm_edit').html(data);
                $('#Edit_Modal').modal('show');
            },
            error: function () {
                toastr.error("Khong the tai du lieu!", "Loi!");
            }
        });
    }

    function Update() {
        var form = document.getElementById('frm_edit');
        const fieldsToValidate = [
            { id: 'MaTrangThai', message: 'Ma trang thai khong duoc bo trong' },
            { id: 'TenTrangThai', message: 'Ten trang thai khong duoc bo trong' },
            { id: 'MaMauHex', message: 'Ma mau hien thi khong duoc bo trong' }
        ];

        if (validateModalFormFields(form, fieldsToValidate)) {
            const csrfToken = $('input[name="__RequestVerificationToken"]').val();
            const formData = new FormData(form);
            $.ajax({
                url: '/QuanLyDanhMuc/DanhMucTrangThai/Update',
                type: 'POST',
                headers: {
                    'RequestVerificationToken': csrfToken
                },
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'JSON',
                success: function (data) {
                    if (data.status == 'success') {
                        toastr.success(data.message);
                        location.reload();
                    } else {
                        toastr.error(data.message, "Loi!");
                    }
                }
            });
        }
    }

    function Delete(id, tenTrangThai) {
        document.getElementById('id_delete').value = id;
        document.getElementById('tentrangthai_delete').innerHTML = tenTrangThai;
        $('#Delete_Modal').modal('show');
    }
</script>
