<div class="modal fade" id="Create_Modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="card-label">@ViewData["Title"]<span class="d-block text-muted pt-2 font-size-sm">Thêm mới @ViewData["Title"]</span></h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><i aria-hidden="true" class="ki ki-close"></i></button>
            </div>
            <div class="modal-body"><form id="frm_create"></form></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary font-weight-bold" onclick="Store()">Thêm mới</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="Edit_Modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="card-label">@ViewData["Title"]<span class="d-block text-muted pt-2 font-size-sm">Chỉnh sửa @ViewData["Title"]</span></h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><i aria-hidden="true" class="ki ki-close"></i></button>
            </div>
            <div class="modal-body"><form id="frm_edit"></form></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-danger font-weight-bold" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary font-weight-bold" onclick="Update()">Cập nhật</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="Delete_Modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="card-label">@ViewData["Title"]<span class="d-block text-muted pt-2 font-size-sm">Xóa @ViewData["Title"]</span></h3>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><i aria-hidden="true" class="ki ki-close"></i></button>
            </div>
            <form asp-controller="DanhMucTieuChiDiem" asp-action="Delete" method="post">
                <div class="modal-body">
                    <div class="form-group"><label>Tên tiêu chí:&nbsp;<b id="tentieuchi_delete" style="color:#0000FF"></b></label></div>
                    <input hidden id="id_delete" name="id_delete" />
                    @Html.AntiForgeryToken()
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light-primary font-weight-bold" data-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger font-weight-bold">Đồng ý</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/modal.validation.js"></script>
<script>
    function Create() {
        $.ajax({ url: '/QuanLyDanhMuc/DanhMucTieuChiDiem/Create', type: 'GET',
            success: function (data) { $('#frm_create').html(data); $('#Create_Modal').modal('show'); },
            error: function () { toastr.error("Không thể tải dữ liệu!", "Lỗi!"); } });
    }
    function Store() {
        var form = document.getElementById('frm_create');
        const fieldsToValidate = [
            { id: 'TieuChi_MaTieuChi', message: 'Mã tiêu chí không được bỏ trống' },
            { id: 'TieuChi_TenTieuChi', message: 'Tên tiêu chí không được bỏ trống' }
        ];
        if (validateModalFormFields(form, fieldsToValidate)) {
            const csrfToken = $('input[name="__RequestVerificationToken"]').val();
            $.ajax({ url: '/QuanLyDanhMuc/DanhMucTieuChiDiem/Store', type: 'POST', headers: { 'RequestVerificationToken': csrfToken }, data: new FormData(form), processData: false, contentType: false, dataType: 'JSON',
                success: function (data) { data.status == 'success' ? (toastr.success(data.message), location.reload()) : toastr.error(data.message, "Lỗi!"); } });
        }
    }
    function Edit(idEdit) {
        const csrfToken = $('input[name="__RequestVerificationToken"]').val();
        $.ajax({ url: '/QuanLyDanhMuc/DanhMucTieuChiDiem/Edit', type: 'POST', headers: { 'RequestVerificationToken': csrfToken }, data: { id: idEdit },
            success: function (data) { $('#frm_edit').html(data); $('#Edit_Modal').modal('show'); },
            error: function () { toastr.error("Không thể tải dữ liệu!", "Lỗi!"); } });
    }
    function Update() {
        var form = document.getElementById('frm_edit');
        const fieldsToValidate = [
            { id: 'TieuChi_MaTieuChi', message: 'Mã tiêu chí không được bỏ trống' },
            { id: 'TieuChi_TenTieuChi', message: 'Tên tiêu chí không được bỏ trống' }
        ];
        if (validateModalFormFields(form, fieldsToValidate)) {
            const csrfToken = $('input[name="__RequestVerificationToken"]').val();
            $.ajax({ url: '/QuanLyDanhMuc/DanhMucTieuChiDiem/Update', type: 'POST', headers: { 'RequestVerificationToken': csrfToken }, data: new FormData(form), processData: false, contentType: false, dataType: 'JSON',
                success: function (data) { data.status == 'success' ? (toastr.success(data.message), location.reload()) : toastr.error(data.message, "Lỗi!"); } });
        }
    }
    function Delete(id, tenTieuChi) { document.getElementById('id_delete').value = id; document.getElementById('tentieuchi_delete').innerHTML = tenTieuChi; $('#Delete_Modal').modal('show'); }
</script>
