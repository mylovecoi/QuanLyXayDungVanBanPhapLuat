@using UI.ViewModels
@model DanhMucTieuChiDiemUpsertViewModel

<input asp-for="TieuChi.Id" type="hidden" />

<div class="row">
    <div class="col-xl-4">
        <div class="form-group">
            <label>Mã tiêu chí <span class="text-danger">*</span></label>
            <input asp-for="TieuChi.MaTieuChi" class="form-control" placeholder="Ví dụ: THOI_GIAN_XAY_DUNG" />
        </div>
    </div>
    <div class="col-xl-5">
        <div class="form-group">
            <label>Tên tiêu chí <span class="text-danger">*</span></label>
            <input asp-for="TieuChi.TenTieuChi" class="form-control" placeholder="Ví dụ: Thời gian xây dựng văn bản" />
        </div>
    </div>
    <div class="col-xl-3">
        <div class="form-group">
            <label>Thứ tự sắp xếp</label>
            <input asp-for="TieuChi.ThuTuSapXep" type="number" min="1" class="form-control" />
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-4">
        <div class="form-group">
            <label>Loại tiêu chí</label>
            <select asp-for="TieuChi.LoaiTieuChi" class="form-control">
                <option value="THOI_GIAN">Thời gian xây dựng</option>
                <option value="CHAT_LUONG">Chất lượng văn bản</option>
            </select>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="form-group">
            <label>Kiểu giá trị</label>
            <select asp-for="TieuChi.KieuGiaTri" class="form-control">
                <option value="TY_LE">Tỷ lệ</option>
                <option value="SO_LAN">Số lần</option>
            </select>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="form-group">
            <label>Đơn vị giá trị</label>
            <select asp-for="TieuChi.DonViGiaTri" class="form-control">
                <option value="PERCENT">%</option>
                <option value="COUNT">Lần</option>
                <option value="DAY">Ngày</option>
            </select>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-4">
        <div class="form-group">
            <label>Điểm tối đa</label>
            <input asp-for="TieuChi.DiemToiDa" type="number" step="0.01" min="0" class="form-control" />
        </div>
    </div>
    <div class="col-xl-4">
        <div class="form-group">
            <label>Trạng thái</label>
            <select asp-for="TieuChi.TrangThai" class="form-control">
                <option value="true">Kích hoạt</option>
                <option value="false">Ngừng sử dụng</option>
            </select>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-6">
        <div class="form-group">
            <label>Mô tả</label>
            <textarea asp-for="TieuChi.MoTa" class="form-control" rows="3"></textarea>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="form-group">
            <label>Ghi chú</label>
            <textarea asp-for="TieuChi.GhiChu" class="form-control" rows="3"></textarea>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mt-4 mb-2">
    <h5 class="mb-0">Thang điểm chi tiết</h5>
    <button type="button" class="btn btn-sm btn-light-primary" onclick="addMucDiemRow()">Thêm mức điểm</button>
</div>

<div class="table-responsive">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th width="8%">STT</th>
                <th>Từ giá trị</th>
                <th>Đến giá trị</th>
                <th>Bao gồm từ</th>
                <th>Bao gồm đến</th>
                <th>Điểm</th>
                <th>Nhãn hiển thị</th>
                <th>Trạng thái</th>
                <th width="8%"></th>
            </tr>
        </thead>
        <tbody id="mucDiemBody">
            @for (var i = 0; i < Model.Mucs.Count; i++)
            {
                <tr>
                    <td>
                        <input name="mucs[@i].Id" type="hidden" value="@Model.Mucs[i].Id" />
                        <input name="mucs[@i].ThuTuSapXep" type="number" min="1" class="form-control" value="@Model.Mucs[i].ThuTuSapXep" />
                    </td>
                    <td><input name="mucs[@i].TuGiaTri" type="number" step="0.01" class="form-control" value="@Model.Mucs[i].TuGiaTri" /></td>
                    <td><input name="mucs[@i].DenGiaTri" type="number" step="0.01" class="form-control" value="@Model.Mucs[i].DenGiaTri" /></td>
                    <td class="text-center">
                        <input type="hidden" name="mucs[@i].BaoGomTuGiaTri" value="false" />
                        <input name="mucs[@i].BaoGomTuGiaTri" type="checkbox" value="true" @(Model.Mucs[i].BaoGomTuGiaTri ? "checked" : null) />
                    </td>
                    <td class="text-center">
                        <input type="hidden" name="mucs[@i].BaoGomDenGiaTri" value="false" />
                        <input name="mucs[@i].BaoGomDenGiaTri" type="checkbox" value="true" @(Model.Mucs[i].BaoGomDenGiaTri ? "checked" : null) />
                    </td>
                    <td><input name="mucs[@i].Diem" type="number" step="0.01" min="0" class="form-control" value="@Model.Mucs[i].Diem" /></td>
                    <td><input name="mucs[@i].NhanHienThi" class="form-control" value="@Model.Mucs[i].NhanHienThi" /></td>
                    <td>
                        <select name="mucs[@i].TrangThai" class="form-control">
                            @if (Model.Mucs[i].TrangThai)
                            {
                                <option value="true" selected>Kích hoạt</option>
                                <option value="false">Ngừng</option>
                            }
                            else
                            {
                                <option value="true">Kích hoạt</option>
                                <option value="false" selected>Ngừng</option>
                            }
                        </select>
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-light-danger" onclick="$(this).closest('tr').remove();refreshMucDiemRows();">Xóa</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    function refreshMucDiemRows() {
        $('#mucDiemBody tr').each(function (i) {
            $(this).find('input, select, textarea').each(function () {
                const name = $(this).attr('name');
                if (!name) return;
                $(this).attr('name', name.replace(/mucs\[\d+\]/, `mucs[${i}]`));
            });
        });
    }

    function addMucDiemRow() {
        const i = $('#mucDiemBody tr').length;
        $('#mucDiemBody').append(`
            <tr>
                <td>
                    <input name="mucs[${i}].Id" type="hidden" value="00000000-0000-0000-0000-000000000000" />
                    <input name="mucs[${i}].ThuTuSapXep" type="number" min="1" class="form-control" value="${i + 1}" />
                </td>
                <td><input name="mucs[${i}].TuGiaTri" type="number" step="0.01" class="form-control" /></td>
                <td><input name="mucs[${i}].DenGiaTri" type="number" step="0.01" class="form-control" /></td>
                <td class="text-center"><input type="hidden" name="mucs[${i}].BaoGomTuGiaTri" value="false" /><input name="mucs[${i}].BaoGomTuGiaTri" type="checkbox" value="true" checked /></td>
                <td class="text-center"><input type="hidden" name="mucs[${i}].BaoGomDenGiaTri" value="false" /><input name="mucs[${i}].BaoGomDenGiaTri" type="checkbox" value="true" checked /></td>
                <td><input name="mucs[${i}].Diem" type="number" step="0.01" min="0" class="form-control" value="0" /></td>
                <td><input name="mucs[${i}].NhanHienThi" class="form-control" /></td>
                <td><select name="mucs[${i}].TrangThai" class="form-control"><option value="true" selected>Kích hoạt</option><option value="false">Ngừng</option></select></td>
                <td class="text-center"><button type="button" class="btn btn-sm btn-light-danger" onclick="$(this).closest('tr').remove();refreshMucDiemRows();">Xóa</button></td>
            </tr>`);
    }
</script>
