@using DataAccess.Entities.QuanLyDanhMuc
@using Services.QuanLyDanhMuc

@{
    var danhMucVanBans = ViewData["DanhMucVanBans"] as List<DanhMucVanBan> ?? new List<DanhMucVanBan>();
    var danhMucDonVis = ViewData["DanhMucDonVis"] as List<DataAccess.Entities.Settings.DanhMucDonVi> ?? new List<DataAccess.Entities.Settings.DanhMucDonVi>();
}

@model QuyTrinhSoanThaoEditModel

<input asp-for="Id" type="hidden" />
<input asp-for="PhienBan" type="hidden" />

<div class="row">
    <div class="col-xl-4">
        <div class="form-group">
            <label>Loại quy trình <span class="text-danger">*</span></label>
            <select asp-for="LoaiQuyTrinh" class="form-control">
                <option value="DangKy">Đăng ký</option>
                <option value="XayDung">Xây dựng</option>
            </select>
        </div>
    </div>
</div>

<div class="alert alert-light-info mb-5">
    Có thể sửa trực tiếp các bước quy trình, thêm bớt bước hoặc đổi nhánh chuyển bước ngay trong form này.
</div>

<div class="row">
    <div class="col-xl-3">
        <div class="form-group">
            <label>Mã quy trình <span class="text-danger">*</span></label>
            <input asp-for="MaQuyTrinh" class="form-control" placeholder="Ví dụ: QTSOANTHAO_TINH_01" />
        </div>
    </div>
    <div class="col-xl-5">
        <div class="form-group">
            <label>Tên quy trình <span class="text-danger">*</span></label>
            <input asp-for="TenQuyTrinh" class="form-control" placeholder="Ví dụ: Quy trình soạn thảo VB cấp tỉnh" />
        </div>
    </div>
    <div class="col-xl-4">
        <div class="form-group">
            <label>Cấp áp dụng</label>
            <select asp-for="CapApDungs" class="form-control select2multi workflow-multi-select" multiple data-placeholder="Chọn cấp áp dụng">
                <option value="Tinh">Tỉnh</option>
                <option value="Xa">Xã</option>
            </select>
            <small class="text-muted">Giữ phím Ctrl hoặc Shift để chọn nhiều cấp áp dụng.</small>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-8">
        <div class="form-group">
            <label>Loại văn bản</label>
            <select asp-for="DanhMucVanBanIds" class="form-control select2multi workflow-multi-select" multiple data-placeholder="Chọn loại văn bản">
                @foreach (var item in danhMucVanBans)
                {
                    <option value="@item.Id">@item.TenLoaiVanBan</option>
                }
            </select>
            <small class="text-muted">Chọn một hoặc nhiều loại văn bản áp dụng cho quy trình này.</small>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="form-group">
            <label>Theo dõi</label>
            <select asp-for="TrangThai" class="form-control">
                <option value="true">Kích hoạt</option>
                <option value="false">Ngừng sử dụng</option>
            </select>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-6">
        <div class="form-group">
            <label>Mô tả</label>
            <textarea asp-for="MoTa" class="form-control" rows="2" placeholder="Mô tả mục đích và phạm vi sử dụng quy trình"></textarea>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="form-group">
            <label>Ghi chú</label>
            <textarea asp-for="GhiChu" class="form-control" rows="2" placeholder="Ghi chú bổ sung"></textarea>
        </div>
    </div>
</div>

<div class="d-flex align-items-center justify-content-between mb-3">
    <h5 class="mb-0">Danh sách bước</h5>
    <button type="button" class="btn btn-sm btn-primary" onclick="addStepRow(this)">
        <i class="la la-plus"></i>Thêm bước
    </button>
</div>
<div class="table-responsive border rounded mb-6">
    <table class="table table-bordered table-sm m-0">
        <thead class="thead-light">
            <tr class="text-center">
                <th style="min-width:120px;">Mã bước</th>
                <th style="min-width:180px;">Tên bước</th>
                <th style="min-width:90px;">Thứ tự</th>
                <th style="min-width:120px;">Loại bước</th>
                <th style="min-width:110px;">Bắt buộc</th>
                <th style="min-width:120px;">Bỏ qua</th>
                <th style="min-width:130px;">Quay lùi</th>
                <th style="min-width:160px;">Cách hoàn thành</th>
                <th style="min-width:120px;">SL phản hồi</th>
                <th style="min-width:130px;">YC file</th>
                <th style="min-width:120px;">Số lần trả lại</th>
                <th style="min-width:120px;">Số ngày xử lý</th>
                <th style="min-width:130px;">Cảnh báo sắp hạn</th>
                <th style="min-width:190px;">Đơn vị tiếp nhận mặc định</th>
                <th style="min-width:150px;">Mô tả</th>
                <th style="min-width:150px;">Ghi chú</th>
                <th style="min-width:70px;">Xóa</th>
            </tr>
        </thead>
        <tbody class="workflow-steps-body">
            @for (var i = 0; i < Model.BuocQuyTrinhs.Count; i++)
            {
                <tr class="step-row">
                    <td>
                        <input type="hidden" name="BuocQuyTrinhs[@i].Id" value="@Model.BuocQuyTrinhs[i].Id" data-field="Id" />
                        <input name="BuocQuyTrinhs[@i].MaBuoc" value="@Model.BuocQuyTrinhs[i].MaBuoc" class="form-control form-control-sm" data-field="MaBuoc" />
                    </td>
                    <td><input name="BuocQuyTrinhs[@i].TenBuoc" value="@Model.BuocQuyTrinhs[i].TenBuoc" class="form-control form-control-sm" data-field="TenBuoc" /></td>
                    <td><input name="BuocQuyTrinhs[@i].ThuTuSapXep" value="@Model.BuocQuyTrinhs[i].ThuTuSapXep" type="number" min="1" class="form-control form-control-sm" data-field="ThuTuSapXep" /></td>
                    <td>
                        <select name="BuocQuyTrinhs[@i].LoaiBuoc" class="form-control form-control-sm" data-field="LoaiBuoc">
                            <option value="KhoiTao" selected="@(Model.BuocQuyTrinhs[i].LoaiBuoc == "KhoiTao")">Khởi tạo</option>
                            <option value="PheDuyet" selected="@(Model.BuocQuyTrinhs[i].LoaiBuoc == "PheDuyet")">Phê duyệt</option>
                            <option value="XuLy" selected="@(Model.BuocQuyTrinhs[i].LoaiBuoc == "XuLy")">Xử lý</option>
                            <option value="LayYKien" selected="@(Model.BuocQuyTrinhs[i].LoaiBuoc == "LayYKien")">Lấy ý kiến</option>
                            <option value="DanhGia" selected="@(Model.BuocQuyTrinhs[i].LoaiBuoc == "DanhGia")">Đánh giá</option>
                            <option value="TrinhKy" selected="@(Model.BuocQuyTrinhs[i].LoaiBuoc == "TrinhKy")">Trình ký</option>
                            <option value="BanHanh" selected="@(Model.BuocQuyTrinhs[i].LoaiBuoc == "BanHanh")">Ban hành</option>
                        </select>
                    </td>
                    <td>
                        <select name="BuocQuyTrinhs[@i].BatBuoc" class="form-control form-control-sm" data-field="BatBuoc">
                            <option value="true" selected="@Model.BuocQuyTrinhs[i].BatBuoc">Có</option>
                            <option value="false" selected="@(!Model.BuocQuyTrinhs[i].BatBuoc)">Không</option>
                        </select>
                    </td>
                    <td>
                        <select name="BuocQuyTrinhs[@i].ChoPhepBoQua" class="form-control form-control-sm" data-field="ChoPhepBoQua">
                            <option value="true" selected="@Model.BuocQuyTrinhs[i].ChoPhepBoQua">Có</option>
                            <option value="false" selected="@(!Model.BuocQuyTrinhs[i].ChoPhepBoQua)">Không</option>
                        </select>
                    </td>
                    <td>
                        <select name="BuocQuyTrinhs[@i].ChoPhepQuayLui" class="form-control form-control-sm" data-field="ChoPhepQuayLui">
                            <option value="true" selected="@Model.BuocQuyTrinhs[i].ChoPhepQuayLui">Có</option>
                            <option value="false" selected="@(!Model.BuocQuyTrinhs[i].ChoPhepQuayLui)">Không</option>
                        </select>
                    </td>
                    <td><input name="BuocQuyTrinhs[@i].CachHoanThanh" value="@Model.BuocQuyTrinhs[i].CachHoanThanh" class="form-control form-control-sm" data-field="CachHoanThanh" /></td>
                    <td><input name="BuocQuyTrinhs[@i].SoLuongPhanHoiToiThieu" value="@Model.BuocQuyTrinhs[i].SoLuongPhanHoiToiThieu" type="number" min="0" class="form-control form-control-sm" data-field="SoLuongPhanHoiToiThieu" /></td>
                    <td>
                        <select name="BuocQuyTrinhs[@i].YeuCauFileDinhKem" class="form-control form-control-sm" data-field="YeuCauFileDinhKem">
                            <option value="true" selected="@Model.BuocQuyTrinhs[i].YeuCauFileDinhKem">Có</option>
                            <option value="false" selected="@(!Model.BuocQuyTrinhs[i].YeuCauFileDinhKem)">Không</option>
                        </select>
                    </td>
                    <td><input name="BuocQuyTrinhs[@i].SoLanTraLaiToiDa" value="@Model.BuocQuyTrinhs[i].SoLanTraLaiToiDa" type="number" min="0" class="form-control form-control-sm" data-field="SoLanTraLaiToiDa" /></td>
                    <td><input name="BuocQuyTrinhs[@i].SoNgayXuLyTieuChuan" value="@Model.BuocQuyTrinhs[i].SoNgayXuLyTieuChuan" type="number" min="1" class="form-control form-control-sm" data-field="SoNgayXuLyTieuChuan" /></td>
                    <td><input name="BuocQuyTrinhs[@i].SoNgayCanhBaoSapHan" value="@Model.BuocQuyTrinhs[i].SoNgayCanhBaoSapHan" type="number" min="0" class="form-control form-control-sm" data-field="SoNgayCanhBaoSapHan" /></td>
                    <td>
                        <select name="BuocQuyTrinhs[@i].DonViTiepNhanMacDinhId" class="form-control form-control-sm" data-field="DonViTiepNhanMacDinhId">
                            <option value="">-- Không cấu hình --</option>
                            @foreach (var donVi in danhMucDonVis)
                            {
                                <option value="@donVi.Id" selected="@(Model.BuocQuyTrinhs[i].DonViTiepNhanMacDinhId == donVi.Id)">@donVi.TenDonVi</option>
                            }
                        </select>
                    </td>
                    <td><input name="BuocQuyTrinhs[@i].MoTa" value="@Model.BuocQuyTrinhs[i].MoTa" class="form-control form-control-sm" data-field="MoTa" /></td>
                    <td><input name="BuocQuyTrinhs[@i].GhiChu" value="@Model.BuocQuyTrinhs[i].GhiChu" class="form-control form-control-sm" data-field="GhiChu" /></td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-clean btn-icon text-danger" onclick="removeWorkflowRow(this)">
                            <i class="la la-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex align-items-center justify-content-between mb-3">
    <h5 class="mb-0">Nhánh chuyển bước</h5>
    <button type="button" class="btn btn-sm btn-primary" onclick="addTransitionRow(this)">
        <i class="la la-plus"></i>Thêm nhánh
    </button>
</div>
<div class="table-responsive border rounded">
    <table class="table table-bordered table-sm m-0">
        <thead class="thead-light">
            <tr class="text-center">
                <th style="min-width:130px;">Từ mã bước</th>
                <th style="min-width:130px;">Đến mã bước</th>
                <th style="min-width:150px;">Điều kiện kết quả</th>
                <th style="min-width:120px;">Nhánh mặc định</th>
                <th style="min-width:180px;">Mô tả</th>
                <th style="min-width:180px;">Ghi chú</th>
                <th style="min-width:70px;">Xóa</th>
            </tr>
        </thead>
        <tbody class="workflow-transitions-body">
            @for (var i = 0; i < Model.ChuyenBuocs.Count; i++)
            {
                <tr class="transition-row">
                    <td>
                        <input type="hidden" name="ChuyenBuocs[@i].Id" value="@Model.ChuyenBuocs[i].Id" data-field="Id" />
                        <input name="ChuyenBuocs[@i].TuBuocMa" value="@Model.ChuyenBuocs[i].TuBuocMa" class="form-control form-control-sm" data-field="TuBuocMa" />
                    </td>
                    <td><input name="ChuyenBuocs[@i].DenBuocMa" value="@Model.ChuyenBuocs[i].DenBuocMa" class="form-control form-control-sm" data-field="DenBuocMa" /></td>
                    <td><input name="ChuyenBuocs[@i].DieuKienKetQua" value="@Model.ChuyenBuocs[i].DieuKienKetQua" class="form-control form-control-sm" data-field="DieuKienKetQua" /></td>
                    <td>
                        <select name="ChuyenBuocs[@i].LaNhanhMacDinh" class="form-control form-control-sm" data-field="LaNhanhMacDinh">
                            <option value="true" selected="@Model.ChuyenBuocs[i].LaNhanhMacDinh">Có</option>
                            <option value="false" selected="@(!Model.ChuyenBuocs[i].LaNhanhMacDinh)">Không</option>
                        </select>
                    </td>
                    <td><input name="ChuyenBuocs[@i].MoTa" value="@Model.ChuyenBuocs[i].MoTa" class="form-control form-control-sm" data-field="MoTa" /></td>
                    <td><input name="ChuyenBuocs[@i].GhiChu" value="@Model.ChuyenBuocs[i].GhiChu" class="form-control form-control-sm" data-field="GhiChu" /></td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-clean btn-icon text-danger" onclick="removeWorkflowRow(this)">
                            <i class="la la-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-3 text-muted font-size-sm">
    Gợi ý:
    <span class="d-block">- "Số ngày xử lý" là hạn tiêu chuẩn của từng bước; khi hồ sơ vào bước, hệ thống sẽ tự tính hạn xử lý.</span>
    <span class="d-block">- "Cảnh báo sắp hạn" là số ngày trước hạn để chuyển sang màu vàng trên màn hình theo dõi.</span>
    <span class="d-block">- "Đơn vị tiếp nhận mặc định" dùng để định sẵn đơn vị nhận xử lý khi hồ sơ chuyển vào bước.</span>
    <span class="d-block">- Bước "LayYKien" nên có SoLuongPhanHoiToiThieu và có thể bật YeuCauFileDinhKem.</span>
    <span class="d-block">- Bước "DanhGia" có thể đặt SoLanTraLaiToiDa = 3 và nhánh "KHONG_DAT" trở về "SOAN_THAO".</span>
    <span class="d-block">- Ở nhánh chuyển bước, nhập đúng Mã bước để liên kết chính xác.</span>
</div>

<div class="d-flex justify-content-end mt-6">
    <a class="btn btn-light-secondary mr-3" href="@Url.Action("Index", "QuyTrinhSoanThao", new { area = "Admin" })">
        Quay lại danh sách
    </a>
    <button type="submit" class="btn btn-primary">
        <i class="la la-save"></i>Lưu dữ liệu
    </button>
</div>
