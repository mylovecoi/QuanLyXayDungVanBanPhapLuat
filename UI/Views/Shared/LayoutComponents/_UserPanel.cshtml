@{
    var session = HttpContextAccessor?.HttpContext?.Session ?? null;
}

<!--begin::Header-->
<div class="offcanvas-header d-flex align-items-center justify-content-between pb-5">
    <h3 class="font-weight-bold m-0">
        @if (session != null && !string.IsNullOrEmpty(session.GetString("SsAdmin")))
        {
            <span>Thông tin tài khoản</span>
        }
        else
        {
            <span>Bạn chưa đăng nhập hệ thống</span>
        }
        <small class="text-muted font-size-sm ml-2"></small>
    </h3>
    <a href="#" class="btn btn-xs btn-icon btn-light btn-hover-primary" id="kt_quick_user_close">
        <i class="ki ki-close icon-xs text-muted"></i>
    </a>
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="offcanvas-content pr-5 mr-n5">
    <!--begin::Header-->
    <div class="d-flex align-items-center mt-5">
        <div class="symbol symbol-100 mr-5">
            <div class="symbol-label">
                <img src="@Url.Content("~/FileUpload/Avatar/default-user.png")"
                     width="100" height="100" />
                <i class="symbol-badge bg-primary"></i>
            </div>
        </div>
        <div class="d-flex flex-column">
            <a href="#" class="font-weight-bold font-size-h5 text-dark-75 text-hover-primary">
                @if (session != null && !string.IsNullOrEmpty(session.GetString("SsAdmin")))
                {
                    <span>@FuntionGlobal.GetSsAdmin(session, "Name")</span>
                }
                else
                {
                    <span>Chưa xác định</span>
                }
            </a>
            <div class="text-muted mt-1">
                @if (session != null && !string.IsNullOrEmpty(session.GetString("SsAdmin")))
                {
                    <span>@FuntionGlobal.GetSsAdmin(session, "Username")</span>
                }
                else
                {
                    <span>Chưa xác định</span>
                }
            </div>
            <div class="navi mt-2">
                <a href="#" class="navi-item">
                    <span class="navi-link p-0 pb-2">
                        <span class="navi-icon mr-1">
                            <span class="svg-icon svg-icon-lg svg-icon-primary">
                                <!--begin::Svg Icon | path:assets/media/svg/icons/Communication/Mail-notification.svg-->
                                <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1">
                                    <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                        <rect x="0" y="0" width="24" height="24" />
                                        <path d="M21,12.0829584 C20.6747915,12.0283988 20.3407122,12 20,12 C16.6862915,12 14,14.6862915 14,18 C14,18.3407122 14.0283988,18.6747915 14.0829584,19 L5,19 C3.8954305,19 3,18.1045695 3,17 L3,8 C3,6.8954305 3.8954305,6 5,6 L19,6 C20.1045695,6 21,6.8954305 21,8 L21,12.0829584 Z M18.1444251,7.83964668 L12,11.1481833 L5.85557487,7.83964668 C5.4908718,7.6432681 5.03602525,7.77972206 4.83964668,8.14442513 C4.6432681,8.5091282 4.77972206,8.96397475 5.14442513,9.16035332 L11.6444251,12.6603533 C11.8664074,12.7798822 12.1335926,12.7798822 12.3555749,12.6603533 L18.8555749,9.16035332 C19.2202779,8.96397475 19.3567319,8.5091282 19.1603533,8.14442513 C18.9639747,7.77972206 18.5091282,7.6432681 18.1444251,7.83964668 Z" fill="#000000" />
                                        <circle fill="#000000" opacity="0.3" cx="19.5" cy="17.5" r="2.5" />
                                    </g>
                                </svg>
                                <!--end::Svg Icon-->
                            </span>
                        </span>
                        <span class="navi-text text-muted text-hover-primary">
                            @if (session != null && !string.IsNullOrEmpty(session.GetString("SsAdmin")))
                            {
                                <span>@FuntionGlobal.GetSsAdmin(session, "Email")</span>
                            }
                            else
                            {
                                <span>Chưa xác định</span>
                            }
                        </span>
                    </span>
                </a>
                @if (session != null && !string.IsNullOrEmpty(session.GetString("SsAdmin")))
                {
                    <a asp-controller="Auth" asp-action="Logout" class="btn btn-sm btn-light-danger font-weight-bolder py-2 px-5">Đăng xuất</a>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-sm btn-light-primary font-weight-bolder py-2 px-5">Đăng nhập</a>
                }
            </div>
        </div>
    </div>
    <!--end::Header-->
    <!--begin::Separator-->
    <div class="separator separator-dashed mt-8 mb-5"></div>
    <!--end::Separator-->
    <!--begin::Nav-->
    @if (session != null && !string.IsNullOrEmpty(session.GetString("SsAdmin")))
    {
        <div class="navi navi-spacer-x-0 p-0">
            <a asp-controller="Home" asp-action="ChangePassword" class="navi-item">
                <div class="navi-link">
                    <div class="symbol symbol-40 bg-light mr-3">
                        <div class="symbol-label">
                            <span class="svg-icon svg-icon-md svg-icon-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1">
