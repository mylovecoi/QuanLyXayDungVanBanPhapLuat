                                </svg>
                            </span>
                        </div>
                    </div>
                    <div class="navi-text">
                        <div>
                            <div class="font-weight-bold">Tài liệu hướng dẫn</div>
                            <div class="text-muted">
                                Thông tin tài liệu hướng dẫn
                                <span class="label label-light-success label-inline font-weight-bold">Tải về</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Danh sách file tải -->
                <div class="dropdown-menu bg-light-dark">
                    <a class="dropdown-item hover-bg-primary hover-text-white"
                       href="~/FileUpload/HDSD/HuongDanSuDung_PM CCCT.pdf" download=download>
                        📄 Hướng dẫn sử dụng
                    </a>
                    <a class="dropdown-item hover-bg-primary hover-text-white"
                       href="~/FileUpload/HDSD/HuongDanCaiDatAgent_CCCT.pdf" download=download>
                        ⚙️ Cài đặt kết nối máy scan 
                    </a>
                </div>
            </div>

            <div class="separator separator-dashed my-7"></div>
            <div>
                <!--begin:Heading-->
                <h3 class="font-weight-bold m-0">
                    Thông tin báo cáo thống kê
                    <small class="text-muted font-size-sm ml-2"></small>
                </h3>
                <br />
                <!--end:Heading-->
                <!--begin::Item-->
                <div class="d-flex align-items-center bg-light-info rounded p-5">
                    <div class="d-flex flex-column flex-grow-1 mr-2">
                        <span class="font-weight-normel text-dark-75 text-hover-primary font-size-lg mb-1">Tên đơn vị: </span>
                        <span class="font-size-sm" style="color:blue">
                            @if (session != null && !string.IsNullOrEmpty(session.GetString("SsAdmin")))
                            {
                                @Html.Raw(FuntionGlobal.GetSsAdmin(session, "TenDonViBaoCao"))
                            }
                        </span>
                        <span class="font-weight-normel text-dark-75 text-hover-primary font-size-lg mb-1">Tên đơn vị chủ quản: </span>
                        <span class="font-size-sm" style="color:blue">
                            @if (session != null && !string.IsNullOrEmpty(session.GetString("SsAdmin")))
                            {
                                @Html.Raw(FuntionGlobal.GetSsAdmin(session, "TenDonViChuQuanBaoCao"))
                            }
                        </span>
                        <span class="font-weight-normel text-dark-75 text-hover-primary font-size-lg mb-1">Địa danh: </span>
                        <span class="font-size-sm" style="color:blue">
                            @if (session != null && !string.IsNullOrEmpty(session.GetString("SsAdmin")))
                            {
                                @FuntionGlobal.GetSsAdmin(session, "DiaDanh")
                            }
                        </span>
                        <span class="font-weight-normel text-dark-75 text-hover-primary font-size-lg mb-1">Chức danh người ký: </span>
                        <span class="font-size-sm" style="color:blue">
                            @if (session != null && !string.IsNullOrEmpty(session.GetString("SsAdmin")))
                            {
                                @Html.Raw(FuntionGlobal.GetSsAdmin(session, "ChucDanhKy"))
                            }
                        </span>
                        <span class="font-weight-normel text-dark-75 text-hover-primary font-size-lg mb-1">Họ và tên người ký: </span>
                        <span class="font-size-sm" style="color:blue">
                            @if (session != null && !string.IsNullOrEmpty(session.GetString("SsAdmin")))
                            {
                                @FuntionGlobal.GetSsAdmin(session, "HoTenNguoiKy")
                            }
                        </span>
                        <br />
                        <a asp-controller="Home" asp-action="UserInfo" class="btn btn-transparent-primary mr-2">Cập nhật</a>
                    </div>
