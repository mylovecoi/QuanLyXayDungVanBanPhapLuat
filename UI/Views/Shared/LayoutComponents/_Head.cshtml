@{
    var session = HttpContextAccessor?.HttpContext?.Session ?? null;
    string Title = ViewData["Title"]?.ToString() ?? "";

    // use theme from ViewBag set in layout; fallback to light
    var theme = (ViewBag.Theme as string) ?? "light";
    theme = string.IsNullOrEmpty(theme) ? "light" : theme.ToLower();
}
<base href="">
<meta charset="utf-8" />
<title>@Title | LifeSoft</title>
<meta name="description" content="" />
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
