<!--begin::Chat Panel-->
<div class="modal modal-sticky modal-sticky-bottom-right" id="kt_chat_modal" data-backdrop="false" aria-modal="true" role="dialog"
     style="display: none; padding-right: 15px; border: 1px solid blue;">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <!--begin::Card-->
            <div class="card card-custom">
                <!--begin::Header-->
                <div class="card-header align-items-center px-4 py-3">
                    <div class="text-center flex-grow-1">
                        <div class="text-dark-75 font-weight-bold font-size-h5">Chat Bot</div>
                        <div>
                            <span class="label label-dot label-success"></span>
                            <span class="font-weight-bold text-muted font-size-sm">Đang hoạt động</span>
                        </div>
                    </div>
                    <div class="text-right flex-grow-1">
                        <button type="button" class="btn btn-clean btn-sm btn-icon btn-icon-md" data-dismiss="modal">
                            <i class="ki ki-close icon-1x"></i>
                        </button>
                    </div>
                </div>
                <!--end::Header-->
                <!--begin::Body-->
                <div class="card-body">
                    <div class="scroll" data-height="375" data-mobile-height="300" style="height: 375px; overflow-y: auto;" id="chatScrollContainer">
                        <div class="messages">
                            <!-- Tin nhắn chào Bot -->
                            <div class="d-flex flex-column mb-5 align-items-start">
                                <div class="d-flex align-items-center">
                                    <div>
                                        <a href="#" class="text-dark-75 text-hover-primary font-weight-bold font-size-h6">Bot</a>
                                    </div>
                                </div>
                                <div class="mt-2 rounded p-5 bg-light-success text-dark-50 font-weight-bold font-size-lg text-left max-w-400px">
                                    Xin chào! Tôi có thể giúp gì cho bạn?
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!--end::Body-->
                <!--begin::Footer-->
                <div class="card-footer align-items-center">
                    <textarea class="form-control border-0 p-0" id="txtQuestionForBot" rows="2" placeholder="Nhập tin nhắn..."></textarea>
                    <div class="d-flex align-items-center justify-content-between mt-5">
                        <div></div>
                        <div>
                            <button type="button" class="btn btn-primary btn-md text-uppercase font-weight-bold py-2 px-6" onclick="sendChatBot()">
                                Gửi
                            </button>
                        </div>
                    </div>
                </div>
                <!--end::Footer-->
            </div>
        </div>
    </div>
</div>
<!--end::Chat Panel-->
<script>
    // Gửi tin nhắn
    function sendChatBot() {
        var moTa = document.getElementById('txtQuestionForBot').value.trim();
        if (moTa === "") return;

        addUserMessage(moTa);

        fetch('/Systems/ChatBot/GetQuestions?moTa=' + encodeURIComponent(moTa))
            .then(response => response.json())
            .then(data => {
                if (data.status === "success" && data.data.length > 0) {
                    let buttonsHtml = data.data.map(item => {
                        return `<button type="button" class="btn btn-light-primary btn-sm font-weight-bold mt-2 mr-2 suggestion-btn" data-id="${item.id}">${item.question}</button>`;
                    }).join("");

                    addBotMessage(`Có phải bạn muốn hỏi về vấn đề này, chọn một nhé:<br><div class="mt-3">${buttonsHtml}</div>`);

                    bindSuggestionEvents();
                } else {
                    addBotMessage("Xin lỗi, tôi chưa tìm thấy thông tin câu hỏi của bạn.");
                }
            });

        document.getElementById('txtQuestionForBot').value = "";
    }

    // Thêm tin nhắn người dùng
    function addUserMessage(content) {
        var messages = document.querySelector('.messages');
        messages.innerHTML += `
        <div class="d-flex flex-column mb-5 align-items-end">
            <div class="d-flex align-items-center">
                <div>
                    <a href="#" class="text-dark-75 text-hover-primary font-weight-bold font-size-h6">Bạn</a>
                </div>
            </div>
            <div class="mt-2 rounded p-5 bg-light-primary text-dark-50 font-weight-bold font-size-lg text-right max-w-400px">
                ${content}
            </div>
        </div>`;
        scrollToBottom();
    }

    // Thêm tin nhắn Bot
    function addBotMessage(content) {
        var messages = document.querySelector('.messages');
        // Tạo phần tử message mới
        var messageWrapper = document.createElement('div');
        messageWrapper.className = 'd-flex flex-column mb-5 align-items-start';

        var headerHtml = `
        <div class="d-flex align-items-center">
            <div>
                <a href="#" class="text-dark-75 text-hover-primary font-weight-bold font-size-h6">Bot</a>
            </div>
        </div>
        `;

        var contentHtml = `
        <div class="mt-2 rounded p-5 bg-light-success text-dark-50 font-weight-bold font-size-lg text-left max-w-400px">
            ${content}
        </div>
        `;

        messageWrapper.innerHTML = headerHtml + contentHtml;

        messages.appendChild(messageWrapper);
        scrollToBottom();
    }


    function scrollToBottom() {
        var scrollContainer = document.getElementById('chatScrollContainer');;
        scrollContainer.scrollTop = scrollContainer.scrollHeight;
    }

    // Gán sự kiện click cho các nút gợi ý (xoá sự kiện cũ trước khi gán mới)
    function bindSuggestionEvents() {
        document.querySelectorAll('.suggestion-btn').forEach(btn => {
            btn.removeEventListener('click', handleSuggestionClick);
            btn.addEventListener('click', handleSuggestionClick);
        });
    }

    // Hàm xử lý khi click vào câu hỏi gợi ý
    function handleSuggestionClick() {
        //var id = this.getAttribute('data-id');
        //fetch('/Systems/ChatBot/GetAnswer/' + id)
        //    .then(res => res.json())
        //    .then(resData => {
        //        addBotMessage(resData.data);
        //    });
        var id = this.getAttribute('data-id');
        var questionText = this.innerText;

        // Hiển thị lại câu hỏi này như là của "Bạn"
        addUserMessage(questionText);

        // Gọi API lấy câu trả lời
        fetch('/Systems/ChatBot/GetAnswer/' + id)
            .then(res => res.json())
            .then(resData => {
                addBotMessage(resData.data);
            });

        // Xoá cụm suggestion
        const suggestionGroup = document.getElementById(sgid);
        if (suggestionGroup) suggestionGroup.remove();
    }

    // Enter để gửi
    document.getElementById('txtQuestionForBot').addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendChatBot();
        }
    });

</script>