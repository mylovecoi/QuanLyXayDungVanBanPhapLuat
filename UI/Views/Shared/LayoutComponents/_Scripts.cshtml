    function MoneyDecimalMask() {
        $('.money-decimal-mask').inputmask({
            alias: 'numeric',
            groupSeparator: '.',
            radixPoint: ',', // Dấu phân cách thập phân
            autoGroup: true,
            allowMinus: false, // Không cho phép nhập số âm
            digits: 3, // Số lượng chữ số thập phân
            placeholder: "0",
            rightAlign: true, // Căn lề sang phải
            onBeforePaste: function (pastedValue, opts) {
                // Xử lý trường hợp khi người dùng dán giá trị vào input
                var processedValue = pastedValue.replace(/[^0-9,]/g, ''); // Loại bỏ các ký tự không phải là số hoặc dấu phân cách
                return processedValue;
            }
        });
    }

    function DateMask() {
        $('.date-mask').inputmask({
            mask: "99/99/9999", // Định dạng mặt nạ cơ bản cho ngày tháng năm
            placeholder: 'dd/mm/yyyy', // Hướng dẫn định dạng
            clearMaskOnLostFocus: false, // Giữ mặt nạ khi mất focus
            showMaskOnHover: false, // Không hiển thị mặt nạ khi hover
            definitions: {
                '9': { validator: "[0-9]", cardinality: 1 } // Định nghĩa ký tự là chữ số
            },
            oninput: function (e) {
                const input = $(e.target);
                const value = input.val();
                let caretPos = e.target.selectionStart;

                // Thêm dấu phân cách tự động
                if (value.length === 2 || value.length === 5) {
                    // Thêm dấu phân cách tự động
                    input.val(value + '/');
                    caretPos++;
                    e.target.selectionStart = caretPos;
                    e.target.selectionEnd = caretPos;
                }

                // Kiểm tra tính hợp lệ của ngày và tháng
                const [day, month, year] = value.split('/').map(part => parseInt(part, 10));

                if (day > 31 || day < 1) {
                    input.css('border', '1px solid red'); // Đánh dấu trường hợp ngày không hợp lệ
                } else if (month > 12 || month < 1) {
                    input.css('border', '1px solid red'); // Đánh dấu trường hợp tháng không hợp lệ
                } else {
                    input.css('border', ''); // Xóa đánh dấu nếu ngày tháng hợp lệ
                }

                // Tuỳ chọn: Nếu cần xử lý năm
                if (year && year.toString().length === 4) {
                    // Nếu cần kiểm tra năm, thêm logic ở đây
                }
            }
        });
    }

    function CustomDateMask() {
        $('.custom-date-mask').inputmask({
            mask: ["99/99/9999"],
            placeholder: "__/__/____",  // sửa placeholder để hiển thị đúng
            showMaskOnHover: false,
            showMaskOnFocus: true,
            //keepStatic: true,
            positionCaretOnClick: "lvp",
            onBeforePaste: function (pastedValue, opts) {
                var cleanValue = pastedValue.replace(/\D/g, '');
                if (cleanValue.length === 8) {
                    return cleanValue.replace(/^(\d{2})(\d{2})(\d{4})$/, "$1/$2/$3");
                }
                if (cleanValue.length === 6) {
                    var m = cleanValue.substring(0, 2);
                    var y = cleanValue.substring(2, 6);
                    return "__/" + m + "/" + y;
                }
                if (cleanValue.length === 4) {
                    return "__/__/" + cleanValue;
                }
                return pastedValue;
            }
        });

        // Validate sau khi nhập xong hoặc dán
        $('.custom-date-mask').on('blur', function () {
            var value = $(this).val();
            if (value === "") return;

            var parts = value.split('/');
            var isValid = true;

            if (parts.length === 3) {
                // dd/mm/yyyy
                var d = parseInt(parts[0], 10);
                var m = parseInt(parts[1], 10);
                var y = parseInt(parts[2], 10);

                if (d < 1 || d > 31 || m < 1 || m > 12 || y < 1900 || y > 2100) {
                    isValid = false;
                }
            } else if (parts.length === 2) {
                // mm/yyyy
                var m = parseInt(parts[0], 10);
                var y = parseInt(parts[1], 10);

                if (m < 1 || m > 12 || y < 1900 || y > 2100) {
                    isValid = false;
                }
            } else if (parts.length === 1) {
                // yyyy
                var y = parseInt(parts[0], 10);
                if (y < 1900 || y > 2100) {
                    isValid = false;
                }
            } else {
                isValid = false;
            }

            if (!isValid) {
                alert("Ngày nhập không hợp lệ. Vui lòng kiểm tra lại!");
                $(this).val('').focus();
            }
        });
    }
    function display_ct6() {
        var x = new Date()
        var month = x.getMonth() + 1;
        var date = x.getDate();
        var year = x.getFullYear();
        var hour = x.getHours();
        var minute = x.getMinutes();
        var second = x.getSeconds();

        if (date < 10) { date = '0' + date }
        if (month < 10) { month = '0' + month }
        if (hour < 10) { hour = '0' + hour }
        if (minute < 10) { minute = '0' + minute }
        if (second < 10) { second = '0' + second }

        var x1 = date + "/" + month + "/" + year;
        x1 = x1 + " - " + hour + ":" + minute + ":" + second;
        document.getElementById('ct6').innerHTML = x1;
        display_c6();
    }
    function display_c6() {
        var refresh = 1000; // Refresh rate in milli seconds
        mytime = setTimeout('display_ct6()', refresh)
    }
    display_c6()

    // Begin::Notification scripts
    let hasUnread = false;
    let shakeInterval;
    let lastNotificationCount = null;
    let isNotificationPreviewLoaded = false;

    function updateNotificationCount(count, canToast = false) {
        const badge = document.getElementById("notification-badge");
        hasUnread = count > 0;

        if (hasUnread) {
            badge.textContent = count > 5 ? "5+" : count;
            badge.style.display = "flex";

            if (!shakeInterval) {
                startShakingLoop();
            }
        } else {
            badge.style.display = "none";
            stopShakingLoop();
        }

        if (canToast && lastNotificationCount !== null && count > lastNotificationCount) {
            const soThongBaoMoi = count - lastNotificationCount;
            toastr.info(`Bạn có ${soThongBaoMoi} thông báo mới từ đơn vị gửi hồ sơ.`, "Thông báo");
        }

        lastNotificationCount = count;
    }

    function shakeBell() {
        const bell = document.getElementById("notification-bell");
        if (!hasUnread || !bell) return;

        bell.classList.add("shake-animation");

        setTimeout(() => {
            bell.classList.remove("shake-animation");
        }, 3000);
    }

    function startShakingLoop() {
        shakeBell();
        shakeInterval = setInterval(shakeBell, 30000); // Lắc mỗi 30 giây
    }

    function stopShakingLoop() {
        clearInterval(shakeInterval);
        shakeInterval = null;
    }

    // Gọi API để lấy số lượng thông báo chưa đọc
    function fetchUnreadNotifications() {
        fetch("/Manages/Notification/Count")
            .then(response => response.json())
            .then(data => {
                updateNotificationCount(data.count || 0, true);
            })
            .catch(error => console.error("Lỗi khi tải thông báo:", error));
    }

    function escapeHtml(value) {
        return (value || "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#39;");
    }

    function renderNotificationPreview(items) {
        const container = document.getElementById("notification-preview-list");
        if (!container) {
            return;
        }

        if (!items || items.length === 0) {
            container.innerHTML = '<div class="px-4 py-6 text-center text-muted">Chưa có thông báo nào.</div>';
            return;
        }

        const rows = items.map(item => {
            const mainUrl = item.urlXetDuyet || item.urlDanhSach || "/Manages/Notifications";
            const statusBadge = item.daXem
                ? '<span class="label label-light-info label-inline font-weight-bold">Đã xem</span>'
                : '<span class="label label-warning label-inline font-weight-bold">Chưa xem</span>';

            return `
                <a href="${mainUrl}" class="d-block text-dark text-hover-primary px-4 py-3 border-bottom notification-preview-item">
                    <div class="d-flex align-items-start justify-content-between mb-2">
                        <div class="font-weight-bolder mr-3">${escapeHtml(item.tenDonViGuiThongBao || "Đơn vị gửi")}</div>
                        ${statusBadge}
                    </div>
                    <div class="text-muted font-size-sm mb-2">${escapeHtml(item.noiDung || "")}</div>
                    <div class="font-size-xs text-muted">${escapeHtml(item.createdDate || "")}</div>
                </a>`;
        });

        container.innerHTML = rows.join("");
    }

    function fetchLatestNotifications(forceRefresh = false) {
        const container = document.getElementById("notification-preview-list");
        if (!container) {
            return;
        }

        if (!forceRefresh && isNotificationPreviewLoaded) {
            return;
        }

        container.innerHTML = '<div class="px-4 py-6 text-center text-muted">Đang tải thông báo...</div>';
        fetch("/Manages/Notification/Latest?top=5")
            .then(response => response.json())
            .then(data => {
                if (data.status !== "success") {
                    container.innerHTML = '<div class="px-4 py-6 text-center text-danger">Không tải được thông báo.</div>';
                    return;
                }

                renderNotificationPreview(data.data || []);
                isNotificationPreviewLoaded = true;
            })
            .catch(error => {
                console.error("Lỗi khi tải danh sách thông báo:", error);
                container.innerHTML = '<div class="px-4 py-6 text-center text-danger">Không tải được thông báo.</div>';
            });
    }

    // begin :: signalR
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/RequestHub", {
            transport: signalR.HttpTransportType.WebSockets, // Ưu tiên WebSockets
            withCredentials: true // Nếu server cần xác thực
        })
        //.configureLogging(signalR.LogLevel.None) // Tắt log hoàn toàn
        .configureLogging(signalR.LogLevel.Error) // Chỉ hiển thị lỗi
        .build();


    // Kết nối đến SignalR
    connection.start().then(() => {
        //console.log("Connected to SignalR!");
    }).catch(err => console.error(err));

    // Nhận tín hiệu từ SignalR và cập nhật số thông báo
    connection.on("ReceiveUpdate", () => {
        // console.log("Có cập nhật mới, gọi API để lấy số thông báo...");
        fetchUnreadNotifications();
        fetchLatestNotifications(true);
    });
    //end :: signalR
    // End::Notification scripts

    document.addEventListener("DOMContentLoaded", function () {
        $('#notificationDropdownToggle').on('click', function (e) {
            e.preventDefault();
            fetchLatestNotifications(true);
        });

        $('#imageCarousel').carousel({
            interval: 3000,
            ride: 'carousel'
        });
    });
</script>
