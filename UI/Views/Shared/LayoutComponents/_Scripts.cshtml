<script>
    $(document).ready(function () {
        if (typeof KTHeader !== 'undefined' && document.getElementById('kt_header')) {
            new KTHeader('kt_header', {
                offset: {
                    desktop: 200,
                    tabletAndMobile: 300
                }
            });
        }

        var menuHierarchy = $("#MenuActive").val();
        if (menuHierarchy) {
            setMenuHierarchy(menuHierarchy);
        }
        keepActiveElementAtTopOnPageLoad();
    });
    // SetMenuHierarchy
    function setMenuHierarchy(menuHierarchy) {
        // Tách chuỗi thành các cấp độ (a, b, c, d)
        var menuLevels = menuHierarchy.split('_');

        var menuId = '';
        // Duyệt qua từng cấp độ để áp dụng lớp CSS
        for (var i = 0; i < menuLevels.length; i++) {

            menuId += (i === 0 ? '' : '_') + menuLevels[i];
            var menuItem = $("#" + menuId); // Sử dụng jQuery để lấy phần tử

            if (menuItem.length) {

                if (i === menuLevels.length - 1) {
                    // Phần tử cuối cùng là menu-item-active
                    menuItem.addClass("menu-item-active");
                } else {
                    // Các phần tử trước đó là menu-item-open và menu-item-here
                    menuItem.addClass("menu-item-open menu-item-here");
                }
            }
        }
    }

    function keepActiveElementAtTopOnPageLoad() {
        var menuElement = $('#kt_aside_menu');
        if (!menuElement.length) return;

        var activeElement = $('.menu-item-active');
        if (!activeElement.length) return;

        var targetPosition = activeElement.offset().top;
        menuElement.stop().animate({
            scrollTop: targetPosition
        }, 'slow');
    }
    // End SetMenuHierarchy

    function showLoadingOverlay() {
        $('#loadingOverlay').css('display', 'block'); // Hiển thị LoadingOverlay
    }

    function hideLoadingOverlay() {
        $('#loadingOverlay').css('display', 'none') // Ẩn LoadingOverlay khi xong quá trình xử lý
        $('body').removeClass('modal-open');
        $('.modal-backdrop').remove();
    }

    // Gọi hàm showLoadingOverlay khi trang bắt đầu tải
    //document.addEventListener("DOMContentLoaded", function () {
    //    showLoadingOverlay();
    //    fetchUnreadNotifications();
    //});

    // Gọi hàm hideLoadingOverlay khi trang đã tải xong
    //window.onload = function () {
