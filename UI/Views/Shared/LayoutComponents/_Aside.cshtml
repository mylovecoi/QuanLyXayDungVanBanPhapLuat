@{
    var session = HttpContextAccessor?.HttpContext?.Session ?? null;
    string Title = ViewData["Title"]?.ToString() ?? "";
}
<div class="aside aside-left aside-fixed d-flex flex-column flex-row-auto" id="kt_aside">
    <!--begin::Brand-->
    <div class="brand flex-column-auto" id="kt_brand">
        <!--begin::Logo-->
        <a asp-controller="Home" asp-action="Index" class="brand-logo">
            <img alt="Logo" src="~/FileUpload/Logo/logo-nganh-tu-phap.png" style="margin: auto; width:22%" />
        </a>
        <!--end::Logo-->
        <!--begin::Toggle-->
        <!--Test lại sau-->
        <button class="brand-toggle btn btn-sm px-0
             @(session != null && (FuntionGlobal.GetSsAdmin(session, "Menu") != "Minimize"
                                     || string.IsNullOrEmpty(FuntionGlobal.GetSsAdmin(session, "SsAdmin"))) ?
                                     "" : " active")" id="kt_aside_toggle">
            <span class="svg-icon svg-icon svg-icon-xl">
                <!--begin::Svg Icon | path:assets/media/svg/icons/Navigation/Angle-double-left.svg-->
