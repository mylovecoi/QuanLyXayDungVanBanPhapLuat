<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>@ViewData["Title"] | LifeSoft</title>
    <link rel="shortcut icon" href="~/FileUpload/Logo/Icon_Life.png"/>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Nunito+Sans:300,400,500,600,700" />
    <meta name='viewport' content='width=device-width, initial-scale=1' />

    <link rel="stylesheet" href="~/assets/css/style.report.css" /> 

    <!-- Bootstrap CSS (phiên bản mới nhất) -->   
    <script src="~/assets/js/jquery.report.js"></script>
   
    <script src="~/assets/js/bootstrap.reports.js"></script>
   
    <script src="~/assets/js/ex.excel.js"></script>
    <script src="~/assets/js/ex.doc.js"></script>

    <style type="text/css">
        .checkbox {
            display: block;
            font-size: 16px;
            font-weight: 500;
            border: 1px solid #333;
            width: 20px;
            height: 20px;
            text-align: center;
            color: #000;
            text-decoration: none;
            line-height: 20px;
            opacity: 1;
        }

        body {  
            font: normal 14px/16px time, serif;
            overflow-x: hidden; /* Ẩn thanh cuộn ngang */
            width: 100%;
        }

        table, p {
            width: 98%;
            margin: auto;
        }

            table tr td:first-child {
                text-align: center;
                /*  border: 1px solid black; */ /* Thêm đường viền */
            }

            table tr th {
                text-align: center;
            }

        td, th {
            padding: 5px;
        }

        p {
            padding: 3px;
        }

        @@media print {
            .in {
                display: none !important;
            }

            #myBtn {
                display: none !important;
            }
        }

        #fixNav {
            /*background: #f7f7f7;*/
            /*background: #1a1a27;*/
            width: 100%;
            height: 30px;
            display: block;
            /*box-shadow: 0px 2px 2px rgba(0,0,0,0.5);*/ /*Đổ bóng cho menu*/
            position: fixed; /*Cho menu cố định 1 vị trí với top và left*/
            top: 0; /*Nằm trên cùng*/
            left: 0; /*Nằm sát bên trái*/
            z-index: 100000; /*Hiển thị lớp trên cùng*/
            opacity: 0;
        }

            #fixNav:hover {
                opacity: 1;
            }

            #fixNav ul {
                margin: 0;
                padding: 0;
            }
                #fixNav ul li {
                    list-style: none inside;
                    width: auto;
                    float: left;
                    line-height: 35px; /*Cho text canh giữa menu*/
                    color: #fff;
                    padding: 0;
                    margin-left: 10px;
                    margin-top: 5px;
                    position: relative;
                }
                    #fixNav ul li a {
                        text-transform: uppercase;
                        white-space: nowrap; /*Cho chữ trong menu không bị wrap*/
                        padding: 0 10px;
                        color: #fff;
                        display: block;
                        font-size: 0.8em;
                        text-decoration: none;
                    }

        #myBtn {
            display: none;
            position: fixed;
            bottom: 50px;
            right: 30px;
            justify-content: center;
            align-items: center;
            width: 25px;
            height: 25px;
            z-index: 100;
            font-size: 40px;
            border: none;
            outline: none;
            background-color: transparent;
            cursor: pointer;
            padding: 10px;
            color: black;
            /*border-radius: 4px ;*/
            border-radius: 0.42rem !important;
        }

            #myBtn:hover {
                color: #3699FF;
            }
    @RenderSection("custom_style", required: false)
    </style>
</head>
<body style="font-size:16px;">
    <input hidden=hidden id="title" name="title" value="@ViewData["Title"]" />
    <div class="in">
        <nav id="fixNav">
            <ul>
                <li>
                    <button type="button" class="btn btn-success" onclick="window.print()">
                        <i class="fas fa-print"></i>&ensp;Print
                    </button>
                </li>
                <li>
                    <button type="button" class="btn btn-primary" onclick="exportDataToDocx()">
                        <i class="far fa-file-word"></i>&ensp;Export Doc
                    </button>
                </li>
                <li>
                    <button type="button" class="btn btn-primary" onclick="exportTableToXlsx()">
                        <i class="far fa-file-excel"></i>&ensp;Export Excel
                    </button>
                </li>
            </ul>
        </nav>
    </div>

    <div id="data" style="position: relative; margin-top: 5px; margin-bottom:5px;">
        @RenderBody()
    </div>

    <button onclick="topFunction()" id="myBtn" title="Di chuyển lên đầu trang" style="display: none;">
        <span class="svg-icon svg-icon-primary svg-icon-2x">
            <!--begin::Svg Icon | path:C:\wamp64\www\keenthemes\themes\metronic\theme\html\demo1\dist/../src/media/svg/icons\Navigation\Angle-double-up.svg-->
            <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1">
                <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                    <polygon points="0 0 24 0 24 24 0 24" />
                    <path d="M8.2928955,10.2071068 C7.90237121,9.81658249 7.90237121,9.18341751 8.2928955,8.79289322 C8.6834198,8.40236893 9.31658478,8.40236893 9.70710907,8.79289322 L15.7071091,14.7928932 C16.085688,15.1714722 16.0989336,15.7810586 15.7371564,16.1757246 L10.2371564,22.1757246 C9.86396402,22.5828436 9.23139665,22.6103465 8.82427766,22.2371541 C8.41715867,21.8639617 8.38965574,21.2313944 8.76284815,20.8242754 L13.6158645,15.5300757 L8.2928955,10.2071068 Z" fill="#000000" fill-rule="nonzero" transform="translate(12.000003, 15.500003) scale(-1, 1) rotate(-90.000000) translate(-12.000003, -15.500003) " />
