<!DOCTYPE html>
<html lang="vi-VN"> *@
@{
    var session = HttpContextAccessor?.HttpContext?.Session ?? null;
    string Title = ViewData["Title"]?.ToString() ?? "";
    string agentId = "";
    if (session != null && !string.IsNullOrEmpty(session.GetString("SsAdmin")))
    {
        agentId = FuntionGlobal.GetSsAdmin(session, "AgentId");
    }

    // NEW: determine theme and expose to partials
    var theme = "light";
    if (session != null && !string.IsNullOrEmpty(session.GetString("SsAdmin")))
    {
        var selectedTheme = FuntionGlobal.GetSsAdmin(session, "Theme");
        if (!string.IsNullOrEmpty(selectedTheme))
        {
            theme = selectedTheme.ToLower();
        }
    }
    ViewBag.Theme = theme;
}
<!DOCTYPE html>
<!-- add theme class to html so CSS scoped to .theme-dark/.theme-light works -->
<html lang="vi-VN" class="theme-@ViewBag.Theme">
<!--begin::Head-->
<head>
    @await Html.PartialAsync("~/Views/Shared/LayoutComponents/_Head.cshtml")
    @RenderSection("custom_style", required: false)
</head>
<!--end::Head-->
<!--begin::Body-->
<body onload="display_ct6()" id="kt_body" class="header-fixed header-mobile-fixed subheader-enabled subheader-fixed page-loading"
      data-controller-path="@Url.Action("Index", ViewContext.RouteData.Values["controller"]?.ToString())">
    <!--begin:: loadingOverlay-->
    <div id="loadingOverlay" class="overlay overlay-block">
        <div class="bg-secondary loading">
            <div class="spinner spinner-lg spinner-primary"></div>
            <span class="text-dark">Đang xử lý! Vui lòng đợi trong giây lát...</span>
        </div>
    </div>
    <!--end:: loadingOverlay-->
    @Html.AntiForgeryToken()
   
    <!--begin::Main-->
    <!--begin::Header Mobile-->
    @await Html.PartialAsync("~/Views/Shared/LayoutComponents/_HeaderMobile.cshtml")
    <!--end::Header Mobile-->
    <div class="d-flex flex-column flex-root">
        <!--begin::Page-->
        <div class="d-flex flex-row flex-column-fluid page">
            <!--begin::Wrapper-->
            <div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
                <!--begin::Header-->
                @await Html.PartialAsync("~/Views/Shared/LayoutComponents/_Header.cshtml")
                <!--end::Header-->
                <!--begin::Content-->
                <div class="content d-flex flex-column flex-column-fluid" id="kt_content"
                     style="background-image: url('../../../assets/media/bg/bg-3.jpg')">
                    <!--begin::Subheader-->
                    <div class="subheader subheader-solid" id="kt_subheader">
                        <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
                            <!--begin::Info-->
                            <div class="d-flex align-items-center flex-wrap mr-1">
                                <!--begin::Page Heading-->
                                <div class="d-flex align-items-baseline flex-wrap mr-5">
                                    <!--begin::Breadcrumb-->
                                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                                        <li class="breadcrumb-item text-muted">
                                            <a asp-controller="Home" asp-action="Index"><h5 class="text-dark font-weight-bold my-1 mr-5">Trang chủ</h5></a>
                                        </li>
                                        @if (Title != "Trang chủ")
                                        {
                                            <li class="breadcrumb-item text-muted">
                                                <a href="" class="text-muted">@ViewData["Title"]</a>
                                            </li>
                                        }
                                    </ul>
                                    <!--end::Breadcrumb-->
                                </div>
                                <!--end::Page Heading-->
                            </div>
                            <!--end::Info-->
                            <!--begin::Toolbar-->
                            <div class="d-flex align-items-center">
                                <span id="ct6" class="label label-sm label-rounded label-light-primary" style="font-size:12px; width:170px; height:30px;"></span>
                            </div>
                            <!--end::Toolbar-->
                        </div>
                    </div>
                    <!--end::Subheader-->
                    <!--begin::Entry-->
                    <div class="d-flex flex-column-fluid">
                        <input hidden id="agentId" name="agentId" value="@agentId" />
                        <!--begin::Container-->
                        <div class="@(session != null && !string.IsNullOrEmpty(session.GetString("SsAdmin")) ?
                                                                                                 session != null && FuntionGlobal.GetSsAdmin(session, "Content") == "Max" ? "container-fluid" : "container" :
                                                                                                 " container-fluid")">
                            <!--begin::Row-->
                            @RenderBody()
                            <!--end::Row-->
                        </div>
                        <!--end::Container-->
                    </div>
                    <!--end::Entry-->
                </div>
                <!--end::Content-->
                <!--begin::Footer-->
                @await Html.PartialAsync("~/Views/Shared/LayoutComponents/_Footer.cshtml")
                <!--end::Footer-->
            </div>
            <!--end::Wrapper-->
        </div>
        <!--end::Page-->
    </div>
    <!--end::Main-->
    <!-- begin::User Panel-->
    <div id="kt_quick_user" class="offcanvas offcanvas-right p-10">
        <!-- begin::User Panel-->
        @await Html.PartialAsync("~/Views/Shared/LayoutComponents/_UserPanel.cshtml")
        @await Html.PartialAsync("~/Views/Shared/LayoutComponents/_ChatBot.cshtml")
        <!-- end::User Panel-->
        <!--begin::Scrolltop-->
        <div id="kt_scrolltop" class="scrolltop">
            <span class="svg-icon">
                <!--begin::Svg Icon | path:assets/media/svg/icons/Navigation/Up-2.svg-->
                <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1">
                    <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                        <polygon points="0 0 24 0 24 24 0 24"></polygon>
                        <rect fill="#000000" opacity="0.3" x="11" y="10" width="2" height="10" rx="1"></rect>
                        <path d="M6.70710678,12.7071068 C6.31658249,13.0976311 5.68341751,13.0976311 5.29289322,12.7071068 C4.90236893,12.3165825 4.90236893,11.6834175 5.29289322,11.2928932 L11.2928932,5.29289322 C11.6714722,4.91431428 12.2810586,4.90106866 12.6757246,5.26284586 L18.6757246,10.7628459 C19.0828436,11.1360383 19.1103465,11.7686056 18.7371541,12.1757246 C18.3639617,12.5828436 17.7313944,12.6103465 17.3242754,12.2371541 L12.0300757,7.38413782 L6.70710678,12.7071068 Z" fill="#000000" fill-rule="nonzero"></path>
                    </g>
                </svg>
                <!--end::Svg Icon-->
            </span>
        </div>
        <!--end::Scrolltop-->
        <!-- begin::Scripts-->
        @await Html.PartialAsync("~/Views/Shared/LayoutComponents/_Scripts.cshtml")
        @RenderSection("custom_script", required: false)
        @await RenderSectionAsync("Scripts", required: false)
        <!-- end::Scripts-->
    </div>
</body>
<!--end::Body-->
</html>